#!/usr/bin/env bash
# EDMV3-T61 AC1: the block between EDM-HELP-BEGIN and EDM-HELP-END below is sentinel-delimited,
# not a hardcoded `sed -n 'A,Bp'` line range -- `usage()` extracts between the sentinels with
# awk. A hardcoded range silently stops covering a new doc line added below its end unless two
# numbers are bumped in lockstep. Mirrored verbatim in bin/edm-state (same fix, same reason).
# EDM-HELP-BEGIN
# edm-lint-artifacts - scan EDM initiative artifacts for violations.
# Usage:
#   edm-lint-artifacts <PREFIX>            # scan one initiative's artifacts (resolved via edm-state)
#   edm-lint-artifacts --all               # scan every initiative under the SRD root -- flat and
#                                           # product-scoped layouts, excluding .archived/
#   edm-lint-artifacts --path <dir|file>   # scan an arbitrary directory or file directly; strictly
#                                           # read-only, performs no state resolution, never calls
#                                           # edm-state
#   edm-lint-artifacts -h|--help           # show this help
#
# <PREFIX>, --all and --path are mutually exclusive. Supplying two of the three is a usage
# error (exit 2), not a silent precedence rule.
#
# Violation classes (all cause a non-zero exit):
#   attribution        -- AI-attribution trailers: the Co-Authored-By / Generated-By / Assisted-By
#                         trailer forms naming any tool, plus the Claude-specific "generated with
#                         claude" / "created by claude" / "claude-flow" phrasings
#   unicode            -- non-ASCII bytes in committed artifact files
#   leaked-tool-tag    -- XML/tool-invocation tags leaked into artifact content
#   mermaid-semicolon  -- a literal ';' inside Mermaid label/edge/message text, or a misused
#                         ignore marker inside a mermaid fence (EDMV3-T43); see plugins/edm/
#                         CLAUDE.md's "Mermaid diagram conventions (canonical)" section
#
# Output format: path:line: <class>: <snippet>
# Exit codes: 0 = clean; 1 = one or more violations found; 2 = usage or environment error
# (unknown flag, missing argument, edm-state absent, unresolvable prefix, unreadable --path
# target). Exit 2 is kept distinct from exit 1 so the PreToolUse git-commit hook can tell a
# misinvocation from a dirty tree -- they call for opposite responses.
#
# Ignore markers (place in .md files to suppress false positives on policy docs):
#   <!-- edm-lint-ignore -->           -- ignores the NEXT line only
#   <!-- edm-lint-ignore-start -->     -- begins an ignored block
#   <!-- edm-lint-ignore-end -->       -- ends an ignored block
#   Lines inside ``` code fences are also ignored automatically, including fences indented
#   inside a numbered step or list item.
#
# Honors the EDM_SRD_ROOT and CLAUDE_PLUGIN_OPTION_SRD_ROOT environment vars
# so relocated trees are linted correctly (AC9).
# EDM-HELP-END
set -euo pipefail

SRD_ROOT="${EDM_SRD_ROOT:-${CLAUDE_PLUGIN_OPTION_SRD_ROOT:-./SRD}}"

die() {
  local msg="$1" code="${2:-1}"
  echo "edm-lint-artifacts: $msg" >&2
  exit "$code"
}

usage() {
  awk '/^# EDM-HELP-BEGIN/{f=1;next} /^# EDM-HELP-END/{f=0} f' "$0"
  exit 0
}

# ---- Argument parsing: <PREFIX> | --all | --path <dir|file>, mutually exclusive ---------------
case "${1:-}" in
  -h|--help|help) usage ;;
esac

MODE="prefix"
PREFIX=""
PATH_ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)
      [[ "$MODE" == "prefix" && -z "$PREFIX" ]] \
        || die "usage: --all is mutually exclusive with --path and a PREFIX" 2
      MODE="all"
      shift
      ;;
    --path)
      [[ $# -ge 2 ]] || die "--path requires a directory or file argument" 2
      [[ "$MODE" == "prefix" && -z "$PREFIX" ]] \
        || die "usage: --path is mutually exclusive with --all and a PREFIX" 2
      MODE="path"
      PATH_ARG="$2"
      shift 2
      ;;
    --*)
      die "unknown flag: $1" 2
      ;;
    *)
      [[ "$MODE" == "prefix" ]] || die "usage: PREFIX is mutually exclusive with --all/--path" 2
      [[ -z "$PREFIX" ]] || die "unexpected extra argument: $1" 2
      PREFIX="$1"
      shift
      ;;
  esac
done

if [[ "$MODE" == "prefix" && -z "$PREFIX" ]]; then
  die "usage: edm-lint-artifacts <PREFIX> | --all | --path <dir|file>" 2
fi

# Verify grep supports -P (PCRE) for Unicode detection.
_has_pcre_grep=0
if echo "" | grep -qP '' 2>/dev/null; then
  _has_pcre_grep=1
fi

violations=0

# ---- Helper: report a violation -----------------------------------------------
# report_violation <class> <filepath> <line> <snippet>
report_violation() {
  local class="$1" filepath="$2" lineno="$3" snippet="$4"
  printf '%s:%s: %s: %s\n' "$filepath" "$lineno" "$class" "$snippet"
  violations=$((violations + 1))
}

# ---- Helper: build the shared per-line classification table for a file (EDMV3-T43) -----------
# Emits "lineno<TAB>ignored" and/or "lineno<TAB>mermaid" for every line that qualifies, computed
# in exactly ONE read of the file, in place of the prior per-class helper that was called once
# per violation class (three separate reads of every file); all four classes below now share this
# single pass, which is both the cleanest factoring and how EDMV3-102's 40% lint-time budget is
# met by construction rather than by a fourth independent full pass.
#
# ignored  -- lines inside ANY ``` fence (any language, or none), inside an
#             <!-- edm-lint-ignore-start/end --> block, or the single line following a bare
#             <!-- edm-lint-ignore --> marker. Consumed by classes 1-3; behavior is unchanged
#             from before this refactor (EDMV3-T43 AC9).
# mermaid  -- lines inside a fence opened with the info string `mermaid` (its first whitespace-
#             delimited token), excluding the fence delimiter lines themselves. Consumed by
#             class 4 only.
#
# Two escape valves suppress a mermaid fence for class 4 specifically (EDMV3-T43 AC6):
#   - The block-form markers (<!-- edm-lint-ignore-start/end -->) placed OUTSIDE the fence --
#     handled generically, since the whole fence then also lands in the "ignored" set, and class
#     4 skips any line that is ignored.
#   - A single-line <!-- edm-lint-ignore --> marker literally on the fence-open line -- suppresses
#     that one fence's "mermaid" membership entirely (its usual next-line-only meaning does not
#     apply here; there is no safe "next line" inside fenced diagram source for it to land on).
# A single-line marker anywhere else inside a mermaid fence is unsupported usage (an HTML comment
# is Mermaid *content*, not a comment -- Mermaid's own comment syntax is `%%`) and is left in the
# "mermaid" set so class 4 reports it explicitly rather than silently doing nothing with it.
build_line_classes() {
  local file="$1"
  # Single awk pass per file. This was a bash `while read` loop with an `awk` fork inside it
  # (one fork per fence line); EDMV3-T67 measured 39,872ms to lint a 30-file initiative against
  # a 3000ms budget, and this loop was the cause. awk does the same state machine in one fork
  # per file. Semantics are byte-identical to the bash version -- the three emitted classes,
  # their ordering per line, and every marker/fence interaction are preserved exactly.
  awk '
    BEGIN { in_fence=0; in_ignore_block=0; ignore_next=0; in_mermaid=0; mermaid_suppressed=0 }
    {
      lineno = NR
      if (ignore_next == 1) {
        print lineno "\tignored"
        print lineno "\tmarker"
        ignore_next = 0
        next
      }
      # Fence detection tolerates leading whitespace. A fence nested inside a numbered step or a
      # list item is indented, and this repository has 60-odd of them -- anchoring at column 1
      # meant classes 1-3 fired on the contents of every indented fence and class 4 never fired
      # inside an indented mermaid fence, neither of which is what --help promises.
      # NOTE: no apostrophes in this awk program -- it is single-quoted in the enclosing shell.
      fence_body = $0
      sub(/^[[:space:]]+/, "", fence_body)
      if (substr(fence_body, 1, 3) == "```") {
        if (in_fence == 0) {
          info = substr(fence_body, 4)
          split(info, parts, /[ \t]+/)
          lang = parts[1]
          in_fence = 1
          if (lang == "mermaid") {
            in_mermaid = 1
            mermaid_suppressed = (index($0, "<!-- edm-lint-ignore -->") > 0) ? 1 : 0
          } else {
            in_mermaid = 0; mermaid_suppressed = 0
          }
        } else {
          in_fence = 0; in_mermaid = 0; mermaid_suppressed = 0
        }
        next
      }
      if (index($0, "<!-- edm-lint-ignore-end -->") > 0) { in_ignore_block = 0; next }
      if (in_fence == 1 || in_ignore_block == 1) print lineno "\tignored"
      if (in_ignore_block == 1) print lineno "\tmarker"
      if (in_mermaid == 1 && mermaid_suppressed == 0) print lineno "\tmermaid"
      if (index($0, "<!-- edm-lint-ignore-start -->") > 0) in_ignore_block = 1
      if (index($0, "<!-- edm-lint-ignore -->") > 0 && in_mermaid == 0) ignore_next = 1
    }
  ' "$file"
}

# ---- Helper: is a line number in a given line-set (generic membership test) --------------------
is_ignored_line() {
  local lineno="$1" lineset="$2"
  [[ -n "$lineset" ]] && echo "$lineset" | grep -qxF "$lineno"
}

# ---- Helper: the class-4 Mermaid scan for one file, as a single awk pass -----------------------
# (EDMV3-T43 AC4/AC5) Applies the raw-semicolon rules only to lines already known to be inside a
# mermaid fence (EDM_MERMAID_SET) and not suppressed by an explicit edm-lint-ignore-start/end
# block (EDM_MARKER_SET). Both sets arrive through the environment rather than -v so that awk
# does no backslash-escape processing on them.
#
# One awk process per file, not per line: the rules below were previously a bash function that
# forked sed and grep about ten times for every mermaid line, which made this class the dominant
# cost of a whole-tree lint once class 1 was fixed.
#
# Emits one tab-separated record per finding:
#   U<TAB><lineno><TAB>            -- an edm-lint-ignore marker misused inside a mermaid fence
#   V<TAB><lineno><TAB><snippet>   -- a raw semicolon inside label/edge/message text
mermaid_scan_awk() {
  local file="$1" mermaid_set="$2" marker_set="$3"
  EDM_MERMAID_SET="$mermaid_set" EDM_MARKER_SET="$marker_set" awk '
    function trim(s) {
      sub(/^[[:space:]]*/, "", s); sub(/[[:space:]]*$/, "", s); return s
    }
    # Strip legal entity codes (#59;, #quot;, #35;, ...) before span-checking so a legitimate
    # entity reference is never mistaken for a raw semicolon. The 1..10 character bound is
    # walked explicitly rather than written as an ERE interval, because interval support is not
    # universal across the awk implementations this plugin runs on (bwk awk, mawk, busybox awk).
    function strip_entities(s,   out, i, n, j, k) {
      out = ""; i = 1; n = length(s)
      while (i <= n) {
        if (substr(s, i, 1) == "#") {
          j = i + 1; k = 0
          while (k < 10 && j <= n && substr(s, j, 1) ~ /[0-9A-Za-z]/) { j++; k++ }
          if (k >= 1 && j <= n && substr(s, j, 1) == ";") { i = j + 1; continue }
        }
        out = out substr(s, i, 1); i++
      }
      return out
    }
    function is_violation(line,   trimmed, stripped, after_colon, p) {
      trimmed = trim(line)

      # Legal: a Mermaid comment line.
      if (substr(trimmed, 1, 2) == "%%") return 0

      # Legal: classDef / style / linkStyle directives -- their trailing ";" is a statement
      # terminator, never a label boundary.
      if (trimmed ~ /^(classDef|style|linkStyle)[[:space:]]/) return 0
      if (trimmed == "classDef" || trimmed == "style" || trimmed == "linkStyle") return 0

      stripped = strip_entities(line)

      # Legal: a bare statement-terminating ";" at the very end of the line (outside any label)
      # -- strip exactly one trailing ";" before span-checking.
      sub(/;[[:space:]]*$/, "", stripped)

      # Label spans: a raw ";" inside [...], (...), {...}, |...|, or "..." is a violation.
      if (stripped ~ /\[[^][]*;[^][]*\]/) return 1
      if (stripped ~ /\([^()]*;[^()]*\)/) return 1
      if (stripped ~ /\{[^{}]*;[^{}]*\}/) return 1
      if (stripped ~ /\|[^|]*;[^|]*\|/) return 1
      if (stripped ~ /"[^"]*;[^"]*"/) return 1

      # Sequence-diagram-style message line: a raw ";" after the first ":" on an arrow line.
      p = index(stripped, ":")
      if (index(stripped, "->") > 0 && p > 0) {
        after_colon = substr(stripped, p + 1)
        if (index(after_colon, ";") > 0) return 1
      }
      return 0
    }
    BEGIN {
      n = split(ENVIRON["EDM_MERMAID_SET"], a, "\n")
      for (i = 1; i <= n; i++) if (a[i] != "") mer[a[i]] = 1
      n = split(ENVIRON["EDM_MARKER_SET"], b, "\n")
      for (i = 1; i <= n; i++) if (b[i] != "") ign[b[i]] = 1
    }
    {
      if (!(FNR in mer)) next
      if (FNR in ign) next
      # Being merely inside a mermaid fence is not itself a suppression reason -- that is exactly
      # what this class exists to inspect -- so a single-line marker here is unsupported usage
      # and is reported rather than silently honored (EDMV3-T43 AC6).
      if (index($0, "<!-- edm-lint-ignore -->") > 0) { print "U\t" FNR "\t"; next }
      if (is_violation($0)) print "V\t" FNR "\t" substr($0, 1, 120)
    }
  ' "$file"
}

# ---- Helper: list *.md files under a directory, excluding .git/ and .archived/ ----------------
collect_md_files() {
  local dir="$1"
  find "$dir" \
    -not -path '*/.git/*' \
    -not -path '*/.archived/*' \
    -name '*.md' \
    2>/dev/null \
  | sort
}

# ---- Helper: scan a list of files across all violation classes --------------------------------
# scan_md_files <file...> -- prints 'path:line: <class>: <snippet>' per violation and increments
# the global `violations`. Shared by prefix mode, --all mode and --path mode so there is exactly
# one implementation of the scan (EDMV3-111).
scan_md_files() {
  [[ $# -eq 0 ]] && return 0
  local file i

  # ---- Shared one-pass line classification (EDMV3-T43) --------------------------
  # build_line_classes is called exactly once per file here, computed up front, and its two
  # derived sets (ignore/mermaid) are reused by all four classes below -- a four-class lint run
  # still costs one read of each file, not four.
  local FILES=("$@")
  local IGNORE_SETS=()
  local MERMAID_SETS=()
  local MARKER_SETS=()
  for i in "${!FILES[@]}"; do
    local _table
    _table="$(build_line_classes "${FILES[$i]}")"
    IGNORE_SETS[$i]="$(printf '%s\n' "$_table" | awk -F'\t' '$2=="ignored"{print $1}')"
    MERMAID_SETS[$i]="$(printf '%s\n' "$_table" | awk -F'\t' '$2=="mermaid"{print $1}')"
    MARKER_SETS[$i]="$(printf '%s\n' "$_table" | awk -F'\t' '$2=="marker"{print $1}')"
  done

  # ---- Class 1: Attribution trailers (EDMV2-T113 phrase set) --------------------
  local _ATTR_PHRASES=(
    "co-authored-by"
    "co-authored by"
    "generated with claude"
    "generated by claude"
    "claude-flow"
    "created by claude"
    # Trailer-style attribution naming any tool, not just Claude. The repository convention bans
    # AI-attribution trailers as a class (`Co-Authored-By`, `Generated-By`), so a trailer naming
    # a different assistant has to fail too. Only the hyphenated trailer spelling is listed: bare
    # "generated by" would fire on ordinary prose, and this repository discusses generated
    # artifacts constantly (docs/canonical-sections.md, the ticket pack, the CHANGELOG).
    "generated-by"
    "assisted-by"
  )
  # One case-insensitive fixed-string grep per file, matching how classes 2 and 3 already work.
  # This was a bash per-line loop that forked `echo | tr` TWICE per line to lowercase it --
  # ~20,000 forks on a 30-file/10k-line initiative, which is what EDMV3-T67 measured at 39,872ms
  # against a 3000ms budget. grep does the same case-insensitive fixed-string match in one fork
  # per file. Phrase list, matching semantics (case-insensitive substring), one-violation-per-line
  # (grep prints each matching line once), and the 120-char snippet are all unchanged.
  local _attr_pattern_file
  _attr_pattern_file="$(mktemp)" || die "mktemp failed" 2
  printf '%s\n' "${_ATTR_PHRASES[@]}" > "$_attr_pattern_file"
  for i in "${!FILES[@]}"; do
    file="${FILES[$i]}"
    local ignore_set lineno _rest snippet
    ignore_set="${IGNORE_SETS[$i]}"
    while IFS=: read -r lineno _rest; do
      is_ignored_line "$lineno" "$ignore_set" && continue
      snippet="$(sed -n "${lineno}p" "$file" 2>/dev/null | tr -d '\r' | cut -c1-120 || true)"
      report_violation "attribution" "$file" "$lineno" "$snippet"
    done < <(grep -niF -f "$_attr_pattern_file" "$file" 2>/dev/null || true)
  done
  rm -f "$_attr_pattern_file"

  # ---- Class 2: Non-ASCII (Unicode) bytes ---------------------------------------
  if [[ "$_has_pcre_grep" -eq 1 ]]; then
    for i in "${!FILES[@]}"; do
      file="${FILES[$i]}"
      local ignore_set lineno _rest snippet
      ignore_set="${IGNORE_SETS[$i]}"
      while IFS=: read -r _f lineno _rest; do
        is_ignored_line "$lineno" "$ignore_set" && continue
        snippet="$(sed -n "${lineno}p" "$file" 2>/dev/null | cut -c1-120 || true)"
        report_violation "unicode" "$file" "$lineno" "$snippet"
      done < <(grep -nP '[^\x00-\x7F]' "$file" 2>/dev/null || true)
    done
  else
    # Fallback: LC_ALL=C grep for bytes > 0x7F
    for i in "${!FILES[@]}"; do
      file="${FILES[$i]}"
      local ignore_set lineno _rest snippet
      ignore_set="${IGNORE_SETS[$i]}"
      while IFS=: read -r lineno _rest; do
        is_ignored_line "$lineno" "$ignore_set" && continue
        snippet="$(sed -n "${lineno}p" "$file" 2>/dev/null | cut -c1-120 || true)"
        report_violation "unicode" "$file" "$lineno" "$snippet"
      done < <(LC_ALL=C grep -nv '^[[:print:][:space:]]*$' "$file" 2>/dev/null || true)
    done
  fi

  # ---- Class 3: Leaked tool/markup tags -----------------------------------------
  # Matches known Claude tool-invocation tag names. Uses -E (extended regex).
  # Pattern scoped to known tag names to avoid false positives on legitimate HTML
  # in code fences or Mermaid diagrams (no bare angle-bracket match).
  local _TAG_PATTERN='</?[[:space:]]*(function_calls|invoke|parameter|antml:|use_mcp_tool|result)[^>]*>'
  for i in "${!FILES[@]}"; do
    file="${FILES[$i]}"
    local ignore_set lineno _rest snippet
    ignore_set="${IGNORE_SETS[$i]}"
    while IFS=: read -r lineno _rest; do
      is_ignored_line "$lineno" "$ignore_set" && continue
      snippet="$(sed -n "${lineno}p" "$file" 2>/dev/null | cut -c1-120 || true)"
      report_violation "leaked-tool-tag" "$file" "$lineno" "$snippet"
    done < <(grep -nE "$_TAG_PATTERN" "$file" 2>/dev/null || true)
  done

  # ---- Class 4: Mermaid literal-semicolon (EDMV3-T43) ---------------------------
  # Files with no ``` mermaid ``` fence short-circuit without a per-line scan (EDMV3-102 AC10
  # performance budget) -- the mermaid set is already empty from the shared pass above, so there
  # is nothing further to compute here.
  for i in "${!FILES[@]}"; do
    file="${FILES[$i]}"
    local mermaid_set="${MERMAID_SETS[$i]}"
    [[ -z "$mermaid_set" ]] && continue
    local marker_set="${MARKER_SETS[$i]}"
    local rec rest kind lineno snippet
    # Lines suppressed by an EXPLICIT edm-lint-ignore-start/end block (the supported escape
    # valve, EDMV3-T43 AC6) are filtered inside the awk pass via EDM_MARKER_SET.
    #
    # Split the record by hand rather than with `IFS=$'\t' read`: tab is IFS whitespace, so read
    # would collapse the field separator and a following literal tab into one delimiter and eat
    # the leading indentation of any tab-indented source line reported in the snippet.
    while IFS= read -r rec; do
      [[ -z "$rec" ]] && continue
      kind="${rec%%$'\t'*}"
      rest="${rec#*$'\t'}"
      lineno="${rest%%$'\t'*}"
      snippet="${rest#*$'\t'}"
      if [[ "$kind" == "U" ]]; then
        snippet="unsupported: edm-lint-ignore has no effect inside a mermaid fence (Mermaid's comment syntax is %%); use edm-lint-ignore-start/end around the fence instead"
      fi
      report_violation "mermaid-semicolon" "$file" "$lineno" "$snippet"
    done < <(mermaid_scan_awk "$file" "$mermaid_set" "$marker_set" 2>/dev/null || true)
  done
}

# ---- Mode dispatch --------------------------------------------------------------------------
case "$MODE" in
  prefix)
    # Resolve the initiative directory via edm-state (honors product-scoped layout).
    command -v edm-state >/dev/null 2>&1 || die "edm-state not found on PATH" 2
    INIT_DIR="$(edm-state resolve-dir "$PREFIX" 2>&1)" \
      || die "no initiative for prefix  (run: edm-state init )" 2
    [[ -d "$INIT_DIR" ]] || die "initiative directory not found: " 2

    MD_FILES=()
    while IFS= read -r _md_f; do
      MD_FILES+=("$_md_f")
    done < <(collect_md_files "$INIT_DIR")

    if [[ ${#MD_FILES[@]} -eq 0 ]]; then
      echo "edm-lint-artifacts: no .md files found in $INIT_DIR"
      exit 0
    fi

    scan_md_files "${MD_FILES[@]}"

    if [[ "$violations" -eq 0 ]]; then
      echo "edm-lint-artifacts: $PREFIX -- CLEAN (no violations found in $INIT_DIR)"
      exit 0
    else
      echo "edm-lint-artifacts: $PREFIX -- $violations violation(s) found" >&2
      exit 1
    fi
    ;;

  path)
    # Strictly read-only: no state resolution, edm-state is never invoked in this branch.
    if [[ -d "$PATH_ARG" ]]; then
      MD_FILES=()
      while IFS= read -r _md_f; do
        MD_FILES+=("$_md_f")
      done < <(collect_md_files "$PATH_ARG")
    elif [[ -f "$PATH_ARG" ]]; then
      # A single named file is linted directly, regardless of extension -- the caller named it
      # explicitly, unlike directory mode which only considers *.md files.
      MD_FILES=("$PATH_ARG")
    else
      die "--path target not found: " 2
    fi

    if [[ ${#MD_FILES[@]} -eq 0 ]]; then
      echo "edm-lint-artifacts: no .md files found under $PATH_ARG"
      exit 0
    fi

    scan_md_files "${MD_FILES[@]}"

    if [[ "$violations" -eq 0 ]]; then
      echo "edm-lint-artifacts: --path $PATH_ARG -- CLEAN (no violations found)"
      exit 0
    else
      echo "edm-lint-artifacts: --path $PATH_ARG -- $violations violation(s) found" >&2
      exit 1
    fi
    ;;

  all)
    # Consumes the existing layout-aware enumeration rather than re-deriving it (EDMV3-111):
    # `edm-state list --paths` already covers both flat and product-scoped layouts and already
    # excludes .archived/ (list_state_files with no --archived arg).
    command -v edm-state >/dev/null 2>&1 || die "edm-state not found on PATH" 2

    INIT_DIRS=()
    while IFS= read -r _init_d; do
      [[ -n "$_init_d" ]] && INIT_DIRS+=("$_init_d")
    done < <(edm-state list --paths 2>/dev/null || true)

    if [[ ${#INIT_DIRS[@]} -eq 0 ]]; then
      echo "edm-lint-artifacts: --all found no initiatives under $SRD_ROOT"
      exit 0
    fi

    for init_dir in "${INIT_DIRS[@]}"; do
      [[ -d "$init_dir" ]] || continue
      label="${init_dir#"$SRD_ROOT"/}"

      MD_FILES=()
      while IFS= read -r _md_f; do
        MD_FILES+=("$_md_f")
      done < <(collect_md_files "$init_dir")
      [[ ${#MD_FILES[@]} -eq 0 ]] && continue

      before=$violations
      echo "=== ${label} (${init_dir}) ==="
      scan_md_files "${MD_FILES[@]}"
      this_count=$((violations - before))
      [[ $this_count -eq 0 ]] && echo "  (clean)"
    done

    if [[ "$violations" -eq 0 ]]; then
      echo "edm-lint-artifacts: --all -- CLEAN (no violations found across $SRD_ROOT)"
      exit 0
    else
      echo "edm-lint-artifacts: --all -- $violations violation(s) found across initiatives" >&2
      exit 1
    fi
    ;;
esac
