#!/usr/bin/env bash
# EDM-HELP-BEGIN
# edm-init -- scaffold a new SRD/{PREFIX}/ (or product-scoped) initiative directory.
# Usage:
#   edm-init [--product <name>] [--description <slug>] [--mode standard|mini-srd|iac|data-ml|prototype] <PREFIX>
#   edm-init -h|--help|help
# Exit codes:
#   0 = initiative created
#   1 = usage, validation, or runtime error
# Notes:
#   - Honors EDM_SRD_ROOT / CLAUDE_PLUGIN_OPTION_SRD_ROOT for the initiative root.
#   - If both --product and --description are set, uses product-scoped layout:
#     SRD/{PRODUCT}/{PREFIX}__{description}/
#   - If only --product is set in a non-interactive context, falls back to flat layout.
# EDM-HELP-END
set -euo pipefail

SRD_ROOT="${EDM_SRD_ROOT:-${CLAUDE_PLUGIN_OPTION_SRD_ROOT:-./SRD}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"

# G21/CA-074: two-argument form -- see edm-validate-prefix's die() for the full rationale.
# Default of 1 preserved (this script's own long-standing exit-code contract; every existing
# call site is single-argument, so this default keeps their behavior unchanged).
die() {
  local msg="$1" code="${2:-1}"
  echo "edm-init: $msg" >&2
  exit "$code"
}

# --- Flag parsing ---
PREFIX=""
PRODUCT=""
DESCRIPTION=""
# Mode-family install-time defaults (CA-010 / EDMV2-102 middle tier). The --mode flag overrides
# MODE; compliance/impl-mode have no flag and come from the userConfig install option (or built-in).
MODE="${CLAUDE_PLUGIN_OPTION_MODE:-standard}"
COMPLIANCE="${CLAUDE_PLUGIN_OPTION_COMPLIANCE_ENABLED:-false}"
IMPL_MODE="${CLAUDE_PLUGIN_OPTION_IMPLEMENTATION_MODE:-standard}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|help) print_help "${BASH_SOURCE[0]:-$0}"; exit 0 ;;
    --product)    [[ $# -ge 2 ]] || die "--product requires a value"; PRODUCT="$2"; shift 2 ;;
    --description) [[ $# -ge 2 ]] || die "--description requires a value"; DESCRIPTION="$2"; shift 2 ;;
    --mode)       [[ $# -ge 2 ]] || die "--mode requires a value"; MODE="$2"; shift 2 ;;
    --*)          die "unknown flag: $1" ;;
    *)            [[ -z "$PREFIX" ]] || die "unexpected extra argument: $1"; PREFIX="$1"; shift ;;
  esac
done

[[ -n "$PREFIX" ]] || die "usage: edm-init [--product <name>] [--description <slug>] [--mode standard|mini-srd|iac|data-ml|prototype] <PREFIX>"
# CA-344(1): no local prefix-format regex here -- bin/edm-validate-prefix is THE validator
# (CLAUDE.md names it as such) and is invoked unconditionally below. A second copy of the format
# regex here rejected input BEFORE the canonical validator was consulted, so a future widening of
# the format would have appeared not to work at this, the primary entry point.

# --- Validate mode-family values (CA-010) ---
case "$MODE" in
  standard|mini-srd|iac|data-ml|prototype) ;;
  *) die "unknown mode: $MODE (must be standard, mini-srd, iac, data-ml, or prototype)" ;;
esac
case "$COMPLIANCE" in
  true|false) ;;
  *) die "compliance_enabled must be true or false, got: '$COMPLIANCE'" ;;
esac
case "$IMPL_MODE" in
  standard|tdd) ;;
  *) die "implementation_mode must be standard or tdd, got: '$IMPL_MODE'" ;;
esac

# --- Validate product/description format (path-traversal guard, CA-002) ---
# Rejects '/', '..', spaces. Empty is allowed (flat layout / interactive prompt handles it below).
# Matches the migrate-path guard so both path-constructing entry points enforce the same format.
validate_slug() {
  [[ -z "$2" ]] && return 0
  [[ "$2" =~ ^[A-Za-z0-9_-]+$ ]] || die "$1 must contain only [A-Za-z0-9_-], got: '$2'"
}
validate_slug "--product" "$PRODUCT"
validate_slug "--description" "$DESCRIPTION"

# --- Validate prefix (format + global uniqueness, T41 / CA-344) ---
# Invoked by SIBLING path, unconditionally: the validator always ships beside this script, and
# the old `command -v` guard was inconsistent with this script's own premise (edm-state is
# called by bare name unconditionally at the init step below). Format errors exit 1, collisions
# exit 2 -- both propagate.
"${SCRIPT_DIR}/edm-validate-prefix" "$PREFIX" || {
  ec=$?
  exit $ec
}

# --- Determine directory layout ---
# If --product and --description are both given, use product-scoped layout.
# Otherwise fall back to legacy flat layout (EDMV2-90 backward compat, AC6).
if [[ -n "$PRODUCT" && -n "$DESCRIPTION" ]]; then
  # Product-scoped: SRD/{PRODUCT}/{PREFIX}__{DESCRIPTION}/
  DIR="${SRD_ROOT}/${PRODUCT}/${PREFIX}__${DESCRIPTION}"
  mkdir -p "${SRD_ROOT}/${PRODUCT}"
  # Export for edm-state init to compute the correct path via state_file_for.
  export EDM_PRODUCT="$PRODUCT"
  export EDM_DESCRIPTION="$DESCRIPTION"
elif [[ -n "$PRODUCT" && -z "$DESCRIPTION" ]]; then
  # Product given without description -- check if interactive.
  if [[ -t 0 ]]; then
    printf "edm-init: enter a short slug for the initiative description (e.g. enhance-edm-plugin): " >&2
    read -r DESCRIPTION
    validate_slug "--description" "$DESCRIPTION"
    if [[ -n "$DESCRIPTION" ]]; then
      DIR="${SRD_ROOT}/${PRODUCT}/${PREFIX}__${DESCRIPTION}"
      mkdir -p "${SRD_ROOT}/${PRODUCT}"
      export EDM_PRODUCT="$PRODUCT"
      export EDM_DESCRIPTION="$DESCRIPTION"
    else
      DIR="${SRD_ROOT}/${PREFIX}"
    fi
  else
    echo "edm-init: --description missing in non-interactive context; using flat layout" >&2
    DIR="${SRD_ROOT}/${PREFIX}"
  fi
else
  # Neither flag -- legacy flat layout (AC6).
  DIR="${SRD_ROOT}/${PREFIX}"
fi

if [[ -d "$DIR" ]]; then
  die "initiative directory already exists at $DIR (run 'edm-state get $PREFIX' to inspect)"
fi

# --- Scaffold directory tree based on mode (T45) ---
mkdir -p "$DIR"

# Always-present WS-D slots (T80/T76): explorers/ for Phase 1 output; decisions.md for key decisions ledger.
mkdir -p "$DIR/explorers"
cat > "$DIR/decisions.md" <<'DECISIONS_EOF'
# Key Decisions

| # | Decision | Chosen | Rationale | Date |
|---|----------|--------|-----------|------|

## Finding-to-Commit Ledger

| Finding | Source | Decision | Ticket | Status |
|---------|--------|----------|--------|--------|
DECISIONS_EOF

case "$MODE" in
  standard|iac|data-ml)
    # Full layout: code-audit/ created; tickets/ is created on demand by phase 4.
    mkdir -p "$DIR/code-audit"
    ;;
  mini-srd)
    # mini-SRD mode: no separate tickets/ directory.
    # code-audit/ still present for Phase 6 code audit.
    mkdir -p "$DIR/code-audit"
    ;;
  prototype)
    # Prototype mode: Phase 1-2 only -- no tickets/, no code-audit/.
    ;;
esac

# Seed the new state file's mode-family fields from the install-time defaults (CA-010).
export EDM_MODE="$MODE"
export EDM_COMPLIANCE_ENABLED="$COMPLIANCE"
export EDM_IMPLEMENTATION_MODE="$IMPL_MODE"
edm-state init "$PREFIX" >/dev/null

# .gitignore behavior (CA-314): the state backup (written by `_rmw_state_body` in
# `bin/edm-state`, permanent by design for migrate-path rollback), the lock file family
# (`with_state_lock`'s `.lock`/`.lockd`, deliberately never unlinked -- see its CA-169 comment)
# and write_atomic's transient temp files are runtime files, not artifacts, and must never be
# committed regardless of commit_state_file -- written unconditionally, unlike the state file
# itself below. README.md's "Runtime files to .gitignore" section reproduces this same block as
# a copy-pasteable reference. G10/CA-340 (round 6): re-pointed by name, not line number -- the
# two line-number citations this comment used to carry had already drifted stale.
cat > "$DIR/.gitignore" <<'EOF'
.edm-state.json.bak
.edm-state.json.tmp.*
.edm-state.lock*
*.lock
*.lockd*
*.md.tmp.*
EOF
# By default the state file itself is committed. Honor commit_state_file=false by adding it
# to the same per-initiative .gitignore above, so it travels correctly under an srd_root
# relocation rather than living in a second, disconnected file.
COMMIT_STATE="${CLAUDE_PLUGIN_OPTION_COMMIT_STATE_FILE:-true}"
if [[ "$COMMIT_STATE" != "true" ]]; then
  echo ".edm-state.json" >> "$DIR/.gitignore"
fi

# Create and switch to initiative branch when inside a git worktree.
# Branch name: edm/{prefix-lowercase}-{description} when description is set,
# otherwise edm/{prefix-lowercase} -- lowercase keeps branch names readable.
BRANCH_MSG=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  _prefix_lc=$(echo "$PREFIX" | tr '[:upper:]' '[:lower:]')
  if [[ -n "$DESCRIPTION" ]]; then
    BRANCH="edm/${_prefix_lc}-${DESCRIPTION}"
  else
    BRANCH="edm/${_prefix_lc}"
  fi
  if git rev-parse --verify "$BRANCH" >/dev/null 2>&1; then
    git checkout "$BRANCH" 2>/dev/null \
      && BRANCH_MSG="switched to existing branch $BRANCH" \
      || BRANCH_MSG="[warn] branch $BRANCH exists but checkout failed; staying on current branch"
  else
    git checkout -b "$BRANCH" 2>/dev/null \
      && BRANCH_MSG="created and switched to branch $BRANCH" \
      || BRANCH_MSG="[warn] branch creation failed; staying on current branch"
  fi

  # Post-checkout correction (F2a, D3): the edm-state init call above, before the branch block,
  # snapshotted
  # initiative_branch from HEAD *before* this block ran, so it recorded the branch the
  # user was on beforehand -- not the branch actually occupied now. record-branch
  # re-reads HEAD itself rather than trusting $BRANCH, so it correctly records the new
  # branch on the success paths above and the original branch on the warn-and-continue
  # paths (checkout failed, user stayed put). It is a no-op outside a git worktree, so
  # this call is safe to leave unconditional inside this guard.
  edm-state record-branch "$PREFIX"
fi

# --- Build tree string before heredoc (bash 3.2: case with | inside $() inside heredoc fails) ---
TREE_LINES="  +-- .edm-state.json
  +-- explorers/
  +-- decisions.md"
if [[ "$MODE" != "prototype" ]]; then
  TREE_LINES="${TREE_LINES}
  +-- code-audit/"
fi

# --- Print scaffold summary ---
cat <<EOF
Initiative scaffold created:
  $DIR/
$TREE_LINES
Mode: $MODE
${BRANCH_MSG:+Branch: $BRANCH_MSG
}Next: run /edm:orchestrator $PREFIX to begin Phase 1.
EOF
