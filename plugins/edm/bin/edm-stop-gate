#!/usr/bin/env bash
# EDMV4-T46: the block between EDM-HELP-BEGIN and EDM-HELP-END below is sentinel-delimited, not a
# hardcoded numeric-line-range extraction -- usage() calls the shared print_help (CA-005,
# _edm-cli-lib.sh), the same convention every other bin/ helper uses.
# EDM-HELP-BEGIN
# edm-stop-gate -- Stop-hook completion gate (EDMV4-T46). Surfaces blocking-class state anomalies
# at Stop time instead of waiting for edm-state archive at the very end of an initiative.
#
# It runs `edm-state validate <PREFIX>` for every active initiative and honours only
# blocking-class anomalies, then evaluates enabled `stop`-event hookify rules exactly once per
# invocation (EDMV4-T45) -- not once per initiative, since a stop-event rule's `conditions` carry
# no per-initiative field to match against (the `stop` event currently defines none). A matched
# `block` rule translates into this gate's own blocking exit status, the same one the validate
# path already spends (EDMV4-T44's translation contract) -- see "Exit codes" below for the value.
#
# Usage:
#   edm-stop-gate            # run from a Stop hook; no arguments
#   edm-stop-gate -h|--help  # show this help
#
# Prefix resolution: this gate calls `edm-state active-initiatives` (no argument, lists every
# initiative with current_phase in 1-6) rather than guessing a prefix from the working directory
# or re-implementing the sweep. When more than one initiative is active, `edm-state validate` runs
# for EACH and the gate blocks if ANY returns a blocking-class anomaly, naming the offending
# initiative. When active-initiatives lists none, this gate exits 0 with zero bytes on stdout and
# stderr -- a repository with no active initiative has nothing to say at every Stop.
#
# Noise control: only blocking-class anomaly text reaches stderr, verbatim. Every other
# (informational) anomaly `edm-state validate` reports is replaced with one summary line per
# initiative: "[EDM] <N> informational anomalies (run: edm-state validate <PREFIX>)". Printing
# every informational anomaly individually would fire on essentially every Stop, and noise on a
# gate is how a gate gets disabled.
#
# Exit codes:
#   0  continue -- no active initiative, or every active initiative's `edm-state validate` run
#      returned no blocking-class anomaly, or the host's own Stop payload carries the literal
#      `stop_hook_active: true` (CA-003: the host sets this precisely when a Stop hook is already
#      blocking this turn, so honouring it here is what lets this gate ever release a session it
#      has blocked, instead of blocking again on the very next Stop for the same still-open
#      anomaly -- e.g. an initiative carrying a routine unclosed PARTIAL otherwise makes
#      `edm-state validate` return a blocking anomaly on every single Stop). Every internal/setup
#      condition also lands here and NEVER blocks: edm-state absent from PATH, jq missing, no
#      resolvable initiative, or `edm-state validate` itself failing/dying for a given prefix (its
#      own setup-error exit, distinct from the blocking-class exit 3 it uses on a real anomaly).
#   2  block -- at least one active initiative's `edm-state validate` run reported a blocking-class
#      anomaly (`edm-state validate` itself exits 3 for that condition; this gate never confuses
#      that with any other non-zero exit code from `validate`) AND the Stop payload's
#      `stop_hook_active` is not the literal `true` -- absent, `false`, or unreadable (missing
#      payload, unparseable JSON, or `jq` unavailable on PATH all read as "not true" and fall
#      through to this gate's ordinary enforcement rather than silently allowing; CA-003's fix must
#      not become a fifth silent bail-out on top of the four internal/setup ones above). OR an
#      enabled `stop`-event hookify rule matched with `"action": "block"` (translated from
#      `edm-hookify eval stop`'s own block status; its setup-error status never escalates here
#      either).
# All operator-facing text goes to stderr, never stdout -- a raw JSON echo to stdout is the
# documented failure mode for a Stop hook.
# EDM-HELP-END
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"

usage() {
  print_help "${BASH_SOURCE[0]:-$0}"
  exit 0
}

case "${1:-}" in
  -h|--help) usage ;;
esac

# soft_exit: every internal/setup-error path exits 0 -- this gate's own contract has no
# non-blocking failure code other than 0 (unlike bin/'s usual two-code die(), which defaults to a
# nonzero setup-error exit). Optionally names the problem on stderr; the caller decides whether a
# message is appropriate for the specific internal condition (AC3 requires total silence for the
# "no active initiatives" path specifically).
soft_exit() {
  local msg="${1:-}"
  [[ -n "$msg" ]] && echo "edm-stop-gate: $msg" >&2
  exit 0
}

# stop_gate_emit_blocking <label> <text> -- the single point this gate writes untrusted,
# interpolated text to stderr (EDMV4-T52 AC6). Both call sites below (a blocking `edm-state
# validate` anomaly line, which can name a repository path, and a matched stop-event hookify
# rule's own message text) route through here, so the sanitization has exactly one site. <label>
# is this script's own literal text and is never sanitized; <text> is the untrusted half. Every
# byte outside tab/CR/LF and the printable ASCII range 0x20-0x7E is replaced with '?' rather than
# dropped, preserving <text>'s line structure.
stop_gate_emit_blocking() {
  local label="$1" text="$2"
  echo "$label" >&2
  printf '%s\n' "$text" | LC_ALL=C tr -c '\011\012\015\040-\176' '?' >&2
}

# CA-003: read the Stop payload on stdin using the same idiom edm-bash-gate already uses, BEFORE
# any potentially-blocking work runs, and honour `stop_hook_active` if the host set it. Without
# this, a routine unclosed PARTIAL (or any other blocking-class anomaly `edm-state validate`
# reports on every Stop) wedges the session: Claude tries to stop, this gate blocks, Claude is
# forced to continue, tries to stop again, and is blocked again -- forever, with no exit but
# disabling the plugin. `stop_hook_active: true` is the host's own signal that a Stop hook is
# already blocking this turn, so exiting 0 here is what lets the loop actually terminate.
STOP_PAYLOAD=""
IFS= read -r -d '' STOP_PAYLOAD || true

STOP_HOOK_ACTIVE=""
if [[ -n "$STOP_PAYLOAD" ]] && command -v jq >/dev/null 2>&1; then
  STOP_HOOK_ACTIVE="$(printf '%s' "$STOP_PAYLOAD" | jq -r '.stop_hook_active // empty' 2>/dev/null)" || STOP_HOOK_ACTIVE=""
fi
# Missing payload, unparseable JSON, or jq unavailable all read as "not true" here and fall
# through to ordinary enforcement below -- this check must never become a new silent bail-out on
# top of the gate's existing internal/setup ones (an uncertain read is not itself grounds to
# stop enforcing a real blocking anomaly).
[[ "$STOP_HOOK_ACTIVE" == "true" ]] && exit 0

command -v edm-state >/dev/null 2>&1 || exit 0

ACTIVE_OUTPUT=""
ACTIVE_RC=0
ACTIVE_OUTPUT="$(edm-state active-initiatives 2>/dev/null)" || ACTIVE_RC=$?
[[ "$ACTIVE_RC" -eq 0 ]] || soft_exit "edm-state active-initiatives exited ${ACTIVE_RC}"

# AC1: parse the human-readable "  <PREFIX>  phase=N  last_updated=..." lines, ignoring the
# "(no active initiatives)" / "(no SRD/ directory)" sentinel lines. Bash 3.2 (C1): a plain
# `while IFS= read -r` loop, no mapfile/readarray.
ACTIVE_PREFIXES=()
while IFS= read -r _line; do
  case "$_line" in
    *"phase="*)
      _prefix="$(awk '{print $1}' <<< "$_line")"
      [[ -n "$_prefix" ]] && ACTIVE_PREFIXES+=("$_prefix")
      ;;
    *) ;;
  esac
done <<< "$ACTIVE_OUTPUT"

# AC3: zero active initiatives -- exit 0 silently, zero bytes on stdout and stderr. This also
# covers the "no resolvable initiative" internal-error case (AC9): there is nothing to validate.
[[ ${#ACTIVE_PREFIXES[@]} -eq 0 ]] && exit 0

ANY_BLOCKING=0

for _prefix in "${ACTIVE_PREFIXES[@]}"; do
  _validate_out=""
  _validate_rc=0
  _validate_out="$(edm-state validate "$_prefix" 2>&1)" || _validate_rc=$?

  # cmd_validate exits 3 (not 1) on a blocking anomaly (bin/edm-state's cmd_validate). Any other
  # non-zero exit (a setup error / `die`) is an internal error for THIS prefix -- never treated as
  # blocking (AC9) -- so this initiative is skipped and the loop continues to the next one.
  case "$_validate_rc" in
    0|3) ;;
    *) continue ;;
  esac

  _blocking_text=""
  _info_count=0
  while IFS= read -r _aline; do
    [[ -z "$_aline" ]] && continue
    case "$_aline" in
      \#*) continue ;;
    esac
    _class="${_aline%% *}"
    case "$_class" in
      blocking)
        _blocking_text="${_blocking_text}${_blocking_text:+$'\n'}${_aline}"
        ;;
      info)
        _info_count=$((_info_count + 1))
        ;;
      *) ;;
    esac
  done <<< "$_validate_out"

  if [[ -n "$_blocking_text" ]]; then
    ANY_BLOCKING=1
    stop_gate_emit_blocking "[EDM] blocking anomaly for initiative ${_prefix}:" "$_blocking_text"
  fi

  if [[ "$_info_count" -gt 0 ]]; then
    echo "[EDM] ${_info_count} informational anomalies (run: edm-state validate ${_prefix})" >&2
  fi
done

# EDMV4-T45: stop-event hookify rules, evaluated exactly ONCE per invocation (not once per active
# initiative -- the `stop` event defines no per-initiative field to vary the payload on). Only
# reached when at least one initiative was active above; a repository with none already exited 0
# silently at AC3's own check, and hookify's own overhead is skipped for the identical reason.
if command -v edm-hookify >/dev/null 2>&1; then
  _hookify_rc=0
  _hookify_out="$(printf '{}' | edm-hookify eval stop 2>&1)" || _hookify_rc=$?
  # T44 AC4/AC5: a hookify block status sets the SAME flag the blocking-class validate path above
  # already sets, so both routes share the one exit line at the bottom of this file; a hookify
  # setup-error status never escalates -- edm-hookify already warned on stderr for that case.
  if [[ "$_hookify_rc" -eq 2 ]]; then
    ANY_BLOCKING=1
    stop_gate_emit_blocking "[EDM] a stop-event hookify rule matched:" "$_hookify_out"
  fi
fi

[[ "$ANY_BLOCKING" -eq 1 ]] && exit 2
exit 0
