#!/usr/bin/env bash
# EDMV4-T43: the block between EDM-HELP-BEGIN and EDM-HELP-END below is sentinel-delimited, not a
# hardcoded numeric-line-range extraction -- usage() calls the shared print_help (CA-005,
# _edm-cli-lib.sh), the same convention every other bin/ helper uses.
# EDM-HELP-BEGIN
# edm-hookify -- evaluate the JSON hookify rule set defined in plugins/edm/CLAUDE.md's
# "Hookify rule format (canonical)" section (EDMV4-T42 built the format; this ticket, EDMV4-T43,
# builds the evaluator that consumes it). There is no existing evaluator anywhere in ECC to port
# from -- explorer 04 found only prose documentation of the condition engine, no code -- so this
# is written from nothing, deliberately in a single-classify-pass shape (one jq invocation per
# call, regardless of how many rule files are enabled) rather than one jq call per rule, matching
# the cost-model fix bin/edm-lint-artifacts already applied once (its own multi-class scan runs
# one classification pass per file, then projects N violation classes from that one table).
#
# Usage:
#   edm-hookify list                    # enumerate enabled rule names, one per line
#   edm-hookify eval <file|bash|stop>    # evaluate enabled rules for one event; reads a JSON
#                                        # payload object on stdin (fields per CLAUDE.md's
#                                        # per-event field table: file_path/new_text/old_text/
#                                        # content for `file`, command for `bash`, none for `stop`)
#   edm-hookify -h|--help                # show this help
#
# Rule discovery: .claude/edm-hookify/*.json under the project root, resolved the same way
# check_permission_rules() resolves it in bin/edm-state (CA-448 baseline): CLAUDE_PROJECT_DIR
# when it names a directory, else `git rev-parse --show-toplevel`, else `.`.
#
# Payload field truncation (AC6): each field value a rule's conditions are matched against is
# truncated to 65536 characters (64 KiB for single-byte/ASCII content, which is the overwhelming
# majority of source-code and diff text) before any operator runs. This is a documented INPUT-SIZE
# CAP, not a timeout -- `timeout(1)` is a GNU coreutils binary absent from stock macOS, this
# plugin's primary development platform, so depending on it would either add a required binary
# outside the bash/jq/git set this plugin pins, or silently do nothing on the platform where a
# runaway regex_match against a multi-megabyte payload is most likely. Bounding the INPUT bounds
# the cost of Oniguruma's regex_match (jq's test()) regardless of how large a single edit's
# new_text/content/command field is.
#
# Output format (`eval`, one line per matched rule): "<rule_id> <action> <message>" -- single-space
# separated, message last so it may itself contain spaces.
#
# Internal record encoding (CA-029). The jq pass below hands its results back to bash as a
# tab-delimited, newline-separated record stream, tagged `E`/`L`/`M` in column 1. Every value
# interpolated into a record -- the rule file's own PATH, and the rule's `name`, `action`,
# `message` and error reason -- is passed through `scrub` INSIDE the jq program first, which
# replaces every C0 control character and DEL (code points < 32, plus 127) with a space. That
# makes it structurally impossible for any of those values to carry a tab or a newline into the
# record stream, which is what the bash-side parser splits on. This is deliberately fixed at the
# ENCODING layer rather than by filtering filenames: `find -name '*.json'` legitimately matches a
# POSIX-legal filename containing a newline, and before this fix such a file forged an `M` record
# with `action` = `block` -- exit 2 -- without its content ever being valid JSON, ever setting
# `enabled: true`, or ever setting `"action": "block"`. The same forge worked from a rule `name`.
# That defeated the format's load-bearing invariant (CLAUDE.md: "a rules layer that could block by
# default would hand every contributor the ability to wedge every other contributor's edits with
# one committed file"). Note `scrub` is about RECORD INTEGRITY only; `hookify_scrub` below is the
# separate, complementary ASCII filter applied on the way OUT to a consumer.
#
# Exit codes -- exactly three, EDMV4-T44's two-tier exit contract (the same violation-versus-
# setup-error split edm-lint-staged-artifacts already applies to `git commit`; see this plugin's
# CLAUDE.md "Hooks behavior" section for the cross-reference by name):
#   0  clean -- no enabled rule matched, or only `warn` rules matched (or, for `list`, the rule
#      set was enumerated), including the case where zero rule files exist at all (an absent
#      .claude/edm-hookify/ directory).
#   1  setup error -- malformed rule file (invalid JSON, a non-object top-level value, missing
#      required key, wrongly-typed `conditions`, unknown operator, out-of-event field, or a
#      pattern the regex engine refuses), a missing or unparseable `eval` payload on stdin, or a
#      required binary (jq) not found on PATH. A malformed rule file never blocks and never
#      disables the rest of the rule set: its path and reason are named on stderr, that file
#      alone is skipped, and every other valid, enabled rule for the requested event is still
#      evaluated in the same run. CA-030: the jq program's per-rule `try/catch` wraps the WHOLE
#      per-rule projection -- validation and condition matching included -- not just `fromjson`.
#      Before that, a top-level JSON array (the natural "all my rules in one file" mistake), a
#      top-level string, a `"conditions": "foo"` typo, or an invalid Oniguruma pattern such as
#      `[` aborted the single jq invocation outright, which exited 1 for the whole directory and
#      silently evaluated ZERO rules -- the exact "one contributor's typo cannot take down every
#      other contributor's rules" contract this paragraph states.
#      CA-031: an `eval` payload that is empty, or that does not parse as a single JSON OBJECT,
#      is itself a setup error rather than degrading to `{}`. Degrading made every field read as
#      the empty string, which made every `not_contains` condition match vacuously (a `block`
#      rule could fire on a parse failure) while every `contains` condition silently stopped
#      matching (a `block` rule stopped enforcing, with a clean exit 0). A field genuinely ABSENT
#      from a well-formed payload is separately treated as non-matching for BOTH polarities, so
#      absence never satisfies a `not_contains` condition either.
#   2  block -- at least one enabled rule matched carrying the literal `"action": "block"` (the
#      format defaults an absent `action` key to `warn`, EDMV4-T42 AC2 -- a rule blocks only by
#      explicit opt-in, never by default). Precedence: a block match always wins the exit code
#      over a concurrent, unrelated setup error in a DIFFERENT rule file -- one contributor's
#      typo in one rule file must never mask another rule's legitimate block -- and a block match
#      is reported alongside every concurrent warn match rather than suppressing it (a block never
#      hides a warning that fired in the same run).
# There is no fourth code. A `warn` match's `<rule_id> warn <message>` line is written to STDERR
# and never raises the exit code above 0 on its own. A `block` match's `<rule_id> block <message>`
# line stays on STDOUT -- the stream EDMV4-T43 already used for every matched-rule line -- since
# it is the payload a consumer reads to build its own refusal message: `edm-gateguard` translates
# this exit 2 into a refusal through its own `emit_decision deny` function (AD2); `edm-stop-gate`
# translates it into its own exit 2. Wiring either consumer to actually call this evaluator on its
# gated path (and stop-event path) is `EDMV4-T45`'s, not built here.
# EDM-HELP-END
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"

die() {
  local msg="$1" code="${2:-1}"
  echo "edm-hookify: $msg" >&2
  exit "$code"
}

usage() {
  print_help "${BASH_SOURCE[0]:-$0}"
  exit 0
}

case "${1:-}" in
  -h|--help) usage ;;
esac

SUBCOMMAND="${1:-}"
[[ -n "$SUBCOMMAND" ]] || die "usage: edm-hookify list | eval <file|bash|stop>"

EVENT=""
case "$SUBCOMMAND" in
  list) ;;
  eval)
    EVENT="${2:-}"
    case "$EVENT" in
      file|bash|stop) ;;
      *) die "usage: edm-hookify eval <file|bash|stop>" ;;
    esac
    ;;
  *)
    die "unknown subcommand: ${SUBCOMMAND} (expected list or eval)"
    ;;
esac

# ---- Resolve project root and rule directory (CA-448 baseline; CLAUDE.md "Rule directory and
# discovery"): CLAUDE_PROJECT_DIR when it names a directory, else git toplevel, else `.`. -------
resolve_project_root() {
  if [[ -n "${CLAUDE_PROJECT_DIR:-}" && -d "${CLAUDE_PROJECT_DIR}" ]]; then
    printf '%s\n' "$CLAUDE_PROJECT_DIR"
    return 0
  fi
  local gt
  gt="$(git rev-parse --show-toplevel 2>/dev/null)" || gt=""
  if [[ -n "$gt" ]]; then
    printf '%s\n' "$gt"
    return 0
  fi
  printf '%s\n' "."
}

PROJECT_ROOT="$(resolve_project_root)"
RULE_DIR="${PROJECT_ROOT}/.claude/edm-hookify"

# ---- Collect rule files. Bash 3.2 (C1): no mapfile/readarray -- a NUL-delimited find loop,
# matching _collect_md_files_into's idiom in edm-lint-artifacts. --------------------------------
RULE_FILES=()
if [[ -d "$RULE_DIR" ]]; then
  while IFS= read -r -d "" _hf; do
    RULE_FILES+=("$_hf")
  done < <(find "$RULE_DIR" -maxdepth 1 -type f -name '*.json' -print0 2>/dev/null)
fi

# AC10: zero rule files -- including the common case of an absent .claude/edm-hookify/ directory
# entirely -- exits 0 immediately, before jq's presence is even checked. Nothing to evaluate means
# nothing needs jq, so a machine missing jq is not penalized for a repository with no rules yet.
if [[ ${#RULE_FILES[@]} -eq 0 ]]; then
  exit 0
fi

command -v jq >/dev/null 2>&1 || die "required binary not found on PATH: jq"

# `eval` reads its JSON payload from the real invocation's stdin (AC1). Drain it into a bash
# variable BEFORE jq's own stdin is repurposed below for the rule-content stream -- the
# one-classify-pass design (AC2/AC3) needs jq's stdin free to carry the NUL-joined rule bytes, so
# the payload travels in as a --arg instead.
#
# CA-031: "no payload" and "a payload whose fields are empty" are different facts and must not
# collapse into the same one. An absent or unparseable payload is a SETUP ERROR (exit 1, never
# blocking) rather than a silent degradation to `{}`. Both shipped consumers already send a
# well-formed object -- `edm-gateguard` and `edm-bash-gate` build theirs with `jq -c`, and
# `edm-stop-gate` sends the literal `{}` -- so this refusal is reachable only through the
# documented user-facing CLI or through a consumer whose own payload construction failed, which
# is precisely the case that must not be mistaken for "nothing violated any rule".
PAYLOAD_RAW=""
if [[ "$SUBCOMMAND" == "eval" ]]; then
  PAYLOAD_RAW="$(cat)"
  if [[ -z "$PAYLOAD_RAW" ]]; then
    die "eval ${EVENT}: no payload on stdin (expected one JSON object; send '{}' for a payload with no fields)"
  fi
  printf '%s' "$PAYLOAD_RAW" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || die "eval ${EVENT}: payload on stdin is not a single JSON object"
fi

# 65536 chars (64 KiB for single-byte/ASCII content -- see the EDM-HELP block above for the
# rationale and its documented approximation for multi-byte UTF-8 text).
HOOKIFY_MAX_FIELD_CHARS=65536

# ---- One classify pass (AC2/AC3): every rule file's raw bytes, NUL-joined, stream into exactly
# ONE jq invocation regardless of how many files there are. A malformed file (invalid JSON, a
# missing required key, an unknown operator, an out-of-event field) is caught INSIDE this single
# jq program via try/catch per rule, not by a separate jq call per file -- a per-file jq call is
# precisely the multiplying cost this design exists to avoid. No temp files are used anywhere
# (AC9): the rule bytes travel over a pipe, never through disk. -------------------------------
build_rule_stream() {
  local f
  for f in "${RULE_FILES[@]}"; do
    cat "$f"
    printf '\0'
  done
}

# shellcheck disable=SC2016 # the single-quoted jq program below intentionally holds literal $vars
JQ_PROGRAM='
def allowed_keys: ["name","enabled","event","action","conditions","message"];
def allowed_events: ["file","stop","bash"];
def allowed_ops: ["regex_match","contains","equals","not_contains","starts_with","ends_with"];
def fields_for_event($e):
  if $e == "file" then ["file_path","new_text","old_text","content"]
  elif $e == "bash" then ["command"]
  else [] end;
def cap($s): if ($s|type) == "string" then $s[0:$maxchars] else $s end;
# scrub -- CA-029 record-encoding guard. Every C0 control character and DEL becomes a space, so
# no interpolated value can carry a delimiter of the record stream (tab, newline, CR) and forge
# a second record. Written with explode/implode rather than a regex character class deliberately:
# it depends on no Oniguruma bracket-expression support and cannot itself be a source of the
# "pattern the engine refuses" failure this same commit teaches the program to survive.
def scrub($s): [ ($s|tostring) | explode[] | if . < 32 or . == 127 then 32 else . end ] | implode;
def validate($r):
  if ($r|type) != "object" then
    {ok:false, error:("rule must be a JSON object, got " + ($r|type))}
  else
  ($r|keys) as $ks
  | ($ks - allowed_keys) as $unknown
  | if ($unknown|length) > 0 then {ok:false, error:("unknown top-level key: " + ($unknown[0]|tostring))}
    elif (([$r|has("name"),has("enabled"),has("event"),has("conditions"),has("message")]) | all) | not
      then {ok:false, error:"missing required key"}
    elif (allowed_events | index($r.event)) == null
      then {ok:false, error:("unknown event: " + ($r.event|tostring))}
    elif ($r.conditions|type) != "array"
      then {ok:false, error:("conditions must be an array, got " + ($r.conditions|type))}
    elif ([$r.conditions[] | select(type != "object")] | length) > 0
      then {ok:false, error:"every entry in conditions must be a JSON object"}
    elif ([$r.conditions[] | select((.field|type) != "string" or (.operator|type) != "string" or (.pattern|type) != "string")] | length) > 0
      then {ok:false, error:"every condition needs string field, operator and pattern"}
    else
      (fields_for_event($r.event)) as $ff
      | ([$r.conditions[]? | select(.operator as $op | (allowed_ops|index($op)) == null)]) as $bad_ops
      | if ($bad_ops|length) > 0 then
          {ok:false, error:("unknown operator: " + $bad_ops[0].operator)}
        else
          ([$r.conditions[]? | select(.field as $fld | ($ff|index($fld)) == null)]) as $bad_fields
          | if ($bad_fields|length) > 0 then
              {ok:false, error:("field \"" + $bad_fields[0].field + "\" does not belong to event " + $r.event)}
            else {ok:true}
            end
        end
    end
  end;
def op_match($op; $val; $pattern):
  if $op == "contains" then ($val|contains($pattern))
  elif $op == "not_contains" then (($val|contains($pattern))|not)
  elif $op == "equals" then ($val == $pattern)
  elif $op == "starts_with" then ($val|startswith($pattern))
  elif $op == "ends_with" then ($val|endswith($pattern))
  elif $op == "regex_match" then ($val|test($pattern))
  else false end;
def conds_match($r; $payload):
  (($r.conditions // [])) as $cs
  | ($cs|length) == 0 or
    (all($cs[]; . as $c
      | ($payload[$c.field]) as $rawval
      | if $rawval == null then
          # CA-031: a field genuinely absent from a well-formed payload is NOT the empty string.
          # Absence is non-matching for BOTH polarities -- a rule meant to fire on the absence of
          # a substring must not fire merely because the field it names was never supplied.
          false
        else
          ($rawval | tostring | cap(.)) as $val
          | op_match($c.operator; $val; $c.pattern)
        end));
# project_rule -- one rule file to at most one record. CA-030: every step below (validate and
# conds_match included, not only fromjson) runs inside the caller try/catch, so a jq runtime error
# raised by ONE rule file yields an E record for THAT file and leaves every other rule evaluated.
def project_rule($path; $raw; $payload):
  (try ($raw|fromjson) catch null) as $parsed
  | if $parsed == null then
      "E\t" + scrub($path) + "\tinvalid JSON"
    else
      (validate($parsed)) as $v
      | if ($v.ok|not) then
          "E\t" + scrub($path) + "\t" + scrub($v.error)
        elif ($parsed.enabled != true) then
          empty
        elif ($mode == "list") then
          "L\t" + scrub($parsed.name // $path)
        elif ($parsed.event != $event) then
          empty
        elif (conds_match($parsed; $payload)) then
          "M\t" + scrub($parsed.name // "unnamed") + "\t" + scrub($parsed.action // "warn") + "\t" + scrub($parsed.message // "")
        else
          empty
        end
    end;
(split("\u0000")) as $raw_all
| $raw_all[0:-1] as $raws
| ($ARGS.positional) as $ps
| ($payload_raw | try fromjson catch {}) as $payload
| range(0; ($ps|length)) as $i
| ($ps[$i]) as $path
| ($raws[$i]) as $raw
| (try project_rule($path; $raw; $payload)
   catch ("E\t" + scrub($path) + "\trule evaluation error: " + scrub(.)))
'

RESULT="$(build_rule_stream | jq -R -s -r \
  --argjson maxchars "$HOOKIFY_MAX_FIELD_CHARS" \
  --arg payload_raw "$PAYLOAD_RAW" \
  --arg event "$EVENT" \
  --arg mode "$SUBCOMMAND" \
  "$JQ_PROGRAM" \
  --args "${RULE_FILES[@]}")" || die "jq evaluation failed"

# hookify_scrub <text> -- the ONE ASCII filter this script owns (CA-056). Every byte outside
# tab/CR/LF and the printable ASCII range 0x20-0x7E is replaced with '?'. Extracted from
# hookify_emit_match so the three emission arms below share one filter rather than one arm
# carrying a filter and the other two carrying none: before this, EDMV4-T52 AC6's stated
# single-emit-point premise was false as written -- the `L)` list arm printed the rule's own
# `name` raw (a non-ASCII byte in a rule name reached stdout unmodified, reproduced live by
# wave-5 QC), and the setup-error arm interpolated raw rule-file JSON values into stderr, so an
# ESC in an unknown top-level key survived far enough to rewrite an operator terminal title.
hookify_scrub() {
  printf '%s' "$1" | LC_ALL=C tr -c '\011\012\015\040-\176' '?'
}

# hookify_emit_match <rule_id> <action> <message> -- the single point this evaluator prints a
# matched-rule line (EDMV4-T52 AC6). All three fields are rule-author-supplied content read
# straight from a project's own .claude/edm-hookify/*.json files (`name`, `action`, `message`),
# which this plugin's automatic ASCII enforcement does not reach (see CLAUDE.md's "Artifact
# content conventions" -- the hookify-file gap this same ticket documents), so a non-ASCII byte
# in any of the three can reach here unfiltered. Every byte outside tab/CR/LF and the printable
# ASCII range 0x20-0x7E is replaced with '?' before the line is written, on either stream --
# stdout for a block (the payload a consumer like edm-gateguard's emit_decision folds into its
# own JSON emission) or stderr for a warn -- so neither downstream consumer ever has to sanitize
# a second time.
hookify_emit_match() {
  local rule_id="$1" action="$2" message="$3" stream="$4"
  local clean_id clean_action clean_message
  clean_id="$(hookify_scrub "$rule_id")"
  clean_action="$(hookify_scrub "$action")"
  clean_message="$(hookify_scrub "$message")"
  if [[ "$stream" == "stdout" ]]; then
    echo "${clean_id} ${clean_action} ${clean_message}"
  else
    echo "${clean_id} ${clean_action} ${clean_message}" >&2
  fi
}

HAD_ERROR=0
HAD_BLOCK=0
while IFS= read -r _line; do
  [[ -z "$_line" ]] && continue
  _tag="${_line%%$'\t'*}"
  _rest="${_line#*$'\t'}"
  case "$_tag" in
    E)
      # CA-056: both halves are rule-file-derived (the discovered path, and a reason string that
      # can quote a rule-authored key or event value), so both go through hookify_scrub. printf,
      # never echo -- a reason or path of exactly "-n" or "-e" is consumed as an option by some
      # echo implementations.
      _epath="${_rest%%$'\t'*}"
      _ereason="${_rest#*$'\t'}"
      printf '%s\n' "edm-hookify: setup error: $(hookify_scrub "$_epath"): $(hookify_scrub "$_ereason")" >&2
      HAD_ERROR=1
      ;;
    L)
      # CA-056: the listed name is `$parsed.name // $path` -- rule-author content either way.
      printf '%s\n' "$(hookify_scrub "$_rest")"
      ;;
    M)
      _mname="${_rest%%$'\t'*}"
      _mrest="${_rest#*$'\t'}"
      _maction="${_mrest%%$'\t'*}"
      _mmessage="${_mrest#*$'\t'}"
      # EDMV4-T44 two-tier exit contract: a rule blocks ONLY on the literal action "block" (the
      # format's own default-to-warn rule, EDMV4-T42 AC2) -- anything else (an absent action, or
      # any other value) is treated as warn, fail-safe toward non-blocking. A warn match is
      # diagnostic text: it goes to STDERR and never raises the exit code above 0 on its own
      # (AC3). A block match's line stays on STDOUT -- the same stream EDMV4-T43 already used for
      # every matched-rule line -- since it is the payload a future consumer (edm-gateguard's
      # emit_decision deny, per AD2; edm-stop-gate's own exit 2) reads to build its refusal
      # message. A block match and a setup error are independent per-rule-file signals from the
      # same one-classify-pass run; AC6's "a block never suppresses a concurrent warning" extends
      # the same way to a concurrent, unrelated setup error in a DIFFERENT rule file -- one
      # contributor's typo must never mask another rule's legitimate block.
      if [[ "$_maction" == "block" ]]; then
        hookify_emit_match "$_mname" "$_maction" "$_mmessage" stdout
        HAD_BLOCK=1
      else
        hookify_emit_match "$_mname" "$_maction" "$_mmessage" stderr
      fi
      ;;
  esac
done <<< "$RESULT"

# Exactly three exit codes -- precedence block > error > clean (see the M-tag comment above for
# why a block outranks a concurrent, unrelated setup error). There is no fourth code.
[[ "$HAD_BLOCK" -eq 1 ]] && exit 2
[[ "$HAD_ERROR" -eq 1 ]] && exit 1
exit 0
