#!/usr/bin/env bash
# EDM-HELP-BEGIN
# edm-validate-prefix -- verify a proposed prefix is valid and unique within SRD/.
# Usage:
#   edm-validate-prefix <PREFIX>
#   edm-validate-prefix -h|--help|help
# Exit codes:
#   0 = valid and unique (safe to use)
#   1 = invalid format
#   2 = collision (already exists anywhere in SRD/ across all products)
# Notes:
#   - Honors EDM_SRD_ROOT / CLAUDE_PLUGIN_OPTION_SRD_ROOT for the scan root.
#   - Product-scoped collisions are checked as SRD/{PRODUCT}/{PREFIX}__*/
# EDM-HELP-END
set -euo pipefail

SRD_ROOT="${EDM_SRD_ROOT:-${CLAUDE_PLUGIN_OPTION_SRD_ROOT:-./SRD}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"
PREFIX="${1:-}"

# CA-074: takes the message and exit code as two separate arguments so the code is never
# echoed as part of the diagnostic text (the previous `echo "...: $*"` form printed the numeric
# exit-code argument as the last word of every message, since `$*` swept it up along with the
# message). Family contract: 1 = invalid format, 2 = collision.
die() {
  local msg="$1" code="${2:-1}"
  echo "edm-validate-prefix: $msg" >&2
  exit "$code"
}

case "${PREFIX}" in
  -h|--help|help)
    print_help "${BASH_SOURCE[0]:-$0}"
    exit 0
    ;;
esac

[[ -n "$PREFIX" ]] || die "usage: edm-validate-prefix <PREFIX>" 1

# Format validation: 3-6 uppercase alphanumeric chars starting with a letter.
if [[ ! "$PREFIX" =~ ^[A-Z][A-Z0-9]{2,5}$ ]]; then
  die "invalid format: prefix must be 3-6 uppercase alphanumeric chars, starting with a letter (got '$PREFIX')" 1
fi

# Global collision scan -- PREFIX must be unique across ALL of SRD/:
#   1. Legacy flat layout: SRD/{PREFIX}/
#   2. Product-scoped layout: SRD/{PRODUCT}/{PREFIX}__*/
# Both must be absent for the prefix to be considered unique (EDMV2-87).

# _scan_product_dirs_for_prefix <root> <prefix> -- print each {root}/*/{prefix}__* directory,
# one per line. CA-344(4): the live and archived halves below used to carry two hand-copies of
# this walk with silently diverged guards (only the live copy had the root -d guard and the
# .archived basename skip); one walker now serves both, and each caller decides die vs warn.
# The .archived skip only matters for the live root, and is a harmless no-match under .archived
# itself (archived trees have no nested .archived).
_scan_product_dirs_for_prefix() {
  local root="$1" prefix="$2" product_dir candidate
  [[ -d "$root" ]] || return 0
  for product_dir in "$root"/*/; do
    product_dir="${product_dir%/}"
    [[ "$(basename "$product_dir")" == ".archived" ]] && continue
    [[ -d "$product_dir" ]] || continue
    for candidate in "${product_dir}/${prefix}__"*/; do
      candidate="${candidate%/}"
      [[ -d "$candidate" ]] && printf '%s\n' "$candidate"
    done
  done
  return 0
}

# AC2: Check legacy flat path.
if [[ -d "${SRD_ROOT}/${PREFIX}" ]]; then
  die "collision: ${SRD_ROOT}/${PREFIX} already exists" 2
fi

# AC1: Check product-scoped directories in any product subdirectory -- die on the first hit.
while IFS= read -r candidate; do
  [[ -n "$candidate" ]] || continue
  die "collision: ${candidate} already exists (prefix ${PREFIX} is already in use under product $(basename "$(dirname "$candidate")"))" 2
done < <(_scan_product_dirs_for_prefix "$SRD_ROOT" "$PREFIX")

# AC5: Also check archived initiatives -- non-fatal warning only.
# Check flat archived path.
if [[ -d "${SRD_ROOT}/.archived/${PREFIX}" ]]; then
  echo "edm-validate-prefix: NOTE: $PREFIX exists in ${SRD_ROOT}/.archived/ (previously used and archived)" >&2
fi
# Check product-scoped archived paths -- same walker, warn instead of die.
while IFS= read -r candidate; do
  [[ -n "$candidate" ]] || continue
  echo "edm-validate-prefix: NOTE: $PREFIX was previously used in $(basename "$(dirname "$candidate")") (archived at $candidate)" >&2
done < <(_scan_product_dirs_for_prefix "${SRD_ROOT}/.archived" "$PREFIX")

echo "ok: $PREFIX is valid and not in use"
exit 0
