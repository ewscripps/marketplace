#!/usr/bin/env bash
# EDMV4-T38 AC2: the block between EDM-HELP-BEGIN and EDM-HELP-END below is sentinel-delimited,
# not a hardcoded numeric-line-range extraction -- `usage()` calls the shared `print_help`
# (CA-005, `_edm-cli-lib.sh`) which extracts between the sentinels with awk, exactly the form
# `edm-lint-artifacts` and `edm-compare-eval` already use. (Deliberately not spelling out the
# hardcoded form's literal syntax here -- EDMV4-T38 AC2's smoke test greps this file for it and
# must fail only on real usage, never on this sentence describing the rule.)
# EDM-HELP-BEGIN
# edm-repo-readiness -- score a repository's readiness for EDM-driven work (EDMV4-T38/T39/T40).
#
# EDM measures *itself* via `/edm:metrics` -- time and cost per phase -- but never scored the
# *repository it is about to work in*. This is that scorecard: a six-category, 0-10-normalized
# rubric (Methodology setup, State health, Test stack, Coverage posture, Convergence history,
# Artifact hygiene) under a versioned rubric string (READINESS_RUBRIC_VERSION). Three categories
# are conditional (Test stack on a detected test framework; Coverage posture on Test stack being
# applicable; Convergence history on at least one archived initiative existing) and are excluded
# from the overall mean, not scored as zero, when inapplicable.
#
# Three states, never two (CA-036/CA-037/CA-038). "Not applicable" and "could not be measured" are
# different things and are reported differently:
#   applicable, measured  -- scored normally and included in the overall mean.
#   not applicable        -- rendered "N/A (not applicable)", excluded from the mean.
#   UNMEASURED            -- the underlying probe (edm-state validate / get-coverage /
#                            metrics-report, or edm-lint-artifacts) did not return a readable
#                            result. The affected checks score zero, the category is rendered
#                            "UNMEASURED" with the reason on stdout AND on stderr, and it is
#                            deliberately KEPT in the overall-score denominator even if its own
#                            conditional predicate says otherwise. A probe that fails must never
#                            raise the score by quietly removing itself from the mean, and a
#                            reader of the score must be able to tell a measured zero from an
#                            unmeasurable one without re-deriving anything.
#
# Every category aggregates signals EDM already computes
# (edm-state validate/get-coverage/metrics-report, edm-lint-artifacts)
# rather than re-detecting them -- this script never scans .claude/settings*.json, test-framework
# config files, or .edm-state.json directly for anything an edm-state subcommand already exposes.
#
# Feeding this score into the 4.3 size classifier and into planning.md is EDMV4-T41's job, not
# this script's own.
#
# Usage:
#   edm-repo-readiness [<PREFIX>] [--json <path>]
#   edm-repo-readiness -h|--help
#
#   <PREFIX>        optional; scopes the per-initiative categories (State health, Test stack,
#                   Coverage posture, and Artifact hygiene's lint scan) to one initiative.
#                   Repository-wide categories (Methodology setup's git/SRD checks, Convergence
#                   history) are unaffected by <PREFIX> -- they describe the repository as a
#                   whole regardless of which initiative was named. An unresolvable <PREFIX> is
#                   a usage error (exit 2).
#   --json <path>   write the machine-readable score report as JSON to <path>. Human-readable
#                   text always goes to stdout; there is no --json-to-stdout form.
#
# Exit codes:
#   0  the repository was scored, regardless of how low the score is.
#   2  usage or setup error (unknown flag, --json with no path, an extra positional argument,
#      an unresolvable <PREFIX>, or a required binary -- jq -- not found on PATH).
# EDM-HELP-END
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"

# EDMV4-T38 AC5: local two-argument die() -- matches the same helper in edm-compare-eval and in
# evals/run-eval.sh (cited by name, not by line: CA-060 widened the file-and-line citation ban to
# cover every script under bin/ and evals/, this one included)
# exactly (msg, code="${2:-2}"). Family-standard default of 2 (usage/setup error).
die() {
  local msg="$1" code="${2:-2}"
  echo "edm-repo-readiness: $msg" >&2
  exit "$code"
}

usage() {
  print_help "${BASH_SOURCE[0]:-$0}"
  exit 0
}

case "${1:-}" in
  -h|--help) usage ;;
esac

command -v jq >/dev/null 2>&1 || die "required binary not found on PATH: jq"

SRD_ROOT="${EDM_SRD_ROOT:-${CLAUDE_PLUGIN_OPTION_SRD_ROOT:-./SRD}}"

# ---- Argument parsing: [<PREFIX>] [--json <path>] --------------------------------------------
PREFIX=""
JSON_OUT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --json)
      [[ $# -ge 2 ]] || die "--json requires a <path> argument"
      [[ -n "$2" ]] || die "--json requires a non-empty <path> argument"
      JSON_OUT="$2"
      shift 2
      ;;
    -*)
      die "unknown flag: $1"
      ;;
    *)
      [[ -z "$PREFIX" ]] || die "unexpected extra argument: $1"
      PREFIX="$1"
      shift
      ;;
  esac
done

# ---- Sibling bin/ scripts, resolved next to THIS script rather than via PATH (EDMV4-T40) -----
# edm-lint-artifacts already resolves edm-state via a bare `command -v edm-state` PATH lookup for
# its own --all mode (an existing bin/ convention). This script deliberately does NOT follow that
# convention for its own edm-state/edm-lint-artifacts calls: a bin/ script under active
# development can sit lower on PATH than an already-installed copy of the same plugin (a stale
# cached edm-state resolving ahead of this worktree's own), which would silently score a
# repository against the wrong version's behavior. Resolving both siblings via SCRIPT_DIR instead
# guarantees this script always calls the edm-state/edm-lint-artifacts shipped beside it.
EDM_STATE_BIN="${SCRIPT_DIR}/edm-state"
EDM_LINT_BIN="${SCRIPT_DIR}/edm-lint-artifacts"
[[ -x "$EDM_STATE_BIN" ]] || die "required sibling script missing or not executable: $EDM_STATE_BIN"
[[ -x "$EDM_LINT_BIN" ]] || die "required sibling script missing or not executable: $EDM_LINT_BIN"

if [[ -n "$PREFIX" ]]; then
  "$EDM_STATE_BIN" get "$PREFIX" >/dev/null 2>&1 || die "prefix not found or unresolvable: $PREFIX"
fi

# EDMV4-T39 AC6: bare top-level version constant, following evals/score-artifacts.sh's
# SCORER_VERSION precedent exactly. No new versioning scheme is invented.
#
# EDMV4-T39 AC7, second conjunct -- the REFUSAL CONTRACT for any future comparator.
# AC7 requires two things, and only the first was implemented: the version reaches the JSON output
# (see `readiness_rubric_version` in REPORT_JSON below), AND this script documents what a future
# comparator must do when it does not match. This block is that second half.
#
# The contract, stated once, for whatever later tool compares two readiness reports (a
# trend line, a regression gate, a before/after in an initiative's own artifacts):
#
#   A comparator that finds `readiness_rubric_version` differing between the two reports it was
#   handed MUST REFUSE the comparison and exit non-zero, naming both versions.
#   It MUST NOT silently compare them, MUST NOT coerce one version to the other, and MUST NOT
#   fall back to comparing only the categories the two happen to share. A version bump means the
#   checks, their point values, or the category set changed, so the two scores are not the same
#   measurement --
#   a delta across a version boundary is a number with no meaning, and reporting one anyway is
#   strictly worse than reporting nothing, because a reader cannot tell it apart from a real
#   regression. A missing `readiness_rubric_version` field is a mismatch too: it is unset, not
#   assumed-current.
#
#   `bin/edm-compare-eval` is the in-repo precedent this contract is modelled on and the shape to
#   copy: it REFUSES on a `scorer_version` mismatch and on a `dimensions_scored` mismatch rather
#   than comparing, printing "REFUSED -- <field> mismatch (baseline X, candidate Y)" on stderr and
#   exiting 2. A readiness comparator should print and exit the same way. No such comparator
#   exists yet; this contract exists so the first one is written correctly instead of discovering
#   the requirement after it has already published a meaningless delta.
READINESS_RUBRIC_VERSION="1.0.0"

# EDMV4-T40 AC5: coverage targets are read from configuration, never hardcoded -- the same
# EDM_<NAME> / CLAUDE_PLUGIN_OPTION_<NAME> / default fallback chain bin/edm-state's own
# SRD_ROOT/SRD_FILENAME/HUMAN_HOURLY_RATE_USD already use.
COVERAGE_TARGET_UNIT_PCT="${EDM_COVERAGE_TARGET_UNIT_PCT:-${CLAUDE_PLUGIN_OPTION_COVERAGE_TARGET_UNIT_PCT:-80}}"
COVERAGE_TARGET_COMPONENT_PCT="${EDM_COVERAGE_TARGET_COMPONENT_PCT:-${CLAUDE_PLUGIN_OPTION_COVERAGE_TARGET_COMPONENT_PCT:-70}}"
COVERAGE_TARGET_INTEGRATION_PCT="${EDM_COVERAGE_TARGET_INTEGRATION_PCT:-${CLAUDE_PLUGIN_OPTION_COVERAGE_TARGET_INTEGRATION_PCT:-60}}"

# ---- Shared helpers -----------------------------------------------------------------------------

# _rr_active_prefixes: one active (non-archived) initiative PREFIX per line. Scoped to a single
# <PREFIX> when one was given on the command line; otherwise every active initiative `edm-state
# list` itself already resolves, across both the flat and product-scoped layouts (EDMV4-T40
# AC2/AC7: layout resolution has exactly one owner, edm-state, never re-derived here).
_rr_active_prefixes() {
  if [[ -n "$PREFIX" ]]; then
    printf '%s\n' "$PREFIX"
    return 0
  fi
  "$EDM_STATE_BIN" list 2>/dev/null | awk '/phase=/{print $1}'
}

# _rr_validate_output <prefix>: prints `edm-state validate <prefix>`'s full output and RETURNS its
# exit status. MUST be invoked exactly this way -- as a process, with its exit captured explicitly
# -- never sourced. `validate` exits 3 on a BLOCKING anomaly (not on any informational one), and
# this script runs under `set -euo pipefail`; an unguarded call would abort the whole scorecard the
# first time it scored a repository with even one routine, informational anomaly (EDMV4-T40
# Technical Notes).
#
# CA-036: the captured status used to be discarded, so a `validate` that DIED (an unresolvable
# prefix, an unparseable state file -- anything outside the documented 0/3 contract) printed
# nothing, matched no anomaly, and scored State health a perfect 10. `edm-stop-gate` switches on
# the same 0/3/other contract, so the two consumers of one contract disagreed. The status is now
# propagated to the caller, which classifies it: 0 and 3 are meaningful results, anything else is
# a setup error that makes every validate-derived check UNMEASURED (see the collection pass below).
_rr_validate_output() {
  local prefix="$1" out rc=0
  out="$("$EDM_STATE_BIN" validate "$prefix" 2>/dev/null)" || rc=$?
  printf '%s\n' "$out"
  return "$rc"
}

# _rr_any_prefix_validate_has <anomaly-type>: prints "true" if ANY prefix whose `validate` was
# READABLE has an anomaly line naming <anomaly-type> (matched as a whole token so e.g.
# "OPEN_PARTIALS" never matches "OPEN_AUDIT_ROUND"); "false" otherwise. Reads the single
# collection pass below rather than re-invoking `validate` once per check (eight re-invocations
# per prefix before CA-036, each of which independently threw its exit status away).
#
# Vacuously "false" when there are no active prefixes -- there is nothing recorded to be unhealthy
# about (State health is an UNCONDITIONAL category per EDMV4-T39 AC1: "nothing recorded" is itself
# a real, clean health signal, not a missing one). It is NOT vacuously "false" when a validate
# failed: that case is caught by RR_VALIDATE_UNMEASURED_REASON, which makes the checks UNMEASURED
# instead of clean.
_rr_any_prefix_validate_has() {
  local needle="$1"
  if printf '%s\n' "$_RR_VALIDATE_LINES" | grep -qE "^(blocking|info)[[:space:]]+${needle}([[:space:]]|\$)"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

# _rr_any_other_blocking_anomaly: "true" if any active prefix reports a BLOCKING anomaly whose
# type is neither OPEN_PARTIALS nor CONVERGED_NO_APPROVAL (each already its own named check
# below) -- catching TIME_ORDER, ZERO_TOKENS, or any future blocking type without hardcoding an
# exhaustive list that would drift the moment state_anomalies() grows a new one.
_rr_any_other_blocking_anomaly() {
  local line class type
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    class="$(printf '%s' "$line" | awk '{print $1}')"
    [[ "$class" == "blocking" ]] || continue
    type="$(printf '%s' "$line" | awk '{print $2}')"
    case "$type" in
      OPEN_PARTIALS|CONVERGED_NO_APPROVAL) continue ;;
      *) printf 'true\n'; return 0 ;;
    esac
  done <<< "$_RR_VALIDATE_LINES"
  printf 'false\n'
}

# ---- Signal collection: ONE pass over all active prefixes, invoking each edm-state probe exactly
# once per prefix and reading its exit status (CA-036/CA-037). Two probes run here:
#   * `edm-state validate`  -- State health, plus Methodology setup's PERM_RULES_MISSING check.
#   * `edm-state get-coverage` -- Test stack / Coverage posture (EDMV4-T40 AC4/AC5: sourced from
#     test_frameworks_detected/get-coverage, never a framework-config-file scan of our own).
# A probe that fails for ANY prefix makes every check derived from it UNMEASURED, conservatively:
# a partial scan is not a clean one, and the categories stay in the denominator.
_RR_VALIDATE_LINES=""
_RR_VALIDATE_FAILURES=""      # "PREFIX (exit N)" entries, comma-joined
_RR_FRAMEWORK_LINES=""
_RR_COVERAGE_LINES=""
_RR_COVERAGE_FAILURES=""      # same shape
while IFS= read -r _rr_p; do
  [[ -n "$_rr_p" ]] || continue

  # --- edm-state validate (CA-036): 0 = no blocking anomaly, 3 = at least one blocking anomaly.
  # Both are real, readable results. Anything else is a setup error and is NEVER scored clean.
  _rr_vrc=0
  _rr_vout="$(_rr_validate_output "$_rr_p")" || _rr_vrc=$?
  if [[ "$_rr_vrc" -eq 0 || "$_rr_vrc" -eq 3 ]]; then
    [[ -n "$_rr_vout" ]] && _RR_VALIDATE_LINES="${_RR_VALIDATE_LINES}${_RR_VALIDATE_LINES:+$'\n'}${_rr_vout}"
  else
    _RR_VALIDATE_FAILURES="${_RR_VALIDATE_FAILURES}${_RR_VALIDATE_FAILURES:+, }${_rr_p} (exit ${_rr_vrc})"
  fi

  # --- edm-state get-coverage (CA-037): exit 0 with no coverage rows means "no coverage recorded",
  # a legitimate N/A. A NON-ZERO exit means the read itself failed, which used to empty the
  # framework signal, mark Test stack and Coverage posture N/A, and drop both out of the
  # overall-score denominator -- so a broken probe RAISED the score. It is now UNMEASURED instead.
  _rr_covrc=0
  _rr_cov_out="$("$EDM_STATE_BIN" get-coverage "$_rr_p" 2>/dev/null)" || _rr_covrc=$?
  if [[ "$_rr_covrc" -ne 0 ]]; then
    _RR_COVERAGE_FAILURES="${_RR_COVERAGE_FAILURES}${_RR_COVERAGE_FAILURES:+, }${_rr_p} (exit ${_rr_covrc})"
    continue
  fi
  # "## Detected Frameworks" lines render as "  key = value" (flat) or "  epic: key = value"
  # (per-epic, EDMV3-T25/CA-421). Split on " = " first, then take the last ": "-delimited token
  # of the left side as the layer key -- this handles both shapes with one rule.
  _rr_fw="$(printf '%s\n' "$_rr_cov_out" | awk -F' = ' '
    NF==2 {
      n = split($1, arr, ": ")
      key = arr[n]
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      print key, $2
    }
  ')"
  [[ -n "$_rr_fw" ]] && _RR_FRAMEWORK_LINES="${_RR_FRAMEWORK_LINES}${_RR_FRAMEWORK_LINES:+$'\n'}${_rr_fw}"
  # Coverage rows render as "<layer>  NN.N%  <measured_at>" (whole-initiative, pct is field 2) or
  # "<epic>  <layer>  NN.N%  <measured_at>" (per-epic, pct is field 3) -- COVERAGE_LAYER_ROW_JQ_DEF
  # / COVERAGE_EPIC_ROW_JQ_DEF in bin/edm-state. Locate the field matching NN.N%, not a fixed
  # column position, so a padding-width change there never silently breaks this.
  _rr_cv="$(printf '%s\n' "$_rr_cov_out" | awk '
    {
      pf = 0
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9]+(\.[0-9]+)?%$/) { pf = i; break }
      }
      if (pf == 2) { p = $2; sub(/%$/, "", p); print $1, p }
      else if (pf == 3) { p = $3; sub(/%$/, "", p); print $2, p }
    }
  ')"
  [[ -n "$_rr_cv" ]] && _RR_COVERAGE_LINES="${_RR_COVERAGE_LINES}${_RR_COVERAGE_LINES:+$'\n'}${_rr_cv}"
done < <(_rr_active_prefixes)

# The two probe-failure reasons, in the exact form every affected check carries as its
# unmeasured_reason (empty string = measured, which is the overwhelmingly common case).
RR_VALIDATE_UNMEASURED_REASON=""
[[ -n "$_RR_VALIDATE_FAILURES" ]] && \
  RR_VALIDATE_UNMEASURED_REASON="edm-state validate returned a status outside its documented 0/3 contract for: ${_RR_VALIDATE_FAILURES}"
RR_COVERAGE_UNMEASURED_REASON=""
[[ -n "$_RR_COVERAGE_FAILURES" ]] && \
  RR_COVERAGE_UNMEASURED_REASON="edm-state get-coverage could not be read for: ${_RR_COVERAGE_FAILURES}"

# _rr_layer_max_pct <layer>: highest recorded coverage pct for <layer> across every collected
# row, or the literal string "null" when no row named that layer exists.
_rr_layer_max_pct() {
  local layer="$1"
  printf '%s\n' "$_RR_COVERAGE_LINES" | awk -v want="$layer" '$1==want{print $2}' | \
    jq -Rn '[inputs | select(length>0) | tonumber] | if length==0 then "null" else (max|tostring) end' | tr -d '"'
}

# _rr_layer_meets_target <layer> <target-pct>: "true"/"false".
_rr_layer_meets_target() {
  local layer="$1" target="$2" pct
  pct="$(_rr_layer_max_pct "$layer")"
  jq -n --arg p "$pct" --arg t "$target" 'if $p == "null" then false else (($p|tonumber) >= ($t|tonumber)) end'
}

TESTSTACK_UNIT_FOUND="false"
if printf '%s\n' "$_RR_FRAMEWORK_LINES" | awk '$1=="unit" && $2!="none" && $2!=""{f=1} END{exit !f}'; then
  TESTSTACK_UNIT_FOUND="true"
fi
TESTSTACK_OTHER_FOUND="false"
if printf '%s\n' "$_RR_FRAMEWORK_LINES" | awk '($1=="component"||$1=="integration"||$1=="e2e"||$1=="contract"||$1=="composable"||$1=="a11y") && $2!="none" && $2!=""{f=1} END{exit !f}'; then
  TESTSTACK_OTHER_FOUND="true"
fi
# EDMV4-T39 Description: "Test stack (10, conditional on any test framework being detected at
# all)". EDMV4-T40 shares this SAME predicate as Coverage posture's own conditional gate (the
# SRD: "Coverage posture (10, conditional on Test stack being applicable)") -- computed once
# here so the two categories can never disagree about applicability.
TESTSTACK_APPLICABLE="false"
if [[ "$TESTSTACK_UNIT_FOUND" == "true" || "$TESTSTACK_OTHER_FOUND" == "true" ]]; then
  TESTSTACK_APPLICABLE="true"
fi

# ---- Methodology setup signals -------------------------------------------------------------------
# EDMV4-T38 out of scope note (kept for continuity): no check here scores whether EDM itself is
# installed (correction 7's self-serving "harness-audit.js" pattern this initiative calls out
# and EDMV4-T39 AC10 forbids) -- these measure the TARGET repository only.
# EDMV4-T40 AC7: every self-detected signal carries a justification comment naming why no
# edm-state call can supply it. "A check with no such comment and no edm-state call is a defect" --
# the two below had none, so they are written out here rather than left implicit.
#
# GIT_REPO_PRESENT: self-detected, and unavoidably so. No edm-state subcommand answers "is the
# working directory inside a git work tree": `branch-check` and `record-branch` both take a
# <PREFIX> and answer a different question (does the recorded initiative_branch match the current
# one), and both are useless on the repository this check exists to score -- one that may have no
# initiative at all yet. `git rev-parse --is-inside-work-tree` is the whole probe, read-only, and
# is not a re-derivation of anything edm-state owns.
GIT_REPO_PRESENT="false"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  GIT_REPO_PRESENT="true"
fi

# SRD_DIR_PRESENT: self-detected because SRD_ROOT is, and that is the honest problem here, not the
# directory test. SRD_ROOT above is a SECOND COPY of the EDM_SRD_ROOT / CLAUDE_PLUGIN_OPTION_SRD_ROOT
# / ./SRD chain `bin/edm-state` already owns at its own top-level SRD_ROOT assignment -- the CA-409
# class this AC's comment requirement exists to force an author to confront rather than paper over.
# It is not removable from inside this script: no edm-state subcommand exposes the resolved root.
# `resolve-dir` and `list --paths` both need an initiative to exist, and this scorecard's whole
# point is to run on a repository that may have none. The residual work is therefore an
# edm-state-owned accessor -- one subcommand printing edm-state's own resolved SRD_ROOT -- which
# belongs in `bin/edm-state`, not here.
#
# What IS done here, so the duplication cannot drift silently while it survives: the two
# assignments are byte-identical, and `bin/tests/wave8-smoke.sh` asserts that byte-identity
# against both live files. A change to either chain that is not made to both fails a test instead
# of quietly giving the scorer a different srd_root than every other consumer.
SRD_DIR_PRESENT="false"
[[ -d "$SRD_ROOT" ]] && SRD_DIR_PRESENT="true"

# EDMV4-T40 AC1: permission-rule presence is read from check_permission_rules()'s result as
# surfaced by the PERM_RULES_MISSING anomaly in edm-state validate's output -- this script never
# scans .claude settings files a second time.
PERM_RULES_OK="true"
[[ "$(_rr_any_prefix_validate_has "PERM_RULES_MISSING")" == "true" ]] && PERM_RULES_OK="false"

# ---- State health signals. EDMV4-T40 AC3: blocking-class anomalies cost more per hit than
# informational ones -- declared as each check's own point value below, alongside the check it
# belongs to, rather than as a separate formula elsewhere. --------------------------------------
SH_NO_OPEN_PARTIALS="true"
[[ "$(_rr_any_prefix_validate_has "OPEN_PARTIALS")" == "true" ]] && SH_NO_OPEN_PARTIALS="false"
SH_NO_CONVERGED_NO_APPROVAL="true"
[[ "$(_rr_any_prefix_validate_has "CONVERGED_NO_APPROVAL")" == "true" ]] && SH_NO_CONVERGED_NO_APPROVAL="false"
SH_NO_OTHER_BLOCKING="true"
[[ "$(_rr_any_other_blocking_anomaly)" == "true" ]] && SH_NO_OTHER_BLOCKING="false"
SH_NO_OPEN_AUDIT_ROUND="true"
[[ "$(_rr_any_prefix_validate_has "OPEN_AUDIT_ROUND")" == "true" ]] && SH_NO_OPEN_AUDIT_ROUND="false"
SH_NO_TORN_TOKEN_LINES="true"
[[ "$(_rr_any_prefix_validate_has "TORN_TOKEN_LINES")" == "true" ]] && SH_NO_TORN_TOKEN_LINES="false"
SH_NO_SPEC_SWEEP_PENDING="true"
[[ "$(_rr_any_prefix_validate_has "SPEC_SWEEP_PENDING")" == "true" ]] && SH_NO_SPEC_SWEEP_PENDING="false"

# ---- Convergence history signals -----------------------------------------------------------------
# _rr_archived_count: count of archived initiatives under SRD_ROOT/.archived.
# EDMV4-T40 AC7: no edm-state subcommand exposes archived-initiative existence directly --
# `edm-state list`/`list --paths` deliberately excludes .archived/ (EDMV3-111), and
# `metrics-report --all`/`--calibrate` mix active+archived rows without labeling which is which.
# This is the one signal in this script genuinely self-detected: a read-only directory count over
# the exact flat (.archived/PREFIX/) and product-scoped (.archived/PRODUCT/PREFIX__desc/) shapes
# edm-state's own list_state_files() already recognizes.
_rr_archived_count() {
  local c
  c="$(find "${SRD_ROOT}/.archived" -maxdepth 3 -name ".edm-state.json" 2>/dev/null | wc -l | tr -d ' ')" || c=0
  printf '%s\n' "${c:-0}"
}
ARCHIVED_COUNT="$(_rr_archived_count)"
CONVERGENCE_APPLICABLE="false"
[[ "$ARCHIVED_COUNT" -ge 1 ]] && CONVERGENCE_APPLICABLE="true"

# EDMV4-T40 AC6: cost and duration history, where scored, is read from edm-state metrics-report.
#
# CA-038: CH_CALIBRATION_AVAILABLE used to default to TRUE and flip to false only on a literal
# "insufficient data" match, so ANY other failure shape -- a non-zero exit, an unparseable state
# file, the renderer's own "error building the calibration report" fallback -- silently awarded
# the calibration-data points. It now defaults to FALSE and is set true only on a POSITIVE signal:
# at least one real "(size, phase)" median row, which `cmd_metrics_report --calibrate` renders as
# "median_duration=". A non-zero exit, or the renderer's error fallback, is UNMEASURED, not false:
# "no calibration data recorded" and "the calibration report could not be produced" are different
# answers and are reported differently.
CALIB_RC=0
CALIB_OUT="$("$EDM_STATE_BIN" metrics-report --calibrate 2>/dev/null)" || CALIB_RC=$?
CH_CALIBRATION_AVAILABLE="false"
RR_CALIBRATION_UNMEASURED_REASON=""
if [[ "$CALIB_RC" -ne 0 ]]; then
  RR_CALIBRATION_UNMEASURED_REASON="edm-state metrics-report --calibrate exited ${CALIB_RC}"
elif printf '%s\n' "$CALIB_OUT" | grep -q "error building the calibration report"; then
  RR_CALIBRATION_UNMEASURED_REASON="edm-state metrics-report --calibrate reported an error building the report"
elif printf '%s\n' "$CALIB_OUT" | grep -q "median_duration="; then
  CH_CALIBRATION_AVAILABLE="true"
fi

METRICS_ALL_RC=0
METRICS_ALL_OUT="$("$EDM_STATE_BIN" metrics-report --all 2>/dev/null)" || METRICS_ALL_RC=$?
CH_COST_HISTORY="false"
RR_METRICS_ALL_UNMEASURED_REASON=""
if [[ "$METRICS_ALL_RC" -ne 0 ]]; then
  RR_METRICS_ALL_UNMEASURED_REASON="edm-state metrics-report --all exited ${METRICS_ALL_RC}"
elif printf '%s\n' "$METRICS_ALL_OUT" | awk '{for(i=1;i<=NF;i++) if ($i ~ /^\$[0-9]/) print $i}' | \
   tr -d '$' | jq -Rn '[inputs | select(length>0) | tonumber] | any(. > 0)' | grep -q true; then
  CH_COST_HISTORY="true"
fi

CH_MULTIPLE_ARCHIVED="false"
[[ "$ARCHIVED_COUNT" -ge 2 ]] && CH_MULTIPLE_ARCHIVED="true"

# ---- Artifact hygiene signals. EDMV4-T40 Description: this is categorization of an existing
# signal, not new detection logic -- edm-lint-artifacts is already the plugin's own artifact-
# hygiene scanner (unicode, attribution trailers, leaked tool tags, mermaid semicolons). --------
LINT_TARGET_ARGS=(--all)
[[ -n "$PREFIX" ]] && LINT_TARGET_ARGS=("$PREFIX")
LINT_RC=0
"$EDM_LINT_BIN" "${LINT_TARGET_ARGS[@]}" >/dev/null 2>&1 || LINT_RC=$?
# edm-lint-artifacts' documented contract: 0 = clean, 1 = real violations found, 2 = setup/usage
# error. Only 0 and 1 are measurements of artifact hygiene; a setup error measured nothing and is
# reported UNMEASURED rather than as "dirty" (same three-state rule as the probes above -- a
# reader must be able to tell "violations found" from "the scanner could not run").
ARTIFACT_LINT_CLEAN="true"
RR_LINT_UNMEASURED_REASON=""
if [[ "$LINT_RC" -eq 1 ]]; then
  ARTIFACT_LINT_CLEAN="false"
elif [[ "$LINT_RC" -ne 0 ]]; then
  ARTIFACT_LINT_CLEAN="false"
  RR_LINT_UNMEASURED_REASON="edm-lint-artifacts exited ${LINT_RC} (a setup/usage error, not a hygiene measurement)"
fi

# ---- Checks --------------------------------------------------------------------------------------
# EDMV4-T39 AC2: each category's checks, raw total and conditional predicate are declared
# together, in one place, below -- a reader can see the whole definition of one category without
# scrolling elsewhere. EDMV4-T39 AC8: every check carries id/category/points/description/pass/fix,
# and fix is mandatory on every check, not only failing ones.
#
# CA-036/CA-037/CA-038: the optional SEVENTH argument is the check's unmeasured_reason -- the empty
# string (the default, and the case for almost every check on almost every run) means the check was
# really measured. A non-empty reason means the probe behind it did not return a readable result:
# the check is forced to pass=false so it earns no points, and carries measured:false plus the
# reason so a consumer -- and the human-readable report below -- can tell a measured zero from an
# unmeasurable one without re-deriving the probe.
_rr_mk_check() {
  jq -nc \
    --arg id "$1" --arg category "$2" --argjson points "$3" \
    --arg description "$4" --argjson pass "$5" --arg fix "$6" \
    --arg unmeasured "${7:-}" \
    '{id: $id, category: $category, points: $points, description: $description,
      pass: (if $unmeasured == "" then $pass else false end),
      fix: $fix,
      measured: ($unmeasured == ""),
      unmeasured_reason: (if $unmeasured == "" then null else $unmeasured end)}'
}

ALL_CHECKS=()

# ---- Methodology setup (10 pts, unconditional) ----------------------------------------------
ALL_CHECKS+=("$(_rr_mk_check "git-repo-present" "Methodology setup" 3 \
  "The scored target is a git working tree." "$GIT_REPO_PRESENT" \
  "Run 'git init' in the target directory before using EDM -- EDM's artifact-commit model (SRD/ under git) assumes a git repository.")")
ALL_CHECKS+=("$(_rr_mk_check "srd-directory-present" "Methodology setup" 2 \
  "The configured srd_root (${SRD_ROOT}) exists." "$SRD_DIR_PRESENT" \
  "Run edm-init to scaffold an initiative, or create ${SRD_ROOT} by hand, before using EDM against this repository.")")
ALL_CHECKS+=("$(_rr_mk_check "permission-ask-rules-configured" "Methodology setup" 5 \
  "No active initiative reports the PERM_RULES_MISSING anomaly from edm-state validate." "$PERM_RULES_OK" \
  "Add the required permissions.ask block (Bash(edm-state approve-gate*), Bash(edm-state archive*)) documented in CLAUDE.md's Required setup section to your project's Claude Code settings." "$RR_VALIDATE_UNMEASURED_REASON")")

# ---- State health (10 pts, unconditional) -----------------------------------------------------
ALL_CHECKS+=("$(_rr_mk_check "state-health-no-open-partials" "State health" 3 \
  "No active initiative reports an unclosed or FAIL-closed OPEN_PARTIALS verdict (blocking, 3pt cost)." "$SH_NO_OPEN_PARTIALS" \
  "Run /edm:verify-runtime <PREFIX> to close every open or FAIL-closed PARTIAL verdict before archiving." "$RR_VALIDATE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "state-health-no-converged-no-approval" "State health" 2 \
  "No active initiative reports code_audit_converged=true with no recorded gate approval (blocking, 2pt cost)." "$SH_NO_CONVERGED_NO_APPROVAL" \
  "Run edm-state approve-gate <PREFIX> code-audit, or investigate a hand-edited state file." "$RR_VALIDATE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "state-health-no-other-blocking-anomalies" "State health" 2 \
  "No active initiative reports any other blocking anomaly, e.g. TIME_ORDER or ZERO_TOKENS (blocking, 2pt cost)." "$SH_NO_OTHER_BLOCKING" \
  "Run edm-state validate <PREFIX> on the named initiative and follow its remediation for the reported blocking anomaly." "$RR_VALIDATE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "state-health-no-open-audit-round" "State health" 1 \
  "No active initiative reports an audit round started but never completed (informational, 1pt cost)." "$SH_NO_OPEN_AUDIT_ROUND" \
  "Run edm-state audit-round-complete <PREFIX> <type> to close the open round, or continue the round in progress." "$RR_VALIDATE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "state-health-no-torn-token-lines" "State health" 1 \
  "No active initiative reports session-JSONL lines that failed to parse while summing tokens (informational, 1pt cost)." "$SH_NO_TORN_TOKEN_LINES" \
  "Usually transient (a session file still being appended to); re-run edm-state validate <PREFIX> later if it persists." "$RR_VALIDATE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "state-health-no-spec-sweep-pending" "State health" 1 \
  "No active initiative has a fixed code-audit finding still owing its same-commit documentation sweep (informational, 1pt cost)." "$SH_NO_SPEC_SWEEP_PENDING" \
  "Sweep the named finding's documentation and set spec_swept to yes or n/a in the findings ledger." "$RR_VALIDATE_UNMEASURED_REASON")")

# ---- Test stack (10 pts, conditional on any detected test framework) --------------------------
ALL_CHECKS+=("$(_rr_mk_check "unit-test-framework-detected" "Test stack" 6 \
  "test_frameworks_detected (via edm-state get-coverage) names a unit test framework for at least one active initiative." "$TESTSTACK_UNIT_FOUND" \
  "Run /edm:test <PREFIX> so edm-test-planner records a detected unit test framework." "$RR_COVERAGE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "additional-layer-framework-detected" "Test stack" 4 \
  "test_frameworks_detected names a framework for at least one non-unit layer (component, integration, e2e, contract, composable, or a11y)." "$TESTSTACK_OTHER_FOUND" \
  "Run /edm:test <PREFIX> and let edm-test-planner/edm-test-scaffold detect and record additional test layers as they become applicable." "$RR_COVERAGE_UNMEASURED_REASON")")

# ---- Coverage posture (10 pts, conditional on Test stack being applicable) ---------------------
ALL_CHECKS+=("$(_rr_mk_check "unit-coverage-meets-target" "Coverage posture" 4 \
  "The highest recorded unit coverage pct meets coverage_target_unit_pct (${COVERAGE_TARGET_UNIT_PCT}%)." "$(_rr_layer_meets_target unit "$COVERAGE_TARGET_UNIT_PCT")" \
  "Run /edm:test <PREFIX> to raise unit coverage to at least ${COVERAGE_TARGET_UNIT_PCT}%, or record it via edm-state record-test-coverage." "$RR_COVERAGE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "component-coverage-meets-target" "Coverage posture" 3 \
  "The highest recorded component coverage pct meets coverage_target_component_pct (${COVERAGE_TARGET_COMPONENT_PCT}%)." "$(_rr_layer_meets_target component "$COVERAGE_TARGET_COMPONENT_PCT")" \
  "Run /edm:test <PREFIX> to raise component coverage to at least ${COVERAGE_TARGET_COMPONENT_PCT}%, or record it via edm-state record-test-coverage." "$RR_COVERAGE_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "integration-coverage-meets-target" "Coverage posture" 3 \
  "The highest recorded integration coverage pct meets coverage_target_integration_pct (${COVERAGE_TARGET_INTEGRATION_PCT}%)." "$(_rr_layer_meets_target integration "$COVERAGE_TARGET_INTEGRATION_PCT")" \
  "Run /edm:test <PREFIX> to raise integration coverage to at least ${COVERAGE_TARGET_INTEGRATION_PCT}%, or record it via edm-state record-test-coverage." "$RR_COVERAGE_UNMEASURED_REASON")")

# ---- Convergence history (10 pts, conditional on at least one archived initiative) -------------
ALL_CHECKS+=("$(_rr_mk_check "convergence-calibration-data-available" "Convergence history" 4 \
  "edm-state metrics-report --calibrate produces at least one (size, phase) median row." "$CH_CALIBRATION_AVAILABLE" \
  "Complete and archive at least one initiative with estimated_size set so /edm:metrics --calibrate has data to compute medians from." "$RR_CALIBRATION_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "convergence-cost-history-recorded" "Convergence history" 3 \
  "edm-state metrics-report --all reports a nonzero Claude cost for at least one initiative." "$CH_COST_HISTORY" \
  "Run phases through to completion with edm-state phase-complete so cost/duration are recorded per phase." "$RR_METRICS_ALL_UNMEASURED_REASON")")
ALL_CHECKS+=("$(_rr_mk_check "convergence-multiple-archived-initiatives" "Convergence history" 3 \
  "More than one archived initiative exists under ${SRD_ROOT}/.archived (found: ${ARCHIVED_COUNT})." "$CH_MULTIPLE_ARCHIVED" \
  "Archive additional completed initiatives with edm-state archive as they converge, to establish a repeatable rhythm.")")

# ---- Artifact hygiene (10 pts, unconditional) --------------------------------------------------
ALL_CHECKS+=("$(_rr_mk_check "artifact-lint-clean" "Artifact hygiene" 10 \
  "edm-lint-artifacts reports zero violations across the scored scope (exit 0)." "$ARTIFACT_LINT_CLEAN" \
  "Run edm-lint-artifacts --all (or edm-lint-artifacts <PREFIX>) to see and fix the reported violations." "$RR_LINT_UNMEASURED_REASON")")

CHECKS_JSON="$(printf '%s\n' "${ALL_CHECKS[@]}" | jq -s '.')"

# EDMV4-T39 AC4: an explicit applicability field per category, so a consumer can distinguish
# "scored 0" from "not applicable" without re-deriving the predicate.
CATEGORY_APPLICABILITY_JSON="$(jq -n \
  --argjson teststack "$TESTSTACK_APPLICABLE" \
  --argjson coverage "$TESTSTACK_APPLICABLE" \
  --argjson convergence "$CONVERGENCE_APPLICABLE" \
  '{
    "Methodology setup": true,
    "State health": true,
    "Test stack": $teststack,
    "Coverage posture": $coverage,
    "Convergence history": $convergence,
    "Artifact hygiene": true
  }')"

# EDMV4-T39 AC3/AC5: each category normalized to 0-10; overall score is the arithmetic mean of
# APPLICABLE categories only (inapplicable categories are excluded from the denominator, never
# scored as zero).
REPORT_JSON="$(jq -n \
  --argjson checks "$CHECKS_JSON" \
  --argjson applicability "$CATEGORY_APPLICABILITY_JSON" \
  --arg version "$READINESS_RUBRIC_VERSION" \
  --arg prefix "$PREFIX" \
  '
  def fmt1: (. * 10 | round) as $t | (($t / 10 | floor) | tostring) + "." + (($t % 10) | tostring);
  # NOTE: jq // treats false (not only null) as absent -- $applicability[...] // true would
  # silently turn a real, computed false back into true here, the same trap the cand_complete
  # comment in edm-compare-eval already flags for a different boolean. Test presence with has()
  # explicitly instead of relying on //.
  # CA-036/CA-037/CA-038: a category is `measured` only when every one of its checks is. An
  # UNMEASURED category is FORCED applicable regardless of its own conditional predicate, so it
  # stays in the $applicable_cats denominator below -- otherwise a failed probe removes the
  # category it broke from the mean and the read failure RAISES the score, which is precisely
  # backwards. `applicable:false` therefore keeps meaning exactly one thing: genuinely N/A.
  ($checks
    | group_by(.category)
    | map(.[0].category as $catname
      | ([.[] | .measured] | all) as $catmeasured
      | {
        name: $catname,
        measured: $catmeasured,
        unmeasured_reasons: ([.[] | select(.measured | not) | .unmeasured_reason] | unique),
        applicable: (if ($catmeasured | not) then true
                     elif ($applicability | has($catname)) then $applicability[$catname]
                     else true end),
        raw_earned: ([.[] | select(.pass) | .points] | add // 0),
        raw_max: ([.[] | .points] | add // 0)
      })
    | map(. + {
        score_0_10: (if .raw_max == 0 then "0.0" else ((.raw_earned / .raw_max * 10) | fmt1) end)
      })
  ) as $cats
  | ($cats | map(select(.applicable))) as $applicable_cats
  | (if ($applicable_cats | length) == 0 then "0.0"
     else (($applicable_cats | map(.score_0_10 | tonumber) | add) / ($applicable_cats | length) | fmt1)
     end) as $overall
  | {
      readiness_rubric_version: $version,
      prefix: (if $prefix == "" then null else $prefix end),
      score: $overall,
      categories: $cats,
      checks: $checks
    }
  ')"

# ---- Human-readable report: stdout only (AC7 -- no JSON on stdout, ever) ---------------------
echo "EDM repository readiness"
echo "========================="
echo "Rubric version: ${READINESS_RUBRIC_VERSION}"
if [[ -n "$PREFIX" ]]; then
  echo "Scope: initiative ${PREFIX} (Methodology setup's git/SRD checks and Convergence history remain repository-wide)"
else
  echo "Scope: whole repository"
fi
echo

printf '%s' "$REPORT_JSON" | jq -r '
  . as $root
  | $root.categories[] as $cat
  | "", ("## " + $cat.name +
      (if ($cat.measured | not) then
         " -- " + $cat.score_0_10 + " / 10  UNMEASURED: " + ($cat.unmeasured_reasons | join("; ")) +
         " (scored zero and KEPT in the overall mean -- this is not a measured zero)"
       elif $cat.applicable then " -- " + $cat.score_0_10 + " / 10"
       else " -- N/A (not applicable)" end)),
    ($root.checks[] | select(.category == $cat.name) |
      (if (.measured | not) then "  [UNMEASURED] " elif .pass then "  [PASS] " else "  [FAIL] " end) +
      .id + " (" + (.points|tostring) + " pts) -- " + .description +
      (if (.measured | not) then "  WHY UNMEASURED: " + .unmeasured_reason + "  FIX: " + .fix
       elif (.pass | not) then "  FIX: " + .fix
       else "" end))
'

# Same reasons, once per unmeasured category, on stderr: stdout is a report a caller may capture
# and parse, and a probe failure must be visible to a caller that only watches stderr too
# (CA-036/CA-037/CA-038 all require the reason to be PRINTED, not merely encoded in the JSON).
printf '%s' "$REPORT_JSON" | jq -r '
  .categories[] | select(.measured | not)
  | "edm-repo-readiness: " + .name + " could not be measured: " + (.unmeasured_reasons | join("; "))
' >&2

echo
printf 'Overall score: %s / 10\n' "$(printf '%s' "$REPORT_JSON" | jq -r '.score')"
RR_UNMEASURED_COUNT="$(printf '%s' "$REPORT_JSON" | jq -r '[.categories[] | select(.measured | not)] | length')"
if [[ "$RR_UNMEASURED_COUNT" -gt 0 ]]; then
  printf 'WARNING: %s of %s categories could not be measured and were scored zero (see UNMEASURED above). The overall score is a FLOOR, not a measurement.\n' \
    "$RR_UNMEASURED_COUNT" "$(printf '%s' "$REPORT_JSON" | jq -r '.categories | length')"
fi

# ---- Machine-readable report: file only, via --json <path> (AC7) ----------------------------
if [[ -n "$JSON_OUT" ]]; then
  printf '%s' "$REPORT_JSON" > "$JSON_OUT" || die "could not write JSON report to $JSON_OUT"
fi

exit 0
