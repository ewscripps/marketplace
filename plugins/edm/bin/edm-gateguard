#!/usr/bin/env bash
# edm-gateguard -- PreToolUse fact-forcing edit gate for Phase 6 (EDMV4-T11).
#
# Why this exists: `PreToolUse` fires exactly once per `git commit`, where a 3,000 ms budget is
# fine because a human is waiting. This hook fires on every Edit/Write/MultiEdit call instead --
# tens to hundreds of times per Phase 6 wave -- so every design choice below optimizes the common
# case: a repository with no active Phase 6 initiative pays one process exec and one marker file
# test, no other filesystem read, no parser subprocess. Two rejected designs: re-deriving "which
# initiative is active" from a fresh sweep costs one parser subprocess per active initiative PER
# EDIT (fifty at the plugin's own 50-initiative fixture); a full state checkpoint (write lock plus
# a hash over every tracked artifact) is Stop/PreCompact-cadence work, not per-edit work.
#
# Provenance (decisions.md D14, ratified at Gate 2): a from-scratch rewrite, not a port or a
# vendored copy of either upstream implementation -- see CLAUDE.md's "Prompt conventions (house
# style)" section for the recorded attribution.
#
# Scope history: EDMV4-T11 built the marker check, the allow path, and the host registration.
# EDMV4-T13 added the single emit_decision function with its two selectable back-ends. EDMV4-T14
# wired the fact-forcing denial content into the Edit/Write/MultiEdit case arms and the per-file
# MultiEdit loop. EDMV4-T15's operational safety controls -- kill switches, exemption globs, the
# session-state cap/staleness rule, and the denial budget -- still land in a follow-on ticket.
#
# EDM-HELP-BEGIN
# edm-gateguard - PreToolUse fact-forcing edit gate for Phase 6 (structural build).
#
# Usage:
#   edm-gateguard              # normal invocation: reads the host's PreToolUse JSON payload from
#                               # stdin (tool_name, tool_input, ...) and never takes arguments
#   edm-gateguard -h|--help    # show this help
#
# Registration: plugins/edm/hooks/hooks.json's PreToolUse array carries a matcher block for
# Edit|Write|MultiEdit whose command guards on this binary's presence exactly like the existing
# `git commit` block does (`command -v edm-gateguard >/dev/null 2>&1 || exit 0` before exec), so an
# uninstalled or partially-installed plugin never blocks a tool call it cannot evaluate.
#
# What runs today: a repository with no active Phase 6 marker allows immediately -- one process
# exec, one marker file test, no other filesystem read, no parser subprocess. With a marker
# present, an Edit/Write/MultiEdit call on a path not yet recorded checked this session is denied
# with a numbered fact list and recorded checked; the identical path on a later call in the same
# session allows. No kill switch, exemption glob or denial budget exists yet (EDMV4-T15).
#
# Exit codes:
#   0  the tool call is allowed, or -h/--help was requested.
#   1  a setup error (unexpected argument, an unparseable stdin payload, or a required parser
#      missing once a marker is present). A setup error never blocks the tool call -- the same
#      non-blocking convention every other hook in this plugin applies (CLAUDE.md's "Hooks
#      behavior" section) -- and deliberately differs from this family of scripts' usual default
#      of 2: on a PreToolUse hook, that code is how a real policy refusal blocks a call in
#      exit-code deny mode, so a setup error here must never reuse it by accident.
#   2  (exit-code deny mode only) a real refusal -- the fact list is on stderr. In the default
#      json deny mode, a refusal instead exits 0 with a hookSpecificOutput payload on stdout; see
#      emit_decision() below for the full contract.
# EDM-HELP-END
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"

# die <msg> [<code>] -- see the EDM-HELP block above for why this script's own default (1) departs
# from the family-standard 2 (edm-lint-artifacts, edm-repo-readiness, edm-compare-eval): those are
# standalone tools where 2 means "usage error"; this one is a PreToolUse hook where 2 means "deny",
# so this default must never collide with that meaning.
die() {
  local msg="$1" code="${2:-1}"
  echo "edm-gateguard: $msg" >&2
  exit "$code"
}

usage() {
  print_help "${BASH_SOURCE[0]:-$0}"
  exit 0
}

# ---- Argument parsing: no positional arguments are legal; the payload arrives on stdin. --------
# A real hook invocation from the host never passes an argument at all -- this parsing exists so
# the binary is also a well-behaved standalone CLI tool for manual testing and for this ticket's
# own smoke coverage, matching every other bin/ helper's -h/--help/help convention.
case "${1:-}" in
  -h|--help|help) usage ;;
esac

if [[ $# -gt 0 ]]; then
  die "unexpected argument: '$1' -- edm-gateguard takes no positional arguments; its payload arrives on stdin as the host's PreToolUse JSON"
fi

# ---- Shared data-directory resolver: guarded sourcing (EDMV4-T17's own contract) -- a missing or
# partially-installed library degrades this script to today's behaviour (no gate at all) rather
# than aborting or, worse, guessing at a marker path. ---------------------------------------------
if [[ -f "${SCRIPT_DIR}/_edm-datadir-lib.sh" ]]; then
  # shellcheck source=/dev/null
  source "${SCRIPT_DIR}/_edm-datadir-lib.sh"
fi

if ! declare -F edm_marker_path >/dev/null 2>&1; then
  # The resolver never loaded (missing file, or a partial install that failed to define its own
  # public function). An unresolvable environment is never a reason to block a tool call -- it is
  # a reason to behave exactly as this plugin did before this ticket existed: no gate at all.
  exit 0
fi

MARKER_PATH="$(edm_marker_path)"

# ---- The allow path: the ONLY filesystem check this script performs when no initiative is in
# Phase 6. `test -f` here is the single stat this build spends on that common case -- one process
# exec, one marker test, zero parser subprocesses, zero state reads. Nothing is written to stdout
# or stderr on this branch: silence on allow is the contract a later ticket's own decision-emission
# function inherits, not something it introduces. -------------------------------------------------
if [[ -z "$MARKER_PATH" ]] || ! test -f "$MARKER_PATH"; then
  exit 0
fi

# ===================================================================================================
# Gated path: a Phase 6 marker exists for this project. Everything below this line is the only
# place in this script where a JSON parser is a legitimate dependency (AD3's qualifier) -- nothing
# above this comment ever references one, by construction, so a repository with no active Phase 6
# initiative never spawns a parser subprocess at all.
# ===================================================================================================

command -v jq >/dev/null 2>&1 \
  || die "a JSON parser is required once a Phase 6 marker is present (the allow path above needed none)"

# Read the host's PreToolUse JSON payload from stdin. `read -d ''` is a bash builtin: it reads
# until end-of-file (no literal NUL ever appears in a JSON document) with no subprocess spawned to
# do it, matching this script's own required-binary contract (bash builtins, jq, stat/test only).
PAYLOAD=""
IFS= read -r -d '' PAYLOAD || true

if [[ -z "$PAYLOAD" ]]; then
  die "no payload was delivered on stdin -- edm-gateguard expects the host's PreToolUse JSON document"
fi

if ! TOOL_NAME="$(printf '%s' "$PAYLOAD" | jq -r '.tool_name // empty' 2>/dev/null)"; then
  die "could not parse the JSON payload delivered on stdin"
fi

# ---- EDMV4-T13: the single decision-emitting function, with two selectable back-ends. Every
# deny and every allow on this gated path is emitted from here and nowhere else in this file --
# no other printf/echo prints a decision payload or a fact list, and no other line exits with a
# decision-carrying status. A later ticket's fact content (EDMV4-T14) and operational controls
# (EDMV4-T15) both call INTO this function; neither grows a second, competing decision site. -----

# EDM_GATEGUARD_DENY_MODE_DEFAULT: set from Spike B's recorded outcome (decisions.md D26, run live
# against `claude --version` 2.1.246, disposable mktemp -d repositories). The JSON
# hookSpecificOutput mechanism denied both `Edit` and `Write` cleanly, with the reason surfaced to
# the agent as a clean tool-result string; the exit-2-plus-stderr mechanism also denied both but
# leaked the hook's own shell command text into the agent's transcript. `MultiEdit` itself was
# UNTESTABLE on that host (the tool never loaded into the session's toolset) and is not evidence
# either way. This single named constant is the whole lever if that evidence is ever superseded --
# flip this one line and the smoke assertion that pins its value fails a test, not a wave; neither
# back-end below is rewritten.
EDM_GATEGUARD_DENY_MODE_DEFAULT="json"

# emit_decision <allow|deny> [<reason>] -- the ONLY place in this script that ever prints a
# decision payload or exits with a decision-carrying status (0 for allow and for a json-mode
# deny -- the JSON payload IS the deny signal the host reads; 2 for an exit-code-mode deny, the
# same code `edm-lint-staged-artifacts:7-10,150-158` already spends to mean "block"). <reason> is
# ignored for "allow": AC2 requires nothing be written to stdout on an allow, in either mode.
# EDM_GATEGUARD_DENY_MODE selects the back-end; any value other than the two legal ones below is a
# setup error (CA-298 -- a setup condition never blocks, matching this file's own `die()`
# contract) regardless of which decision was requested, so a misconfigured mode is caught the
# first time this function runs rather than only on the next real denial.
emit_decision() {
  local decision="$1"
  local reason="${2:-}"
  local mode="${EDM_GATEGUARD_DENY_MODE:-$EDM_GATEGUARD_DENY_MODE_DEFAULT}"

  case "$mode" in
    json|exit-code) : ;;
    *)
      die "EDM_GATEGUARD_DENY_MODE must be 'json' or 'exit-code' (got: '${mode}')"
      ;;
  esac

  case "$decision" in
    allow)
      exit 0
      ;;
    deny)
      case "$mode" in
        json)
          # AC8: the payload is built with `jq -cn`, never string concatenation -- a quote, a
          # backslash or an embedded newline in $reason is escaped correctly by jq's own --arg
          # handling, the exact class of bug a hand-rolled escaper would reintroduce. `-c`
          # (compact) is required: jq's default pretty-printed multi-line form would not match
          # AC2's single-line literal.
          jq -cn --arg reason "$reason" \
            '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":$reason}}'
          exit 0
          ;;
        exit-code)
          # AC3: the fact list goes to stderr as plain text -- no JSON, so no escaping concern
          # applies to this back-end at all.
          printf '%s\n' "$reason" >&2
          exit 2
          ;;
      esac
      ;;
    *)
      die "emit_decision: unknown decision '${decision}' (expected 'allow' or 'deny')"
      ;;
  esac
}

# ---- EDMV4-T14: per-file "checked" session state -- deny first touch, allow on retry. A minimal,
# append-only form lives here; EDMV4-T15 upgrades this exact surface with a 500-entry cap and a
# 30-minute staleness/truncation rule ("Session state lives at ${data}/run/<project-key>.checked").
# No kill switch, exemption glob or denial budget exists yet -- every call below denies once per
# path and allows thereafter, unconditionally, until EDMV4-T15 lands.
GG_STATE_DIR=""
if declare -F edm_data_dir >/dev/null 2>&1; then
  GG_STATE_DIR="$(edm_data_dir)"
  [[ -n "$GG_STATE_DIR" ]] && GG_STATE_DIR="${GG_STATE_DIR}/run"
fi
GG_CHECKED_FILE=""
if [[ -n "$GG_STATE_DIR" ]]; then
  GG_CHECKED_FILE="${GG_STATE_DIR}/$(edm_project_key).checked"
fi

# gg_is_checked <file_path> -- true if <file_path> was already recorded checked this session.
gg_is_checked() {
  local target="$1"
  [[ -n "$GG_CHECKED_FILE" && -f "$GG_CHECKED_FILE" ]] || return 1
  grep -Fxq -- "$target" "$GG_CHECKED_FILE" 2>/dev/null
}

# gg_mark_checked <file_path> -- records <file_path> as checked so a retry on the same path
# allows. Best-effort: a write failure here is never a reason to deny -- the caller has already
# decided to deny with facts by the time this runs, and EDMV4-T15 is what makes every state-write
# failure path explicitly non-blocking end to end (its own AC7); this build already never treats
# a failed mark as a reason to change the decision just made.
gg_mark_checked() {
  local target="$1"
  [[ -n "$GG_CHECKED_FILE" ]] || return 0
  mkdir -p "$(dirname "$GG_CHECKED_FILE")" 2>/dev/null || return 0
  printf '%s\n' "$target" >> "$GG_CHECKED_FILE" 2>/dev/null || true
}

# gg_build_facts <edit|write> <path> -- the four numbered facts a denial forces the agent to
# produce (EDMV4-T14 AC1/AC2). Facts 3 and 4 are byte-identical between the two variants; only
# facts 1 and 2 swap (AC2). Fact 4 deliberately asks for the ticket's own acceptance criteria, by
# ID, never the user's current instruction (AC3): EDM substitutes a fact it already has for a
# better one, reinforcing ticket traceability instead of re-narrating a prompt the agent holds.
# This wording is EDM's own -- no text is copied from either upstream source (AC7).
gg_build_facts() {
  local kind="$1" path="$2"
  local fact1 fact2
  if [[ "$kind" == "write" ]]; then
    fact1="1. Name the file(s) and line(s) that will call this new file (${path})."
    fact2="2. Confirm no existing file already serves the same purpose as this new file."
  else
    fact1="1. List all files that import or require this file (${path}), searching the tree."
    fact2="2. List the public functions or classes affected by this change."
  fi
  printf '%s\n%s\n%s\n%s' \
    "$fact1" \
    "$fact2" \
    "3. If this file reads or writes data files, show field names, structure and date format using redacted or synthetic values -- never raw production data." \
    "4. Quote the acceptance criteria of the ticket being implemented, by its {PREFIX}-T{NN} ID."
}

# ---- Dispatch on tool name. Bash 3.2 floor (C1): a `case` over a small, fixed name set is the
# portable form here, not an associative array keyed by tool name. -------------------------------
case "$TOOL_NAME" in
  Edit)
    GG_TARGET="$(printf '%s' "$PAYLOAD" | jq -r '.tool_input.file_path // empty' 2>/dev/null)"
    if [[ -n "$GG_TARGET" ]] && ! gg_is_checked "$GG_TARGET"; then
      gg_mark_checked "$GG_TARGET"
      emit_decision deny "$(gg_build_facts edit "$GG_TARGET")"
    fi
    ;;
  Write)
    GG_TARGET="$(printf '%s' "$PAYLOAD" | jq -r '.tool_input.file_path // empty' 2>/dev/null)"
    if [[ -n "$GG_TARGET" ]] && ! gg_is_checked "$GG_TARGET"; then
      gg_mark_checked "$GG_TARGET"
      emit_decision deny "$(gg_build_facts write "$GG_TARGET")"
    fi
    ;;
  MultiEdit)
    # EDMV4-T14 AC4/AC5. Tolerant of both the SRD's assumed multi-file batch shape
    # (edits[].file_path) and Claude Code's own documented single-file MultiEdit shape
    # (tool_input.file_path plus edits[] of old_string/new_string, with no per-edit file_path) --
    # collected into one de-duplicated, sorted list rather than assuming either. This could not be
    # confirmed against a live host from this environment (decisions.md records the restraint);
    # the extraction degrades to a one-element list under the single-file shape, which behaves
    # exactly like a normal Edit denial on that one path. Denies on the first still-unchecked path
    # and returns immediately via emit_decision's own exit, never evaluating the rest of the batch
    # in the same call. Reuses the Edit fact set -- MultiEdit only ever touches files that already
    # exist, never a new file, so the Write variant's facts do not apply here.
    GG_MULTI_FILES="$(printf '%s' "$PAYLOAD" | jq -r '
      ([.tool_input.file_path] + [.tool_input.edits[]?.file_path?])
      | map(select(. != null and . != ""))
      | unique[]
    ' 2>/dev/null)"
    while IFS= read -r GG_TARGET; do
      [[ -z "$GG_TARGET" ]] && continue
      if ! gg_is_checked "$GG_TARGET"; then
        gg_mark_checked "$GG_TARGET"
        emit_decision deny "$(gg_build_facts edit "$GG_TARGET")"
      fi
    done <<< "$GG_MULTI_FILES"
    ;;
  *)
    # A tool name reached the gated path that this gate does not target (a future matcher change,
    # or a payload this build did not anticipate). Allow rather than guess at a decision for a
    # case nothing above named -- this gate has never inspected anything but Edit/Write/MultiEdit
    # and is not the place to start guessing about a tool it was never registered against.
    : ;;
esac

# Every branch above allows silently once every path in scope for this call is already checked
# (or the tool name is one this gate does not target, or no file_path could be extracted at all)
# -- emitted through the single decision-emitting function above rather than a bare `exit 0`.
emit_decision allow ""

# =====================================================================================================
# Performance reference (not executed -- documentation only). Allow path (marker absent): 50 ms p95,
# one repository with no active Phase 6 initiative, over 20 samples -- `timing.sh --gateguard`. Gated
# path (marker present, first touch): 1 exec, a handful of stat calls plus the session-state read/
# append EDMV4-T15 adds, 1 parser invocation -- measured by the same `--gateguard` mode's other
# branch, against a generated fixture, so a change to either branch's cost shows up as a real number
# rather than an assumption nobody re-checked.
# =====================================================================================================
