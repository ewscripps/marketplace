#!/usr/bin/env bash
# edm-gateguard -- PreToolUse fact-forcing edit gate for Phase 6 (EDMV4-T11).
#
# Why this exists: `PreToolUse` fires exactly once per `git commit` (a 3,000 ms budget is fine
# with a human waiting); this hook fires on every Edit/Write/MultiEdit call instead -- tens to
# hundreds of times per wave -- so every design choice optimizes the common case: no active
# Phase 6 initiative pays one exec, one marker test, no parser subprocess. Provenance
# (decisions.md D14): a from-scratch rewrite, not a port -- see CLAUDE.md's "Prompt conventions
# (house style)" section for the recorded attribution.
#
# Scope history: EDMV4-T11 built the marker check/allow path/host registration; EDMV4-T13 added
# emit_decision; EDMV4-T14 wired the fact-forcing denial content and the MultiEdit loop; EDMV4-T15
# added the kill switches/exemptions/session state/denial budget; EDMV4-T45 (this build) wires
# file-event hookify rule evaluation into the allow path.
#
# EDM-HELP-BEGIN
# edm-gateguard - PreToolUse fact-forcing edit gate for Phase 6 (structural build).
#
# Usage:
#   edm-gateguard              # normal invocation: reads the host's PreToolUse JSON payload from
#                               # stdin (tool_name, tool_input, ...) and never takes arguments
#   edm-gateguard -h|--help    # show this help
#
# Registration: plugins/edm/hooks/hooks.json's PreToolUse array carries a matcher block for
# Edit|Write|MultiEdit whose command guards on this binary's presence exactly like the existing
# `git commit` block does (`command -v edm-gateguard >/dev/null 2>&1 || exit 0` before exec), so an
# uninstalled or partially-installed plugin never blocks a tool call it cannot evaluate.
#
# What runs today: no active Phase 6 marker allows immediately -- one exec, one marker test, no
# parser subprocess. Either EDM_GATEGUARD=0|false|off|disabled|disable or
# EDM_GATEGUARD_DISABLED=1 (literal "1" only) exits 0 before that marker test even runs. With a
# marker present, an Edit/Write/MultiEdit call on a path not yet checked this session denies with
# a numbered fact list, UNLESS EDM_GATEGUARD_EXEMPT_GLOBS matches (default: SRD/, test trees,
# dist/build, node_modules, .git) or the denial budget (EDM_GATEGUARD_MAX_DENIALS, default 3) is
# spent, in which case it allows with a stderr advisory. A denied path allows on any later call
# in the same session (state at EDM_GATEGUARD_STATE_DIR or the plugin data dir's run/
# subdirectory, capped at 500 entries, stale past 30 minutes idle). On the allow path, enabled
# `file`-event hookify rules (see CLAUDE.md's "Hookify rule format") evaluate once per call.
#
# Exit codes:
#   0  allowed (every kill-switch and fail-open path included), or -h/--help was requested.
#   1  a setup error: a bad argument, an unparseable stdin payload, or a required parser missing
#      once a marker is present -- absent a marker, no parser is ever referenced. Never blocks
#      (CLAUDE.md's "Hooks behavior") -- differs from this family's usual default of 2, "deny" here.
#   2  (exit-code deny mode only) a real refusal, fact list on stderr. json deny mode (the
#      default) instead exits 0 with a hookSpecificOutput payload on stdout; see emit_decision().
# EDM-HELP-END
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${SCRIPT_DIR}/_edm-cli-lib.sh"

# die <msg> [<code>] -- default (1) departs from the family-standard 2 (edm-lint-artifacts et al)
# since 2 means "deny" on this hook, and a setup error must never collide with that.
die() {
  local msg="$1" code="${2:-1}"
  echo "edm-gateguard: $msg" >&2
  exit "$code"
}

usage() {
  print_help "${BASH_SOURCE[0]:-$0}"
  exit 0
}

# No positional arguments are legal; the payload arrives on stdin. A real hook invocation never
# passes one -- this exists so the binary is also a well-behaved standalone CLI for manual tests.
case "${1:-}" in
  -h|--help|help) usage ;;
esac

if [[ $# -gt 0 ]]; then
  die "unexpected argument: '$1' -- edm-gateguard takes no positional arguments; its payload arrives on stdin as the host's PreToolUse JSON"
fi

# EDMV4-T15 AC1/AC2/AC3: two independent kill switches, checked before ANYTHING else -- no
# datadir-lib sourcing, no marker resolution, no filesystem read beyond this process's own
# environment. Both sit ahead of the datadir-lib source below, or a kill switch would still pay
# the very cost it exists to let an operator skip.
case "${EDM_GATEGUARD:-}" in
  0|false|off|disabled|disable) exit 0 ;;
esac
if [[ "${EDM_GATEGUARD_DISABLED:-}" == "1" ]]; then
  exit 0
fi

# Guarded sourcing (EDMV4-T17's contract): a missing/partial library degrades to no gate at all.
if [[ -f "${SCRIPT_DIR}/_edm-datadir-lib.sh" ]]; then
  # shellcheck source=/dev/null
  source "${SCRIPT_DIR}/_edm-datadir-lib.sh"
fi

if ! declare -F edm_marker_path >/dev/null 2>&1; then
  exit 0
fi

MARKER_PATH="$(edm_marker_path)"

# The allow path: the ONLY filesystem check when no initiative is in Phase 6. Silence on allow is
# the contract emit_decision inherits below, not something it introduces.
if [[ -z "$MARKER_PATH" ]] || ! test -f "$MARKER_PATH"; then
  exit 0
fi

# EDMV4-T15 AC11: a marker whose recorded initiative directory no longer exists (branch switch,
# `git clean`) is stale -- treat it exactly like marker-absent (allow, zero jq). Pure bash field
# extraction (no cut/awk); marker format is PREFIX<TAB>initiative_dir<TAB>started_at (T12 AC6).
MARKER_LINE=""
IFS= read -r MARKER_LINE < "$MARKER_PATH" 2>/dev/null || true

# CA-045: the stale test above is only meaningful on a marker that actually parses. The marker's
# contract is exactly three tab-separated fields (bin/edm-state's _edm_marker_write:
# PREFIX<TAB>initiative_dir<TAB>started_at), and `${MARKER_LINE#*$'\t'}` returns the WHOLE line
# unchanged when there is no tab -- so a truncated or corrupted marker used to land in
# MARKER_INITIATIVE_DIR as a single token, fail `[[ -d ]]`, and take the stale-marker `exit 0`.
# That silently disabled Phase 6 fact-forcing for the entire session, read identically to the
# legitimate branch-switch case, and printed nothing.
#
# The contract, decided here rather than left implicit: a marker that does not parse into three
# tab-separated fields is a SETUP condition, not a stale marker. It fails CLOSED -- the gate
# continues to the gated path below and applies its ordinary allow/deny -- and it names itself on
# stderr. It is never escalated into a refusal of its own: a setup condition must be visible, not
# blocking, which is the same rule edm-stop-gate and edm-bash-gate follow. A zero-byte marker
# file lands here too (zero fields), so its pre-existing deny is now the deliberate, diagnosed
# outcome rather than an accident of `[[ -n ]]` on an empty string.
MARKER_MALFORMED=0
case "$MARKER_LINE" in
  *$'\t'*$'\t'*) ;;
  *) MARKER_MALFORMED=1 ;;
esac

if [[ "$MARKER_MALFORMED" -eq 1 ]]; then
  # The remediation hint deliberately names the SUBCOMMAND without its binary: EDMV4-T11 AC5
  # requires this script to invoke the state binary zero times, and the assertion behind it
  # greps non-comment lines for that binary's name -- a literal mention inside this message
  # would trip it exactly the way CA-009's explanatory comment once did.
  echo "edm-gateguard: Phase 6 marker ${MARKER_PATH} is malformed (expected PREFIX<TAB>initiative_dir<TAB>started_at) -- enforcing the gate rather than reading it as stale; re-run 'phase-start <PREFIX> 6' to rewrite it" >&2
else
  MARKER_REST="${MARKER_LINE#*$'\t'}"
  MARKER_INITIATIVE_DIR="${MARKER_REST%%$'\t'*}"
  # CA-081: only an ABSOLUTE recorded directory can be tested from here. This hook runs with the
  # host's cwd, which is not the cwd `phase-start 6` ran in, so a RELATIVE second field re-resolved
  # against this process's cwd appeared missing from any other directory or git worktree -- the
  # marker read as stale and the gate exited 0, silently disabling the whole gated path.
  # bin/edm-state now records an absolute path; this arm handles a marker written before that fix
  # (or by hand) by resolving it against CLAUDE_PROJECT_DIR when the host supplied one, and
  # otherwise declining to test it at all. Declining fails CLOSED (the gate continues to its
  # ordinary allow/deny below) -- treating an untestable path as missing is the fail-OPEN direction
  # this finding is about.
  case "$MARKER_INITIATIVE_DIR" in
    ""|/*) ;;
    *)
      if [[ -n "${CLAUDE_PROJECT_DIR:-}" ]]; then
        MARKER_INITIATIVE_DIR="${CLAUDE_PROJECT_DIR%/}/${MARKER_INITIATIVE_DIR}"
      else
        MARKER_INITIATIVE_DIR=""
      fi
      ;;
  esac
  if [[ -n "$MARKER_INITIATIVE_DIR" ]] && [[ ! -d "$MARKER_INITIATIVE_DIR" ]]; then
    exit 0
  fi
fi

# Gated path: a Phase 6 marker exists for this project. Everything below this line is the only
# place a JSON parser is a legitimate dependency (AD3's qualifier) -- nothing above ever
# references one, so a repository with no active Phase 6 initiative never spawns a parser.

command -v jq >/dev/null 2>&1 \
  || die "a JSON parser is required once a Phase 6 marker is present (the allow path above needed none)"

# `read -d ''` is a bash builtin -- reads stdin to EOF with no subprocess spawned.
PAYLOAD=""
IFS= read -r -d '' PAYLOAD || true

if [[ -z "$PAYLOAD" ]]; then
  die "no payload was delivered on stdin -- edm-gateguard expects the host's PreToolUse JSON document"
fi

if ! TOOL_NAME="$(printf '%s' "$PAYLOAD" | jq -r '.tool_name // empty' 2>/dev/null)"; then
  die "could not parse the JSON payload delivered on stdin"
fi

# EDMV4-T13: the single decision-emitting function. Every deny/allow on this gated path is
# emitted from here and nowhere else -- T14's fact content and T15's operational controls both
# call INTO this function; neither grows a second, competing decision site.

# Set from Spike B's recorded outcome (decisions.md D26): the JSON hookSpecificOutput mechanism
# denied both Edit and Write cleanly; the exit-2-plus-stderr mechanism also denied both but leaked
# the hook's shell command text into the transcript. MultiEdit was UNTESTABLE on that host and is
# not evidence either way. This one constant is the whole lever if that evidence is superseded.
EDM_GATEGUARD_DENY_MODE_DEFAULT="json"

# emit_decision <allow|deny> [<reason>] -- the ONLY place that prints a decision payload or exits
# with a decision-carrying status (0 for allow and for a json-mode deny; 2 for an exit-code-mode
# deny, the code `edm-lint-staged-artifacts` already spends to mean "block"). EDM_GATEGUARD_DENY_MODE
# selects the back-end; any other value is a setup error (CA-298), regardless of the decision.
emit_decision() {
  local decision="$1"
  local reason="${2:-}"
  # EDMV4-T52 AC6: sanitize BEFORE anything else touches $reason, including the `jq -cn --arg`
  # call the json back-end makes below. $reason is built from gg_build_facts() (which
  # interpolates the target file path verbatim) and/or a matched hookify rule's own message text
  # (EDMV4-T45's allow-path wiring) -- both originate outside this plugin, from a repository or a
  # rule author this gate has no control over, and a repository path may legitimately contain a
  # non-ASCII byte. Every byte outside tab/CR/LF and the printable ASCII range 0x20-0x7E is
  # replaced with '?' rather than dropped, so the fact count and line structure of the surrounding
  # denial text is unchanged. Sanitizing FIRST also protects the JSON control channel (AC7): jq
  # requires valid UTF-8 input, so a raw non-ASCII byte reaching `jq -cn --arg` risks the whole
  # emission failing outright -- a broken control channel is a worse defect than the byte it would
  # have removed, per this ticket's own Description.
  reason="$(printf '%s' "$reason" | LC_ALL=C tr -c '\011\012\015\040-\176' '?')"
  local mode="${EDM_GATEGUARD_DENY_MODE:-$EDM_GATEGUARD_DENY_MODE_DEFAULT}"

  case "$mode" in
    json|exit-code) : ;;
    *)
      die "EDM_GATEGUARD_DENY_MODE must be 'json' or 'exit-code' (got: '${mode}')"
      ;;
  esac

  case "$decision" in
    allow)
      exit 0
      ;;
    deny)
      case "$mode" in
        json)
          # AC8: built with `jq -cn`, never string concatenation, so embedded quotes/backslashes/
          # newlines in $reason are escaped correctly. `-c` (compact) matches AC2's single-line form.
          jq -cn --arg reason "$reason" \
            '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":$reason}}'
          exit 0
          ;;
        exit-code)
          # AC3: the fact list goes to stderr as plain text -- no JSON, no escaping concern.
          printf '%s\n' "$reason" >&2
          exit 2
          ;;
      esac
      ;;
    *)
      die "emit_decision: unknown decision '${decision}' (expected 'allow' or 'deny')"
      ;;
  esac
}

# ---- EDMV4-T15: session-state directory. EDM_GATEGUARD_STATE_DIR overrides edm_data_dir()'s own
# resolution entirely when set, independent of the marker's own data-directory chain, so an
# operator (or a test) can redirect session state without touching where the marker itself lives.
gg_state_dir() {
  if [[ -n "${EDM_GATEGUARD_STATE_DIR:-}" ]]; then
    printf '%s\n' "${EDM_GATEGUARD_STATE_DIR%/}"
    return 0
  fi
  local data
  data="$(edm_data_dir)"
  [[ -n "$data" ]] || { printf '%s\n' ""; return 0; }
  printf '%s\n' "${data}/run"
}

GG_STATE_DIR=""
declare -F edm_data_dir >/dev/null 2>&1 && GG_STATE_DIR="$(gg_state_dir)"
GG_PROJECT_KEY=""
declare -F edm_project_key >/dev/null 2>&1 && GG_PROJECT_KEY="$(edm_project_key)"
GG_CHECKED_FILE="" GG_DENIALS_FILE=""
if [[ -n "$GG_STATE_DIR" && -n "$GG_PROJECT_KEY" ]]; then
  GG_CHECKED_FILE="${GG_STATE_DIR}/${GG_PROJECT_KEY}.checked"
  GG_DENIALS_FILE="${GG_STATE_DIR}/${GG_PROJECT_KEY}.denials"
fi
# CA-009: validate rather than let a non-numeric value reach the arithmetic comparison in
# gg_maybe_deny (`[[ "$(gg_denial_count)" -ge "$GG_MAX_DENIALS" ]]`). Bash arithmetic evaluates a
# non-numeric operand as 0 -- `[[ "0" -ge "none" ]]` is true -- so an unvalidated
# EDM_GATEGUARD_MAX_DENIALS=none made the FIRST call read the budget as already spent and allow
# every edit while printing "denial budget reached", the opposite of the fail-closed default. Same
# `''|*[!0-9]*` shape edm-state's to_int() uses, but this warns on stderr rather than silently
# coercing (do not silently coerce -- the operator should know their setting was ignored).
GG_MAX_DENIALS_RAW="${EDM_GATEGUARD_MAX_DENIALS:-3}"
case "$GG_MAX_DENIALS_RAW" in
  ''|*[!0-9]*)
    echo "edm-gateguard: EDM_GATEGUARD_MAX_DENIALS must be a non-negative integer (got: '${GG_MAX_DENIALS_RAW}') -- falling back to the default of 3" >&2
    GG_MAX_DENIALS=3
    ;;
  *)
    GG_MAX_DENIALS="$GG_MAX_DENIALS_RAW"
    ;;
esac
GG_STALE_SECONDS=1800

# CA-084: the denial budget is keyed per SESSION -- which is what EDMV4-T15 AC8 and CLAUDE.md's
# EDM_GATEGUARD_MAX_DENIALS bullet have always claimed, and what a per-PROJECT key made untrue the
# moment a wave ran 6-10 implementers against one 3-denial budget. The host stamps session_id on
# every PreToolUse payload; absent it (a hand-driven invocation, a fixture) the marker's own
# started_at field is the fallback session identity, so one Phase-6 run shares one budget and a
# later `phase-start 6` starts a fresh one. The key is written as a whole line into the denials
# file, so every byte outside a conservative set is folded to `_` -- a newline inside it would
# otherwise split into two records and inflate the count.
GG_SESSION_KEY=""
GG_SESSION_KEY="$(printf '%s' "$PAYLOAD" | jq -r '.session_id // empty' 2>/dev/null)" || GG_SESSION_KEY=""
[[ -n "$GG_SESSION_KEY" ]] || GG_SESSION_KEY="${MARKER_LINE##*$'\t'}"
[[ -n "$GG_SESSION_KEY" ]] || GG_SESSION_KEY="default"
GG_SESSION_KEY="${GG_SESSION_KEY//[^A-Za-z0-9._:-]/_}"

# ---- CA-083/CA-084/CA-085/CA-101: session-state concurrency. This hook fires on every Edit and
# Write, and Phase 6 runs 6-10 implementers in parallel, so concurrent invocation is this gate's
# NORMAL operating mode, not a corner case. gg_mark_checked was an unlocked read-modify-write, so
# two parallel hooks lost one another's entry and a file already investigated was denied a second
# time; gg_record_denial had the same shape plus the per-project key above; and both staged through
# a fully predictable `${file}.tmp.$$` written with a truncating `>` and no trap.
GG_LOCK_STALE_SECONDS=60
GG_LOCK_TRIES=60
GG_LOCKDIR="" GG_TMPFILE=""

# gg_mtime <path> -- portable mtime: GNU `stat -c %Y`, BSD `stat -f %m` (`find` is outside the
# required-binary set). Sole owner of that fallback pair in this file.
gg_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || true
}

# CA-101: the trap layer both the lock and the staging file rely on. Non-local variables on
# purpose -- the bodies expand them at SIGNAL time, when a function-local would already be popped
# (the hazard bin/tests/_harness.sh documents and bin/edm-state's CA-088 fix closes on its side).
gg_cleanup() {
  [[ -n "$GG_TMPFILE" ]] && rm -f "$GG_TMPFILE" 2>/dev/null
  [[ -n "$GG_LOCKDIR" ]] && rm -rf "$GG_LOCKDIR" 2>/dev/null
  return 0
}
gg_arm_traps() {
  trap 'gg_cleanup' EXIT
  trap 'gg_cleanup; exit 130' INT
  trap 'gg_cleanup; exit 143' TERM
  trap 'gg_cleanup; exit 129' HUP
}

# gg_lock <lockdir> -- best-effort mkdir spin lock (atomic on every local filesystem; the same
# primitive bin/edm-state's with_state_lock falls back to when flock is absent). Returns non-zero
# rather than blocking forever: a gate that cannot take the lock still must not deny an edit, so
# every caller proceeds UNLOCKED on failure -- which is exactly the pre-fix behaviour, never worse.
# A holder killed mid-write would otherwise wedge every later hook, so a lockdir older than
# GG_LOCK_STALE_SECONDS is broken once, loudly, and the acquisition retried exactly once more.
gg_lock() {
  local d="$1" i=0 broke=0 age now
  while ! mkdir "$d" 2>/dev/null; do
    i=$((i + 1))
    if [[ $i -ge $GG_LOCK_TRIES ]]; then
      [[ $broke -eq 0 ]] || return 1
      age="$(gg_mtime "$d")"
      now="$(date +%s)"
      if [[ -n "$age" ]] && (( now - age > GG_LOCK_STALE_SECONDS )); then
        echo "edm-gateguard: breaking session-state lock ${d}, held longer than ${GG_LOCK_STALE_SECONDS}s (its holder is gone)" >&2
        rm -rf "$d" 2>/dev/null || true
        broke=1
        i=0
        continue
      fi
      return 1
    fi
    sleep 0.02
  done
  GG_LOCKDIR="$d"
  gg_arm_traps
  return 0
}

gg_unlock() {
  [[ -n "$GG_LOCKDIR" ]] || return 0
  rm -rf "$GG_LOCKDIR" 2>/dev/null || true
  GG_LOCKDIR=""
  return 0
}

# gg_fresh_lines <path> -- prints <path>'s lines within the last 30 minutes' mtime; otherwise
# prints nothing (stale reads as empty) and best-effort removes it (EDMV4-T15 AC6).
gg_fresh_lines() {
  local path="$1"
  [[ -n "$path" && -f "$path" ]] || return 0
  local mtime=""
  mtime="$(gg_mtime "$path")"
  [[ -n "$mtime" ]] || return 0
  local now; now="$(date +%s)"
  if (( now - mtime > GG_STALE_SECONDS )); then
    # CA-085: re-read the mtime immediately before the unlink. A concurrent writer that refreshed
    # this file between the read above and the removal had its state deleted outright. Re-reading
    # narrows that window to the gap between two syscalls, and a file that turns out to have moved
    # is not stale after all -- fall through and read it. The window is NARROWED, not closed: an
    # unlink cannot be made atomic against a separate stat under this plugin's required-binary set.
    # The residual costs at most one extra denial (a re-forced fact list), never a wrong allow.
    local mtime2=""
    mtime2="$(gg_mtime "$path")"
    if [[ "$mtime2" == "$mtime" ]]; then
      rm -f "$path" 2>/dev/null || true
      return 0
    fi
  fi
  cat "$path" 2>/dev/null || true
}

# gg_is_checked <file_path> -- true if <file_path> is present in the (fresh) checked-file.
gg_is_checked() {
  local target="$1"
  [[ -n "$GG_CHECKED_FILE" ]] || return 1
  gg_fresh_lines "$GG_CHECKED_FILE" | grep -Fxq -- "$target"
}

# gg_mark_checked <file_path> -- records <file_path> checked so a retry allows, capped at 500
# entries oldest-first (AC6). A write failure warns on stderr naming EDM_GATEGUARD_STATE_DIR and
# returns non-zero so the caller (gg_maybe_deny) allows this call rather than denying it (AC7,
# CA-001) -- a gate that cannot record what it has already asked for must not deny the same edit
# forever. An unresolvable session-state location ($GG_CHECKED_FILE empty -- no data directory at
# all, not a write failure against one that exists) is a distinct, pre-existing case and stays a
# silent no-op return 0: there is nothing to warn about naming a variable that resolved to nothing.
gg_mark_checked() {
  local target="$1"
  [[ -n "$GG_CHECKED_FILE" ]] || return 0
  if ! mkdir -p "$(dirname "$GG_CHECKED_FILE")" 2>/dev/null; then
    echo "edm-gateguard: could not create the session-state directory (EDM_GATEGUARD_STATE_DIR=${EDM_GATEGUARD_STATE_DIR:-<unset>}) -- allowing this call rather than denying with nothing recorded" >&2
    return 1
  fi
  # CA-083: the read-modify-write below runs under a lock. Two parallel Edit hooks previously lost
  # one another's entry, so a path one of them had already forced facts for was denied a second
  # time -- the common case at 6-10 implementers, not the corner case. A lock that cannot be taken
  # is NOT a reason to deny (AC7/CA-001): fall through unlocked, i.e. the pre-fix behaviour.
  gg_lock "${GG_CHECKED_FILE}.lockd" || true
  local existing tmp
  existing="$(gg_fresh_lines "$GG_CHECKED_FILE")"
  # CA-101: mktemp, never `${file}.tmp.$$`. The PID-derived name is fully predictable, and
  # EDM_GATEGUARD_STATE_DIR, CLAUDE_PLUGIN_DATA and XDG_DATA_HOME can each steer this directory
  # into a shared /tmp where another local user pre-plants a symlink at that name -- which the old
  # truncating `>` followed and truncated. Template form with no suffix after the X run: BSD mktemp
  # rejects a suffix. This is bin/edm-state's write_atomic shape, the family standard this file
  # diverged from; gg_arm_traps covers the staging file on INT/TERM/HUP/EXIT.
  tmp=""
  tmp="$(mktemp "${GG_CHECKED_FILE}.tmp.XXXXXX" 2>/dev/null)" || tmp=""
  if [[ -z "$tmp" ]]; then
    gg_unlock
    echo "edm-gateguard: could not stage session state (EDM_GATEGUARD_STATE_DIR=${EDM_GATEGUARD_STATE_DIR:-<unset>}) -- allowing this call rather than denying with nothing recorded" >&2
    return 1
  fi
  GG_TMPFILE="$tmp"
  gg_arm_traps
  if { printf '%s\n' "$existing"; printf '%s\n' "$target"; } | grep -v '^$' | tail -n 500 > "$tmp" 2>/dev/null \
      && mv "$tmp" "$GG_CHECKED_FILE" 2>/dev/null; then
    GG_TMPFILE=""
    gg_unlock
  else
    rm -f "$tmp" 2>/dev/null || true
    GG_TMPFILE=""
    gg_unlock
    echo "edm-gateguard: could not write session state (EDM_GATEGUARD_STATE_DIR=${EDM_GATEGUARD_STATE_DIR:-<unset>}) -- allowing this call rather than denying with nothing recorded" >&2
    return 1
  fi
}

# gg_denial_count -- number of fresh (non-stale) full-denial records for THIS session (CA-084).
# Each record is the session key on its own line, so counting exact matches scopes the budget to
# one session while leaving sibling sessions' records in the same file untouched -- which is what
# keeps EDM_GATEGUARD_STATE_DIR's documented `<override>/<project-key>.denials` path unchanged.
gg_denial_count() {
  [[ -n "$GG_DENIALS_FILE" ]] || { echo 0; return 0; }
  gg_fresh_lines "$GG_DENIALS_FILE" | grep -cFx -- "$GG_SESSION_KEY" || true
}

# gg_record_denial -- appends one denial record, best-effort (AC8's budget counter). Shares the
# checked-file's 30-minute staleness rule, so the budget cannot outlive the wave it bounds. A
# write failure here warns on stderr naming EDM_GATEGUARD_STATE_DIR but never changes the
# decision already made (unlike gg_mark_checked, this only runs after gg_maybe_deny has already
# committed to denying) -- it just means the budget undercounts for this call.
gg_record_denial() {
  [[ -n "$GG_DENIALS_FILE" ]] || return 0
  if ! mkdir -p "$(dirname "$GG_DENIALS_FILE")" 2>/dev/null; then
    echo "edm-gateguard: could not create the session-state directory (EDM_GATEGUARD_STATE_DIR=${EDM_GATEGUARD_STATE_DIR:-<unset>}) -- the denial budget will not be counted for this call" >&2
    return 0
  fi
  # CA-084/CA-101: one atomic APPEND, not a read-modify-write through a predictable temp file. A
  # single short write through an O_APPEND descriptor is not interleaved with a concurrent
  # appender's on a local filesystem, so this needs no lock and cannot lose a sibling hook's record
  # the way the old read-then-rewrite did -- and with no staging file there is no symlink-plant
  # target either. gg_fresh_lines first so a file past the 30-minute staleness cap is dropped
  # rather than resurrected by the append refreshing its mtime; that function stays the single
  # owner of the staleness decision (AC8's "the budget cannot outlive the wave it bounds").
  gg_fresh_lines "$GG_DENIALS_FILE" >/dev/null
  if ! printf '%s\n' "$GG_SESSION_KEY" >> "$GG_DENIALS_FILE" 2>/dev/null; then
    echo "edm-gateguard: could not write session state (EDM_GATEGUARD_STATE_DIR=${EDM_GATEGUARD_STATE_DIR:-<unset>}) -- the denial budget will not be counted for this call" >&2
  fi
}

# ---- EDMV4-T15 AC4/AC5: exempt-glob matching. ECC's unanchored substring matcher makes
# `**/tests/**` match `/repo/tests/x.js` but not the bare relative `tests/x.js` -- this tests ONE
# glob in two normalized shapes instead of requiring two entries: `**` becomes a plain `*` (which,
# inside a `case` pattern, already matches `/`), tested as-is (covers an absolute path) and with a
# leading `*/` stripped (covers the bare relative form, which has no leading segment to consume).
GG_EXEMPT_GLOBS_DEFAULT="**/SRD/**,**/tests/**,**/test/**,**/__tests__/**,**/dist/**,**/build/**,**/node_modules/**,**/.git/**"
gg_is_exempt() {
  local path="$1"
  local globs="${EDM_GATEGUARD_EXEMPT_GLOBS:-$GG_EXEMPT_GLOBS_DEFAULT}"
  local saved_ifs="$IFS"
  IFS=','
  local -a glob_list
  # shellcheck disable=SC2206 # intentional word-split on IFS=, -- see the comment above this array
  glob_list=($globs)
  IFS="$saved_ifs"
  local g gg stripped
  for g in "${glob_list[@]}"; do
    [[ -z "$g" ]] && continue
    gg="${g//\*\*/*}"
    case "$path" in
      $gg) return 0 ;;
    esac
    stripped="${gg#\*/}"
    case "$path" in
      $stripped) return 0 ;;
    esac
  done
  return 1
}

# gg_build_facts <edit|write> <path> -- the four numbered facts a denial forces (T14 AC1/AC2).
# Facts 3/4 are byte-identical between variants; only 1/2 swap. Fact 4 asks for the ticket's own
# AC, by ID, never the user's current instruction (AC3). Wording is EDM's own (AC7).
gg_build_facts() {
  local kind="$1" path="$2"
  local fact1 fact2
  if [[ "$kind" == "write" ]]; then
    fact1="1. Name the file(s) and line(s) that will call this new file (${path})."
    fact2="2. Confirm no existing file already serves the same purpose as this new file."
  else
    fact1="1. List all files that import or require this file (${path}), searching the tree."
    fact2="2. List the public functions or classes affected by this change."
  fi
  printf '%s\n%s\n%s\n%s' \
    "$fact1" \
    "$fact2" \
    "3. If this file reads or writes data files, show field names, structure and date format using redacted or synthetic values -- never raw production data." \
    "4. Quote the acceptance criteria of the ticket being implemented, by its {PREFIX}-T{NN} ID."
}

# gg_maybe_deny <edit|write> <path> -- the one shared decision path every case arm calls into, so
# exemption/checked/budget ordering lives in one place. An empty/exempt/already-checked path falls
# through silently. A first-touch path denies UNLESS the denial budget is spent (AC8), in which
# case a stderr advisory prints and this falls through to allow -- deliberately without marking
# the path checked, so the next call still advises rather than treating budget exhaustion as an
# earned investigation pass. CA-001/AC7: a state-write failure (gg_mark_checked returning
# non-zero) also falls through to allow, BEFORE gg_record_denial or emit_decision deny run -- a
# gate that cannot record what it has already asked for must not deny the same edit forever.
# gg_mark_checked has already printed its own stderr warning naming EDM_GATEGUARD_STATE_DIR.
gg_maybe_deny() {
  local kind="$1" path="$2"
  [[ -n "$path" ]] || return 0
  gg_is_exempt "$path" && return 0
  gg_is_checked "$path" && return 0
  if [[ "$(gg_denial_count)" -ge "$GG_MAX_DENIALS" ]]; then
    echo "edm-gateguard: denial budget (${GG_MAX_DENIALS}) reached for this session -- allowing '${path}' without a fresh denial" >&2
    return 0
  fi
  gg_mark_checked "$path" || return 0
  gg_record_denial
  emit_decision deny "$(gg_build_facts "$kind" "$path")"
}

# ---- Dispatch on tool name. Bash 3.2 floor (C1): a `case` over a small, fixed name set is the
# portable form here, not an associative array keyed by tool name. -------------------------------
case "$TOOL_NAME" in
  Edit)
    GG_TARGET="$(printf '%s' "$PAYLOAD" | jq -r '.tool_input.file_path // empty' 2>/dev/null)"
    gg_maybe_deny edit "$GG_TARGET"
    ;;
  Write)
    GG_TARGET="$(printf '%s' "$PAYLOAD" | jq -r '.tool_input.file_path // empty' 2>/dev/null)"
    gg_maybe_deny write "$GG_TARGET"
    ;;
  MultiEdit)
    # EDMV4-T14 AC4/AC5. Tolerant of both the SRD's assumed multi-file batch shape
    # (edits[].file_path) and Claude Code's own single-file shape (tool_input.file_path plus
    # edits[] of old_string/new_string, no per-edit file_path) -- one de-duplicated list rather
    # than assuming either; the live shape could not be confirmed from this environment
    # (decisions.md records the restraint). Reuses the Edit fact set -- MultiEdit only ever
    # touches files that already exist.
    GG_MULTI_FILES="$(printf '%s' "$PAYLOAD" | jq -r '
      ([.tool_input.file_path] + [.tool_input.edits[]?.file_path?])
      | map(select(. != null and . != ""))
      | unique[]
    ' 2>/dev/null)"
    while IFS= read -r GG_TARGET; do
      gg_maybe_deny edit "$GG_TARGET"
    done <<< "$GG_MULTI_FILES"
    ;;
  *)
    # An unrecognized tool name on the gated path: allow rather than guess at a decision for a
    # case this gate was never registered against.
    : ;;
esac

# EDMV4-T45 AC1/AC7: file-event hookify rules evaluate ONLY here, on the allow path, reusing
# $PAYLOAD already parsed -- no second stdin read -- projected into the file-event field shape
# once per gated call regardless of tool name. Absent edm-hookify is a silent allow.
if command -v edm-hookify >/dev/null 2>&1; then
  GG_HOOKIFY_PAYLOAD="$(printf '%s' "$PAYLOAD" | jq -c '{
    file_path: (.tool_input.file_path // (.tool_input.edits[0].file_path // "")),
    old_text: (.tool_input.old_string // ([.tool_input.edits[]?.old_string?] | map(select(.!=null)) | join("\n"))),
    new_text: (.tool_input.new_string // .tool_input.content // ([.tool_input.edits[]?.new_string?] | map(select(.!=null)) | join("\n"))),
    content: (.tool_input.content // "")
  }' 2>/dev/null)"
  GG_HOOKIFY_RC=0
  GG_HOOKIFY_OUT="$(printf '%s' "$GG_HOOKIFY_PAYLOAD" | edm-hookify eval file)" || GG_HOOKIFY_RC=$?
  # T44 AC4/AC5: hookify's block code becomes a refusal through THIS script's own emit_decision
  # (AD2); hookify's setup-error code never escalates (it already warned on stderr); a clean run
  # falls through unchanged.
  [[ "$GG_HOOKIFY_RC" -eq 2 ]] && emit_decision deny "$GG_HOOKIFY_OUT"
fi

# Every branch above allows silently once every path in scope is already checked (or exempt, or
# budget-exhausted, or the tool name is one this gate does not target) -- via emit_decision, not a
# bare `exit 0`. Performance reference: allow path (marker absent) targets 50 ms p95 over 20
# samples, measured by `bin/tests/timing.sh --gateguard` against a generated fixture.
emit_decision allow ""
