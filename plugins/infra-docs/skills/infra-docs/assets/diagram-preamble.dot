// Shared Graphviz preamble for Scripps infrastructure diagrams.
// Copy these attribute blocks into a new .dot so diagrams look like each other.
//
// Palette matches the Confluence/Atlassian tokens used on the pages:
//   neutral  fill #F4F5F7  border #8993A4
//   primary  fill #DEEBFF  border #0747A6   (us-east-2 / primary region)
//   dr       fill #EAE6FF  border #403294   (us-west-2 / DR region)
//   firewall fill #FFEBE6  border #BF2600
//   allow    fill #E3FCEF  border #006644
//   caution  fill #FFFAE6  border #FF991F
//
// Always: rankdir=TB unless LR demonstrably reads better, and check the ratio.

digraph example {
  rankdir=TB;
  compound=true;              // required before lhead/ltail cluster clipping works
  bgcolor="white";
  fontname="Arial,Helvetica,sans-serif";

  node [shape=box style="rounded,filled" fontname="Arial,Helvetica,sans-serif" fontsize=11
        color="#8993A4" fillcolor="#F4F5F7" fontcolor="#172B4D" margin="0.16,0.10"];
  edge [fontname="Arial,Helvetica,sans-serif" fontsize=9 color="#5E6C84" fontcolor="#42526E" arrowsize=0.7];

  subgraph cluster_primary {          // name MUST start with cluster_ to draw a box
    label=<<b>us-east-2 (Ohio) — PRIMARY</b>>;
    fontsize=12; style="rounded,filled"; fillcolor="#FAFBFC"; color="#0747A6"; penwidth=1.4;
    node [fillcolor="#DEEBFF" color="#0747A6"];
    a [label=<<b>Bold title</b><br/><font point-size="9">detail line</font>>];
  }

  subgraph cluster_dr {
    label=<<b>us-west-2 (Oregon) — DR</b>>;
    fontsize=12; style="rounded,filled"; fillcolor="#FAFBFC"; color="#403294"; penwidth=1.4;
    node [fillcolor="#EAE6FF" color="#403294"];
    b [label="Node"];
  }

  // constraint=false keeps an edge from driving rank — use for peering links and
  // return paths that would otherwise distort the layout.
  a -> b [dir=both penwidth=1.6 color="#0747A6" constraint=false label="peering"];

  // NEVER declare rank=same at graph level: it pulls nodes out of their clusters and
  // crashes the layout with an assertion in mincross.c.
}
