#!/usr/bin/env bash
# edm-state - read/write SRD/{PREFIX}/.edm-state.json files for the EDM plugin.
# Usage:
#   edm-state get <PREFIX>                              # print state JSON
#   edm-state set <PREFIX> <key> <value>                # set a top-level field (typed for known fields)
#   edm-state list                                      # list in-progress initiatives
#   edm-state active-initiatives                        # list initiatives with current_phase in 1-6
#   edm-state init <PREFIX>                             # write a fresh state file
#   edm-state approve-gate <PREFIX> <gate-num>          # record a gate approval
#   edm-state phase-start <PREFIX> <phase-num>          # record phase start timestamp
#   edm-state phase-complete <PREFIX> <phase-num>       # record phase completion + duration
#   edm-state checkpoint-if-active                      # called by Stop/PreCompact hooks
#   edm-state record-task-duration                      # called by TaskCompleted hook (reserved no-op)
#   edm-state record-test-coverage <PREFIX> <layer> <pct>   # record coverage % for a test layer
#   edm-state record-tests-added <PREFIX> <phase> <layer> <count>  # record test count by layer
#   edm-state get-coverage <PREFIX>                     # print coverage summary for all layers
#   edm-state srd-version <PREFIX> <version>            # set the SRD version (e.g. 1.0.0, 1.1.0)
#   edm-state archive <PREFIX>                          # mark initiative complete (git-aware)
#   edm-state write-handoff <PREFIX>                    # write/refresh HANDOFF.md for cross-user resumption
#   edm-state watch-impl                                # tail git log for ticket commits (called by monitor)
#   edm-state metrics-report <PREFIX|--all|--calibrate>
#   edm-state validate <PREFIX>                         # check state file for anomalies (read-only)
#   edm-state gate-check <PREFIX> <gated-command>       # deterministic gate enforcement (read-only)
#   edm-state branch-check <PREFIX>                     # verify current git branch matches initiative_branch
#   edm-state git-lock-check                            # detect and remediate stale .git/index.lock
#   edm-state migrate-path --product <n> --description <s> <PREFIX>  # opt-in move to product-scoped layout
set -euo pipefail

SRD_ROOT="${EDM_SRD_ROOT:-${CLAUDE_PLUGIN_OPTION_SRD_ROOT:-./SRD}}"
SRD_FILENAME="${EDM_SRD_FILENAME:-${CLAUDE_PLUGIN_OPTION_SRD_FILENAME:-srd.md}}"
TICKET_PACK_DIRNAME="${EDM_TICKET_PACK_DIRNAME:-${CLAUDE_PLUGIN_OPTION_TICKET_PACK_DIRNAME:-tickets}}"
HUMAN_HOURLY_RATE_USD="${EDM_HUMAN_HOURLY_RATE_USD:-${CLAUDE_PLUGIN_OPTION_HUMAN_HOURLY_RATE_USD:-150}}"

die() { echo "edm-state: $*" >&2; exit 1; }

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required (install: brew install jq / apt install jq)"
}

# Compute a stable hash of a file. Returns "absent" if the file doesn't exist.
# Tries sha256sum (Linux), then shasum -a 256 (macOS), then md5sum/md5 as last resort.
artifact_hash() {
  local file="$1"
  [[ -f "$file" ]] || { echo "absent"; return 0; }
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | cut -d' ' -f1
  elif command -v md5sum >/dev/null 2>&1; then
    md5sum "$file" | cut -d' ' -f1
  else
    md5 -q "$file" 2>/dev/null || echo "unhashable"
  fi
}

# Record the current hash of a named artifact into .edm-state.json.
# artifact_name: a stable key like "srd" or "tickets"
# file_path: the actual file to hash
record_artifact_hash() {
  local prefix="$1" artifact_name="$2" file_path="$3"
  require_jq
  local hash t current new
  hash="$(artifact_hash "$file_path")"
  t="$(now_utc)"
  current="$(read_state "$prefix")"
  new="$(echo "$current" | jq \
    --arg name "$artifact_name" \
    --arg hash "$hash" \
    --arg path "$file_path" \
    --arg t "$t" '
    .artifact_hashes[$name] = {hash: $hash, path: $path, recorded_at: $t}
    | .last_updated = $t
  ')"
  write_state "$prefix" "$new"
}

# initiative_dir_for <PREFIX>
# Returns the initiative directory path (without /.edm-state.json).
# Delegates to state_file_for for layout resolution.
initiative_dir_for() {
  local state_file
  state_file="$(state_file_for "$1")"
  echo "${state_file%/.edm-state.json}"
}

# state_file_for <PREFIX>
# Single source of layout truth (SRD section 5.4). Resolves the .edm-state.json
# path for a given PREFIX under both the legacy flat layout and the new
# product-scoped layout (SRD/{PRODUCT}/{PREFIX}__{DESCRIPTION}/).
#
# Resolution order (first match wins):
#   1. Existing flat file   SRD/{PREFIX}/.edm-state.json          (AC2 backward compat)
#   2. Existing product dir SRD/*/{PREFIX}__*/.edm-state.json     (AC1 on-disk discovery)
#   3. Env vars EDM_PRODUCT + EDM_DESCRIPTION                     (AC1 pre-init compute)
#   4. Env var  EDM_PRODUCT only (glob within product)            (AC6)
#   5. Flat default (safe fallback for pre-init / legacy)         (AC5)
state_file_for() {
  local prefix="$1"
  local flat_path="${SRD_ROOT}/${prefix}/.edm-state.json"

  # AC2: Legacy flat state file already exists — keep its path unchanged.
  [[ -f "$flat_path" ]] && echo "$flat_path" && return 0

  # AC1/AC6: Product-scoped directory already exists on disk.
  local matches=()
  local dir
  for dir in "${SRD_ROOT}"/*/"${prefix}"__*/; do
    # Strip trailing slash from glob expansion
    dir="${dir%/}"
    [[ -d "$dir" ]] && [[ -f "${dir}/.edm-state.json" ]] && matches+=("${dir}/.edm-state.json")
  done
  if [[ ${#matches[@]} -eq 1 ]]; then
    echo "${matches[0]}"
    return 0
  elif [[ ${#matches[@]} -gt 1 ]]; then
    echo "edm-state: WARNING: multiple product-scoped directories for ${prefix}; using first match" >&2
    echo "${matches[0]}"
    return 0
  fi

  # AC1: Compute product-scoped path from env vars when no on-disk match found.
  local product="${EDM_PRODUCT:-}"
  local description="${EDM_DESCRIPTION:-}"
  if [[ -n "$product" && -n "$description" ]]; then
    echo "${SRD_ROOT}/${product}/${prefix}__${description}/.edm-state.json"
    return 0
  fi

  # AC6: Product known but description unknown — glob within product directory.
  if [[ -n "$product" ]]; then
    for dir in "${SRD_ROOT}/${product}/${prefix}__"*/; do
      dir="${dir%/}"
      [[ -d "$dir" ]] && echo "${dir}/.edm-state.json" && return 0
    done
  fi

  # AC5: Default flat path (pre-init or legacy initiative with no existing file).
  echo "$flat_path"
}

# ---- Cost tracking ---------------------------------------------------------
# Token usage is read from Claude Code session JSONL files at:
#   ~/.claude/projects/<encoded-cwd>/<session-id>.jsonl
# Each assistant message has .message.usage with input/output/cache token counts
# and .message.model identifying the model used.

session_dir_for_cwd() {
  local cwd
  cwd="$(pwd)"
  # Claude Code encodes the cwd by replacing both '/' and '.' with '-'
  echo "${HOME}/.claude/projects/$(echo "$cwd" | tr '/.' '-')"
}

# Sum cumulative tokens across all assistant messages in this project's sessions
# whose timestamp >= the given ISO 8601 time. Outputs JSON:
#   {input, output, cache_read, cache_write_5m, cache_write_1h, model}
# Cache writes are split by TTL because 5-min and 1-hour writes have different
# per-million-token rates.
get_session_tokens_since() {
  local since="$1"
  local sessions_dir
  sessions_dir="$(session_dir_for_cwd)"
  if [[ ! -d "$sessions_dir" ]] || ! ls "$sessions_dir"/*.jsonl >/dev/null 2>&1; then
    echo '{"input":0,"output":0,"cache_read":0,"cache_write_5m":0,"cache_write_1h":0,"model":"unknown"}'
    return 0
  fi
  cat "$sessions_dir"/*.jsonl 2>/dev/null | jq -s --arg since "$since" '
    [.[] | select(.type == "assistant" and (.timestamp // "") >= $since)] as $msgs |
    {
      input: ([$msgs[].message.usage.input_tokens // 0] | add // 0),
      output: ([$msgs[].message.usage.output_tokens // 0] | add // 0),
      cache_read: ([$msgs[].message.usage.cache_read_input_tokens // 0] | add // 0),
      cache_write_5m: ([$msgs[].message.usage.cache_creation.ephemeral_5m_input_tokens // 0] | add // 0),
      cache_write_1h: ([$msgs[].message.usage.cache_creation.ephemeral_1h_input_tokens // 0] | add // 0),
      model: ($msgs[-1].message.model // "unknown")
    }
  ' 2>/dev/null || echo '{"input":0,"output":0,"cache_read":0,"cache_write_5m":0,"cache_write_1h":0,"model":"unknown"}'
}

# Anthropic pricing per million tokens (USD), verified May 2026.
# https://docs.anthropic.com/en/docs/about-claude/pricing
# Override via env vars to track rate changes without modifying this script.
#   EDM_OPUS_INPUT_RATE, EDM_OPUS_OUTPUT_RATE,
#   EDM_OPUS_CACHE_READ_RATE, EDM_OPUS_CACHE_WRITE_5M_RATE, EDM_OPUS_CACHE_WRITE_1H_RATE
#   (likewise for SONNET, HAIKU)
compute_cost_usd() {
  local model="$1" input="$2" output="$3" cache_read="$4" cw5m="$5" cw1h="$6"
  local in_rate out_rate cr_rate cw5m_rate cw1h_rate
  case "$model" in
    *opus*)
      in_rate="${EDM_OPUS_INPUT_RATE:-5}"
      out_rate="${EDM_OPUS_OUTPUT_RATE:-25}"
      cr_rate="${EDM_OPUS_CACHE_READ_RATE:-0.50}"
      cw5m_rate="${EDM_OPUS_CACHE_WRITE_5M_RATE:-6.25}"
      cw1h_rate="${EDM_OPUS_CACHE_WRITE_1H_RATE:-10.00}"
      ;;
    *haiku*)
      in_rate="${EDM_HAIKU_INPUT_RATE:-1}"
      out_rate="${EDM_HAIKU_OUTPUT_RATE:-5}"
      cr_rate="${EDM_HAIKU_CACHE_READ_RATE:-0.10}"
      cw5m_rate="${EDM_HAIKU_CACHE_WRITE_5M_RATE:-1.25}"
      cw1h_rate="${EDM_HAIKU_CACHE_WRITE_1H_RATE:-2.00}"
      ;;
    *sonnet*|*)
      in_rate="${EDM_SONNET_INPUT_RATE:-3}"
      out_rate="${EDM_SONNET_OUTPUT_RATE:-15}"
      cr_rate="${EDM_SONNET_CACHE_READ_RATE:-0.30}"
      cw5m_rate="${EDM_SONNET_CACHE_WRITE_5M_RATE:-3.75}"
      cw1h_rate="${EDM_SONNET_CACHE_WRITE_1H_RATE:-6.00}"
      ;;
  esac
  awk -v i="$input" -v o="$output" -v cr="$cache_read" -v c5="$cw5m" -v c1="$cw1h" \
      -v ir="$in_rate" -v or="$out_rate" -v crr="$cr_rate" -v c5r="$cw5m_rate" -v c1r="$cw1h_rate" \
      'BEGIN { printf "%.4f", (i*ir + o*or + cr*crr + c5*c5r + c1*c1r) / 1000000 }'
}

# Estimate human cost (USD) for a phase given:
#   - phase number (1-6)
#   - initiative size (Small / Medium / Large)
# Uses the Phase Timing Guidelines hours x HUMAN_HOURLY_RATE_USD.
human_cost_for_phase() {
  local phase="$1" size="$2"
  local hours
  case "${size}-${phase}" in
    "Small-1")  hours=0.5  ;; "Small-2")  hours=2  ;; "Small-3")  hours=1   ;;
    "Small-4")  hours=1    ;; "Small-5")  hours=0.5;; "Small-6")  hours=6   ;;
    "Medium-1") hours=1    ;; "Medium-2") hours=4  ;; "Medium-3") hours=2   ;;
    "Medium-4") hours=3    ;; "Medium-5") hours=1  ;; "Medium-6") hours=18  ;;
    "Large-1")  hours=2    ;; "Large-2")  hours=8  ;; "Large-3")  hours=4   ;;
    "Large-4")  hours=6    ;; "Large-5")  hours=2  ;; "Large-6")  hours=36  ;;
    *)          hours=0    ;;
  esac
  awk -v h="$hours" -v r="$HUMAN_HOURLY_RATE_USD" 'BEGIN { printf "%.2f", h*r }'
}

read_state() {
  local prefix="$1"
  local f
  f="$(state_file_for "$prefix")"
  [[ -f "$f" ]] || die "no state file for $prefix at $f"
  cat "$f"
}

write_state() {
  local prefix="$1"
  local content="$2"
  local f lockbase
  f="$(state_file_for "$prefix")"
  lockbase="${f%.json}"
  mkdir -p "$(dirname "$f")"
  with_state_lock "$lockbase" printf '%s\n' "$content" > "$f"
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# ---- Advisory file locking (T24) -------------------------------------------
# with_state_lock <lockbase> <command...>
# Acquires an exclusive advisory lock scoped to <lockbase>, runs the command,
# then releases the lock. Uses flock(1) on <lockbase>.lock when available;
# falls back to a mkdir-based spin-lock on <lockbase>.lockd for macOS portability.
with_state_lock() {
  local lockbase="$1"; shift
  local lockfile="${lockbase}.lock"
  local lockdir="${lockbase}.lockd"
  local pidfile="${lockdir}/pid"

  if command -v flock >/dev/null 2>&1; then
    # Fast path: flock-based locking on FD 200
    (
      flock -w 10 200 || { echo "edm-state: state lock timeout after 10s on ${lockfile} (another edm-state process may be holding it)" >&2; exit 1; }
      "$@"
    ) 200>"${lockfile}"
  else
    # Fallback: mkdir-based spin-lock (POSIX-portable, atomic on local filesystems)
    local tries=0
    until mkdir "$lockdir" 2>/dev/null; do
      tries=$(( tries + 1 ))
      if [[ $tries -ge 50 ]]; then
        local holder_pid=""
        [[ -f "$pidfile" ]] && holder_pid="$(cat "$pidfile" 2>/dev/null || true)"
        die "state lock timeout after 50 tries on ${lockdir}${holder_pid:+ (held by PID ${holder_pid})}"
      fi
      sleep 0.1
    done
    echo $$ > "$pidfile" 2>/dev/null || true
    # shellcheck disable=SC2064
    trap "rm -rf '${lockdir}'" EXIT INT TERM HUP
    "$@"
    local ec=$?
    rm -rf "$lockdir"
    trap - EXIT INT TERM HUP
    return $ec
  fi
}

# ---- Type coercion helpers (T33) -------------------------------------------
# read_bool <json-string> <field> [<default>]
# Returns normalized bash boolean string "true" or "false" regardless of whether
# the field is stored as a JSON boolean or a JSON string.
read_bool() {
  local json="$1" field="$2" default="${3:-false}"
  echo "$json" | jq -r --arg f "$field" --arg d "$default" '
    (.[$f] // null) as $v |
    if $v == null then $d
    elif ($v | type) == "boolean" then (if $v then "true" else "false" end)
    elif ($v | type) == "string" then (if $v == "true" then "true" else "false" end)
    else $d
    end
  '
}

# read_num <json-string> <field> [<default>]
# Returns normalized number (integer or float) regardless of string vs number storage.
read_num() {
  local json="$1" field="$2" default="${3:-0}"
  echo "$json" | jq -r --arg f "$field" --arg d "$default" '
    (.[$f] // null) as $v |
    if $v == null then $d
    elif ($v | type) == "number" then $v
    elif ($v | type) == "string" then (($v | tonumber?) // ($d | tonumber))
    else $d
    end
  '
}

# ---- State anomaly detection (T29) -----------------------------------------
# state_anomalies <PREFIX>
# Reads state and emits zero or more anomaly lines. Each line has the form:
#   <CODE>  <affected-field>  <description>
# Exits 0 and emits nothing when no anomalies found. Never mutates state.
state_anomalies() {
  local prefix="$1"
  require_jq
  local state
  state="$(read_state "$prefix")"
  local found=0
  # TIME_ORDER: completed_at earlier than started_at within any phase entry
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    echo "$line"
    found=1
  done < <(echo "$state" | jq -r '
    .phase_durations // {} | to_entries[] |
    .key as $k | .value as $v |
    if ($v.started_at != null and $v.started_at != "" and
        $v.completed_at != null and $v.completed_at != "") then
      (($v.completed_at | fromdateiso8601?) // 0) as $c |
      (($v.started_at | fromdateiso8601?) // 0) as $s |
      if $c > 0 and $s > 0 and $c < $s then
        "TIME_ORDER  phase_durations.\($k)  completed_at (\($v.completed_at)) is earlier than started_at (\($v.started_at))"
      else empty end
    else empty end
  ' 2>/dev/null)
  # SIZE_UNKNOWN: estimated_size is "Unknown" and current_phase >= 2
  local phase size
  phase="$(echo "$state" | jq -r '.current_phase // 0')"
  size="$(echo "$state" | jq -r '.estimated_size // "Unknown"')"
  if [[ "$size" == "Unknown" && "$phase" -ge 2 ]]; then
    echo "SIZE_UNKNOWN  estimated_size  size is still Unknown at phase ${phase} (set via edm-state set ${prefix} estimated_size Small|Medium|Large)"
    found=1
  fi
  # ZERO_TOKENS: model_used is set but input+output tokens are both 0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    echo "$line"
    found=1
  done < <(echo "$state" | jq -r '
    .phase_durations // {} | to_entries[] |
    .key as $k | .value as $v |
    if ($v.model_used != null and $v.model_used != "" and $v.model_used != "unknown" and
        ($v.tokens.input // 0) == 0 and ($v.tokens.output // 0) == 0) then
      "ZERO_TOKENS  phase_durations.\($k).tokens  model_used is \($v.model_used) but both input and output tokens are 0"
    else empty end
  ' 2>/dev/null)
  return 0
}

cmd_get() {
  [[ $# -eq 1 ]] || die "usage: edm-state get <PREFIX>"
  read_state "$1"
}

cmd_set() {
  [[ $# -eq 3 ]] || die "usage: edm-state set <PREFIX> <key> <value>"
  require_jq
  local prefix="$1" key="$2" value="$3"
  local current new
  current="$(read_state "$prefix")"
  # Typed-set path: known fields with specific JSON types use --argjson with validation.
  case "$key" in
    compliance_enabled|code_audit_converged)
      # Boolean fields: accept exactly true or false
      [[ "$value" == "true" || "$value" == "false" ]] \
        || die "set: field '$key' requires a boolean value (true|false); got: $value"
      new="$(echo "$current" | jq --argjson v "$value" --arg k "$key" --arg t "$(now_utc)" '.[$k] = $v | .last_updated = $t')"
      ;;
    current_phase|qc_shard_threshold)
      # Number fields: must match numeric pattern
      [[ "$value" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] \
        || die "set: field '$key' requires a numeric value; got: $value"
      new="$(echo "$current" | jq --argjson v "$value" --arg k "$key" --arg t "$(now_utc)" '.[$k] = $v | .last_updated = $t')"
      ;;
    *)
      # Unknown/free-text fields: keep v1.x string behavior for backward compatibility
      new="$(echo "$current" | jq --arg k "$key" --arg v "$value" --arg t "$(now_utc)" '.[$k] = $v | .last_updated = $t')"
      ;;
  esac
  write_state "$prefix" "$new"
}

cmd_init() {
  [[ $# -eq 1 ]] || die "usage: edm-state init <PREFIX>"
  require_jq
  local prefix="$1"
  local f
  f="$(state_file_for "$prefix")"
  if [[ -f "$f" ]]; then
    echo "edm-state: state file already exists at $f" >&2
    return 0
  fi
  mkdir -p "$(dirname "$f")"
  local branch product description
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
  # Accept product/description from env so edm-init --product/--description can pre-seed them.
  product="${EDM_PRODUCT:-}"
  description="${EDM_DESCRIPTION:-}"
  jq -n --arg p "$prefix" --arg t "$(now_utc)" --arg b "$branch" \
        --arg prod "$product" --arg desc "$description" '{
    prefix: $p,
    current_phase: 0,
    gates_approved: [],
    artifacts: {},
    artifact_hashes: {},
    srd_version: "0.0.0",
    estimated_size: "Unknown",
    initiative_branch: $b,
    product_name: $prod,
    initiative_description: $desc,
    phase_durations: {},
    test_frameworks_detected: {},
    coverage_by_layer: {},
    code_audit_converged: false,
    last_updated: $t
  }' > "$f"
  echo "initialized $f"
}

cmd_list() {
  [[ -d "$SRD_ROOT" ]] || { echo "no SRD/ directory yet"; return 0; }
  require_jq
  local found=0
  # Collect state files from both flat (SRD/{PREFIX}/) and product-scoped
  # (SRD/{PRODUCT}/{PREFIX}__*/) layouts; de-duplicate by canonical path.
  local seen_paths=()
  local state
  for state in \
      "$SRD_ROOT"/*/.edm-state.json \
      "$SRD_ROOT"/*/*/.edm-state.json; do
    [[ -f "$state" ]] || continue
    # De-duplicate: skip if this path was already emitted.
    local already=0
    local seen
    for seen in "${seen_paths[@]+"${seen_paths[@]}"}"; do
      [[ "$seen" == "$state" ]] && already=1 && break
    done
    [[ $already -eq 1 ]] && continue
    seen_paths+=("$state")
    found=1
    local prefix phase gates last product description
    prefix="$(jq -r '.prefix // "unknown"' "$state" 2>/dev/null || echo unknown)"
    phase="$(jq -r '.current_phase // 0' "$state" 2>/dev/null || echo 0)"
    gates="$(jq -r '.gates_approved | length' "$state" 2>/dev/null || echo 0)"
    last="$(jq -r '.last_updated // "unknown"' "$state" 2>/dev/null || echo unknown)"
    product="$(jq -r '.product_name // ""' "$state" 2>/dev/null || true)"
    description="$(jq -r '.initiative_description // ""' "$state" 2>/dev/null || true)"
    if [[ -n "$product" || -n "$description" ]]; then
      printf "  %-12s  phase=%d  gates_approved=%d  last_updated=%s  product=%s  description=%s\n" \
        "$prefix" "$phase" "$gates" "$last" "${product:-(none)}" "${description:-(none)}"
    else
      printf "  %-12s  phase=%d  gates_approved=%d  last_updated=%s\n" "$prefix" "$phase" "$gates" "$last"
    fi
  done
  [[ $found -eq 1 ]] || echo "  (no in-progress initiatives)"
}

cmd_approve_gate() {
  [[ $# -eq 2 ]] || die "usage: edm-state approve-gate <PREFIX> <gate-num>"
  require_jq
  local prefix="$1" gate="$2"
  local current new approver
  current="$(read_state "$prefix")"
  approver="${USER:-unknown}"
  new="$(echo "$current" | jq --argjson g "$gate" --arg t "$(now_utc)" --arg a "$approver" '
    .gates_approved += [{gate: $g, approved_at: $t, approver: $a}]
    | .last_updated = $t
  ')"
  write_state "$prefix" "$new"
  echo "approved gate $gate for $prefix at $(now_utc)"
  write_handoff_internal "$prefix"
}

cmd_phase_start() {
  [[ $# -eq 2 ]] || die "usage: edm-state phase-start <PREFIX> <phase-num>"
  require_jq
  local prefix="$1" phase="$2"
  local current new key
  current="$(read_state "$prefix")"
  key="${phase}_phase"
  new="$(echo "$current" | jq --arg k "$key" --argjson p "$phase" --arg t "$(now_utc)" '
    .current_phase = $p
    | .phase_durations[$k] = ((.phase_durations[$k] // {}) + {started_at: $t})
    | .last_updated = $t
  ')"
  write_state "$prefix" "$new"
  write_handoff_internal "$prefix"
}

cmd_phase_complete() {
  [[ $# -eq 2 ]] || die "usage: edm-state phase-complete <PREFIX> <phase-num>"
  require_jq
  local prefix="$1" phase="$2"
  local current key started_at
  current="$(read_state "$prefix")"
  key="${phase}_phase"
  started_at="$(echo "$current" | jq -r --arg k "$key" '.phase_durations[$k].started_at // empty')"

  # Read token usage since phase start (if started_at is known)
  local tokens="" input=0 output=0 cache_read=0 cw5m=0 cw1h=0 model="unknown" cost="0.0000"
  if [[ -n "$started_at" ]]; then
    tokens="$(get_session_tokens_since "$started_at")"
    input="$(echo "$tokens" | jq -r '.input // 0')"
    output="$(echo "$tokens" | jq -r '.output // 0')"
    cache_read="$(echo "$tokens" | jq -r '.cache_read // 0')"
    cw5m="$(echo "$tokens" | jq -r '.cache_write_5m // 0')"
    cw1h="$(echo "$tokens" | jq -r '.cache_write_1h // 0')"
    model="$(echo "$tokens" | jq -r '.model // "unknown"')"
    cost="$(compute_cost_usd "$model" "$input" "$output" "$cache_read" "$cw5m" "$cw1h")"
  fi

  # Estimate human baseline cost for comparison
  local size human_cost
  size="$(echo "$current" | jq -r '.estimated_size // "Medium"')"
  human_cost="$(human_cost_for_phase "$phase" "$size")"

  local new
  new="$(echo "$current" | jq --arg k "$key" --arg t "$(now_utc)" \
            --argjson i "$input" --argjson o "$output" \
            --argjson cr "$cache_read" --argjson c5 "$cw5m" --argjson c1 "$cw1h" \
            --arg model "$model" --arg cost "$cost" --arg human_cost "$human_cost" '
    .phase_durations[$k] = (
      (.phase_durations[$k] // {})
      | . + {completed_at: $t}
      | . + {duration_seconds: (
          if .started_at then ((($t | fromdateiso8601) - (.started_at | fromdateiso8601))) else 0 end
        )}
      | . + {tokens: {input: $i, output: $o, cache_read: $cr, cache_write_5m: $c5, cache_write_1h: $c1}}
      | . + {model_used: $model}
      | . + {estimated_cost_usd: ($cost | tonumber)}
      | . + {human_baseline_usd: ($human_cost | tonumber)}
    )
    | .last_updated = $t
  ')"
  write_state "$prefix" "$new"

  # Record artifact hashes for phases that produce or revise gate-critical files.
  # Drift is detected in checkpoint-if-active by comparing these stored hashes to
  # what's currently on disk.
  local _dir
  _dir="$(initiative_dir_for "$prefix")"
  case "$phase" in
    2|3)
      local srd_path="${_dir}/${SRD_FILENAME}"
      [[ -f "$srd_path" ]] && record_artifact_hash "$prefix" "srd" "$srd_path" ;;
    4|5)
      local tickets_path="${_dir}/${TICKET_PACK_DIRNAME}/README.md"
      [[ -f "$tickets_path" ]] && record_artifact_hash "$prefix" "tickets" "$tickets_path" ;;
  esac

  write_handoff_internal "$prefix"
}

cmd_checkpoint() {
  # Called by Stop/PreCompact hooks. Touches last_updated and checks whether any
  # gate-critical artifacts (SRD, ticket pack) have changed since their last
  # recorded hash. Warnings are printed to stdout so Claude surfaces them.
  [[ -d "$SRD_ROOT" ]] || return 0
  require_jq
  for state in "$SRD_ROOT"/*/.edm-state.json; do
    [[ -f "$state" ]] || continue
    local current new prefix
    prefix="$(jq -r '.prefix' "$state" 2>/dev/null || echo unknown)"
    current="$(cat "$state")"
    new="$(echo "$current" | jq --arg t "$(now_utc)" '.last_updated = $t')"
    printf '%s\n' "$new" > "$state"

    # Drift detection - compare current file hashes to last recorded hashes.
    local hashes
    hashes="$(echo "$current" | jq -r '.artifact_hashes // {} | to_entries[] | "\(.key) \(.value.hash) \(.value.path) \(.value.recorded_at)"' 2>/dev/null || true)"
    local drift_found=0
    while IFS=' ' read -r artifact_name stored_hash file_path recorded_at; do
      [[ -n "$artifact_name" ]] || continue
      local current_hash
      current_hash="$(artifact_hash "$file_path")"
      if [[ "$current_hash" != "$stored_hash" && "$current_hash" != "absent" && "$current_hash" != "unhashable" ]]; then
        if [[ $drift_found -eq 0 ]]; then
          echo ""
          echo "(!) EDM drift detected - ${prefix}:"
          drift_found=1
        fi
        case "$artifact_name" in
          srd)
            local gate_status
            gate_status="$(echo "$current" | jq -r '
              (.gates_approved // []) | map(select(.gate == 2)) |
              if length > 0 then "Gate 2 was approved at \(.[0].approved_at)" else "Gate 2 not yet approved" end
            ' 2>/dev/null || echo "unknown gate status")"
            echo "  ${SRD_FILENAME} modified since last recorded at phase-complete (${recorded_at})."
            echo "  ${gate_status}."
            echo "  -> Re-run /edm:audit-srd ${prefix} and re-approve Gate 2 before creating tickets."
            ;;
          tickets)
            local gate_status
            gate_status="$(echo "$current" | jq -r '
              (.gates_approved // []) | map(select(.gate == 3)) |
              if length > 0 then "Gate 3 was approved at \(.[0].approved_at)" else "Gate 3 not yet approved" end
            ' 2>/dev/null || echo "unknown gate status")"
            echo "  Ticket pack README modified since last recorded at phase-complete (${recorded_at})."
            echo "  ${gate_status}."
            echo "  -> Re-run /edm:audit-tickets ${prefix} and re-approve Gate 3 before implementation."
            ;;
          *)
            echo "  ${artifact_name} (${file_path}) modified since last recorded at ${recorded_at}."
            ;;
        esac
      fi
    done <<< "$hashes"
    [[ $drift_found -eq 0 ]] || echo ""
    write_handoff_internal "$prefix"
  done
}

cmd_record_task_duration() {
  # Reserved no-op — TaskCompleted hook wires here but accumulation is not yet implemented.
  # The hook fires correctly and this function runs safely, but no durations are recorded.
  # Future work: parse stdin JSON from hook and accumulate per-task durations into state.
  return 0
}

cmd_record_test_coverage() {
  [[ $# -eq 3 ]] || die "usage: edm-state record-test-coverage <PREFIX> <layer> <pct>"
  require_jq
  local prefix="$1" layer="$2" pct="$3"
  local current new
  current="$(read_state "$prefix")"
  new="$(echo "$current" | jq --arg l "$layer" --argjson p "$pct" --arg t "$(now_utc)" '
    .coverage_by_layer[$l] = {pct: $p, measured_at: $t}
    | .last_updated = $t
  ')"
  write_state "$prefix" "$new"
  echo "recorded coverage: $layer = ${pct}% for $prefix"
}

cmd_record_tests_added() {
  [[ $# -eq 4 ]] || die "usage: edm-state record-tests-added <PREFIX> <phase> <layer> <count>"
  require_jq
  local prefix="$1" phase="$2" layer="$3" count="$4"
  local current new key
  current="$(read_state "$prefix")"
  key="${phase}_phase"
  new="$(echo "$current" | jq --arg k "$key" --arg l "$layer" --argjson c "$count" --arg t "$(now_utc)" '
    .phase_durations[$k] = ((.phase_durations[$k] // {})
      | .tests_by_layer[$l] = ((.tests_by_layer[$l] // 0) + $c)
      | .tests_added = ((.tests_by_layer | to_entries | map(.value) | add) // 0))
    | .last_updated = $t
  ')"
  write_state "$prefix" "$new"
  echo "recorded: +${count} ${layer} tests in phase ${phase} for $prefix"
}

cmd_get_coverage() {
  [[ $# -eq 1 ]] || die "usage: edm-state get-coverage <PREFIX>"
  require_jq
  local prefix="$1"
  local state
  state="$(state_file_for "$prefix")"
  [[ -f "$state" ]] || die "no state for $prefix"
  echo "# Test Coverage - $prefix"
  echo
  jq -r '
    (.coverage_by_layer // {}) | to_entries |
    if length == 0 then "  (no coverage recorded yet - run /edm:test first)"
    else
      "  Layer          Coverage  Measured At",
      "  ----------     --------  -----------",
      (.[] | "  \(.key | . + (" " * (14 - length)))  \(.value.pct)%\(if .value.pct < 10 then "        " elif .value.pct < 100 then "       " else "      " end)  \(.value.measured_at // "?")") |
    .[] // .
    end
  ' "$state" 2>/dev/null || echo "  (no coverage data)"
  echo
  jq -r '
    [.phase_durations | to_entries[] | {phase: .key, tests: .value.tests_added, by_layer: .value.tests_by_layer}] |
    map(select(.tests != null and .tests > 0)) |
    if length == 0 then ""
    else
      "# Tests Added by Phase\n",
      (.[] | "  \(.phase): \(.tests) total  \(.by_layer // {} | to_entries | map("\(.key)=\(.value)") | join(", "))")
    end |
    .[] // .
  ' "$state" 2>/dev/null
}

cmd_srd_version() {
  [[ $# -eq 2 ]] || die "usage: edm-state srd-version <PREFIX> <version>"
  local prefix="$1" version="$2"
  require_jq
  local current new
  current="$(read_state "$prefix")"
  new="$(echo "$current" | jq --arg v "$version" --arg t "$(now_utc)" '.srd_version = $v | .last_updated = $t')"
  write_state "$prefix" "$new"
  echo "set srd_version = $version for $prefix"
  write_handoff_internal "$prefix"
}

cmd_archive() {
  [[ $# -eq 1 ]] || die "usage: edm-state archive <PREFIX>"
  require_jq
  local prefix="$1"
  local src dst
  src="$(initiative_dir_for "$prefix")"
  # Archived initiatives go under .archived/{PREFIX} regardless of source layout.
  dst="${SRD_ROOT}/.archived/${prefix}"
  [[ -d "$src" ]] || die "no initiative directory at $src"

  # Gate check: read code_audit_converged, product_name, and mode from state file.
  local state_file
  state_file="${src}/.edm-state.json"
  if [[ -f "$state_file" ]]; then
    local state_json mode converged product_name
    state_json="$(cat "$state_file" 2>/dev/null || echo '{}')"
    mode="$(echo "$state_json" | jq -r '.mode // "null"')"
    product_name="$(echo "$state_json" | jq -r '.product_name // ""')"
    # Use read_bool to normalize legacy string "false" or missing field correctly.
    if echo "$state_json" | jq -e 'has("code_audit_converged")' >/dev/null 2>&1; then
      converged="$(read_bool "$state_json" "code_audit_converged" "false")"
    else
      converged="absent"
    fi

    if [[ "$mode" == "prototype" ]]; then
      echo "[warn] prototype mode -- skipping code-audit convergence check" >&2
    elif [[ "$converged" == "absent" ]]; then
      echo "[warn] legacy initiative -- code_audit_converged not set; proceeding" >&2
    elif [[ "$converged" == "false" && -n "$product_name" ]]; then
      die "archive refused: code_audit_converged=false; run /edm:code-audit ${prefix} and ensure REMEDIATION.md convergence before archiving"
    fi
    # converged == "true": proceed silently
  fi

  mkdir -p "${SRD_ROOT}/.archived"
  # Use git mv when inside a git worktree so the move is tracked; fall back to plain mv.
  if git -C "$src" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git mv "$src" "$dst" 2>/dev/null || mv "$src" "$dst"
  else
    mv "$src" "$dst"
  fi
  echo "archived $prefix -> $dst"
}

cmd_watch_impl() {
  # Called by the monitor during /edm:implement. Tails git log for new commits
  # referencing any {PREFIX}-T{NN} ticket ID. Emits one line per new commit so
  # the monitor delivers it as a notification.
  command -v git >/dev/null 2>&1 || { echo "git not available"; return 0; }
  local last_sha
  last_sha="$(git rev-parse HEAD 2>/dev/null || echo '')"
  while true; do
    sleep 5
    local new_commits
    new_commits="$(git log --pretty=format:'%h %s' "${last_sha}..HEAD" 2>/dev/null | grep -E '[A-Z]+-T[0-9]+' || true)"
    if [[ -n "$new_commits" ]]; then
      echo "$new_commits"
      last_sha="$(git rev-parse HEAD 2>/dev/null || echo "$last_sha")"
    fi
  done
}

cmd_metrics_report() {
  require_jq
  local arg="${1:-}"
  case "$arg" in
    --all)
      [[ -d "$SRD_ROOT" ]] || { echo "no SRD/ directory"; return 0; }
      echo "# EDM Metrics - Aggregate"
      echo
      printf "  %-12s  %-8s  %-10s  %-12s  %-12s  %-12s\n" "Initiative" "Size" "Total Time" "Claude Cost" "Human Cost" "Cost Ratio"
      printf "  %-12s  %-8s  %-10s  %-12s  %-12s  %-12s\n" "----------" "----" "----------" "-----------" "----------" "----------"
      for state in "$SRD_ROOT"/*/.edm-state.json "$SRD_ROOT"/.archived/*/.edm-state.json; do
        [[ -f "$state" ]] || continue
        jq -r '
          [.phase_durations | to_entries[] | .value] as $phases |
          {
            prefix: .prefix,
            size: (.estimated_size // "?"),
            total_seconds: ([$phases[].duration_seconds // 0] | add),
            total_claude: ([$phases[].estimated_cost_usd // 0] | add),
            total_human: ([$phases[].human_baseline_usd // 0] | add)
          }
          | "  \(.prefix | tostring | .[0:12])  \(.size | tostring | .[0:8])  \(.total_seconds)s\(if .total_seconds < 100 then "         " else "       " end)  $\(.total_claude)\(if .total_claude < 10 then "        " else "      " end)  $\(.total_human)\(if .total_human < 100 then "       " else "     " end)  \(if .total_claude > 0 then ((.total_human / .total_claude) | tostring | .[0:6]) + "x" else "n/a" end)"
        ' "$state" 2>/dev/null
      done
      echo
      echo "Cost Ratio = human_cost / claude_cost (higher = more savings vs. human team baseline)"
      ;;
    --calibrate)
      [[ -d "$SRD_ROOT" ]] || { echo "no SRD/ directory"; return 0; }
      echo "# EDM Calibration - suggested updates to Phase Timing Guidelines"
      echo
      echo "Computed from completed initiatives (active + archived). Median values per (size, phase)."
      echo
      jq -s -r '
        [.[] | select(.estimated_size != null) | . as $i |
          (.phase_durations | to_entries[] | {
            size: $i.estimated_size,
            phase: (.key | sub("_phase$"; "")),
            duration: (.value.duration_seconds // 0),
            cost: (.value.estimated_cost_usd // 0)
          })
        ]
        | group_by(.size + "_" + .phase)
        | map({
            key: .[0].size + "_phase_" + .[0].phase,
            count: length,
            median_duration_s: ((sort_by(.duration) | .[length / 2 | floor].duration)),
            median_cost_usd: ((sort_by(.cost) | .[length / 2 | floor].cost))
          })
        | .[]
        | "  \(.key): n=\(.count), median_duration=\(.median_duration_s)s, median_cost=$\(.median_cost_usd)"
      ' "$SRD_ROOT"/*/.edm-state.json "$SRD_ROOT"/.archived/*/.edm-state.json 2>/dev/null || \
        echo "  (insufficient data - need at least one completed initiative)"
      ;;
    "")
      die "usage: edm-state metrics-report <PREFIX|--all|--calibrate>"
      ;;
    *)
      local prefix="$arg"
      local state
      state="$(state_file_for "$prefix")"
      [[ -f "$state" ]] || die "no state for $prefix"
      echo "# EDM Metrics - $prefix"
      echo
      jq -r '"Initiative: \(.prefix)  |  size: \(.estimated_size // "Unknown")  |  current phase: \(.current_phase)  |  human hourly rate: $'"$HUMAN_HOURLY_RATE_USD"'"' "$state"
      jq -r 'if (.product_name // "") != "" or (.initiative_description // "") != "" then "Product: \(.product_name // "(none)")  |  Description: \(.initiative_description // "(none)")" else empty end' "$state" 2>/dev/null || true
      echo
      printf "  %-10s  %-10s  %-12s  %-12s  %-10s  %-12s  %-10s\n" "Phase" "Duration" "Claude Cost" "Human Cost" "Savings" "Tokens (i/o)" "Model"
      printf "  %-10s  %-10s  %-12s  %-12s  %-10s  %-12s  %-10s\n" "-----" "--------" "-----------" "----------" "-------" "------------" "-----"
      jq -r '
        .phase_durations
        | to_entries
        | sort_by(.key)
        | .[]
        | .key as $k
        | .value as $v
        | "  \($k | sub("_phase$"; "Phase ") | .[0:10])  \(($v.duration_seconds // 0))s\(if ($v.duration_seconds // 0) < 100 then "       " else "     " end)  $\(($v.estimated_cost_usd // 0))\(if ($v.estimated_cost_usd // 0) < 10 then "        " else "      " end)  $\(($v.human_baseline_usd // 0))\(if ($v.human_baseline_usd // 0) < 100 then "        " else "      " end)  \(if ($v.estimated_cost_usd // 0) > 0 then ((($v.human_baseline_usd // 0) / ($v.estimated_cost_usd // 1)) | tostring | .[0:5]) + "x" else "n/a" end)\(if ($v.estimated_cost_usd // 0) > 0 then "    " else "        " end)  \(($v.tokens.input // 0))/\(($v.tokens.output // 0))\(if (($v.tokens.input // 0) + ($v.tokens.output // 0)) < 1000 then "        " else "     " end)  \($v.model_used // "?")"
      ' "$state"
      echo
      jq -r '
        [.phase_durations[] | .estimated_cost_usd // 0] as $costs |
        [.phase_durations[] | .human_baseline_usd // 0] as $humans |
        [.phase_durations[] | .duration_seconds // 0] as $secs |
        ($costs | add) as $tc |
        ($humans | add) as $th |
        ($secs | add) as $ts |
        "  Total: \($ts)s  |  Claude: $\($tc)  |  Human baseline: $\($th)  |  Savings: " +
          (if $tc > 0 then "\(($th / $tc) | tostring | .[0:6])x cheaper" else "n/a" end)
      ' "$state"
      # Gate review time section (only shown when at least one gate is approved)
      # gate_review_seconds = approved_at(gate_N) - phase_complete_timestamp(gated_phase)
      # Gated phases: gate 1 -> phase 1, gate 2 -> phase 3, gate 3 -> phase 5
      local has_gates
      has_gates="$(jq -r '(.gates_approved // []) | length' "$state" 2>/dev/null || echo 0)"
      if [[ "$has_gates" -gt 0 ]]; then
        echo "## Gate Review Times"
        echo
        jq -r '
          # Bind the full state object so it remains accessible after generator iteration.
          . as $state |

          # gated_phase_key: returns the phase_durations key for the phase preceding each gate.
          def gated_phase_key(g):
            if g == 1 then "1_phase"
            elif g == 2 then "3_phase"
            elif g == 3 then "5_phase"
            else null end;

          # phase_complete_epoch: returns epoch seconds for when the gated phase completed.
          # Falls back to started_at + duration_seconds if completed_at is missing.
          def phase_complete_epoch($s; key):
            $s.phase_durations[key] as $pd |
            if $pd == null then null
            elif ($pd.completed_at != null and $pd.completed_at != "") then
              ($pd.completed_at | fromdateiso8601)
            elif ($pd.started_at != null and $pd.started_at != "" and $pd.duration_seconds != null) then
              (($pd.started_at | fromdateiso8601) + $pd.duration_seconds)
            else null end;

          [1, 2, 3] | .[] as $g |
          (($state.gates_approved // []) | map(select(.gate == $g)) | first) as $approval |
          (gated_phase_key($g)) as $pk |
          (phase_complete_epoch($state; $pk)) as $complete_epoch |
          (if $g == 1 then 1 elif $g == 2 then 3 else 5 end) as $gated_phase_num |
          if $approval == null then
            "  Gate \($g) review:  n/a  (not yet approved)"
          elif $complete_epoch == null then
            "  Gate \($g) review:  n/a  (phase \($gated_phase_num) completion time unknown)"
          else
            ($approval.approved_at | fromdateiso8601) as $approved_epoch |
            ($approved_epoch - $complete_epoch) as $diff |
            if $diff < 0 then
              "  Gate \($g) review:  n/a  (timestamp inconsistency)"
            else
              "  Gate \($g) review:  \($diff | floor)s  (approved \($approval.approved_at[:10]), phase \($gated_phase_num) completed \($state.phase_durations[$pk].completed_at // "unknown" | if . != "unknown" then .[:10] else . end))"
            end
          end
        ' "$state" 2>/dev/null || echo "  (gate review data unavailable)"
        echo
      fi
      # Test coverage summary (if any recorded)
      local has_coverage
      has_coverage="$(jq -r '(.coverage_by_layer // {}) | length' "$state" 2>/dev/null || echo 0)"
      if [[ "$has_coverage" -gt 0 ]]; then
        echo "## Test Coverage"
        echo
        printf "  %-14s  %-10s  %-20s\n" "Layer" "Coverage" "Measured At"
        printf "  %-14s  %-10s  %-20s\n" "-----" "--------" "-----------"
        jq -r '
          (.coverage_by_layer // {}) | to_entries[] |
          "  \(.key | . + (" " * (14 - length | if . < 0 then 0 else . end)))  \(.value.pct)%\(if .value.pct < 10 then "         " elif .value.pct < 100 then "        " else "       " end)  \(.value.measured_at // "?")"
        ' "$state" 2>/dev/null
        echo
      fi
      ;;
  esac
}

# ---- Migrate path (T42) ------------------------------------------------------
# migrate-path --product <name> --description <slug> <PREFIX>
# Relocates a flat initiative SRD/{PREFIX}/ to SRD/{PRODUCT}/{PREFIX}__{DESCRIPTION}/
# and updates product_name + initiative_description in state. Git-aware when tracked.

cmd_migrate_path() {
  require_jq
  local prefix="" product="" description=""
  # Flag parsing: accept --product/--description in any order with PREFIX positional.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --product)    [[ $# -ge 2 ]] || die "migrate-path: --product requires a value"; product="$2"; shift 2 ;;
      --description) [[ $# -ge 2 ]] || die "migrate-path: --description requires a value"; description="$2"; shift 2 ;;
      --*)          die "migrate-path: unknown flag $1" ;;
      *)            [[ -z "$prefix" ]] || die "migrate-path: unexpected extra argument: $1"; prefix="$1"; shift ;;
    esac
  done
  [[ -n "$prefix" ]] || die "usage: edm-state migrate-path --product <name> --description <slug> <PREFIX>"
  [[ -n "$product" ]] || die "migrate-path: --product is required"
  [[ -n "$description" ]] || die "migrate-path: --description is required"

  # Resolve current (flat) source directory.
  local src dst
  src="${SRD_ROOT}/${prefix}"
  [[ -d "$src" ]] || die "migrate-path: source directory not found: $src"

  dst="${SRD_ROOT}/${product}/${prefix}__${description}"
  [[ ! -d "$dst" ]] || die "migrate-path: target directory already exists: $dst"

  # Create product subdirectory.
  mkdir -p "${SRD_ROOT}/${product}"

  # Move the initiative directory — git-aware when inside a worktree.
  if git -C "$src" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git mv "$src" "$dst" 2>/dev/null || mv "$src" "$dst"
  else
    mv "$src" "$dst"
  fi

  # Update state: write product_name and initiative_description via the typed path.
  local new_state_file="${dst}/.edm-state.json"
  [[ -f "$new_state_file" ]] || die "migrate-path: state file not found after move: $new_state_file"
  local current new
  current="$(cat "$new_state_file")"
  new="$(echo "$current" | jq --arg p "$product" --arg d "$description" --arg t "$(now_utc)" '
    .product_name = $p | .initiative_description = $d | .last_updated = $t
  ')"
  # Write directly to the new path (state_file_for will now resolve it correctly).
  printf '%s\n' "$new" > "$new_state_file"

  echo "migrated ${prefix}: ${src} -> ${dst}"
  echo "set product_name=${product}, initiative_description=${description}"
}

# ---- Active initiatives (T35) -----------------------------------------------
# active-initiatives: list initiatives with current_phase in 1-6

cmd_active_initiatives() {
  [[ -d "$SRD_ROOT" ]] || { echo "(no SRD/ directory)"; return 0; }
  require_jq
  local found=0
  for state in "$SRD_ROOT"/*/.edm-state.json; do
    [[ -f "$state" ]] || continue
    local phase
    phase="$(jq -r '.current_phase // 0' "$state" 2>/dev/null || echo 0)"
    if [[ "$phase" -ge 1 && "$phase" -le 6 ]]; then
      found=1
      local prefix last
      prefix="$(jq -r '.prefix' "$state" 2>/dev/null || echo unknown)"
      last="$(jq -r '.last_updated' "$state" 2>/dev/null || echo unknown)"
      printf "  %-12s  phase=%d  last_updated=%s\n" "$prefix" "$phase" "$last"
    fi
  done
  [[ $found -eq 1 ]] || echo "  (no active initiatives)"
}

# ---- Gate enforcement (T27) --------------------------------------------------
# gate-check <PREFIX> <gated-command>
# Exits 0 if the gate prerequisite for <gated-command> is satisfied.
# Exits 1 with a human-readable error if the gate is not yet approved.
# Read-only — never mutates state.
#
# Gated commands and their required gates:
#   srd | audit-srd  -> Gate 1 must be approved
#   tickets          -> Gate 2 must be approved
#   audit-tickets | implement -> Gate 3 must be approved

cmd_gate_check() {
  [[ $# -eq 2 ]] || die "usage: edm-state gate-check <PREFIX> <gated-command>"
  require_jq
  local prefix="$1" gated_cmd="$2"
  local state required_gate
  state="$(read_state "$prefix")"

  case "$gated_cmd" in
    srd|audit-srd)    required_gate=1 ;;
    tickets)          required_gate=2 ;;
    audit-tickets|implement) required_gate=3 ;;
    *)
      # Unknown command — no gate enforcement; allow through.
      return 0
      ;;
  esac

  local approved
  approved="$(echo "$state" | jq -r --argjson g "$required_gate" '
    (.gates_approved // []) | map(select(.gate == $g)) | length
  ' 2>/dev/null || echo 0)"

  if [[ "$approved" -eq 0 ]]; then
    echo "edm-state gate-check: Gate ${required_gate} has not been approved for ${prefix}." >&2
    echo "Run /edm:orchestrator ${prefix} and approve Gate ${required_gate} before running /${gated_cmd}." >&2
    return 1
  fi
  return 0
}

# ---- Validate (T32) ----------------------------------------------------------
# validate <PREFIX>
# Runs state_anomalies and exits 3 if any anomalies found, 0 if clean.

cmd_validate() {
  [[ $# -eq 1 ]] || die "usage: edm-state validate <PREFIX>"
  local prefix="$1"
  local anomalies
  anomalies="$(state_anomalies "$prefix")"
  if [[ -n "$anomalies" ]]; then
    echo "# State anomalies for $prefix:"
    echo
    echo "$anomalies"
    return 3
  fi
  echo "# State OK: no anomalies found for $prefix"
  return 0
}

# ---- Branch check (T35) ------------------------------------------------------
# branch-check <PREFIX>
# Verifies the current git branch matches the initiative_branch recorded in state.
# Exits 0 on match or when no initiative_branch is recorded (legacy state).
# Exits 1 with an advisory on mismatch.

cmd_branch_check() {
  [[ $# -eq 1 ]] || die "usage: edm-state branch-check <PREFIX>"
  local prefix="$1"
  require_jq
  local state initiative_branch current_branch
  state="$(read_state "$prefix")"
  initiative_branch="$(echo "$state" | jq -r '.initiative_branch // ""')"
  if [[ -z "$initiative_branch" ]]; then
    # Legacy state without initiative_branch — no enforcement.
    return 0
  fi
  current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
  if [[ -z "$current_branch" ]]; then
    echo "[warn] could not determine current git branch; skipping branch check" >&2
    return 0
  fi
  if [[ "$current_branch" != "$initiative_branch" ]]; then
    echo "edm-state branch-check: current branch '${current_branch}' does not match initiative_branch '${initiative_branch}'." >&2
    echo "Run: git checkout ${initiative_branch}" >&2
    return 1
  fi
  return 0
}

# ---- Git lock check (T36) ----------------------------------------------------
# git-lock-check
# Detects a stale .git/index.lock file and removes it if the holding process is gone.

cmd_git_lock_check() {
  local git_dir
  git_dir="$(git rev-parse --git-dir 2>/dev/null || echo '')"
  if [[ -z "$git_dir" ]]; then
    echo "not inside a git repository" >&2
    return 0
  fi
  local lock_file="${git_dir}/index.lock"
  if [[ ! -f "$lock_file" ]]; then
    echo "no .git/index.lock present"
    return 0
  fi
  # Attempt to identify the holding PID if possible (lock file contents not reliable).
  # On macOS/Linux: if no git process is running, the lock is stale.
  local git_pids
  git_pids="$(pgrep -x git 2>/dev/null | tr '\n' ' ' | xargs || true)"
  if [[ -z "$git_pids" ]]; then
    echo "stale .git/index.lock detected (no git process running); removing..."
    rm -f "$lock_file"
    echo "removed $lock_file"
  else
    echo "WARNING: .git/index.lock exists and git processes are running (PIDs: ${git_pids})" >&2
    echo "Do not remove the lock while git is active; wait for the process to finish." >&2
    return 1
  fi
}

# ---- HANDOFF.md generation --------------------------------------------------
# Writes SRD/{PREFIX}/HANDOFF.md - a version-controlled snapshot that any team
# member can read to understand current status and resume the initiative.
# Called automatically from phase-complete, approve-gate, and checkpoint-if-active.
# Preserves the user-editable ## Notes section across re-writes.

write_handoff_internal() {
  local prefix="$1"
  require_jq
  local state_file
  state_file="$(state_file_for "$prefix")"
  [[ -f "$state_file" ]] || return 0

  local state
  state="$(cat "$state_file")"

  local phase
  phase="$(echo "$state" | jq -r '.current_phase // 0')"

  local phase_name
  case "$phase" in
    0) phase_name="Not started" ;;
    1) phase_name="Phase 1 - Planning" ;;
    2) phase_name="Phase 2 - SRD Creation" ;;
    3) phase_name="Phase 3 - SRD Audit" ;;
    4) phase_name="Phase 4 - Ticket Creation" ;;
    5) phase_name="Phase 5 - Ticket Audit" ;;
    6) phase_name="Phase 6 - Implementation" ;;
    *) phase_name="Phase ${phase}" ;;
  esac

  local gates_count last_gate
  gates_count="$(echo "$state" | jq -r '(.gates_approved // []) | length')"
  last_gate="$(echo "$state" | jq -r '
    (.gates_approved // []) | .[-1] // null |
    if . then "Gate \(.gate) - approved \(.approved_at) by \(.approver // "unknown")"
    else "none yet"
    end
  ')"

  # Derive what to do next from current phase + gates approved
  local gate_nums next_action
  gate_nums="$(echo "$state" | jq -r '[(.gates_approved // []) | .[].gate] | sort | .[]' 2>/dev/null | tr '\n' ' ')"
  case "$phase" in
    0|1)
      if echo " $gate_nums " | grep -qw 1; then
        next_action="Proceed to Phase 2 - SRD creation (\`/edm:orchestrator ${prefix}\`)"
      else
        next_action="HITL Gate 1 pending - run \`/edm:orchestrator ${prefix}\` to present scope for team approval"
      fi
      ;;
    2|3)
      if echo " $gate_nums " | grep -qw 2; then
        next_action="Proceed to Phase 4 - ticket creation (\`/edm:orchestrator ${prefix}\`)"
      else
        next_action="HITL Gate 2 pending - run \`/edm:orchestrator ${prefix}\` to present SRD for team approval"
      fi
      ;;
    4|5)
      if echo " $gate_nums " | grep -qw 3; then
        next_action="Proceed to Phase 6 - implementation (\`/edm:orchestrator ${prefix}\`)"
      else
        next_action="HITL Gate 3 pending - run \`/edm:orchestrator ${prefix}\` to present ticket pack for team approval"
      fi
      ;;
    6) next_action="Phase 6 in progress - run \`/edm:orchestrator ${prefix}\` to continue, then \`/edm:test ${prefix}\` when all tickets pass QC" ;;
    *) next_action="Run \`/edm:orchestrator ${prefix}\` to check status" ;;
  esac

  # Gate list
  local gate_list
  gate_list="$(echo "$state" | jq -r '
    (.gates_approved // []) |
    if length == 0 then "_(none yet)_"
    else map("- Gate \(.gate) - approved \(.approved_at) by \(.approver // "unknown")") | join("\n")
    end
  ')"

  # Artifact presence — derive paths from the layout resolver (T44).
  local _init_dir
  _init_dir="$(initiative_dir_for "$prefix")"
  local planning_path="${_init_dir}/planning.md"
  local srd_path="${_init_dir}/${SRD_FILENAME}"
  local audit_srd_path="${_init_dir}/audit-srd.md"
  local tickets_path="${_init_dir}/${TICKET_PACK_DIRNAME}/README.md"
  local audit_tickets_path="${_init_dir}/${TICKET_PACK_DIRNAME}/audit.md"

  local s_planning s_srd s_audit_srd s_tickets s_audit_tickets
  s_planning="$([[ -f "$planning_path" ]] && echo '[present]' || echo '[absent]')"
  s_srd="$([[ -f "$srd_path" ]] && echo '[present]' || echo '[absent]')"
  s_audit_srd="$([[ -f "$audit_srd_path" ]] && echo '[present]' || echo '[absent]')"
  s_tickets="$([[ -f "$tickets_path" ]] && echo '[present]' || echo '[absent]')"
  s_audit_tickets="$([[ -f "$audit_tickets_path" ]] && echo '[present]' || echo '[absent]')"

  # Decisions Made section from planning.md
  local decisions=""
  if [[ -f "$planning_path" ]]; then
    decisions="$(awk '/^## Decisions Made/{p=1;next} p && /^## /{p=0} p{print}' "$planning_path" 2>/dev/null \
      | grep -v '^[[:space:]]*$' || true)"
  fi
  [[ -n "$decisions" ]] || decisions="_(none recorded yet - decisions are captured at Gate 1)_"

  # Preserve user-edited Notes section across re-writes
  local handoff_path="${_init_dir}/HANDOFF.md"
  local notes=""
  if [[ -f "$handoff_path" ]]; then
    notes="$(awk '/^## Notes/{p=1;next} p && /^## /{p=0} p{print}' "$handoff_path" 2>/dev/null \
      | grep -v '^[[:space:]]*$' || true)"
  fi
  [[ -n "$notes" ]] || notes="_(Add anything a teammate should know before resuming - context, blockers, preferences)_"

  # Surface product and description when present (T43)
  local product_name initiative_description
  product_name="$(echo "$state" | jq -r '.product_name // ""')"
  initiative_description="$(echo "$state" | jq -r '.initiative_description // ""')"

  local updated_at
  updated_at="$(now_utc)"

  {
    printf '%s\n\n' "# ${prefix} - Session Handoff"
    printf '%s  \n' "> **Last updated**: ${updated_at} by ${USER:-unknown}"
    printf '%s\n\n' "> **To resume**: \`/edm:orchestrator ${prefix}\`"
    printf '%s\n\n' "## Current Status"
    printf '%s\n' "- **Phase**: ${phase_name}"
    printf '%s\n' "- **Gates approved**: ${gates_count} of 3"
    printf '%s\n' "- **Last gate**: ${last_gate}"
    [[ -n "$product_name" ]] && printf '%s\n' "- **Product**: ${product_name}"
    [[ -n "$initiative_description" ]] && printf '%s\n' "- **Description**: ${initiative_description}"
    printf '%s\n\n' "- **Next action**: ${next_action}"
    printf '%s\n\n' "## Gates"
    printf '%s\n\n' "${gate_list}"
    printf '%s\n\n' "## Artifact Checklist"
    printf '%s\n' "| Artifact | Status |"
    printf '%s\n' "|----------|--------|"
    printf '%s\n' "| \`${_init_dir}/planning.md\` | ${s_planning} |"
    printf '%s\n' "| \`${_init_dir}/${SRD_FILENAME}\` | ${s_srd} |"
    printf '%s\n' "| \`${_init_dir}/audit-srd.md\` | ${s_audit_srd} |"
    printf '%s\n' "| \`${_init_dir}/${TICKET_PACK_DIRNAME}/README.md\` | ${s_tickets} |"
    printf '%s\n\n' "| \`${_init_dir}/${TICKET_PACK_DIRNAME}/audit.md\` | ${s_audit_tickets} |"
    printf '%s\n\n' "## Key Decisions Made"
    printf '%s\n\n' "${decisions}"
    printf '%s\n\n' "## How to Resume"
    printf '%s\n' "1. Pull the latest branch - all EDM artifacts are committed"
    printf '%s\n' "2. Open Claude Code in the project root"
    printf '%s\n' "3. Run: \`/edm:orchestrator ${prefix}\`"
    printf '%s\n\n' "4. The orchestrator detects the existing initiative and resumes from **${phase_name}**"
    printf '%s\n\n' "## Notes"
    printf '%s\n' "${notes}"
  } > "$handoff_path"
}

cmd_write_handoff() {
  [[ $# -eq 1 ]] || die "usage: edm-state write-handoff <PREFIX>"
  write_handoff_internal "$1"
  echo "wrote $(initiative_dir_for "$1")/HANDOFF.md"
}

# ---- dispatch ---------------------------------------------------------------

cmd="${1:-}"; shift || true
case "$cmd" in
  get)                  cmd_get "$@" ;;
  set)                  cmd_set "$@" ;;
  init)                 cmd_init "$@" ;;
  list)                 cmd_list "$@" ;;
  active-initiatives)   cmd_active_initiatives "$@" ;;
  migrate-path)         cmd_migrate_path "$@" ;;
  approve-gate)         cmd_approve_gate "$@" ;;
  phase-start)          cmd_phase_start "$@" ;;
  phase-complete)       cmd_phase_complete "$@" ;;
  checkpoint-if-active) cmd_checkpoint "$@" ;;
  record-task-duration) cmd_record_task_duration "$@" ;;
  record-test-coverage) cmd_record_test_coverage "$@" ;;
  record-tests-added)   cmd_record_tests_added "$@" ;;
  get-coverage)         cmd_get_coverage "$@" ;;
  srd-version)          cmd_srd_version "$@" ;;
  archive)              cmd_archive "$@" ;;
  write-handoff)        cmd_write_handoff "$@" ;;
  watch-impl)           cmd_watch_impl "$@" ;;
  metrics-report)       cmd_metrics_report "$@" ;;
  validate)             cmd_validate "$@" ;;
  gate-check)           cmd_gate_check "$@" ;;
  branch-check)         cmd_branch_check "$@" ;;
  git-lock-check)       cmd_git_lock_check "$@" ;;
  ""|-h|--help|help)
    sed -n '2,26p' "$0"
    ;;
  *)
    die "unknown subcommand: $cmd (try --help)"
    ;;
esac
